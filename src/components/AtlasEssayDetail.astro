---
/** Site-agnostic essay body: data belongs to the invoking region. */
const { article, listingHref, listingLabel = 'エッセイ一覧へ' } = Astro.props;
---
<article class="atlas-shared-essay">
  <header>
    <a class="atlas-essay-back" href={listingHref}>← {listingLabel}</a>
    {article.region && <p class="atlas-essay-region">{article.region}</p>}
    <h1>{article.title}</h1>
    {article.teaser && <p class="atlas-essay-lead">{article.teaser}</p>}
    {article.imageUrl && <figure><img src={article.imageUrl} alt={article.alt || article.title} /><figcaption>{article.photoCredit || ''}</figcaption></figure>}
    {article.tags?.length > 0 && <ul class="atlas-essay-tags" aria-label="自然条件タグ">{article.tags.map((tag)=><li>{tag}</li>)}</ul>}
  </header>
  <div class="atlas-essay-body">
    {(article.sections || []).map((section)=>(
      <section>
        {section.heading && <h2>{section.heading}</h2>}
        {(section.paragraphs || []).map((paragraph)=><p>{paragraph}</p>)}
      </section>
    ))}
  </div>
  {article.sources?.length > 0 && <aside class="atlas-essay-sources">
    <h2>出典・参照資料</h2>
    <ul>{article.sources.map((source)=><li><a href={source.url} rel="noopener noreferrer">{source.label}</a></li>)}</ul>
  </aside>}
</article>
<style>
  .atlas-shared-essay{max-width:980px;margin:0 auto;padding:44px 23px 90px}
  .atlas-shared-essay header{max-width:880px;margin:0 auto}
  .atlas-essay-back{font-size:.88rem;color:#496a59;text-decoration:none}
  .atlas-essay-region{margin:48px 0 12px;color:#64806e;font-size:.85rem;font-weight:700}
  .atlas-shared-essay h1{font-family:var(--book-serif,serif);font-weight:500;font-size:clamp(2.3rem,5vw,4.2rem);line-height:1.35}
  .atlas-essay-lead{font-size:1.15rem;line-height:1.95;color:#51665b}
  .atlas-shared-essay figure{margin:40px 0}
  .atlas-shared-essay figure img{display:block;width:100%;max-height:600px;object-fit:cover;border-radius:12px}
  .atlas-shared-essay figcaption{color:#687b70;font-size:.78rem;margin-top:9px}
  .atlas-essay-tags{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:22px 0;padding:0}
  .atlas-essay-tags li{border-radius:999px;padding:5px 12px;background:#e9f0e7;color:#365d49;font-size:.81rem}
  .atlas-essay-body{max-width:760px;margin:40px auto}
  .atlas-essay-body section{margin-bottom:46px}
  .atlas-essay-body h2{font-family:var(--book-serif,serif);font-size:clamp(1.5rem,3vw,2.2rem);font-weight:500}
  .atlas-essay-body p{font-size:1.09rem;line-height:2.15;margin:1.35rem 0}
  .atlas-essay-sources{max-width:760px;margin:auto;border-top:1px solid #dde5dc;padding-top:20px}
  .atlas-essay-sources h2{font-size:1.1rem}
  .atlas-essay-sources li{line-height:1.8;overflow-wrap:anywhere}
</style>
