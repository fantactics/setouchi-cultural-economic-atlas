---
/** Site-agnostic essay body: data belongs to the invoking region. */
const { article, listingHref, listingLabel = 'エッセイ一覧へ' } = Astro.props;
---
<article class="atlas-shared-essay">
  <header>
    <a class="atlas-essay-back" href={listingHref}>← {listingLabel}</a>
    {article.region && <p class="atlas-essay-region"><span aria-hidden="true">✳</span> {article.category ? article.category + ' / ' : ''}{article.region}</p>}
    <h1>{article.title}</h1>
    {article.teaser && <p class="atlas-essay-lead">{article.teaser}</p>}
    {article.imageUrl && <figure><img src={article.imageUrl} alt={article.alt || article.title} /><figcaption>{article.photoCredit || ''}</figcaption></figure>}
    {article.tags?.length > 0 && <ul class="atlas-essay-tags" aria-label="自然条件タグ">{article.tags.map((tag)=><li>{tag}</li>)}</ul>}
  </header>
  <div class="atlas-essay-body">
    {(article.sections || []).map((section)=>(
      <section>
        {section.heading && <h2>{section.heading}</h2>}
        {(section.paragraphs || []).map((paragraph)=><p>{paragraph}</p>)}
      </section>
    ))}
  </div>
  {article.sources?.length > 0 && <aside class="atlas-essay-sources">
    <h2>出典・参照資料</h2>
    <ul>{article.sources.map((source)=><li><a href={source.url} rel="noopener noreferrer">{source.label}</a></li>)}</ul>
  </aside>}
</article>
<style>
  .atlas-shared-essay{max-width:1030px;margin:0 auto;padding:clamp(25px,5vw,58px) 22px 90px;color:#304940;font-family:system-ui,-apple-system,"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif}
  .atlas-shared-essay header{max-width:910px;margin:0 auto}
  .atlas-essay-back{display:inline-flex;align-items:center;border-radius:99px;border:1px solid #d9e8dc;background:#edf5ed;padding:9px 15px;font-size:.83rem;font-weight:750;color:#396b55;text-decoration:none}
  .atlas-essay-back:hover{background:#e4efe4}
  .atlas-essay-region{margin:48px 0 13px;color:#b26b47;font-size:.76rem;font-weight:850;letter-spacing:.05em}
  .atlas-essay-region span{font-size:1rem;margin-right:3px}
  .atlas-shared-essay h1{font-family:inherit;font-weight:850;font-size:clamp(2.05rem,4.75vw,3.9rem);letter-spacing:-.05em;line-height:1.34;color:#2a5544;text-wrap:pretty;margin:0 0 21px}
  .atlas-essay-lead{font-size:clamp(1.05rem,1.5vw,1.2rem);line-height:1.95;font-weight:550;color:#647b6b;max-width:770px}
  .atlas-shared-essay figure{margin:35px 0}
  .atlas-shared-essay figure img{display:block;width:100%;max-height:620px;object-fit:cover;border-radius:22px;background:#e7ede8}
  .atlas-shared-essay figcaption{color:#728279;font-size:.76rem;margin-top:10px;line-height:1.6}
  .atlas-essay-tags{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:21px 0;padding:0}
  .atlas-essay-tags li{border-radius:999px;padding:6px 13px;background:#e7f3ea;color:#3a7158;font-size:.79rem;font-weight:700}
  .atlas-essay-body{max-width:760px;margin:50px auto 60px}
  .atlas-essay-body section{margin-bottom:49px}
  .atlas-essay-body h2{font-family:inherit;font-size:clamp(1.45rem,2.8vw,2.1rem);font-weight:800;color:#355c4d;letter-spacing:-.04em;border-left:5px solid #d79365;padding-left:18px;line-height:1.5}
  .atlas-essay-body p{font-size:clamp(1.01rem,1.5vw,1.095rem);line-height:2.13;margin:1.35rem 0;letter-spacing:.007em}
  .atlas-essay-sources{max-width:760px;margin:auto;border-top:1px solid #dce5dc;padding-top:24px}
  .atlas-essay-sources h2{font-size:1.06rem;font-weight:800;color:#466a58}
  .atlas-essay-sources ul{padding-left:1.3rem}
  .atlas-essay-sources li{line-height:1.85;overflow-wrap:anywhere;font-size:.86rem;color:#697d71;margin:.45rem 0}
  .atlas-essay-sources a{color:#376c59}
  @media(max-width:600px){.atlas-essay-region{margin-top:32px}.atlas-shared-essay figure img{border-radius:14px}.atlas-essay-body{margin-top:35px}.atlas-essay-body h2{padding-left:13px}}
</style>
