---
import PlaceLocatorMap from './PlaceLocatorMap.astro';
import { additionalPlacePhotos } from '../data/additionalPlacePhotos.js';
const { place } = Astro.props;
const claimLabels={fact:'事実',interpretation:'解釈',hypothesis:'仮説'};
const photos=additionalPlacePhotos[place.id] || [];
const heroPhoto=photos[0] || null;
const essayLinksByPlace={
  kada:[
    {
      href:'/setouchi-cultural-economic-atlas/book/kada-sea-bream-one-line/',
      title:'潮を釣る町――加太の真鯛は、なぜ一本の糸で獲られるのか',
      description:'紀淡海峡の急潮と一本釣りから、自然条件が漁師の技能を通じて地域価値へ変わる過程を読む。'
    },
    {
      href:'/setouchi-cultural-economic-atlas/book/kitan-strait-tai-to-shirasu/',
      title:'海峡を越えると、鯛がしらすになる',
      description:'加太から泉州へ。同じ紀淡海峡につながる海で、漁法・加工・食文化が変わる理由を追う。'
    }
  ]
};
const essayLinks=essayLinksByPlace[place.id] || [];
---
<article class="regional-profile-page">
  <section class="place-hero chapter-hero">
    <div class="kicker">REGION / {place.prefecture}</div>
    <h1>{place.name}</h1>
    <p class="subtitle">{place.subtitle}</p>
    <div class="tag-row">{place.tags.map((tag)=><span>{tag}</span>)}</div>
  </section>

  {heroPhoto && (
    <section class="section">
      <figure class="photo-evidence-card">
        <a class="photo-image-link" href={heroPhoto.sourcePage} target="_blank" rel="noreferrer">
          <img src={heroPhoto.imageUrl} alt={heroPhoto.alt} fetchpriority="high" decoding="async" />
        </a>
        <figcaption>
          <h3>{heroPhoto.title}</h3>
          <p class="photo-caption">{heroPhoto.caption}</p>
          <div class="photo-insight"><strong>この写真から読む：</strong>{heroPhoto.insight}</div>
          <div class="photo-credit">Photo: {heroPhoto.author} / <a href={heroPhoto.licenseUrl} target="_blank" rel="noreferrer">{heroPhoto.license}</a> · <a href={heroPhoto.sourcePage} target="_blank" rel="noreferrer">原典 ↗</a></div>
        </figcaption>
      </figure>
    </section>
  )}

  <PlaceLocatorMap place={place} />

  <section class="section">
    <div class="kicker">CORE QUESTION</div>
    <h2>なぜ、この町はこの町になったのか。</h2>
    <p class="lead">{place.sections[17]?.[1]}</p>
  </section>

  {essayLinks.length > 0 && (
    <section class="section gene-section">
      <div class="kicker">ESSAYS</div>
      <h2>{place.name}から読むエッセイ</h2>
      <div class="chapter-related-grid">
        {essayLinks.map((essay)=><a class="compare-button secondary" href={essay.href}>
          <strong>{essay.title}</strong><br />
          <span>{essay.description}</span>
        </a>)}
      </div>
    </section>
  )}

  {photos.length > 1 && (
    <section class="section photo-evidence-section">
      <div class="kicker">PHOTO EVIDENCE</div>
      <h2>{place.name}を、写真から読む</h2>
      <div class="photo-evidence-grid">
        {photos.slice(1).map((photo)=><figure class="photo-evidence-card" id={photo.id}>
          <a class="photo-image-link" href={photo.sourcePage} target="_blank" rel="noreferrer">
            <img src={photo.imageUrl} alt={photo.alt} loading="lazy" decoding="async" />
          </a>
          <figcaption>
            <h3>{photo.title}</h3>
            <p class="photo-caption">{photo.caption}</p>
            <div class="photo-insight"><strong>この写真から読む：</strong>{photo.insight}</div>
            <div class="photo-credit">Photo: {photo.author} / <a href={photo.licenseUrl} target="_blank" rel="noreferrer">{photo.license}</a> · <a href={photo.sourcePage} target="_blank" rel="noreferrer">原典 ↗</a></div>
          </figcaption>
        </figure>)}
      </div>
    </section>
  )}

  <section class="section gene-section">
    <div class="kicker">REGIONAL PROFILE</div>
    <h2>自然基盤から現在までを読む</h2>
    <div class="comparison-insight-grid">
      {place.sections.map((section,index)=><article class="insight-card">
        <span class="kicker">{String(index+1).padStart(2,'0')} / {claimLabels[section[2]] || section[2]}</span>
        <h3>{section[0]}</h3>
        <p>{section[1]}</p>
      </article>)}
    </div>
  </section>

  <section class="section">
    <div class="kicker">REGIONAL CAPABILITIES</div>
    <h2>地域に蓄積してきた連鎖</h2>
    {place.genes.map((gene)=><article class="chapter-block">
      <h3>{gene.name}</h3>
      <p>{gene.type}</p>
      <div class="research-chain">
        {gene.chain.map((item)=><span>{item}</span>)}
      </div>
    </article>)}
    <p class="lead">ここで示す連鎖は「同じ土地に後の産業がある」というだけで能力継承とみなすものではありません。人材・技能・組織・資本・土地・交通条件のどれが実際に次の時代へ持ち越されたのかを、今後の研究ノートで分解して検証します。</p>
  </section>

  <section class="section gene-section">
    <div class="kicker">RELATED READING</div>
    <h2>他地域と比べる</h2>
    <div class="chapter-related-grid">
      <a class="compare-button" href="/setouchi-cultural-economic-atlas/places/">地域一覧へ →</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/book/">エッセイから読む →</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/">研究ノートへ →</a>
    </div>
  </section>

  <section class="section">
    <div class="kicker">SOURCES</div>
    <h2>出典・参照資料</h2>
    <ol class="source-list">{place.sources.map((source)=><li><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a> <span>— {source.publisher}</span></li>)}</ol>
  </section>
</article>
