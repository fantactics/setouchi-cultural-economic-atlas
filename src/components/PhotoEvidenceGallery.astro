---
import { photoThemeLabels } from '../data/photoEvidence.js';
const { items = [], title = '写真証拠' } = Astro.props;
---
{items.length > 0 && (
  <section class="section photo-evidence-section">
    <h2>{title}</h2>
    <div class="photo-evidence-grid">
      {items.map((item)=>(
        <figure class="photo-evidence-card" id={item.id}>
          <a class="photo-image-link" href={item.sourcePage} target="_blank" rel="noreferrer">
            <img src={item.imageUrl} alt={item.alt} loading="lazy" decoding="async" />
          </a>
          <figcaption>
            <div class="photo-evidence-meta">
              <span class={`claim-badge ${item.claimType}`}>{item.claimType.toUpperCase()}</span>
              <span class="photo-theme">{photoThemeLabels[item.theme] || item.theme}</span>
            </div>
            <h3>{item.title}</h3>
            <p class="photo-caption">{item.caption}</p>
            <div class="photo-insight"><strong>この写真から読む：</strong>{item.insight}</div>
            <div class="photo-credit">
              Photo: {item.author} / {item.sourceType} /
              <a href={item.licenseUrl} target="_blank" rel="noreferrer">{item.license}</a>
              {' · '}
              <a href={item.sourcePage} target="_blank" rel="noreferrer">原典 ↗</a>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
