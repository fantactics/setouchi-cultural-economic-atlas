---
import { regionalEssaysFor, regionPhotoFor } from '../data/regionDirectory.js';
import { cardTeaser } from '../data/essayCardCopy.js';
const { place }=Astro.props;
const essays=regionalEssaysFor(place);
const photo=regionPhotoFor(place);
const base='/setouchi-cultural-economic-atlas/';
---
<main class="regional-reading">
  <a class="region-back" href={base+'places/'}>← 地名から</a>
  <header class="region-reading-header">
    <span>PLACE / {place.prefecture}</span>
    <h1>{place.name}</h1>
    {place.subtitle && <p>{place.subtitle}</p>}
  </header>
  {photo?.imageUrl && <figure class="region-reading-photo">
    <img src={photo.imageUrl} alt={photo.alt||photo.title||place.name} fetchpriority="high" decoding="async"/>
    <figcaption>{photo.caption||photo.title}{photo.author && <small>　Photo: {photo.author}{photo.sourcePage && <> / <a href={photo.sourcePage} target="_blank" rel="noreferrer">{photo.license||'写真出典'}</a></>}</small>}</figcaption>
  </figure>}
  <section class="region-reading-essays" id="related-essays">
    <div class="region-reading-kicker">ESSAYS</div>
    <h2>{place.name}を読む</h2>
    {essays.length>0 ? <div class="region-reading-list">
      {essays.map(a=><a href={base+'book/'+a.slug+'/'}><strong>{a.title}</strong><span>{cardTeaser(a)}</span><small>読む →</small></a>)}
    </div> : <p>この地域を主題とした公開エッセイは準備中です。下の地域資料をご覧ください。</p>}
  </section>
  {Astro.slots.has('research') && <details class="region-reading-research"><summary>地域資料・写真・出典を詳しく見る</summary><slot name="research" /></details>}
  <p class="region-reading-footer"><a href={base+'places/'}>← 他の町・島を探す</a></p>
</main>
<script is:inline>
  (()=>{const d=document.querySelector('.region-reading-research');if(!d)return;const openHash=()=>{const id=decodeURIComponent(location.hash.slice(1));if(id&&d.querySelector('[id="'+CSS.escape(id)+'"]')){d.open=true;requestAnimationFrame(()=>document.getElementById(id)?.scrollIntoView());}};openHash();window.addEventListener('hashchange',openHash);d.addEventListener('toggle',()=>{if(d.open)window.dispatchEvent(new Event('resize'));});})();
</script>
<style>
.regional-reading{max-width:1100px;margin:0 auto;padding:30px 22px 60px;color:#294a40}.region-back,.region-reading-footer a{color:#326e5c;font-size:.9rem;font-weight:700}.region-reading-header{margin:28px 0 22px}.region-reading-header>span,.region-reading-kicker{color:#b66e52;font-size:.78rem;font-weight:800;letter-spacing:.09em}.region-reading-header h1{font-size:clamp(2.2rem,5vw,3.5rem);line-height:1.2;margin:9px 0;font-weight:800}.region-reading-header p{font-size:1.05rem;line-height:1.8;margin:6px 0}.region-reading-photo{margin:0 0 35px}.region-reading-photo img{display:block;width:100%;max-height:490px;object-fit:cover;border-radius:16px}.region-reading-photo figcaption{font-size:.78rem;color:#64746c;margin:9px 2px;line-height:1.6}.region-reading-essays{margin:35px 0}.region-reading-essays h2{font-size:clamp(1.4rem,3vw,2rem);margin:6px 0 18px}.region-reading-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.region-reading-list a{display:flex;flex-direction:column;gap:8px;border:1px solid #d9e4dc;border-radius:12px;padding:18px;text-decoration:none;background:#fffdfa;color:inherit;line-height:1.6}.region-reading-list a:hover{border-color:#6eaa93}.region-reading-list strong{font-size:1.08rem}.region-reading-list span{font-size:.9rem;color:#596e64}.region-reading-list small{margin-top:auto;color:#326e5c;font-weight:700}.region-reading-research{margin-top:35px;border:1px solid #d9e4dc;border-radius:12px}.region-reading-research>summary{padding:18px;cursor:pointer;color:#326e5c;font-weight:700}.region-reading-footer{margin-top:32px}@media(max-width:650px){.regional-reading{padding:20px 17px 45px}.region-reading-list{grid-template-columns:1fr}.region-reading-photo img{max-height:320px}}
</style>
