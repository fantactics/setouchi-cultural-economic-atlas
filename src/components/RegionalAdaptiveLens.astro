---
import { places } from '../data/places.js';
import { regionalPossibilityTimelines } from '../data/regionalPossibilityTimelines.js';
import { regionalDynamicNaturalCapitalExpansion } from '../data/regionalDynamicNaturalCapitalExpansion.js';
import RegionalDynamicNaturalCapital from './RegionalDynamicNaturalCapital.astro';
import '../styles/regional-adaptive.css';

const { placeId } = Astro.props;
const place = places.find((item)=>item.id===placeId);
const placeName = place?.name || 'この地域';
const timeline = regionalPossibilityTimelines[placeId] || [];
const expandedDynamicNaturalCapital = regionalDynamicNaturalCapitalExpansion[placeId] || null;
---

{expandedDynamicNaturalCapital && <RegionalDynamicNaturalCapital profile={expandedDynamicNaturalCapital} />}

{timeline.length > 0 && (
  <section class="section regional-adaptive" id="region-possibilities">
    <div class="regional-adaptive-head">
      <div>
        <div class="kicker">CHANGE OVER TIME</div>
        <h2>この土地で、人ができることはどう変わったか</h2>
      </div>
      <p>人口や産業の増減だけで地域を評価せず、自然条件への適応、技術、交通、制度、土地利用の変化によって、<strong>何が可能になり、同時に何が難しくなったのか</strong>を時系列で読みます。</p>
    </div>

    <div class="regional-possibility-timeline-wrap">
      <div class="regional-possibility-timeline-head">
        <div><span>{placeName}</span><h3>可能性と制約の変遷</h3></div>
        <p>同じ土地でも、人ができることは一定ではありません。ある変化が新しい選択肢を生む一方で、以前可能だった暮らしや利用を難しくすることがあります。</p>
      </div>

      <div class="regional-possibility-timeline">
        {timeline.map((phase,index)=>(
          <article class="regional-possibility-phase">
            <div class="regional-phase-index">{String(index + 1).padStart(2,'0')}</div>
            <div class="regional-phase-body">
              <h4>{phase.era}</h4>
              <div class="regional-phase-pair">
                <div>
                  <span class="regional-phase-label enabled">可能になったこと</span>
                  <p>{phase.enabled}</p>
                </div>
                <div>
                  <span class="regional-phase-label constrained">同時に難しくなったこと・残った制約</span>
                  <p>{phase.constrained}</p>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="regional-timeline-note">この時系列は、既存資料と地域ページの記述をもとに、土地と人間の関係の変化を編集上再構成したものです。時代を成功／衰退の順序として評価するものではありません。</p>
    </div>

    <div class="regional-adaptive-links">
      <a href="/setouchi-cultural-economic-atlas/methodology/">方法論 →</a>
      <a href="/setouchi-cultural-economic-atlas/about/">このアトラスの立場 →</a>
    </div>
  </section>
)}

<script is:inline>
  (()=>{
    const nav=document.querySelector('.region-cover-nav');
    if(!nav || nav.querySelector('a[href="#region-possibilities"]')) return;
    const link=document.createElement('a');
    link.href='#region-possibilities';
    link.innerHTML='<small>05</small><strong>可能性の変遷</strong><span>できることはどう変わったか</span>';
    nav.appendChild(link);
  })();
</script>
