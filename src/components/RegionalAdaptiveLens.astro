---
import { places } from '../data/places.js';
import '../styles/regional-adaptive.css';

const { placeId } = Astro.props;
const place = places.find((item)=>item.id===placeId);
const placeName = place?.name || 'この地域';
const section = (index) => place?.sections?.[index] || null;

const possibilityDimensions = [
  {
    id:'living',
    number:'01',
    title:'生活可能性',
    subtitle:'住む・移動する・日常生活を営む',
    question:'地形、交通、住宅、災害リスク、生活サービスは、どのような暮らしを可能にし、何を難しくしているか。',
    items:[section(12),section(4),section(14)].filter(Boolean)
  },
  {
    id:'livelihood',
    number:'02',
    title:'生業可能性',
    subtitle:'働く・つくる・商う・技能を継ぐ',
    question:'この土地では、どのような仕事や技能が成立してきたか。産業の変化によって、何が失われ、何が別の形で残ったか。',
    items:[section(6),section(8),section(10)].filter(Boolean)
  },
  {
    id:'nature',
    number:'03',
    title:'自然享受可能性',
    subtitle:'海・山・水・食・景観から恩恵を得る',
    question:'自然環境や生態系から何を得られるか。開発、人口変化、土地利用の変化は、そのアクセスと恩恵をどう変えたか。',
    items:[section(2),section(5),section(14)].filter(Boolean)
  },
  {
    id:'culture',
    number:'04',
    title:'文化実践可能性',
    subtitle:'祭る・食べる・つくる・記憶を継ぐ',
    question:'文化を「残っている物」としてではなく、今も実践できる行為として見る。誰が担い、どの条件によって継続可能になっているか。',
    items:[section(13),section(16),section(3)].filter(Boolean)
  },
  {
    id:'economic',
    number:'05',
    title:'経済的可能性',
    subtitle:'所得を得る・起業する・市場とつながる',
    question:'地域の企業、設備、技能、取引網、市場接続は、どのような経済活動を可能にしているか。成長だけでなく依存や外部不経済も含めて見る。',
    items:[section(10),section(11),section(9)].filter(Boolean)
  },
  {
    id:'choice',
    number:'06',
    title:'選択可能性',
    subtitle:'残る・出る・戻る・別の使い方を選ぶ',
    question:'現在の変化によって、人や地域が選べる生き方・土地利用・産業の幅は広がっているか、狭まっているか。',
    items:[section(15),section(17),section(12)].filter(Boolean)
  }
];
---
<section class="section regional-adaptive" id="region-possibilities">
  <div class="regional-adaptive-head">
    <div>
      <div class="kicker">HUMAN POSSIBILITIES / CONSTRAINTS</div>
      <h2>{placeName}で、人は何を得られ、何ができるのか</h2>
    </div>
    <p>人口、産業、観光、土地利用の増減そのものを評価しません。それらの変化によって、<strong>人が得られるもの・できること・できなくなったこと</strong>がどう変わったのかを、6つの観点から読み直します。</p>
  </div>

  <div class="regional-adaptive-grid">
    {possibilityDimensions.map((dimension)=>(
      <article class={`regional-adaptive-card ${dimension.id}`}>
        <span>{dimension.number} / POSSIBILITY</span>
        <h3>{dimension.title}</h3>
        <strong>{dimension.subtitle}</strong>
        <p>{dimension.question}</p>
        <div class="regional-world-list">
          {dimension.items.map(([title,body])=>(
            <div>
              <strong>{title}</strong>
              <small>{body}</small>
            </div>
          ))}
        </div>
      </article>
    ))}
  </div>

  <div class="regional-learning-loop">
    <div class="regional-learning-chain" aria-label="regional possibility reading cycle">
      <span>何が可能だったか</span><b>→</b><span>何が難しくなったか</span><b>→</b><span>何が新しく可能になったか</span><b>→</b><span>誰が利得・損失を受けるか</span>
    </div>
    <div class="regional-learning-copy">
      <small>NO PRESET ANSWER</small>
      <strong>「課題」は、分析の前提ではなく分析の結果として現れる。</strong>
      <p>人口減少、産業成長、観光化、自然回復などを、最初から善悪で分類しません。同じ変化でも、公共サービス、所得、土地、静けさ、生態系、文化、移動などへの影響は異なります。SETOUCHI ATLASはその交換関係を記述し、どの可能性を重視するかという価値判断はその先に置きます。</p>
    </div>
  </div>

  <div class="regional-adaptive-links">
    <a href="/setouchi-cultural-economic-atlas/methodology/">方法論 →</a>
    <a href="/setouchi-cultural-economic-atlas/about/">このアトラスの立場 →</a>
    <a href="/setouchi-cultural-economic-atlas/data/">根拠データ →</a>
  </div>
</section>

<script is:inline>
  (()=>{
    const nav=document.querySelector('.region-cover-nav');
    if(!nav || nav.querySelector('a[href="#region-possibilities"]')) return;
    const link=document.createElement('a');
    link.href='#region-possibilities';
    link.innerHTML='<small>05</small><strong>人間の可能性</strong><span>何を得られ、何ができるのか</span>';
    nav.appendChild(link);
  })();
</script>
