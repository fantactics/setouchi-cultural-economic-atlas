---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasEssayCards from '../../components/AtlasEssayCards.astro';
import AtlasEssaySearch from '../../components/AtlasEssaySearch.astro';
import { kiiArticles } from '../../data/kiiCmsArticles.js';
import { atlasSites } from '../../config/atlasSites.js';
import '../../styles/reader-navigation.css';

const site = atlasSites.kii;
const stories = kiiArticles.map((article)=>({ ...article, href: `${site.basePath}book/${article.slug}/` }));
// Photo-first, concise front page: three feature stories, three more and a search box.
// Full listings, places, and nature tags have their own dedicated pages.
const featured = stories.slice(0, 3);
const otherStories = stories.slice(-3);
---
<BaseLayout siteKey="kii" title={site.name} description={site.description} image={featured[0]?.imageUrl || null} imageAlt={featured[0]?.alt || ''}>
  <div class="reader-home kii-home-simple">
    <h1 class="reader-home-screenreader">KII ATLAS のエッセイ</h1>

    <section class="reader-home-featured" aria-labelledby="kii-feature-title">
      <p class="reader-home-feature-label" id="kii-feature-title">今日の3篇</p>
      <div class="reader-home-feature-grid">
        {featured.map((story,index)=>(
          <a class="reader-home-feature" href={story.href}>
            {story.imageUrl && <img src={story.imageUrl} alt={story.alt || story.title} loading={index===0?'eager':'lazy'} />}
            <div class="reader-home-feature-copy">
              <span>{story.region}</span>
              <h2>{story.title}</h2>
              <p>{story.teaser}</p>
              <strong>読む →</strong>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="reader-home-section" aria-labelledby="kii-more-title">
      <div class="reader-section-heading">
        <div>
          <p class="reader-eyebrow">MORE STORIES</p>
          <h2 id="kii-more-title">ほかにも、こんな旅。</h2>
          <p>気になる写真から、寄り道してみよう。</p>
        </div>
        <a href={site.basePath+'book/'}>すべてのエッセイを見る →</a>
      </div>
      <AtlasEssayCards stories={otherStories}/>
    </section>

    <section class="reader-home-search" aria-labelledby="kii-search-title">
      <div class="reader-section-heading">
        <div>
          <p class="reader-eyebrow">FIND A STORY</p>
          <h2 id="kii-search-title">ことばで、ひとっとび。</h2>
          <p>地名、温泉、山や川。思いついたことばで探してみよう。</p>
        </div>
      </div>
      <AtlasEssaySearch stories={stories} label="紀伊半島のエッセイを探す" placeholder="例：熊野、白浜、石、温泉" inputId="kii-home-search" />
    </section>
    <nav class="kii-home-about" aria-label="さらに探す">
      <a href={site.basePath+'regions/'}>地名から探す →</a>
      <a href={site.basePath+'nature/'}>自然条件から探す →</a>
      <a href={site.basePath+'about/'}>このサイトについて →</a>
    </nav>
  </div>
</BaseLayout>
<style>
  .kii-home-simple{font-family:system-ui,-apple-system,"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif;color:#29483d}
  .kii-home-simple .reader-home-feature-grid .reader-home-feature{background:#fffdf8}
  .kii-home-simple .reader-home-feature-copy>span{color:#bd7955}
  .kii-home-simple .reader-home-feature-copy strong{background:#e8f1e6;color:#386d56}
  .kii-home-simple .reader-section-heading h2{color:#31594a}
  .kii-home-simple .reader-home-search{background:#edf3ea}
  .kii-home-simple .reader-home-search .atlas-region-search{margin:12px 0 0;background:transparent;padding:0}
  .kii-home-simple .reader-home-search .atlas-region-search label{font-size:.82rem;color:#4e6c5b}
  .kii-home-about{margin:55px 0 0;padding:24px 0;border-top:1px solid #dce5d9;color:#61766a;font-size:.85rem;line-height:1.85}
  .kii-home-about a{display:inline-block;margin:0 20px 8px 0;text-decoration:underline;text-underline-offset:4px;color:#366954;font-weight:700}
  :global(body.atlas-theme-forest){--sea:#376d59;--paper:#faf9f3;--line:#e5e8db}
  @media(max-width:580px){.kii-home-about{margin-top:35px}}
</style>
