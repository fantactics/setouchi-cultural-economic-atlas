---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AtlasEssaySearch from '../../../components/AtlasEssaySearch.astro';
import { atlasSites } from '../../../config/atlasSites.js';
import { kiiArticles } from '../../../data/kiiCmsArticles.js';
import '../../../styles/reader-navigation.css';
import '../../../styles/kii-discovery.css';
import '../../../styles/kii-essay-magazine.css';

const site = atlasSites.kii;
const stories = kiiArticles.map(a=>({...a,href:`${site.basePath}book/${a.slug}/`}));
const bySlug = new Map(stories.map(story=>[story.slug,story]));
const coverSlugs=[
  'nachi-waterfall-where-rock-meets-faith',
  'arida-mikan-climbs-the-hillside',
  'hashiguiiwa-rocks-sunrise-and-legends',
  'kawayu-hot-spring-river-as-a-bath',
  'totsukawa-mountain-villages-and-tenchugumi',
  'dorokyo-quiet-water-cutting-deep',
  'shichirimihama-pebbles-from-river-to-pilgrimage',
  'koyasan-mountain-top-basin-city',
  'shirarahama-white-sand-across-the-sea',
  'saikazaki-blue-green-stone-garden'
];
const coverStories=coverSlugs.map(slug=>bySlug.get(slug)).filter(Boolean);
const featured=coverStories.slice(0,3);
// Categories are drawn from KII article data to avoid adding unpopulated entrances.
const preferredCategories=['信仰景観','歴史景観','農業景観','観光景観','渓谷景観','海と道','自然と文化の景観'];
const categories=preferredCategories
  .map((label,i)=>({label,number:String(i+1).padStart(2,'0'),stories:stories.filter(a=>a.category===label)}))
  .filter(group=>group.stories.length);
const ungrouped=stories.filter(a=>!preferredCategories.includes(a.category));
if(ungrouped.length)throw Error('KII magazine category missing: '+ungrouped.map(a=>a.category).join(','));
const categoryDescription={
  '信仰景観':'山と水が、人の祈りに出会う。',
  '歴史景観':'山と谷の地形から、人と権力の歴史を読み解く。',
  '農業景観':'土地に合わせて育った、実りの風景。',
  '観光景観':'旅人を惹きつける景色の、その理由。',
  '渓谷景観':'深い谷と雨がつくる、水の道。',
  '海と道':'山から海へ、石と人が旅をする。',
  '自然と文化の景観':'岩の色も、暮らしの美意識になる。'
};
---
<BaseLayout siteKey="kii" title="エッセイ一覧" description="今日は、どの紀伊半島へ？写真や風景のテーマから選んで読む、KII ATLASのエッセイ集。">
  <div class="kii-magazine">
    <header class="kii-magazine-intro">
      <div><p class="kii-magazine-eyebrow">STORIES FROM KII <span aria-hidden="true">✳</span></p><h1>今日は、どの紀伊半島へ？</h1></div>
      <p>山の色、川の流れ、海辺の岩。<br />気になる写真から、旅するように読んでみよう。</p>
    </header>

    <section class="kii-magazine-opening" aria-labelledby="kii-magazine-opening-title">
      <div class="kii-magazine-feature-heading"><span>START HERE <span aria-hidden="true">✦</span></span><h2 id="kii-magazine-opening-title">まずは、この3篇。</h2></div>
      <div class="kii-magazine-features">
        {featured.map((story,index)=>(
          <a class="kii-magazine-feature" href={story.href}>
            {story.imageUrl && <img src={story.imageUrl} alt={story.alt || story.title} loading={index===0?'eager':'lazy'}/>}
            <div class="kii-magazine-feature-copy">
              <small>{story.category} / {story.region.split('・')[0]}</small>
              <h3>{story.title}</h3>
              <p>{story.teaser}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="kii-magazine-discovery" aria-labelledby="kii-magazine-discovery-title">
      <div class="kii-magazine-discovery-head">
        <div><span>WHERE TO NEXT? <span aria-hidden="true">✳</span></span><h2 id="kii-magazine-discovery-title">いま、どんな風景が気になる？</h2><p>山を歩く、海を眺める、土地の仕事を知る。好きな景色からどうぞ。</p></div>
        <a href="#kii-all-essays">全{stories.length}篇をみる ↓</a>
      </div>
      <nav class="kii-magazine-categories" aria-label="風景のテーマから探す">
        {categories.map((group,i)=>(
          <a href={`#kii-category-${i+1}`} class="kii-magazine-category">
            <span>{group.number} / {group.stories.length}篇</span>
            <strong>{group.label}</strong>
            <small>{categoryDescription[group.label]}</small>
            <em aria-hidden="true">↗</em>
          </a>
        ))}
      </nav>
      <div class="kii-magazine-search">
        <h3>キーワードで、ひとっとび。</h3>
        <p>「熊野」「みかん」「滝」「温泉」など、思いついた言葉で。</p>
        <AtlasEssaySearch stories={stories} label="エッセイを探す" placeholder="例：熊野、みかん、滝、温泉" inputId="kii-index-search"/>
      </div>
    </section>

    <section class="kii-magazine-all" id="kii-all-essays" aria-labelledby="kii-all-title">
      <div class="kii-magazine-all-heading"><div><p class="kii-magazine-eyebrow">EXPLORE THE LANDSCAPES</p><h2 id="kii-all-title">紀伊を、つまみ読み。</h2></div><p>自然と人が出会って生まれた風景を、テーマごとに。</p></div>
      {categories.map((group,i)=>(
        <section class="kii-magazine-group" id={`kii-category-${i+1}`} aria-labelledby={`kii-category-title-${i+1}`}>
          <div class="kii-magazine-group-head">
            <h3 id={`kii-category-title-${i+1}`}>{group.label} <small>{group.stories.length}篇</small></h3>
            <p>{categoryDescription[group.label]}</p>
          </div>
          <div class="kii-magazine-story-grid">
            {group.stories.map(story=>(
              <a class="kii-magazine-story" href={story.href}>
                {story.imageUrl && <div class="kii-magazine-photo"><img src={story.imageUrl} alt={story.alt || story.title} loading="lazy"/></div>}
                <div class="kii-magazine-story-copy"><h4>{story.title}</h4><p>{story.teaser}</p><span>{story.region}</span></div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </section>

    <section class="kii-magazine-directory" id="kii-title-directory" aria-labelledby="kii-title-directory-heading">
      <p class="kii-magazine-eyebrow">ALL STORIES / DIRECTORY</p>
      <h2 id="kii-title-directory-heading">タイトルを、ずらり。</h2>
      <p>全{stories.length}篇。写真を見ずに探したいときはこちら。</p>
      <div class="kii-magazine-directory-grid">
        {categories.map(group=><div class="kii-magazine-directory-group">
          <h3>{group.label}</h3>
          <ul>{group.stories.map(story=><li><a href={story.href}>{story.title}</a></li>)}</ul>
        </div>)}
      </div>
    </section>
    <div class="kii-magazine-back"><a href="#kii-magazine-discovery-title">↑ 風景選びへ戻る</a></div>
  </div>
</BaseLayout>