---
import BaseLayout from '../layouts/BaseLayout.astro';
import { places } from '../data/places.js';
import { seafoodSpecies } from '../data/seafood.js';

const placeById = Object.fromEntries(places.map((p)=>[p.id,p]));
const placeSpecies = Object.fromEntries(places.map((p)=>[
  p.id,
  seafoodSpecies.filter((s)=>s.places.includes(p.id))
]));
const seasonOrder = ['春','夏','秋','冬'];
const speciesBySeason = Object.fromEntries(seasonOrder.map((season)=>[
  season,
  seafoodSpecies.filter((s)=>s.seasons.includes(season))
]));
---
<BaseLayout title="海の食文化 | 瀬戸内文化経済アトラス" description="鯛・タコ・シャコなど、瀬戸内の海域条件と魚食文化を横断的に読む。">
  <section class="place-hero">
    <div class="kicker">SEAFOOD CULTURE</div>
    <h1>瀬戸内の海の食文化</h1>
    <p class="subtitle">魚種を並べるだけでなく、海域条件・漁法・調理・港町文化までを一つの連鎖として読みます。</p>
  </section>

  <section class="section">
    <div class="kicker">SPECIES LAYERS</div>
    <h2>まず9つの魚介から読む</h2>
    <div class="seafood-grid">
      {seafoodSpecies.map((item)=>(
        <a class="seafood-card" href={`/setouchi-cultural-economic-atlas/seafood/${item.id}/`}>
          <div class="kicker">{item.seasons}</div>
          <h3>{item.name}</h3>
          <p>{item.thesis}</p>
          <ul class="tags">{item.regions.slice(0,4).map((r)=><li>{r}</li>)}</ul>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="kicker">SEASONAL CALENDAR</div>
    <h2>旬で読む</h2>
    <div class="season-grid">
      {seasonOrder.map((season)=>(
        <article class="season-card">
          <h3>{season}</h3>
          <div class="season-species-list">
            {speciesBySeason[season].map((s)=><a href={`/setouchi-cultural-economic-atlas/seafood/${s.id}/`}>{s.name}</a>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="kicker">SPECIES × PLACE</div>
    <h2>魚種と地域の関係</h2>
    <div class="compare-table-wrap">
      <table class="compare-table seafood-matrix">
        <thead>
          <tr>
            <th>魚種</th>
            {places.map((p)=><th>{p.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {seafoodSpecies.map((s)=>(
            <tr>
              <th><a href={`/setouchi-cultural-economic-atlas/seafood/${s.id}/`}>{s.name}</a></th>
              {places.map((p)=><td class={s.places.includes(p.id) ? 'seafood-hit' : ''}>{s.places.includes(p.id) ? '●' : '—'}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="map-note">●は現在の一次資料で地域との結びつきを確認しているもの。空欄は「存在しない」ではなく、未検証を含みます。</p>
  </section>

  <section class="section">
    <div class="kicker">STRUCTURE</div>
    <h2>「海の食文化」をどう読むか</h2>
    <div class="causal-chain seafood-chain">
      <span>海峡・干潟・砂泥底・多島海</span><b>→</b>
      <span>魚種・資源</span><b>→</b>
      <span>漁法</span><b>→</b>
      <span>保存・加工</span><b>→</b>
      <span>郷土料理</span><b>→</b>
      <span>港町文化・観光</span>
    </div>
    <p class="lead">同じ「瀬戸内の魚」でも、鯛は強潮流、シャコは砂泥底、牡蠣は静穏な内湾、イリコは燧灘の漁場と加工技術というように、食文化の成立条件は異なります。</p>
  </section>

  <section class="section">
    <div class="kicker">BY PLACE</div>
    <h2>10地域から見る</h2>
    <div class="grid">
      {places.map((place)=>(
        <article class="card" id={`place-${place.id}`}>
          <div class="kicker">{place.prefecture}</div>
          <h3>{place.name}</h3>
          {placeSpecies[place.id].length ? (
            <>
              <p>{placeSpecies[place.id].map((s)=>s.name).join('・')}</p>
              <div class="seafood-link-list">
                {placeSpecies[place.id].map((s)=>(
                  <a class="text-link" href={`/setouchi-cultural-economic-atlas/seafood/${s.id}/`}>{s.name} →</a>
                ))}
              </div>
            </>
          ) : (
            <p class="map-note">海の食文化データは今後追加検証。</p>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="kicker">NEIGHBORING HOTSPOTS</div>
    <h2>10地域外でも外せない場所</h2>
    <div class="comparison-insight-grid">
      <article class="insight-card"><h3>笠岡</h3><p>シャコ、市の魚、シャコ丼。さらに備後フィッシュではマダイ・タコ・アナゴ・ガザミなど多様な魚介が季節別に整理されている。</p></article>
      <article class="insight-card"><h3>西讃・伊吹島</h3><p>カタクチイワシを煮干しに加工するイリコ文化。讃岐うどんの出汁と漁業・加工業が直結する。</p></article>
      <article class="insight-card"><h3>広島湾</h3><p>牡蠣養殖を核に、静穏な内湾・河川からの栄養供給・筏養殖技術が一体化した食文化圏。</p></article>
    </div>
  </section>
</BaseLayout>
