---
import BaseLayout from '../layouts/BaseLayout.astro';
import { places } from '../data/places.js';
import { industrySpatialNodes, industrySpatialRelations, industrySpatialCategories, industryRelationTypes, industryEraPresets, industryNodeStartStage } from '../data/industrySpatial.js';

const rows = places.map((place)=>({
  id:place.id,
  name:place.name,
  prefecture:place.prefecture,
  industry:place.sections[6],
  companies:place.sections[7],
  gene:place.sections[8],
  capital:place.sections[9],
  ecosystem:place.sections[10],
  sources:place.sources,
  sectionSources:place.sectionSources || {}
}));

const mappedPlaceCount = new Set(industrySpatialNodes.map((n)=>n.placeId)).size;

const sourceMap = (row, index) => {
  const ids = row.sectionSources[index] || [];
  return ids.map((id)=>row.sources.find((s)=>s.id===id)).filter(Boolean);
};
---
<BaseLayout title="産業・資本比較 | 瀬戸内文化経済アトラス" description="瀬戸内17地域の地域産業・代表企業・資本形成・産業生態系を比較する。">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <section class="place-hero">
    <div class="kicker">INDUSTRY & CAPITAL</div>
    <h1>現在の産業は、どこから来たのか</h1>
    <p class="subtitle">歴史産業の「直系子孫」だけを探すのではなく、土地・港湾・技能・商人資本・交通・制度が、現在の企業と産業集積へどう受け渡されたかを17地域で比較します。</p>
  </section>

  <section class="section">
    <div class="kicker">SPATIAL LINEAGE MAP</div>
    <h2>{mappedPlaceCount}地域の産業遺伝子を、空間で追う</h2>
    <p class="lead">旧塩田・商家地区・歴史港と、現在の本社・工場・産業集積を重ねます。線は企業の直系系譜とは限らず、土地・物流・技能・資本など「何が継承されたか」を分けて表示します。</p>

    <div class="industry-era-control">
      <div class="industry-era-head">
        <span class="filter-label">時代</span>
        <strong id="industry-era-label">{industryEraPresets[3].label}</strong>
        <small id="industry-era-period">{industryEraPresets[3].period}</small>
      </div>
      <input id="industry-era-range" type="range" min="0" max={industryEraPresets.length - 1} step="1" value="3" aria-label="産業形成の時代を切り替える" />
      <div class="industry-era-labels">
        {industryEraPresets.map((era)=><span>{era.label}</span>)}
      </div>
      <p id="industry-era-description" class="industry-era-description">{industryEraPresets[3].description}</p>
      <div id="industry-era-count" class="industry-era-count"></div>
      <p class="map-note">表示は「その時代までに形成された産業資産」の累積です。過去の港・塩田・商家なども、後世の産業を読む痕跡として残します。</p>
    </div>

    <div class="industry-map-controls">
      <div class="industry-filter-group">
        <span class="filter-label">地点</span>
        {Object.entries(industrySpatialCategories).map(([key,item])=>(
          <button type="button" class="industry-map-filter active" data-node-category={key}>{item.label}</button>
        ))}
      </div>
      <div class="industry-filter-group relation-filter-group">
        <span class="filter-label">関係線</span>
        {Object.entries(industryRelationTypes).map(([key,item])=>(
          <button type="button" class="industry-relation-filter active" data-relation-type={key}>{item.label}</button>
        ))}
      </div>
    </div>

    <div id="industry-lineage-map"
      class="atlas-map industry-lineage-map"
      data-nodes={JSON.stringify(industrySpatialNodes)}
      data-relations={JSON.stringify(industrySpatialRelations)}
      data-categories={JSON.stringify(industrySpatialCategories)}
      data-relation-types={JSON.stringify(industryRelationTypes)}
      data-eras={JSON.stringify(industryEraPresets)}
      data-node-start-stage={JSON.stringify(industryNodeStartStage)}></div>

    <div class="industry-map-legend">
      {Object.entries(industryRelationTypes).map(([key,item])=>(
        <div><span class={`line-swatch ${key}`}></span><strong>{item.label}</strong><small>{item.description}</small></div>
      ))}
    </div>

    <p class="map-note">位置精度は地点ごとに site / address / district / approximate を保持しています。範囲型の産業地区・旧塩田などは代表点表示であり、境界を示すものではありません。</p>
  </section>

  <section class="section textile-corridor-case">
    <div class="kicker">SETOUCHI TEXTILE BELT</div>
    <h2>児島だけでなく、今治・東かがわ・福山へ広げて比較する</h2>
    <p class="lead">瀬戸内の繊維産業は、干拓綿作・港湾物流・水質・縫製技能・藍染・工程集積など、異なる条件から成立しています。4産地を同じ軸で比較する専用ページを追加しました。</p>
    <a class="compare-button" href="/setouchi-cultural-economic-atlas/textiles/">瀬戸内の繊維・縫製産業帯を見る →</a>
  </section>

  <section class="section transport-industry-link">
    <div class="kicker">TRANSPORT × INDUSTRY</div>
    <h2>交通の変化と、産業立地の変化を行き来する</h2>
    <p class="lead">近世の港、近代鉄道、戦後の港湾・架橋が産業立地にどう影響したかは、Transportの時代地図と併読すると見えやすくなります。</p>
    <a class="compare-button" href="/setouchi-cultural-economic-atlas/transport/">交通の時代地図を見る →</a>
  </section>

  <section class="section">
    <div class="kicker">LINEAGE CASES</div>
    <h2>同じ「つながり」ではない</h2>
    <div class="industry-lineage-list">
      {industrySpatialRelations.map((rel)=>{
        const from=industrySpatialNodes.find((n)=>n.id===rel.from);
        const to=industrySpatialNodes.find((n)=>n.id===rel.to);
        const type=industryRelationTypes[rel.type];
        return (
          <article class="industry-lineage-card">
            <div class="industry-lineage-meta">
              <span class={`relation-badge ${rel.type}`}>{type.label}</span>
              <span class={`confidence-badge ${rel.confidence}`}>{rel.confidence.toUpperCase()}</span>
            </div>
            <h3>{from?.name} → {to?.name}</h3>
            <p>{rel.note}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section textile-case">
    <div class="kicker">TEXTILE INDUSTRY CASE</div>
    <h2>下津井・児島・倉敷：港湾物流から繊維産業へ</h2>
    <p class="lead">この地域では「港町」と「繊維産地」を別々に見ると因果が切れます。干拓地の綿作、北前船による肥料・木綿物流、児島の織布・縫製技能、明治期の機械制紡績、学生服、ジーンズまでを一つの地域産業システムとして読みます。</p>
    <div class="comparison-insight-grid">
      <article class="insight-card"><h3>1. 干拓と綿作</h3><p>塩分を含む干拓地でも栽培しやすい綿が、児島・倉敷の織物産業の原料基盤になりました。</p></article>
      <article class="insight-card"><h3>2. 北前船と下津井</h3><p>干鰯・ニシン粕などの肥料が入り、綿・木綿・塩などが外へ出る物流回路が形成されました。</p></article>
      <article class="insight-card"><h3>3. 技能の連鎖</h3><p>真田紐・小倉織・足袋から、学生服・作業服・縫製・染色へ技能が蓄積しました。</p></article>
      <article class="insight-card"><h3>4. 紡績の近代化</h3><p>1881年の下村紡績、1889年の倉敷紡績所など、機械制紡績と近代企業資本が地域に新しい産業層を加えました。</p></article>
      <article class="insight-card"><h3>5. 学生服</h3><p>1955年には全国学生服の約7割を児島産が占めるまでに縫製産地が拡大しました。</p></article>
      <article class="insight-card"><h3>6. ジーンズ</h3><p>1965年の国産初ジーンズ生産へ展開し、現在は加工技術・ブランド・産業観光まで価値を拡張しています。</p></article>
    </div>
    <p class="map-note">重要なのは「下津井港がジーンズを生んだ」と単純化しないことです。港湾物流は綿作・商品流通を支える一要素で、児島の加工技能、需要変化、近代紡績資本など複数の経路が重なって現在の繊維産業になっています。</p>
    <a class="text-link" href="/setouchi-cultural-economic-atlas/textiles/">今治・東かがわ・福山との横断比較 →</a>
  </section>

  <section class="section">
    <div class="kicker">COMPARATIVE MATRIX</div>
    <h2>17地域を5つの層で比べる</h2>
    <div class="compare-table-wrap">
      <table class="compare-table industry-compare-table">
        <thead>
          <tr><th>地域</th><th>地域産業</th><th>代表企業・主体</th><th>産業遺伝子</th><th>資本形成</th><th>産業生態系</th></tr>
        </thead>
        <tbody>
          {rows.map((row)=>(
            <tr id={`place-${row.id}`}>
              <th><a href={`/setouchi-cultural-economic-atlas/places/${row.id}/`}>{row.name}</a><small>{row.prefecture}</small></th>
              {[6,7,8,9,10].map((index)=>{
                const section = row[index===6?'industry':index===7?'companies':index===8?'gene':index===9?'capital':'ecosystem'];
                const refs = sourceMap(row,index);
                return (
                  <td>
                    <span class={`claim-badge ${section[2]}`}>{section[2].toUpperCase()}</span>
                    <p>{section[1]}</p>
                    {refs.length>0 && <div class="industry-source-pills">{refs.slice(0,3).map((s)=><a href={s.url} target="_blank" rel="noreferrer">{s.id}</a>)}</div>}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="kicker">CAPITAL PATHS</div>
    <h2>資本形成には少なくとも4つの経路がある</h2>
    <div class="comparison-insight-grid">
      <article class="insight-card"><h3>商人資本の蓄積</h3><p>尾道・柳井・竹原など。交易利益が商家、金融、廻船、醸造、町並みへ再投資される。</p></article>
      <article class="insight-card"><h3>土地・港湾の継承</h3><p>赤穂・坂出・防府など。塩田や沿岸造成地が、後の工業・港湾用地へ転換される。</p></article>
      <article class="insight-card"><h3>技能・企業の自己強化</h3><p>今治・引田周辺など。造船・舶用、手袋縫製、醸造といった技能の蓄積が企業群を形成する。</p></article>
      <article class="insight-card"><h3>県都・ゲートウェイ集積</h3><p>松山・高松・下関など。交通結節、行政、本社、金融、物流が複合して都市中心性を再生産する。</p></article>
    </div>
  </section>

  <section class="section">
    <div class="kicker">READING RULE</div>
    <h2>「昔から続いている」と言い過ぎない</h2>
    <div class="synthesis">
      産業遺伝子は企業の直接的な系譜を意味しません。製塩から化学、港から工業、交易から金融へ移る場合、
      直接継承されるのは企業ではなく、土地・物流・技能・市場・資本・制度であることがあります。
      本ページではFACT / INTERPRETATION / HYPOTHESISを分け、連続性の強さを検証可能な形で残します。
    </div>
  </section>
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script is:inline>
    (() => {
      const el=document.getElementById('industry-lineage-map');
      if(!el || !window.L) return;
      const nodes=JSON.parse(el.dataset.nodes || '[]');
      const relations=JSON.parse(el.dataset.relations || '[]');
      const categories=JSON.parse(el.dataset.categories || '{}');
      const relationTypes=JSON.parse(el.dataset.relationTypes || '{}');
      const eras=JSON.parse(el.dataset.eras || '[]');
      const nodeStartStage=JSON.parse(el.dataset.nodeStartStage || '{}');

      const map=L.map(el,{scrollWheelZoom:false}).setView([34.15,132.75],7);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
        maxZoom:18,attribution:'&copy; OpenStreetMap contributors'
      }).addTo(map);

      const nodeLayers={};
      const relationLayers={};
      const nodeMarkers={};
      const relationLines=[];
      const nodeById=Object.fromEntries(nodes.map((n)=>[n.id,n]));
      const stageIndex=Object.fromEntries(eras.map((e,i)=>[e.id,i]));
      let activeEraIndex=Math.max(0,eras.length-1);
      const nodeCategoryEnabled={};
      const relationTypeEnabled={};

      const categoryStyle={
        heritage:{color:'#8a623c',fillColor:'#c39a69'},
        infrastructure:{color:'#315f84',fillColor:'#6f9db9'},
        headquarters:{color:'#6a4e8b',fillColor:'#9e82b8'},
        factory:{color:'#7f493f',fillColor:'#b87a6d'},
        cluster:{color:'#50714f',fillColor:'#7ca37a'}
      };

      const relationStyle={
        direct_continuity:{color:'#5c3e2e',weight:5,dashArray:null},
        land_inheritance:{color:'#8a6a36',weight:4,dashArray:'10 6'},
        logistics_inheritance:{color:'#315f84',weight:4,dashArray:'14 5 2 5'},
        skill_inheritance:{color:'#50714f',weight:4,dashArray:'2 6'},
        capital_inheritance:{color:'#6a4e8b',weight:4,dashArray:null},
        parallel_modern_layer:{color:'#777',weight:3,dashArray:'5 7'}
      };

      nodes.forEach((n)=>{
        if(!nodeLayers[n.category]) nodeLayers[n.category]=L.layerGroup();
        nodeCategoryEnabled[n.category]=true;
        const style=categoryStyle[n.category] || {color:'#555',fillColor:'#999'};
        const marker=L.circleMarker([n.lat,n.lon],{
          radius:8,weight:2.2,fillOpacity:.86,color:style.color,fillColor:style.fillColor
        }).bindPopup(
          '<strong>'+n.name+'</strong><br>'+
          (categories[n.category]?.label || n.category)+' / '+n.era+
          '<br>'+n.note+
          '<br><small>形成段階: '+(eras[stageIndex[nodeStartStage[n.id]]] ? eras[stageIndex[nodeStartStage[n.id]]].label : '未設定')+' / 位置精度: '+n.precision+'</small>'+
          '<br><a href="'+n.sourceUrl+'" target="_blank" rel="noreferrer">根拠資料 ↗</a>'
        );
        nodeMarkers[n.id]=marker;
      });

      relations.forEach((rel)=>{
        const from=nodeById[rel.from], to=nodeById[rel.to];
        if(!from || !to) return;
        relationTypeEnabled[rel.type]=true;
        const style=relationStyle[rel.type] || {color:'#777',weight:3,dashArray:'5 7'};
        const line=L.polyline([[from.lat,from.lon],[to.lat,to.lon]],{
          color:style.color,weight:style.weight,dashArray:style.dashArray,opacity:.78
        }).bindPopup(
          '<strong>'+(relationTypes[rel.type]?.label || rel.type)+'</strong><br>'+
          from.name+' → '+to.name+
          '<br>'+rel.note+
          '<br><small>確度: '+rel.confidence.toUpperCase()+'</small>'
        );
        relationLines.push({rel,line});
      });

      const isNodeAvailable=(id)=>{
        const start=nodeStartStage[id] || 'contemporary';
        return (stageIndex[start] ?? eras.length-1) <= activeEraIndex;
      };

      const refreshMap=()=>{
        Object.values(nodeLayers).forEach((layer)=>layer.clearLayers());
        nodes.forEach((n)=>{
          if(nodeCategoryEnabled[n.category] && isNodeAvailable(n.id)){
            nodeLayers[n.category].addLayer(nodeMarkers[n.id]);
          }
        });
        Object.entries(nodeLayers).forEach(([key,layer])=>{
          if(nodeCategoryEnabled[key] && !map.hasLayer(layer)) map.addLayer(layer);
          if(!nodeCategoryEnabled[key] && map.hasLayer(layer)) map.removeLayer(layer);
        });

        Object.values(relationLayers).forEach((layer)=>layer.clearLayers());
        relationLines.forEach(({rel,line})=>{
          if(!relationLayers[rel.type]) relationLayers[rel.type]=L.layerGroup();
          if(relationTypeEnabled[rel.type] && isNodeAvailable(rel.from) && isNodeAvailable(rel.to)){
            relationLayers[rel.type].addLayer(line);
          }
        });
        Object.entries(relationLayers).forEach(([key,layer])=>{
          if(relationTypeEnabled[key] && !map.hasLayer(layer)) map.addLayer(layer);
          if(!relationTypeEnabled[key] && map.hasLayer(layer)) map.removeLayer(layer);
        });
      };

      const allCoords=nodes.map((n)=>[n.lat,n.lon]);
      if(allCoords.length) map.fitBounds(L.latLngBounds(allCoords),{padding:[26,26]});

      const eraRange=document.getElementById('industry-era-range');
      const eraLabel=document.getElementById('industry-era-label');
      const eraPeriod=document.getElementById('industry-era-period');
      const eraDescription=document.getElementById('industry-era-description');
      const eraCount=document.getElementById('industry-era-count');
      const applyEra=(index)=>{
        activeEraIndex=index;
        const era=eras[index];
        if(eraLabel && era) eraLabel.textContent=era.label;
        if(eraPeriod && era) eraPeriod.textContent=era.period;
        if(eraDescription && era) eraDescription.textContent=era.description;
        if(eraCount){
          const visibleNodes=nodes.filter((n)=>isNodeAvailable(n.id)).length;
          const visibleRelations=relations.filter((r)=>isNodeAvailable(r.from) && isNodeAvailable(r.to)).length;
          eraCount.textContent='形成済み拠点 '+visibleNodes+' / '+nodes.length+'　・　表示可能な継承関係 '+visibleRelations+' / '+relations.length;
        }
        refreshMap();
      };
      if(eraRange){
        eraRange.addEventListener('input',()=>applyEra(Number(eraRange.value)));
      }

      document.querySelectorAll('.industry-map-filter').forEach((button)=>{
        button.addEventListener('click',()=>{
          const key=button.dataset.nodeCategory;
          nodeCategoryEnabled[key]=!nodeCategoryEnabled[key];
          button.classList.toggle('active',nodeCategoryEnabled[key]);
          refreshMap();
        });
      });

      document.querySelectorAll('.industry-relation-filter').forEach((button)=>{
        button.addEventListener('click',()=>{
          const key=button.dataset.relationType;
          relationTypeEnabled[key]=!relationTypeEnabled[key];
          button.classList.toggle('active',relationTypeEnabled[key]);
          refreshMap();
        });
      });

      applyEra(activeEraIndex);
    })();
  </script>
</BaseLayout>
