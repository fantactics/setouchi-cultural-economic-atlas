---
import BaseLayout from '../layouts/BaseLayout.astro';
import { places } from '../data/places.js';
import { researchChapters } from '../data/researchChapters.js';
import { concepts } from '../data/concepts.js';
import { reasoningEssays } from '../data/reasoningEssays.js';

const featuredConceptIds=[
  'regional-capability-capital','traffic-friction','economy-of-waiting',
  'nodal-capital','urban-stratigraphy','remote-ecosystem-connection',
  'ecosystem-on-a-plate','landscape-of-practice','invisible-supply-source'
];
const featuredConcepts=featuredConceptIds.map((id)=>concepts.find((x)=>x.id===id)).filter(Boolean);
const featuredReasoning=reasoningEssays.slice(0,6);
const featuredPlaceIds=['onomichi','mitarai','tadotsu','shimotsui','imabari','niihama','shodoshima','matsuyama','yanai','iwakuni'];
const featuredPlaces=featuredPlaceIds.map((id)=>places.find((x)=>x.id===id)).filter(Boolean);
---
<BaseLayout title="瀬戸内文化経済アトラス" description="自然・生業・交易・産業・文化・都市の因果から、瀬戸内を読む文化経済アトラス。">
  <section class="home-hero">
    <div class="home-hero-copy">
      <div class="eyebrow">SETOUCHI CULTURE & ECONOMY ATLAS</div>
      <h1>自然から、<br />町と文化ができるまで。</h1>
      <p>瀬戸内を「名物」「観光地」「主要産業」の一覧ではなく、地形・水・海の生態系から、生業、港・交易、加工技術、都市、食・信仰・景観へ続く因果の連鎖として読むアトラス。</p>
      <div class="home-hero-actions">
        <a class="compare-button" href="/setouchi-cultural-economic-atlas/chapters/">研究本文を読む →</a>
        <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/places/">地域から読む →</a>
      </div>
    </div>
    <div class="home-hero-model">
      <div class="model-node"><span>01</span><b>自然基盤</b><small>地形・地質・気候・水・海況</small></div>
      <div class="model-arrow">↓</div>
      <div class="model-node"><span>02</span><b>生業と技術</b><small>漁・塩・農・石・鉱山・発酵</small></div>
      <div class="model-arrow">↓</div>
      <div class="model-node"><span>03</span><b>交易と地域能力</b><small>港・船・技能・企業・金融</small></div>
      <div class="model-arrow">↓</div>
      <div class="model-node"><span>04</span><b>文化と都市</b><small>食・信仰・景観・町割り</small></div>
    </div>
  </section>

  <section class="section home-manifesto">
    <div class="kicker">CORE QUESTION</div>
    <h2>「自然環境が何を可能にし、人間がそれを何に変えた地域なのか」</h2>
    <p class="lead">自然は産業を決定しません。自然が与える制約と可能性に、人間が技術・制度・交易・投資で応答します。その反復が、地域能力、都市、料理、祭礼、景観として残ります。</p>
    <div class="evidence-legend">
      <span><i class="legend-line solid"></i><b>実線</b> 検証できる因果</span>
      <span><i class="legend-line dashed"></i><b>破線</b> 強いが複合要因</span>
      <span><i class="legend-line dotted"></i><b>点線</b> 検証中の仮説</span>
    </div>
  </section>

  <section class="section reasoning-home-section">
    <div class="section-heading-row">
      <div>
        <div class="kicker">HOW THE ANALYSIS EMERGED</div>
        <h2>結論より、その結論へ至る道筋を読む</h2>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/reasoning/">思考の道筋をすべて読む →</a>
    </div>
    <p class="lead">最初の仮説、うまく説明できない反例、別地域との比較、説明変数の組み替え。研究の「途中」を消さず、読み物として残します。</p>
    <div class="reasoning-home-grid">
      {featuredReasoning.map((essay,i)=>(
        <a class="reasoning-home-card" href={`/setouchi-cultural-economic-atlas/reasoning/${essay.slug}/`}>
          <span>{String(i+1).padStart(2,'0')} / CH. {essay.chapter}</span>
          <h3>{essay.title}</h3>
          <p>{essay.subtitle}</p>
          <small>{essay.question}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading-row">
      <div>
        <div class="kicker">RESEARCH CHAPTERS</div>
        <h2>02〜10章：瀬戸内ができるまで</h2>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/chapters/">全章を見る →</a>
    </div>
    <div class="chapter-card-grid">
      {researchChapters.map((chapter)=>(
        <a class="chapter-card" href={`/setouchi-cultural-economic-atlas/chapters/${chapter.slug}/`}>
          <span class="chapter-no">{chapter.number}</span>
          <h3>{chapter.title}</h3>
          <p>{chapter.subtitle}</p>
          <small>{chapter.sections.length} sections</small>
        </a>
      ))}
    </div>
  </section>

  <section class="section gene-section">
    <div class="section-heading-row">
      <div>
        <div class="kicker">ATLAS CONCEPTS</div>
        <h2>議論から生まれた分析概念</h2>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/concepts/">概念辞典を見る →</a>
    </div>
    <div class="concept-preview-grid">
      {featuredConcepts.map((item)=>(
        <a class="concept-preview" href={`/setouchi-cultural-economic-atlas/concepts/#${item.id}`}>
          <span>{item.category}</span>
          <h3>{item.title}</h3>
          <p>{item.definition}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading-row">
      <div>
        <div class="kicker">CASE STUDIES</div>
        <h2>地域ごとに、同じ問いを当てる</h2>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/places/">全{places.length}地域を見る →</a>
    </div>
    <div class="home-place-grid">
      {featuredPlaces.map((place)=>(
        <a class="home-place-card" href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>
          <span>{place.prefecture}</span>
          <h3>{place.name}</h3>
          <p>{place.subtitle}</p>
          <div class="mini-tags">{place.tags.slice(0,3).map((tag)=><small>{tag}</small>)}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="kicker">MAPS & EVIDENCE</div>
    <h2>本文を、地図・比較・写真で検証する</h2>
    <div class="tool-grid">
      <a href="/setouchi-cultural-economic-atlas/transect/"><span>断面</span><h3>Transect</h3><p>山から海までの地形断面。</p></a>
      <a href="/setouchi-cultural-economic-atlas/climate/"><span>気候</span><h3>Climate</h3><p>光・雨・気温・水条件。</p></a>
      <a href="/setouchi-cultural-economic-atlas/wind-tide/"><span>海況</span><h3>Wind & Tide</h3><p>潮と風という見えないインフラ。</p></a>
      <a href="/setouchi-cultural-economic-atlas/seafood/"><span>生態</span><h3>Seafood</h3><p>魚介・漁場・料理の地域差。</p></a>
      <a href="/setouchi-cultural-economic-atlas/transport/"><span>交通</span><h3>Transport</h3><p>歴史港から現代交通まで。</p></a>
      <a href="/setouchi-cultural-economic-atlas/industry/"><span>産業</span><h3>Industry</h3><p>土地・技能・企業の時間変化。</p></a>
      <a href="/setouchi-cultural-economic-atlas/textiles/"><span>産業帯</span><h3>Textiles</h3><p>児島・福山・今治・東かがわを工程で比較。</p></a>
      <a href="/setouchi-cultural-economic-atlas/typology/"><span>類型</span><h3>Typology</h3><p>地域形成メカニズムを横断比較。</p></a>
      <a href="/setouchi-cultural-economic-atlas/evolution/"><span>因果</span><h3>Evolution</h3><p>各地域の因果グラフを比較。</p></a>
      <a href="/setouchi-cultural-economic-atlas/photos/"><span>写真</span><h3>Photo Evidence</h3><p>装飾ではなく、因果を示す写真。</p></a>
    </div>
  </section>

  <section class="section home-method-link">
    <div>
      <div class="kicker">METHODOLOGY</div>
      <h2>事実・解釈・仮説を分ける</h2>
      <p class="lead">因果を作り過ぎないため、一次資料・公的資料で確認できる事実と、本アトラスの解釈、追加検証が必要な仮説を分けています。</p>
    </div>
    <a class="compare-button" href="/setouchi-cultural-economic-atlas/methodology/">編集・検証ルール →</a>
  </section>
</BaseLayout>
