---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bookArticles } from '../data/bookArticles.js';
import { photoEvidence } from '../data/photoEvidence.js';
import { places } from '../data/places.js';

const photoById=Object.fromEntries(photoEvidence.map((p)=>[p.id,p]));
const mapPlaces=places.map((p)=>({
  id:p.id,
  name:p.name,
  prefecture:p.prefecture,
  lat:p.lat,
  lon:p.lon,
  subtitle:p.subtitle,
  pilot:['imabari','shimotsui','niihama'].includes(p.id)
}));

const pilots=[
  {
    id:'imabari',
    kicker:'今治・来島海峡',
    title:'潮の速い海峡と港から、海事産業へ。',
    chain:['急潮','潮待ち','修繕','造船・海運'],
    href:'/setouchi-cultural-economic-atlas/places/imabari/'
  },
  {
    id:'shimotsui',
    kicker:'児島・下津井',
    title:'海だった土地から、綿とデニムの産地へ。',
    chain:['浅海','干拓・綿','縫製','デニム'],
    href:'/setouchi-cultural-economic-atlas/book/kojima-from-cotton-to-jeans/'
  },
  {
    id:'niihama',
    kicker:'新居浜・別子',
    title:'山の銅山から、海辺の工業都市へ。',
    chain:['銅山','製錬','機械・化学・電力'],
    href:'/setouchi-cultural-economic-atlas/places/niihama/'
  }
];
---
<BaseLayout title="瀬戸内自然文化経済アトラス" description="地図から瀬戸内を見る。島、港、平野、海峡を入口に、自然・産業・文化のつながりをたどる。">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

  <section class="map-first-hero">
    <div id="home-atlas-map"
      class="home-atlas-map-canvas"
      data-places={JSON.stringify(mapPlaces)}></div>

    <div class="map-first-copy">
      <div class="kicker">SETOUCHI ATLAS</div>
      <h1>瀬戸内を、<br/>地図から読む。</h1>
      <p>島、港、平野、海峡。まず場所を選んでください。そこから自然、産業、食、文化のつながりをたどれます。</p>
      <div class="map-first-actions">
        <a href="/setouchi-cultural-economic-atlas/places/">地域一覧</a>
        <a href="/setouchi-cultural-economic-atlas/book/">物語を読む</a>
      </div>
    </div>

    <div class="map-first-legend">
      <span><i class="map-dot pilot"></i>地域パイロット</span>
      <span><i class="map-dot"></i>掲載地域</span>
      <small>地図の点をクリックすると地域ページへ進めます。</small>
    </div>
  </section>

  <section class="section home-layer-nav">
    <div class="section-heading-row compact">
      <div>
        <div class="kicker">CHANGE THE VIEW</div>
        <h2>同じ瀬戸内を、違う地図で見る</h2>
      </div>
    </div>
    <div class="home-layer-grid">
      <a href="/setouchi-cultural-economic-atlas/climate/"><strong>気候</strong><span>雨・気温・日照</span></a>
      <a href="/setouchi-cultural-economic-atlas/wind-tide/"><strong>潮と風</strong><span>海峡・航海・港</span></a>
      <a href="/setouchi-cultural-economic-atlas/industry/"><strong>産業</strong><span>土地・技能・企業</span></a>
      <a href="/setouchi-cultural-economic-atlas/transport/"><strong>交通</strong><span>港・鉄道・橋</span></a>
      <a href="/setouchi-cultural-economic-atlas/comparative-reading/"><strong>地域比較</strong><span>似ている町、違う町</span></a>
    </div>
  </section>

  <section class="section home-pilots">
    <div class="section-heading-row">
      <div>
        <div class="kicker">REGIONAL PILOTS</div>
        <h2>まず3地域から見てみる</h2>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/places/">すべての地域を見る →</a>
    </div>
    <div class="home-pilot-grid">
      {pilots.map((pilot)=>(
        <a class="home-pilot-card" href={pilot.href}>
          <small>{pilot.kicker}</small>
          <h3>{pilot.title}</h3>
          <div class="home-pilot-chain">
            {pilot.chain.map((item,i)=>(
              <>
                <span>{item}</span>
                {i < pilot.chain.length-1 && <b>→</b>}
              </>
            ))}
          </div>
          <em>地図と資料で見る →</em>
        </a>
      ))}
    </div>
  </section>

  <section class="section latest-serial home-reading">
    <div class="section-heading-row">
      <div>
        <div class="kicker">STORIES</div>
        <h2>地図の次に、地域の物語を読む</h2>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/book/">目次を開く →</a>
    </div>
    <div class="serial-stack">
      {bookArticles.slice(0,6).map((article)=>{
        const photo=photoById[article.heroPhotoId];
        return (
          <a class="serial-row" href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>
            <div class="serial-number">{article.number}</div>
            <div class="serial-copy">
              <small>{article.part}</small>
              <h3>{article.title}</h3>
              <p>{article.subtitle}</p>
            </div>
            {photo && <img src={photo.imageUrl} alt={photo.alt} loading="lazy" />}
          </a>
        )
      })}
    </div>
  </section>

  <section class="section home-evidence">
    <div class="kicker">EXPLORE</div>
    <h2>もっと細かく見る</h2>
    <div class="evidence-link-grid">
      <a href="/setouchi-cultural-economic-atlas/places/"><b>地域データ</b><span>地域ごとの自然・産業・文化</span></a>
      <a href="/setouchi-cultural-economic-atlas/photos/"><b>写真</b><span>景観から地域を読む</span></a>
      <a href="/setouchi-cultural-economic-atlas/transect/"><b>地形断面</b><span>山から海まで</span></a>
      <a href="/setouchi-cultural-economic-atlas/wind-tide/"><b>風と潮</b><span>見えない海の条件</span></a>
      <a href="/setouchi-cultural-economic-atlas/industry/"><b>産業地図</b><span>産業の場所とつながり</span></a>
      <a href="/setouchi-cultural-economic-atlas/chapters/"><b>研究ノート</b><span>検証中のテーマ</span></a>
    </div>
  </section>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script is:inline>
    (() => {
      const el=document.getElementById('home-atlas-map');
      if(!el || !window.L) return;
      const places=JSON.parse(el.dataset.places || '[]');
      const map=L.map(el,{scrollWheelZoom:false,zoomControl:true,attributionControl:true}).setView([34.25,133.45],7);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
        maxZoom:18,
        attribution:'&copy; OpenStreetMap contributors'
      }).addTo(map);

      places.forEach((place)=>{
        const marker=L.circleMarker([place.lat,place.lon],{
          radius:place.pilot ? 9 : 6,
          weight:place.pilot ? 3 : 2,
          fillOpacity:place.pilot ? .95 : .76,
          color:place.pilot ? '#17313b' : '#ffffff',
          fillColor:place.pilot ? '#f0a45d' : '#245b6a'
        }).addTo(map);

        marker.bindTooltip(place.name,{direction:'top',offset:[0,-5],opacity:.92});
        marker.bindPopup(
          '<div class="home-map-popup">'+
          '<small>'+place.prefecture+'</small>'+
          '<strong>'+place.name+'</strong>'+
          '<p>'+place.subtitle+'</p>'+
          '<a href="/setouchi-cultural-economic-atlas/places/'+place.id+'/">この地域を見る →</a>'+
          '</div>'
        );
      });

      const coords=places.filter((p)=>Number.isFinite(p.lat)&&Number.isFinite(p.lon)).map((p)=>[p.lat,p.lon]);
      if(coords.length) map.fitBounds(L.latLngBounds(coords),{padding:[36,36]});
    })();
  </script>
</BaseLayout>
