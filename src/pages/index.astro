---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { cardPhotoId } from '../data/essayCardCopy.js';
import { orderedBookArticles } from '../data/bookArticles.js';
import { withMarkdownMetadata } from '../data/essayMarkdownMetadata.js';
import { kadaEssays } from '../data/kadaEssays.js';
import { kadaIndustryEssay } from '../data/kadaIndustryEssay.js';
import { cycleTourismEssay } from '../data/cycleTourismEssay.js';
import { tomoTwoActPortEssay } from '../data/tomoTwoActPortEssay.js';
import { portSystemEssays } from '../data/portSystemEssays.js';
import { setouchiSushiEssay } from '../data/setouchiSushiEssay.js';
import { setouchiShrimpEssay } from '../data/setouchiShrimpEssay.js';
import { setouchiItinerantTradeBoatsEssay } from '../data/setouchiItinerantTradeBoatsEssay.js';
import { setouchiShipMaterialsEssay } from '../data/setouchiShipMaterialsEssay.js';
import { niboshiShirasuEssay } from '../data/niboshiShirasuEssay.js';
import { kojimaCircularEssay } from '../data/kojimaCircularEssay.js';
import { kojimaIslandEssays } from '../data/kojimaIslandEssays.js';
import { quageoSetouchiEssays } from '../data/quageoSetouchiEssays.js';
import { saltLandscapeNatureEssays } from '../data/saltLandscapeNatureEssays.js';
import { essayIndexPhotoOverrides } from '../data/essayIndexPhotos.js';
import { photoEvidence } from '../data/photoEvidence.js';
import { additionalPlacePhotos } from '../data/additionalPlacePhotos.js';
import '../styles/reader-navigation.css';
import '../styles/home-landscape-refresh.css';

const allEssays=[...orderedBookArticles,...kadaEssays,kadaIndustryEssay,cycleTourismEssay,tomoTwoActPortEssay,...portSystemEssays,kojimaCircularEssay,...kojimaIslandEssays,...quageoSetouchiEssays,...saltLandscapeNatureEssays,setouchiSushiEssay,setouchiShrimpEssay,setouchiItinerantTradeBoatsEssay,setouchiShipMaterialsEssay,niboshiShirasuEssay].filter(Boolean).map(withMarkdownMetadata);
const photoById=Object.fromEntries([...photoEvidence,...Object.values(additionalPlacePhotos).flat()].map((p)=>[p.id,p]));
const essayPhoto=(article)=>{
  const curated=essayIndexPhotoOverrides[article.slug];
  if(curated?.imageUrl) return curated;
  const chosenPhoto=photoById[cardPhotoId(article)];
  if(chosenPhoto?.imageUrl) return chosenPhoto;
  if(article.heroPhoto?.imageUrl) return article.heroPhoto;
  const ids=[article.heroPhotoId,...(article.sections||[]).flatMap((section)=>section.photoIds||[])].filter(Boolean);
  return ids.map((id)=>photoById[id]).find((photo)=>photo?.imageUrl) || null;
};
// The homepage's three representative essays are deliberately fixed by editorial choice.
const featuredSlugs=['tomo-two-act-tidal-port','kojima-from-cotton-to-jeans','oysters-taste-of-small-seas'];
const featuredArticles=featuredSlugs.map((slug)=>allEssays.find((article)=>article.slug===slug)).filter(Boolean);

// Homepage-only landscape selections, independent of the article covers.
const homePhotos={
  ...photoById,
  'home-ikuchijima-orchard': {
    imageUrl:'/setouchi-cultural-economic-atlas/images/atlas-original/ikuchijima/6cdf89cdf1.webp',
    alt:'生口島の山裾に広がる柑橘畑。品種は未確認。',
    title:'生口島の柑橘畑',
    author:'ATLAS編集者'
  }
};
const readingTrails=[
  {
    "label": "潮が動かす世界",
    "question": "海面の下では、何が起きているのか。",
    "slugs": [
      "setouchi-250-submarine-caldrons",
      "kurushima-tides-and-navigation",
      "setouchi-shrimp-middle-layer"
    ],
    "photoId": "photo-naruto-whirlpool",
    "position": "50% 50%"
  },
  {
    "label": "土地と水に向き合う",
    "question": "人は、与えられた土地をどう使ってきたのか。",
    "slugs": [
      "hiketa-castle-port-town",
      "sanuki-store-the-rain",
      "mikan-slope-and-varieties"
    ],
    "photoId": "photo-karihama-citrus-terraces",
    "position": "50% 50%"
  },
  {
    "label": "名産が生まれるまで",
    "question": "なぜ、その土地ならではの味が生まれたのか。",
    "slugs": [
      "tatara-bridge-citrus-seasons",
      "shodoshima-somen-to-sesame-oil",
      "ibuki-fat-sardines-revalued"
    ],
    "photoId": "home-ikuchijima-orchard",
    "position": "50% 50%"
  }
];
const trailCards=readingTrails.map((trail)=>({
  ...trail,
  articles:trail.slugs.map((slug)=>allEssays.find((article)=>article.slug===slug)).filter(Boolean),
  coverPhoto:homePhotos[trail.photoId]
}));
const featuredPhoto=(article)=>{
  if(article.slug==='tomo-two-act-tidal-port') return article.heroPhoto || essayPhoto(article);
  if(article.slug==='oysters-taste-of-small-seas') return homePhotos['photo-hiroshima-oyster-rafts'];
  return essayPhoto(article);
};
const saltContrasts=[
  {slug:'takehara-salt-capital-to-townscape',place:'竹原',caption:'塩の富が残した白壁',photoId:'photo-takehara-view'},
  {slug:'kinkai-salt-field-to-solar',place:'錦海湾',caption:'海を仕切って生まれた土地',photoId:'photo-kinkai-solar'}
].map((item)=>({
  ...item,
  article:allEssays.find((article)=>article.slug===item.slug),
  photo:homePhotos[item.photoId]
}));
const homepagePhotos=[...new Map([
  ...featuredArticles.map(featuredPhoto),
  ...trailCards.map(trail=>trail.coverPhoto),
  ...saltContrasts.map(item=>item.photo)
].filter(Boolean).map(photo=>[photo.imageUrl,photo])).values()];
if(featuredArticles.length!==3 || featuredArticles.some((article)=>!featuredPhoto(article)?.imageUrl) ||
  trailCards.length!==3 || trailCards.some((trail)=>!trail.coverPhoto?.imageUrl || trail.articles.length!==3) ||
  saltContrasts.some((item)=>!item.article || !item.photo?.imageUrl) ||
  new Set([...featuredSlugs,...readingTrails.flatMap(trail=>trail.slugs)]).size!==12) {
  throw new Error('Homepage photo selection is incomplete; review before deployment');
}
---
<BaseLayout title="SETOUCHI ATLAS｜ランドスケープ ＝ ネイチャー ｘ カルチャー" description="ランドスケープ ＝ ネイチャー ｘ カルチャー。港町の路地、島の食卓、海辺の工場。瀬戸内を旅するエッセイ集。">
  <main class="reader-home visual-home">
    <header class="visual-home-intro">
      <p class="visual-home-eyebrow">LANDSCAPE = NATURE × CULTURE</p>
      <h1>その風景には、理由がある。</h1>
      <p>海、島、畑、町。景色の奥にある物語を、訪ねに行こう。</p>
    </header>

    <section class="visual-home-featured" aria-labelledby="visual-home-feature-title">
      <div class="visual-home-heading visual-home-heading--small">
        <h2 id="visual-home-feature-title">初めての3篇</h2>
        <a href="/setouchi-cultural-economic-atlas/book/">すべてのエッセイ <span aria-hidden="true">↗</span></a>
      </div>
      <div class="visual-home-feature-grid">
        {featuredArticles.map((article,index)=>{
          const photo=featuredPhoto(article);
          return <a
            class:list={['visual-home-feature',index===0 && 'visual-home-feature--large']}
            href={'/setouchi-cultural-economic-atlas/book/'+article.slug+'/'}
            aria-label={article.title+'を読む'}
          >
            <img
              src={photo.imageUrl}
              alt={photo.alt || article.title}
              loading={index===0?'eager':'lazy'}
              fetchpriority={index===0?'high':'auto'}
              decoding="async"
            />
            <div class="visual-home-feature-copy">
              <span>{article.cities?.slice(0,2).join('・') || '瀬戸内'}</span>
              <h3>{article.title}</h3>
              <span class="visual-home-feature-arrow" aria-hidden="true">↗</span>
            </div>
          </a>;
        })}
      </div>
    </section>

    <section class="visual-home-section" aria-labelledby="visual-home-trails-title">
      <div class="visual-home-heading">
        <div><p class="visual-home-eyebrow">STORY TRAILS</p><h2 id="visual-home-trails-title">3つの読書の旅</h2></div>
        <p class="visual-home-heading-note">気になる風景から、3篇をめぐる。</p>
      </div>
      <div class="visual-home-trail-grid">
        {trailCards.map((trail,index)=>(
          <details class="visual-home-trail">
            <summary aria-label={trail.label+'の3篇を表示'}>
              <img src={trail.coverPhoto.imageUrl} alt={trail.coverPhoto.alt || trail.label} style={`object-position:${trail.position}`} loading="lazy" decoding="async" />
              <span class="visual-home-trail-copy">
                <small>TRAIL {String(index+1).padStart(2,'0')}</small>
                <strong>{trail.label}</strong>
                <span>{trail.question}</span>
                <em>3篇を見る <span aria-hidden="true">＋</span></em>
              </span>
            </summary>
            <ol class="visual-home-trail-links">
              {trail.articles.map((article,i)=>(
                <li><a href={'/setouchi-cultural-economic-atlas/book/'+article.slug+'/'}>
                  <span>{String(i+1).padStart(2,'0')}</span><strong>{article.title}</strong><span aria-hidden="true">↗</span>
                </a></li>
              ))}
            </ol>
          </details>
        ))}
      </div>
    </section>

    <section class="visual-home-section" aria-labelledby="visual-home-salt-title">
      <div class="visual-home-heading">
        <div>
          <p class="visual-home-eyebrow">READ AS A SERIES</p>
          <h2 id="visual-home-salt-title">塩田の、その先。</h2>
          <p>海を仕切って生まれた土地は、塩づくりが終わったあと、どう変わったのか。</p>
        </div>
        <a href="/setouchi-cultural-economic-atlas/collections/salt-afterlife/">七つの土地を読み比べる <span aria-hidden="true">↗</span></a>
      </div>
      <div class="visual-home-salt-grid">
        {saltContrasts.map((item)=>(
          <a class="visual-home-salt-card" href={'/setouchi-cultural-economic-atlas/book/'+item.slug+'/'}>
            <img src={item.photo.imageUrl} alt={item.photo.alt || item.article.title} loading="lazy" decoding="async" />
            <div class="visual-home-salt-copy"><span>{item.place}</span><h3>{item.caption}</h3></div>
          </a>
        ))}
      </div>
    </section>

    <nav class="visual-home-explore" aria-label="エッセイを探す">
      <a href="/setouchi-cultural-economic-atlas/book/nature/">
        <span class="visual-home-explore-symbol" aria-hidden="true">◌</span>
        <span><strong>自然条件から</strong><small>潮・風・地形・生き物</small></span>
        <span class="visual-home-explore-arrow" aria-hidden="true">↗</span>
      </a>
      <a href="/setouchi-cultural-economic-atlas/book/culture/">
        <span class="visual-home-explore-symbol" aria-hidden="true">✳</span>
        <span><strong>文化・風習から</strong><small>食・信仰・商い・仕事</small></span>
        <span class="visual-home-explore-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>

    <section class="visual-home-search" aria-label="エッセイをキーワードで探す">
      <SiteSearch essaysOnly={true} />
    </section>
    <details class="visual-home-photo-credits">
      <summary>トップページの写真出典</summary>
      <ul>{homepagePhotos.map(photo=><li>{photo.sourcePage ? <a href={photo.sourcePage} target="_blank" rel="noreferrer">{photo.title || photo.alt}</a> : <span>{photo.title || photo.alt}</span>} — {photo.author || '出典はエッセイ参照'} {photo.licenseUrl ? <a href={photo.licenseUrl} target="_blank" rel="noreferrer">{photo.license}</a> : photo.license}</li>)}</ul>
    </details>
    <p class="visual-home-directory"><a href="/setouchi-cultural-economic-atlas/book/">すべてのエッセイを一覧で見る <span aria-hidden="true">↗</span></a></p>
  </main>
</BaseLayout>