---
import BaseLayout from '../layouts/BaseLayout.astro';
import { orderedBookArticles } from '../data/bookArticles.js';
import { photoEvidence } from '../data/photoEvidence.js';
import { places } from '../data/places.js';

const photoById=Object.fromEntries(photoEvidence.map((p)=>[p.id,p]));
const heroPhoto=photoById['photo-onomichi-panorama'] || photoEvidence[0];
const mapPlaces=places.map((p)=>({id:p.id,name:p.name,prefecture:p.prefecture,lat:p.lat,lon:p.lon,subtitle:p.subtitle}));
const aiEssay=orderedBookArticles.find((a)=>a.slug==='ai-era-regional-planning-learning-velocity');
const saltEssay=orderedBookArticles.find((a)=>a.slug==='four-salt-fields');
const portsEssay=orderedBookArticles.find((a)=>a.slug==='ports-that-needed-waiting');
const featuredEssays=[aiEssay,saltEssay,portsEssay].filter(Boolean);
---
<BaseLayout title="SETOUCHI ATLAS | 瀬戸内自然文化経済アトラス" description="瀬戸内で人が何を得られ、何ができたのか、そして何が得られなくなり、できなくなったのかを、自然・生態系・生業・技術・産業・文化・都市の変化から読むリサーチ・アトラス。">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

  <section class="concept-hero">
    <div class="kicker">SETOUCHI NATURAL / CULTURAL / ECONOMIC ATLAS</div>
    <h1>この土地で、人は何を得られ、何ができたのか。</h1>
    <p class="concept-dek">瀬戸内を、自然・生態系・生業・技術・産業・文化・都市の連鎖として読みます。人口増加や産業成長をあらかじめ目標とは置きません。人口、産業、土地利用、交通、環境の変化によって、人が得られるもの、できること、失うもの、難しくなることがどう変わったのかを記述します。地域の未来を考えるのは、その分析の先です。</p>
    <div class="concept-chain" aria-label="地域形成の因果連鎖">
      <span>自然環境</span><b>→</b><span>生態系</span><b>→</b><span>生業・技術</span><b>→</b><span>産業・文化</span><b>→</b><span>都市・地域社会</span>
    </div>
    <div class="concept-actions">
      <a href="/setouchi-cultural-economic-atlas/about/">このアトラスの考え方</a>
      <a class="secondary" href="/setouchi-cultural-economic-atlas/methodology/">方法論を読む</a>
    </div>
  </section>

  <section class="section atlas-thesis">
    <div class="atlas-thesis-grid">
      <blockquote>地域の未来を、先に決めない。まず、その土地が人に与えてきた可能性と制約の変化を読む。</blockquote>
      <div>
        <div class="kicker">THE CORE QUESTION</div>
        <p>人口減少、産業成長、観光振興、土地利用転換は、それ自体を成功や失敗とはみなしません。一つの変化が、生活、所得、自然へのアクセス、文化、移動、時間、土地利用などに異なる利得と損失をもたらすからです。</p>
        <p>本アトラスの目的は一つの正解を出すことではなく、「誰が、何を得られるようになり、何を失い、何ができるようになり、何が難しくなったのか」を検証可能な形で示す知識基盤をつくることです。</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">THREE RESEARCH PILLARS</div>
    <h2>3つの問いで、瀬戸内を読む</h2>
    <div class="research-pillar-grid">
      <article class="research-pillar">
        <span>01 / FORMATION</span>
        <h3>なぜ、この土地にこの地域が生まれたのか</h3>
        <p>地形・地質・気候・海況から、生業、交易、産業、食文化、港、都市形成までを因果でつなぎます。</p>
      </article>
      <article class="research-pillar">
        <span>02 / POSSIBILITIES</span>
        <h3>この地域で、人は何を得られ、何ができたのか</h3>
        <p>土地、生態系、技能、設備、企業間ネットワーク、交通、文化、制度が、人の生活と生業にどのような可能性を開いてきたかを読みます。</p>
      </article>
      <article class="research-pillar">
        <span>03 / CHANGE</span>
        <h3>何が難しくなり、新しく何が可能になったのか</h3>
        <p>人口、産業、技術、交通、気候、土地利用の変化を、利得と損失の両面から追います。どちらを選ぶべきかは先に決めません。</p>
      </article>
    </div>
  </section>

  <section class="learning-band">
    <div class="kicker">AI × ADAPTIVE RESEARCH</div>
    <h2>変化を観測し、見方を更新する。</h2>
    <p>AIは、未来の正解を決めるためではなく、探索、翻訳、比較、データ整理、変化検知のコストを下げるために使います。新しい証拠が出れば仮説を修正し、異なる価値の間にあるトレードオフを見える形にする。何を大切にし、どの選択をするかという価値判断は、地域と人に残します。</p>
    <div class="learning-metrics">
      <div><strong>Local Depth</strong><span>現地の風景と地域固有性から問いを立てる</span></div>
      <div><strong>Global Comparison</strong><span>世界の類似事例から差と共通構造を確かめる</span></div>
      <div><strong>Learning Velocity</strong><span>新しい証拠によって見方を修正できる速度を観察する</span></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">HOW TO READ</div>
    <h2>5つの入口から読む</h2>
    <div class="route-grid">
      <a class="route-card" href="/setouchi-cultural-economic-atlas/places/">
        <span>REGIONS</span><h3>地域</h3><p>一つの町・島・港を、自然基盤から現在の可能性と制約まで縦に読む。</p><em>地域から入る →</em>
      </a>
      <a class="route-card" href="/setouchi-cultural-economic-atlas/book/">
        <span>ESSAYS</span><h3>エッセイ</h3><p>現地で生まれた違和感や問いから、分野横断の仮説を組み立てる。</p><em>問いから読む →</em>
      </a>
      <a class="route-card" href="/setouchi-cultural-economic-atlas/chapters/">
        <span>RESEARCH NOTES</span><h3>研究ノート</h3><p>複数地域・時系列・史料・統計・世界事例を比較して仮説を検証する。</p><em>仕組みを検証する →</em>
      </a>
      <a class="route-card" href="/setouchi-cultural-economic-atlas/data/">
        <span>DATA</span><h3>データ</h3><p>地図、気候、土地利用、産業、交通、写真などの検証材料を確認する。</p><em>根拠を見る →</em>
      </a>
      <a class="route-card" href="/setouchi-cultural-economic-atlas/methodology/">
        <span>METHOD</span><h3>方法論</h3><p>事実・解釈・仮説を分け、価値判断を先取りせず、比較と観測で記述を更新する。</p><em>研究方法を見る →</em>
      </a>
    </div>
  </section>

  <section class="section gene-section">
    <div class="section-heading-row">
      <div><div class="kicker">CURRENT CORE PROGRAMS</div><h2>現在の重点研究</h2></div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/chapters/">研究ノート一覧 →</a>
    </div>
    <div class="program-grid">
      <a class="program-card featured" href="/setouchi-cultural-economic-atlas/chapters/setouchi-nature-positive/">
        <span>NATURE / LAND USE</span><h3>人口減少で、土地利用の可能性と制約はどう変わるか</h3><p>維持、低密度管理、生態系復元、自然遷移など複数の土地利用を、費用、生活、生態系、防災の利得と損失から比較します。</p>
      </a>
      <a class="program-card featured" href="/setouchi-cultural-economic-atlas/chapters/regional-asset-reproduction/">
        <span>REGIONAL CAPABILITIES</span><h3>何が地域に残り、何が失われつつあるのか</h3><p>産業、技能、文化、町並み、自然資本を、生活や生業を可能にしてきた地域能力として追います。</p>
      </a>
      <a class="program-card" href="/setouchi-cultural-economic-atlas/chapters/setouchi-industrial-transformation/">
        <span>INDUSTRIAL TRANSFORMATION</span><h3>産業の変化は、何を可能にし、何を失わせるのか</h3><p>製品だけでなく、技能・設備・ネットワーク・市場接続の継承と消失を追います。</p>
      </a>
      <a class="program-card" href="/setouchi-cultural-economic-atlas/methodology-ai-adaptive/">
        <span>AI / ADAPTIVE RESEARCH</span><h3>結論ではなく、更新可能な見方をつくる</h3><p>Local Depth × Global Comparison × Adaptive Researchを、ATLASの標準方法として整備します。</p>
      </a>
    </div>
  </section>

  <section class="map-first-hero">
    <div id="home-atlas-map" class="home-atlas-map-canvas" data-places={JSON.stringify(mapPlaces)}></div>
    <div class="map-first-copy">
      <div class="kicker">MAP</div>
      <h1>場所から読む。</h1>
      <p>自然条件も、産業の履歴も、人が得られるもの・できることも地域ごとに違います。地図から一つの地域を選び、その可能性と制約の変化をたどってください。</p>
      <div class="map-first-actions"><a href="/setouchi-cultural-economic-atlas/places/">地域一覧へ</a></div>
    </div>
  </section>

  {featuredEssays.length>0 && (
    <section class="section">
      <div class="section-heading-row"><div><div class="kicker">ESSAYS</div><h2>問いを立てる</h2><p class="home-reading-intro">エッセイは結論ではなく、現地の違和感を検証可能な問いへ変える場所です。</p></div><a class="text-link" href="/setouchi-cultural-economic-atlas/book/">エッセイ一覧 →</a></div>
      <div class="magazine-story-grid">
        {featuredEssays.map((article)=><a class="magazine-story-card" href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}><small>{article.part}</small><strong>{article.title}</strong><span>{article.subtitle}</span><em>読む →</em></a>)}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-heading-row"><div><div class="kicker">EVIDENCE</div><h2>データで確かめる</h2><p class="home-reading-intro">地図・統計・写真は結論ではなく、仮説を支持・修正し、利得と損失の両面を確かめるための証拠です。</p></div><a class="text-link" href="/setouchi-cultural-economic-atlas/data/">データ一覧 →</a></div>
    <div class="evidence-link-grid">
      <a href="/setouchi-cultural-economic-atlas/climate/"><b>気候</b><span>雨・気温・日照</span></a>
      <a href="/setouchi-cultural-economic-atlas/wind-tide/"><b>潮と風</b><span>海峡・航海・港</span></a>
      <a href="/setouchi-cultural-economic-atlas/land-use/"><b>土地利用</b><span>干拓・市街地・産業跡地・自然遷移</span></a>
      <a href="/setouchi-cultural-economic-atlas/industry/"><b>産業</b><span>土地・技能・企業ネットワーク</span></a>
      <a href="/setouchi-cultural-economic-atlas/transect/"><b>地形断面</b><span>山から海まで</span></a>
      <a href="/setouchi-cultural-economic-atlas/photos/"><b>写真資料</b><span>景観を証拠として読む</span></a>
    </div>
  </section>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script is:inline>
    (()=>{
      const el=document.getElementById('home-atlas-map');
      if(!el || !window.L) return;
      let items=[]; try{items=JSON.parse(el.dataset.places||'[]')}catch(_){return}
      const map=L.map(el,{scrollWheelZoom:false}).setView([34.25,133.45],7);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors'}).addTo(map);
      items.forEach((p)=>{
        if(typeof p.lat!=='number'||typeof p.lon!=='number') return;
        const marker=L.circleMarker([p.lat,p.lon],{radius:6,weight:2,fillOpacity:.85}).addTo(map);
        marker.bindPopup(`<strong>${p.name}</strong><br><small>${p.prefecture}</small><br>${p.subtitle||''}<br><a href="/setouchi-cultural-economic-atlas/places/${p.id}/">地域ページへ →</a>`);
      });
    })();
  </script>
</BaseLayout>