---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { cardTeaser, cardPhotoId } from '../data/essayCardCopy.js';
import { orderedBookArticles } from '../data/bookArticles.js';
import { kadaEssays } from '../data/kadaEssays.js';
import { kadaIndustryEssay } from '../data/kadaIndustryEssay.js';
import { cycleTourismEssay } from '../data/cycleTourismEssay.js';
import { shimotsuiHijikiEssay } from '../data/shimotsuiHijikiEssay.js';
import { tomoTwoActPortEssay } from '../data/tomoTwoActPortEssay.js';
import { portSystemEssays } from '../data/portSystemEssays.js';
import { setouchiSushiEssay } from '../data/setouchiSushiEssay.js';
import { setouchiShrimpEssay } from '../data/setouchiShrimpEssay.js';
import { setouchiLifeYearEssay } from '../data/setouchiLifeYearEssay.js';
import { setouchiItinerantTradeBoatsEssay } from '../data/setouchiItinerantTradeBoatsEssay.js';
import { setouchiShipMaterialsEssay } from '../data/setouchiShipMaterialsEssay.js';
import { niboshiShirasuEssay } from '../data/niboshiShirasuEssay.js';
import { aiRegionalPlanningEssay } from '../data/aiRegionalPlanningEssay.js';
import { kojimaCircularEssay } from '../data/kojimaCircularEssay.js';
import { kojimaIslandEssays } from '../data/kojimaIslandEssays.js';
import { essayIndexPhotoOverrides } from '../data/essayIndexPhotos.js';
import { photoEvidence } from '../data/photoEvidence.js';
import { additionalPlacePhotos } from '../data/additionalPlacePhotos.js';
import '../styles/reader-navigation.css';

const allEssays=[...orderedBookArticles,...kadaEssays,kadaIndustryEssay,cycleTourismEssay,shimotsuiHijikiEssay,tomoTwoActPortEssay,...portSystemEssays,kojimaCircularEssay,...kojimaIslandEssays,setouchiSushiEssay,setouchiShrimpEssay,setouchiLifeYearEssay,setouchiItinerantTradeBoatsEssay,setouchiShipMaterialsEssay,niboshiShirasuEssay,aiRegionalPlanningEssay].filter(Boolean);
const photoById=Object.fromEntries([...photoEvidence,...Object.values(additionalPlacePhotos).flat()].map((p)=>[p.id,p]));
const essayPhoto=(article)=>{
  const curated=essayIndexPhotoOverrides[article.slug];
  if(curated?.imageUrl) return curated;
  const chosenPhoto=photoById[cardPhotoId(article)];
  if(chosenPhoto?.imageUrl) return chosenPhoto;
  if(article.heroPhoto?.imageUrl) return article.heroPhoto;
  const ids=[article.heroPhotoId,...(article.sections||[]).flatMap((section)=>section.photoIds||[])].filter(Boolean);
  return ids.map((id)=>photoById[id]).find((photo)=>photo?.imageUrl) || null;
};
const recommendedSlugs=['kojima-from-cotton-to-jeans','soy-sauce-lees-to-chomeiso','imabari-why-shipbuilding','tai-meshi-two-seas','ports-that-needed-waiting','shodoshima-open-island'];
const recommended=recommendedSlugs.map((slug)=>allEssays.find((article)=>article.slug===slug)).filter(Boolean);
const coverArticle=recommended[0];
const coverPhoto=coverArticle ? essayPhoto(coverArticle) : null;

// Keep an ordinary server-rendered selection for crawlers and visitors without JS.
// With JS enabled, six distinct essays are sampled on every homepage visit.
// Never choose articles without an appropriate photo for image-led slots.
const randomPickPool=[...new Map(allEssays.map((article)=>[article.slug,article])).values()]
  .map((article)=>{
    const photo=essayPhoto(article);
    return {
      slug:article.slug,
      title:article.title,
      teaser:cardTeaser(article),
      cities:article.cities?.slice(0,2).join('・') || '瀬戸内',
      imageUrl:photo?.imageUrl || '',
      alt:photo?.alt || article.title
    };
  })
  .filter((entry)=>entry.imageUrl);
if(randomPickPool.length<6) throw new Error('Homepage needs at least six illustrated essays.');
---
<BaseLayout title="SETOUCHI ATLAS - 私の瀬戸内地誌紀行" description="港町の路地、島の食卓、海辺の工場。自然と人の営みが重なって生まれた風景の理由をたどる、私の瀬戸内素描。">
  <div class="reader-home">
    <section class="reader-home-intro">
      <p class="reader-eyebrow">SETOUCHI ATLAS</p>
      <h1>風景の理由をたどる</h1>
      <p class="reader-home-subtitle">私の瀬戸内地誌紀行</p>
      <p class="reader-home-lead">港町の路地、島の食卓、海辺の工場。<br />見慣れた風景にも、そうなった理由がある。<br />自然と人の営みが重なって生まれた瀬戸内の姿を、旅先で見つけた問いからたどります。</p>
      <a class="reader-primary-link" href="/setouchi-cultural-economic-atlas/book/">エッセイを探す <span aria-hidden="true">→</span></a>
    </section>

    {coverArticle && <a class="reader-home-feature" href={`/setouchi-cultural-economic-atlas/book/${coverArticle.slug}/`}>
      {coverPhoto?.imageUrl && <img src={coverPhoto.imageUrl} alt={coverPhoto.alt || coverArticle.title} fetchpriority="high" />}
      <div class="reader-home-feature-copy"><span>まずは、この一篇から</span><h2>{coverArticle.title}</h2><p>{cardTeaser(coverArticle)}</p><strong>読む →</strong></div>
    </a>}

    <section class="reader-home-section" aria-labelledby="home-picks">
      <div class="reader-section-heading"><div><p class="reader-eyebrow">PICK UP</p><h2 id="home-picks">こんな旅の話から。</h2><p>気になる風景から、気軽に一篇。</p></div><a href="/setouchi-cultural-economic-atlas/book/">すべてのエッセイを見る →</a></div>
      <div class="reader-essay-grid">
        {recommended.slice(1).map((article)=>{
          const photo=essayPhoto(article);
          return <a class="reader-essay-card" href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>
            {photo?.imageUrl && <img src={photo.imageUrl} alt={photo.alt || article.title} loading="lazy" />}
            <div><span>{article.cities?.slice(0,2).join('・') || '瀬戸内'}</span><h3>{article.title}</h3><p>{cardTeaser(article)}</p><strong>読む →</strong></div>
          </a>;
        })}
      </div>
    </section>

    <section class="reader-home-search" aria-labelledby="reader-home-search-title">
      <div class="reader-section-heading"><div><p class="reader-eyebrow">FIND A STORY</p><h2 id="reader-home-search-title">気になる言葉で、探す。</h2><p>町の名前、食べもの、港、島などからエッセイを検索できます。</p></div></div>
      <SiteSearch essaysOnly={true} />
    </section>
    <script id="home-random-picks" type="application/json" set:html={JSON.stringify(randomPickPool).replace(/</g,'\\u003c')}></script>
    <script is:inline>
      (() => {
        const data=document.getElementById('home-random-picks');
        const feature=document.querySelector('.reader-home-feature');
        const cards=[...document.querySelectorAll('.reader-home-section .reader-essay-card')];
        if(!data || !feature || cards.length!==5) return;
        let options;
        try { options=JSON.parse(data.textContent || '[]'); } catch { return; }
        if(options.length<6) return;
        // Fisher–Yates: each visit selects six distinct articles without a server rebuild.
        for(let i=options.length-1;i>0;i--){
          const j=Math.floor(Math.random()*(i+1));
          [options[i],options[j]]=[options[j],options[i]];
        }
        const selected=options.slice(0,6);
        const root='/setouchi-cultural-economic-atlas/book/';
        const headline=selected[0];
        feature.href=root+headline.slug+'/';
        const featureImage=feature.querySelector('img');
        if(featureImage){featureImage.src=headline.imageUrl;featureImage.alt=headline.alt;}
        const featureTitle=feature.querySelector('.reader-home-feature-copy h2');
        const featureText=feature.querySelector('.reader-home-feature-copy p');
        if(featureTitle)featureTitle.textContent=headline.title;
        if(featureText)featureText.textContent=headline.teaser;
        cards.forEach((card,index)=>{
          const story=selected[index+1];
          card.href=root+story.slug+'/';
          const img=card.querySelector('img');
          if(img){img.src=story.imageUrl;img.alt=story.alt;}
          const city=card.querySelector('div>span');
          const title=card.querySelector('h3');
          const teaser=card.querySelector('p');
          if(city)city.textContent=story.cities;
          if(title)title.textContent=story.title;
          if(teaser)teaser.textContent=story.teaser;
        });
      })();
    </script>
  </div>
</BaseLayout>