---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasRegionMap from '../components/AtlasRegionMap.astro';
import { orderedBookArticles } from '../data/bookArticles.js';
import { photoEvidence } from '../data/photoEvidence.js';
import { places } from '../data/places.js';
import { hinasePlace } from '../data/hinasePlace.js';
import '../styles/home-magazine.css';

const allPlaces=[...places,hinasePlace];
const photoById=Object.fromEntries(photoEvidence.map((p)=>[p.id,p]));

const coverSlugs=[
  'four-salt-fields',
  'tai-meshi-two-seas',
  'shimotsui-tako-meshi',
  'oysters-taste-of-small-seas',
  'ports-that-needed-waiting',
  'shodoshima-open-island'
];
const coverStories=coverSlugs
  .map((slug)=>orderedBookArticles.find((a)=>a.slug===slug))
  .filter(Boolean)
  .map((article)=>{
    const photo=photoById[article.heroPhotoId] || (article.sections || []).flatMap((section)=>section.photoIds || []).map((id)=>photoById[id]).find(Boolean);
    return photo ? {
      imageUrl:photo.imageUrl,
      alt:photo.alt,
      photoTitle:photo.title,
      credit:photo.credit || '',
      part:article.part,
      title:article.title,
      subtitle:article.subtitle,
      href:`/setouchi-cultural-economic-atlas/book/${article.slug}/`
    } : null;
  })
  .filter(Boolean);
const heroStory=coverStories[0];
const heroPhoto=heroStory ? {imageUrl:heroStory.imageUrl,alt:heroStory.alt,title:heroStory.photoTitle,credit:heroStory.credit} : photoEvidence[0];

const curatedSlugs=[
  'tai-meshi-two-seas',
  'shimotsui-tako-meshi',
  'oysters-taste-of-small-seas',
  'ports-that-needed-waiting',
  'shodoshima-open-island',
  'four-salt-fields'
];
const curated=curatedSlugs.map((slug)=>orderedBookArticles.find((a)=>a.slug===slug)).filter(Boolean);
const essaySelection=[...curated,...orderedBookArticles.filter((a)=>!curatedSlugs.includes(a.slug))].slice(0,6);
const articlePhoto=(article)=>photoById[article?.heroPhotoId] || heroPhoto;

const photoFeatureDefs=[
  ['photo-hinase-bay','日生――牡蠣を育て、海を育て直す','/setouchi-cultural-economic-atlas/places/hinase/'],
  ['photo-shodoshima-olive-sea','小豆島――海と畑と食産業','/setouchi-cultural-economic-atlas/places/shodoshima/'],
  ['photo-imabari-kurushima','今治――海峡を渡る技術と暮らし','/setouchi-cultural-economic-atlas/places/imabari/'],
  ['photo-mitarai-panorama','御手洗――待つことが商いだった港','/setouchi-cultural-economic-atlas/places/mitarai/'],
  ['photo-shimotsui-geography','下津井――潮流とタコと港町','/setouchi-cultural-economic-atlas/places/shimotsui/'],
  ['photo-onomichi-panorama','尾道――斜面と水道のあいだ','/setouchi-cultural-economic-atlas/places/onomichi/']
];
const photoFeatures=photoFeatureDefs.map(([id,title,href])=>({photo:photoById[id],title,href})).filter((item)=>item.photo);
---
<BaseLayout title="SETOUCHI ATLAS | 瀬戸内自然文化経済アトラス" description="瀬戸内を歩き、食べ、眺め、考える。写真とエッセイから地域と人の関係をたどるアトラス。">
  <section class="home-magazine-cover" data-random-cover="home" data-cover-stories={JSON.stringify(coverStories)}>
    {heroPhoto && <img class="js-cover-image" src={heroPhoto.imageUrl} alt={heroPhoto.alt} fetchpriority="high" />}
    <div class="home-magazine-masthead">
      <strong>SETOUCHI ATLAS</strong>
      <span>LANDSCAPE / FOOD / PORTS / INDUSTRY / LIFE</span>
    </div>
    <div class="home-magazine-feature">
      <small class="js-cover-kicker">FEATURED ESSAY / {heroStory?.part}</small>
      <h1 class="js-cover-title">{heroStory?.title}</h1>
      <p class="js-cover-subtitle">{heroStory?.subtitle}</p>
      {heroStory && <a class="js-cover-link" href={heroStory.href}>このエッセイを読む →</a>}
    </div>
    {heroPhoto && <div class="home-magazine-credit js-cover-credit">{heroPhoto.title}{heroPhoto.credit ? ` / ${heroPhoto.credit}` : ''}</div>}
  </section>

  <script is:inline>
    (() => {
      const cover=document.querySelector('[data-random-cover="home"]');
      if (!cover) return;
      let stories=[];
      try { stories=JSON.parse(cover.dataset.coverStories || '[]'); } catch (_) { return; }
      if (!stories.length) return;
      const key='setouchi-home-cover-last';
      const previous=Number(sessionStorage.getItem(key));
      let index=Math.floor(Math.random()*stories.length);
      if (stories.length>1 && Number.isInteger(previous) && index===previous) index=(index+1+Math.floor(Math.random()*(stories.length-1)))%stories.length;
      sessionStorage.setItem(key,String(index));
      const story=stories[index];
      const image=cover.querySelector('.js-cover-image');
      const kicker=cover.querySelector('.js-cover-kicker');
      const title=cover.querySelector('.js-cover-title');
      const subtitle=cover.querySelector('.js-cover-subtitle');
      const link=cover.querySelector('.js-cover-link');
      const credit=cover.querySelector('.js-cover-credit');
      if (image) { image.src=story.imageUrl; image.alt=story.alt || ''; }
      if (kicker) kicker.textContent=`FEATURED ESSAY / ${story.part || ''}`;
      if (title) title.textContent=story.title || '';
      if (subtitle) subtitle.textContent=story.subtitle || '';
      if (link) link.href=story.href;
      if (credit) credit.textContent=`${story.photoTitle || ''}${story.credit ? ` / ${story.credit}` : ''}`;
    })();
  </script>

  <section class="section home-cover-intro">
    <p>瀬戸内の町を歩く。港を見る。魚を食べる。工場の向こうに、かつての塩田を想像する。SETOUCHI ATLASは、そんな小さな発見から、土地と人の暮らしの関係をたどる読み物です。</p>
    <a href="/setouchi-cultural-economic-atlas/about/">このアトラスについて →</a>
  </section>

  <section class="section home-magazine-section">
    <div class="home-magazine-section-header">
      <div>
        <div class="kicker">ESSAYS</div>
        <h2>まず、読む。</h2>
        <p>海、食、港、産業、町並み。現地で生まれた問いを、一本の読み物として追います。</p>
      </div>
      <a href="/setouchi-cultural-economic-atlas/book/">エッセイをすべて見る →</a>
    </div>
    <div class="home-essay-spread">
      {essaySelection.map((article)=>{
        const photo=articlePhoto(article);
        return (
          <a class="home-essay-card" href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>
            {photo && <div class="home-essay-card-photo"><img src={photo.imageUrl} alt={photo.alt} loading="lazy" /></div>}
            <div class="home-essay-card-copy">
              <small>{article.part}</small>
              <strong>{article.title}</strong>
              <span>{article.subtitle}</span>
              <em>読む →</em>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="section home-magazine-section home-photo-section">
    <div class="home-magazine-section-header">
      <div>
        <div class="kicker">PHOTO STORIES</div>
        <h2>写真から、入る。</h2>
        <p>景観、港、海、食、生業。写真を入口に、その場所で人がどう暮らしてきたかをたどります。</p>
      </div>
      <a href="/setouchi-cultural-economic-atlas/photos/">写真資料を見る →</a>
    </div>
    <div class="home-photo-grid">
      {photoFeatures.map(({photo,title,href})=>(
        <a class="home-photo-card" href={href}>
          <img src={photo.imageUrl} alt={photo.alt} loading="lazy" />
          <div><small>{photo.theme || 'SETOUCHI'}</small><strong>{title}</strong></div>
        </a>
      ))}
    </div>
  </section>

  <section class="home-map-intro">
    <div class="kicker">21 REGIONS</div>
    <h2>気になる場所から、歩き始める。</h2>
    <p>赤穂から下関、引田から松山まで。地域ページでは、一つの町を自然、食、生業、産業、暮らしの時間軸で読みます。</p>
  </section>
  <AtlasRegionMap places={allPlaces} actionHref="/setouchi-cultural-economic-atlas/places/" actionLabel="21地域を見る" />

  <section class="section home-magazine-section home-deeper-section">
    <div class="home-magazine-section-header">
      <div>
        <div class="kicker">GO DEEPER</div>
        <h2>もっと深く知りたくなったら。</h2>
        <p>エッセイで立てた問いを、比較、史料、統計、地図で確かめるための研究層があります。</p>
      </div>
    </div>
    <div class="home-deeper-grid">
      <a href="/setouchi-cultural-economic-atlas/chapters/"><span>RESEARCH NOTES</span><strong>研究ノート</strong><p>複数地域を比較し、仮説を検証する。</p></a>
      <a href="/setouchi-cultural-economic-atlas/data/"><span>DATA / EVIDENCE</span><strong>データ</strong><p>地図、写真、産業、交通、自然条件を確認する。</p></a>
      <a href="/setouchi-cultural-economic-atlas/methodology/"><span>METHOD</span><strong>方法論</strong><p>事実、解釈、仮説、価値判断をどう分けているかを見る。</p></a>
    </div>
  </section>
</BaseLayout>