---
import BaseLayout from '../layouts/BaseLayout.astro';
import { orderedBookArticles } from '../data/bookArticles.js';
import { photoEvidence } from '../data/photoEvidence.js';
import { places } from '../data/places.js';
import { researchChapters } from '../data/researchChapters.js';

const photoById=Object.fromEntries(photoEvidence.map((p)=>[p.id,p]));
const mainlandOrder=['ako','ushimado','shimotsui','tomonoura','onomichi','mihara','takehara','mitarai','iwakuni','yanai','hofu','shimonoseki'];
const shikokuOrder=['hiketa','shodoshima','takamatsu','sakaide','tadotsu','niihama','imabari','matsuyama'];
const mainlandPlaces=mainlandOrder.map((id)=>places.find((p)=>p.id===id)).filter(Boolean);
const shikokuPlaces=shikokuOrder.map((id)=>places.find((p)=>p.id===id)).filter(Boolean);
const mapPlaces=places.map((p)=>({
  id:p.id,
  name:p.name,
  prefecture:p.prefecture,
  lat:p.lat,
  lon:p.lon,
  subtitle:p.subtitle
}));

const coverArticles=orderedBookArticles.map((article)=>({
  slug:article.slug,
  part:article.part,
  title:article.title,
  subtitle:article.subtitle,
  heroPhotoId:article.heroPhotoId,
  photoIds:[...new Set([
    article.heroPhotoId,
    ...article.sections.flatMap((section)=>section.photoIds || [])
  ].filter(Boolean))]
}));
const coverPhotos=photoEvidence
  .filter((photo)=>photo.imageUrl && photo.sourcePage)
  .map((photo)=>({
    id:photo.id,
    placeId:photo.placeId,
    title:photo.title,
    caption:photo.caption,
    imageUrl:photo.imageUrl,
    alt:photo.alt,
    author:photo.author,
    license:photo.license,
    sourcePage:photo.sourcePage
  }));
const coverPhotoById=Object.fromEntries(coverPhotos.map((photo)=>[photo.id,photo]));
const featureArticles=coverArticles.filter((article)=>article.photoIds.some((id)=>coverPhotoById[id]));
const initialFeature=featureArticles[0] || coverArticles[0];
const initialFeaturePhotos=(initialFeature?.photoIds || []).map((id)=>coverPhotoById[id]).filter(Boolean);
const initialCoverPhoto=coverPhotoById[initialFeature?.heroPhotoId] || initialFeaturePhotos[0] || coverPhotos[0];

---
<BaseLayout title="SETOUCHI ATLAS" description="瀬戸内のまちの過去・現在・未来を、自然環境と人々の営みとの関係性からたどる。">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

  <section
    id="magazine-cover"
    class="magazine-cover"
    data-articles={JSON.stringify(coverArticles)}
    data-photos={JSON.stringify(coverPhotos)}
  >
    <img class="magazine-cover-image" data-cover-image src={initialCoverPhoto?.imageUrl} alt={initialCoverPhoto?.alt || ''} />
    <div class="magazine-cover-scrim"></div>

    <div class="magazine-feature">
      <div class="magazine-feature-label">FEATURED ESSAY</div>
      <small data-cover-part>{initialFeature?.part}</small>
      <h1 data-cover-title>{initialFeature?.title}</h1>
      <p data-cover-subtitle>{initialFeature?.subtitle}</p>
      <div class="magazine-feature-actions">
        <a data-cover-link href={`/setouchi-cultural-economic-atlas/book/${initialFeature?.slug}/`}>このエッセイを読む →</a>
        <button type="button" data-reshuffle>別の表紙を見る</button>
      </div>
    </div>

    <div class="magazine-photo-credit">
      <span data-cover-photo-title>{initialCoverPhoto?.title}</span>
      <small>Photo: <span data-cover-photo-author>{initialCoverPhoto?.author}</span> / <a data-cover-photo-source href={initialCoverPhoto?.sourcePage} target="_blank" rel="noreferrer">{initialCoverPhoto?.license}</a></small>
    </div>
  </section>

  <section class="section magazine-selection">
    <div class="section-heading-row">
      <div>
        <div class="kicker">THIS VISIT</div>
        <h2>今号の読みもの</h2>
        <p class="home-reading-intro">アクセスするたびに、アトラスから3本を選びます。固定された「おすすめ順」ではなく、思いがけない地域やテーマとの出会いをつくります。</p>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/book/">エッセイ一覧 →</a>
    </div>
    <div class="magazine-story-grid">
      {[0,1,2].map((i)=>(
        <a class="magazine-story-card" data-random-story={i} href={`/setouchi-cultural-economic-atlas/book/${coverArticles[i]?.slug}/`}>
          <small data-story-part>{coverArticles[i]?.part}</small>
          <strong data-story-title>{coverArticles[i]?.title}</strong>
          <span data-story-subtitle>{coverArticles[i]?.subtitle}</span>
          <em>読む →</em>
        </a>
      ))}
    </div>
  </section>

  <section class="section magazine-photo-selection">
    <div class="section-heading-row">
      <div>
        <div class="kicker">PHOTO NOTES</div>
        <h2>今日の3枚</h2>
        <p class="home-reading-intro">港、斜面、工場、町並み。文章とは別の入口から瀬戸内を眺めます。</p>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/photos/">写真資料 →</a>
    </div>
    <div class="magazine-photo-grid">
      {[0,1,2].map((i)=>{
        const photo=coverPhotos[i];
        return (
          <a class="magazine-photo-card" data-random-photo={i} href={photo?.placeId ? `/setouchi-cultural-economic-atlas/places/${photo.placeId}/` : '/setouchi-cultural-economic-atlas/photos/'}>
            <img data-photo-image src={photo?.imageUrl} alt={photo?.alt || ''} loading="lazy" />
            <div>
              <strong data-photo-title>{photo?.title}</strong>
              <span data-photo-caption>{photo?.caption}</span>
            </div>
          </a>
        )
      })}
    </div>
  </section>


  <section class="map-first-hero">
    <div id="home-atlas-map"
      class="home-atlas-map-canvas"
      data-places={JSON.stringify(mapPlaces)}></div>

    <div class="map-first-copy">
      <h1>瀬戸内を、<br/>地図から読む。</h1>
      <p>島、港、平野、海峡。まず場所を選んでください。そこから自然、産業、食、文化のつながりをたどれます。</p>
      <div class="map-first-actions">
        <a href="/setouchi-cultural-economic-atlas/places/">地域一覧</a>
        <a href="/setouchi-cultural-economic-atlas/book/">エッセイを読む</a>
      </div>
    </div>

    <div class="map-first-legend">
      <span><i class="map-dot"></i>掲載地域</span>
      <small>地図の点をクリックすると地域ページへ進めます。</small>
    </div>
  </section>



  <section class="section home-region-index">
    <div class="section-heading-row">
      <div>
        <h2>地域から見る</h2>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/places/">地域一覧 →</a>
    </div>

    <div class="home-region-group">
      <h3>近畿・中国地方</h3>
      <div class="home-region-grid">
        {mainlandPlaces.map((place)=>(
          <a href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>
            <strong>{place.name}</strong>
            <span>{place.prefecture}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="home-region-group">
      <h3>四国地方</h3>
      <div class="home-region-grid">
        {shikokuPlaces.map((place)=>(
          <a href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>
            <strong>{place.name}</strong>
            <span>{place.prefecture}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section home-research-notes">
    <div class="section-heading-row">
      <div>
        <h2>研究ノート</h2>
        <p class="home-reading-intro">地域を越えて、瀬戸内の仕組みを考える。</p>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/chapters/">研究ノート一覧 →</a>
    </div>
    <div class="home-research-grid">
      {researchChapters.map((chapter)=>(
        <a href={`/setouchi-cultural-economic-atlas/chapters/${chapter.slug}/`}>
          <strong>{chapter.title}</strong>
          <span>{chapter.subtitle}</span>
        </a>
      ))}
    </div>
  </section>

  <section id="data-library" class="section home-evidence">
    <h2>データ集</h2>
    <p class="lead">地域を詳しく確認するときに使う基礎データと地図です。</p>
    <div class="evidence-link-grid">
      <a href="/setouchi-cultural-economic-atlas/climate/"><b>気候</b><span>雨・気温・日照</span></a>
      <a href="/setouchi-cultural-economic-atlas/wind-tide/"><b>潮と風</b><span>海峡・航海・港</span></a>
      <a href="/setouchi-cultural-economic-atlas/industry/"><b>産業</b><span>土地・技能・企業</span></a>
      <a href="/setouchi-cultural-economic-atlas/transport/"><b>交通</b><span>港・鉄道・橋</span></a>
      <a href="/setouchi-cultural-economic-atlas/transect/"><b>地形断面</b><span>山から海まで</span></a>
      <a href="/setouchi-cultural-economic-atlas/photos/"><b>写真資料</b><span>景観・港・産業</span></a>
    </div>
  </section>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script is:inline>
    (() => {
      const cover=document.getElementById('magazine-cover');
      if(!cover) return;

      let articles=[];
      let photos=[];
      try {
        articles=JSON.parse(cover.dataset.articles || '[]');
        photos=JSON.parse(cover.dataset.photos || '[]');
      } catch (_) {
        return;
      }

      const shuffle=(items)=>{
        const a=[...items];
        for(let i=a.length-1;i>0;i--){
          const j=Math.floor(Math.random()*(i+1));
          [a[i],a[j]]=[a[j],a[i]];
        }
        return a;
      };

      const setText=(selector,value)=>{
        const el=document.querySelector(selector);
        if(el) el.textContent=value || '';
      };

      const render=()=>{
        if(!articles.length || !photos.length) return;
        const photoById=Object.fromEntries(photos.map((photo)=>[photo.id,photo]));
        const eligibleArticles=articles.filter((article)=>(article.photoIds || []).some((id)=>photoById[id]));
        const storyPool=shuffle(eligibleArticles.length ? eligibleArticles : articles);
        const photoPool=shuffle(photos);
        const feature=storyPool[0];
        const featurePhotos=(feature?.photoIds || []).map((id)=>photoById[id]).filter(Boolean);
        const heroPhoto=feature?.heroPhotoId ? photoById[feature.heroPhotoId] : null;
        const coverPhoto=heroPhoto || shuffle(featurePhotos)[0] || photoPool[0];

        const coverImage=cover.querySelector('[data-cover-image]');
        if(coverImage){
          coverImage.src=coverPhoto.imageUrl;
          coverImage.alt=coverPhoto.alt || '';
        }
        setText('[data-cover-part]',feature.part);
        setText('[data-cover-title]',feature.title);
        setText('[data-cover-subtitle]',feature.subtitle);
        const coverLink=cover.querySelector('[data-cover-link]');
        if(coverLink) coverLink.href='/setouchi-cultural-economic-atlas/book/'+feature.slug+'/';

        setText('[data-cover-photo-title]',coverPhoto.title);
        setText('[data-cover-photo-author]',coverPhoto.author);
        const source=cover.querySelector('[data-cover-photo-source]');
        if(source){
          source.href=coverPhoto.sourcePage;
          source.textContent=coverPhoto.license || 'source';
        }

        document.querySelectorAll('[data-random-story]').forEach((card,index)=>{
          const article=storyPool[index+1] || storyPool[index] || feature;
          card.href='/setouchi-cultural-economic-atlas/book/'+article.slug+'/';
          const part=card.querySelector('[data-story-part]');
          const title=card.querySelector('[data-story-title]');
          const subtitle=card.querySelector('[data-story-subtitle]');
          if(part) part.textContent=article.part || '';
          if(title) title.textContent=article.title || '';
          if(subtitle) subtitle.textContent=article.subtitle || '';
        });

        document.querySelectorAll('[data-random-photo]').forEach((card,index)=>{
          const photo=photoPool[index+1] || photoPool[index] || coverPhoto;
          card.href=photo.placeId
            ? '/setouchi-cultural-economic-atlas/places/'+photo.placeId+'/'
            : '/setouchi-cultural-economic-atlas/photos/';
          const img=card.querySelector('[data-photo-image]');
          const title=card.querySelector('[data-photo-title]');
          const caption=card.querySelector('[data-photo-caption]');
          if(img){
            img.src=photo.imageUrl;
            img.alt=photo.alt || '';
          }
          if(title) title.textContent=photo.title || '';
          if(caption) caption.textContent=photo.caption || '';
        });
      };

      render();
      const reshuffle=cover.querySelector('[data-reshuffle]');
      if(reshuffle) reshuffle.addEventListener('click',render);
    })();
  </script>

  <script is:inline>
    (() => {
      const el=document.getElementById('home-atlas-map');
      if(!el || !window.L) return;
      const places=JSON.parse(el.dataset.places || '[]');
      const map=L.map(el,{scrollWheelZoom:false,zoomControl:true,attributionControl:true}).setView([34.25,133.45],7);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
        maxZoom:18,
        attribution:'&copy; OpenStreetMap contributors'
      }).addTo(map);

      places.forEach((place)=>{
        const marker=L.circleMarker([place.lat,place.lon],{
          radius:7,
          weight:2,
          fillOpacity:.84,
          color:'#ffffff',
          fillColor:'#245b6a'
        }).addTo(map);

        marker.bindTooltip(place.name,{direction:'top',offset:[0,-5],opacity:.92});
        marker.bindPopup(
          '<div class="home-map-popup">'+
          '<small>'+place.prefecture+'</small>'+
          '<strong>'+place.name+'</strong>'+
          '<p>'+place.subtitle+'</p>'+
          '<a href="/setouchi-cultural-economic-atlas/places/'+place.id+'/">この地域を見る →</a>'+
          '</div>'
        );
      });

      const coords=places.filter((p)=>Number.isFinite(p.lat)&&Number.isFinite(p.lon)).map((p)=>[p.lat,p.lon]);
      if(coords.length) map.fitBounds(L.latLngBounds(coords),{padding:[36,36]});
    })();
  </script>
</BaseLayout>
