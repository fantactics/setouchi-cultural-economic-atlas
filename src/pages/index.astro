---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bookArticles } from '../data/bookArticles.js';
import { photoEvidence } from '../data/photoEvidence.js';
const photoById=Object.fromEntries(photoEvidence.map((p)=>[p.id,p]));
const first=bookArticles[0];
const hero=photoById[first.heroPhotoId];
---
<BaseLayout title="瀬戸内文化経済アトラス | 読む瀬戸内" description="風景と史実から、瀬戸内の地域形成を考える連載型文化経済アトラス。">
  <section class="new-home-cover">
    {hero && <img src={hero.imageUrl} alt={hero.alt} class="new-home-cover-image" />}
    <div class="new-home-cover-shade"></div>
    <div class="new-home-cover-copy">
      <div class="eyebrow">SETOUCHI CULTURE & ECONOMY ATLAS</div>
      <h1>読む瀬戸内</h1>
      <p>土地を眺め、史料を読み、町と町を比べる。<br/>結論へ急がず、「なぜこの町はこの町になったのか」を歩くように考える。</p>
      <a class="book-primary-link" href={`/setouchi-cultural-economic-atlas/book/${first.slug}/`}>第1回から読む　→</a>
    </div>
  </section>

  <section class="section editorial-statement">
    <div class="kicker">EDITORIAL IDEA</div>
    <h2>答えより、答えへ向かう途中を読む。</h2>
    <p>このサイトでは、最初から結論を掲げません。塩田跡の写真を見る。市史の年代を確かめる。別の港町と並べる。すると説明できない違いが出てくる。そこで仮説を作り直す。その過程自体を本文にします。</p>
    <p>各記事は、確認できる史実に出典を付け、その事実同士をどう突き合わせたかを文章で追います。結論は最後に数行だけ。まだ分からないことも、そのまま残します。</p>
  </section>

  <section class="section latest-serial">
    <div class="section-heading-row">
      <div>
        <div class="kicker">SERIAL</div>
        <h2>連載を順に読む</h2>
      </div>
      <a class="text-link" href="/setouchi-cultural-economic-atlas/book/">目次を開く →</a>
    </div>
    <div class="serial-stack">
      {bookArticles.map((article)=>{
        const photo=photoById[article.heroPhotoId];
        return (
          <a class="serial-row" href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>
            <div class="serial-number">{article.number}</div>
            <div class="serial-copy">
              <small>{article.part}</small>
              <h3>{article.title}</h3>
              <p>{article.subtitle}</p>
            </div>
            {photo && <img src={photo.imageUrl} alt={photo.alt} loading="lazy" />}
          </a>
        )
      })}
    </div>
  </section>

  <section class="section reverse-entry-section">
    <div class="reverse-entry-card">
      <div class="kicker">CITY INDEX</div>
      <h2>都市名から逆引きする</h2>
      <p>今治、尾道、小豆島、赤穂。ひとつの町が別の記事で何度も顔を出します。</p>
      <a href="/setouchi-cultural-economic-atlas/cities/">都市索引 →</a>
    </div>
    <div class="reverse-entry-card">
      <div class="kicker">KEYWORD INDEX</div>
      <h2>小さな言葉から入る</h2>
      <p>潮待ち、造船、塩田、住吉神社、ジーンズ。興味のある言葉から記事を横断できます。</p>
      <a href="/setouchi-cultural-economic-atlas/keywords/">キーワード索引 →</a>
    </div>
  </section>

  <section class="section evidence-library">
    <div class="kicker">ATLAS / EVIDENCE</div>
    <h2>読み物の裏側にある、地図と資料</h2>
    <p class="lead">連載で気になった事実を、地域データ、地形断面、気候、潮流、産業、写真証拠で掘り下げられます。</p>
    <div class="evidence-link-grid">
      <a href="/setouchi-cultural-economic-atlas/places/"><b>地域データ</b><span>20地域の18レイヤー</span></a>
      <a href="/setouchi-cultural-economic-atlas/photos/"><b>写真証拠</b><span>景観・港・産業を読む</span></a>
      <a href="/setouchi-cultural-economic-atlas/transect/"><b>地形断面</b><span>山から海まで</span></a>
      <a href="/setouchi-cultural-economic-atlas/wind-tide/"><b>風と潮</b><span>見えない交通条件</span></a>
      <a href="/setouchi-cultural-economic-atlas/industry/"><b>産業地図</b><span>土地・技能・企業</span></a>
      <a href="/setouchi-cultural-economic-atlas/chapters/"><b>研究ノート</b><span>02〜10章の横断整理</span></a>
    </div>
  </section>

  <section class="section notebook-note">
    <div class="kicker">RESEARCH NOTEBOOK</div>
    <h2>「思考の道筋」と概念辞典も残しています</h2>
    <p>連載本文より圧縮した研究ノート、比較表、概念整理は別レイヤーに残します。本文を読んだ後に、構造を確認するための索引です。</p>
    <div class="chapter-related-grid">
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/reasoning/">思考の道筋（要約版） →</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/concepts/">概念辞典 →</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/comparative-reading/">比較読解 →</a>
    </div>
  </section>
</BaseLayout>
