---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSearch from '../components/SiteSearch.astro';
import AtlasEssayCards from '../components/AtlasEssayCards.astro';
import { cardTeaser, cardPhotoId } from '../data/essayCardCopy.js';
import { orderedBookArticles } from '../data/bookArticles.js';
import { withMarkdownMetadata } from '../data/essayMarkdownMetadata.js';
import { kadaEssays } from '../data/kadaEssays.js';
import { kadaIndustryEssay } from '../data/kadaIndustryEssay.js';
import { cycleTourismEssay } from '../data/cycleTourismEssay.js';
import { tomoTwoActPortEssay } from '../data/tomoTwoActPortEssay.js';
import { portSystemEssays } from '../data/portSystemEssays.js';
import { setouchiSushiEssay } from '../data/setouchiSushiEssay.js';
import { setouchiShrimpEssay } from '../data/setouchiShrimpEssay.js';
import { setouchiItinerantTradeBoatsEssay } from '../data/setouchiItinerantTradeBoatsEssay.js';
import { setouchiShipMaterialsEssay } from '../data/setouchiShipMaterialsEssay.js';
import { niboshiShirasuEssay } from '../data/niboshiShirasuEssay.js';
import { kojimaCircularEssay } from '../data/kojimaCircularEssay.js';
import { kojimaIslandEssays } from '../data/kojimaIslandEssays.js';
import { quageoSetouchiEssays } from '../data/quageoSetouchiEssays.js';
import { saltLandscapeNatureEssays } from '../data/saltLandscapeNatureEssays.js';
import { essayIndexPhotoOverrides } from '../data/essayIndexPhotos.js';
import { photoEvidence } from '../data/photoEvidence.js';
import { additionalPlacePhotos } from '../data/additionalPlacePhotos.js';
import '../styles/reader-navigation.css';

const allEssays=[...orderedBookArticles,...kadaEssays,kadaIndustryEssay,cycleTourismEssay,tomoTwoActPortEssay,...portSystemEssays,kojimaCircularEssay,...kojimaIslandEssays,...quageoSetouchiEssays,...saltLandscapeNatureEssays,setouchiSushiEssay,setouchiShrimpEssay,setouchiItinerantTradeBoatsEssay,setouchiShipMaterialsEssay,niboshiShirasuEssay].filter(Boolean).map(withMarkdownMetadata);
const photoById=Object.fromEntries([...photoEvidence,...Object.values(additionalPlacePhotos).flat()].map((p)=>[p.id,p]));
const essayPhoto=(article)=>{
  const curated=essayIndexPhotoOverrides[article.slug];
  if(curated?.imageUrl) return curated;
  const chosenPhoto=photoById[cardPhotoId(article)];
  if(chosenPhoto?.imageUrl) return chosenPhoto;
  if(article.heroPhoto?.imageUrl) return article.heroPhoto;
  const ids=[article.heroPhotoId,...(article.sections||[]).flatMap((section)=>section.photoIds||[])].filter(Boolean);
  return ids.map((id)=>photoById[id]).find((photo)=>photo?.imageUrl) || null;
};
const recommendedSlugs=['kojima-from-cotton-to-jeans','imabari-why-shipbuilding','tai-meshi-two-seas','ports-that-needed-waiting','shodoshima-open-island','sanuki-store-the-rain','setouchi-sushi-not-nigiri'];
const recommended=recommendedSlugs.map((slug)=>allEssays.find((article)=>article.slug===slug)).filter(Boolean);
const featuredArticles=recommended.slice(0,3);

// Render three feature essays and five more picks for visitors without JavaScript.
// With JavaScript, choose eight distinct illustrated essays at each visit.
const randomPickPool=[...new Map(allEssays.map((article)=>[article.slug,article])).values()]
  .map((article)=>{
    const photo=essayPhoto(article);
    return {
      slug:article.slug,
      title:article.title,
      teaser:cardTeaser(article),
      cities:article.cities?.slice(0,2).join('・') || '瀬戸内',
      imageUrl:photo?.imageUrl || '',
      alt:photo?.alt || article.title
    };
  })
  .filter((entry)=>entry.imageUrl);
if(randomPickPool.length<8) throw new Error('Homepage needs at least eight illustrated essays.');
---
<BaseLayout title="SETOUCHI ATLAS｜ランドスケープ ＝ ネイチャー ｘ カルチャー" description="ランドスケープ ＝ ネイチャー ｘ カルチャー。港町の路地、島の食卓、海辺の工場。瀬戸内を旅するエッセイ集。">
  <div class="reader-home">
    <h1 class="reader-home-screenreader">SETOUCHI ATLAS のエッセイ</h1>
    <section class="reader-home-featured" aria-label="今日の3篇">
      <p class="reader-home-feature-label">今日の3篇</p>
      <div class="reader-home-feature-grid">
        {featuredArticles.map((article,index)=>{
          const photo=essayPhoto(article);
          return <a class="reader-home-feature" href={'/setouchi-cultural-economic-atlas/book/'+article.slug+'/'}>
            {photo?.imageUrl && <img src={photo.imageUrl} alt={photo.alt || article.title} loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':'auto'} />}
            <div class="reader-home-feature-copy"><span>{article.cities?.slice(0,2).join('・') || '瀬戸内'}</span><h2>{article.title}</h2><p>{cardTeaser(article)}</p><strong>読む →</strong></div>
          </a>;
        })}
      </div>
    </section>

    <section class="reader-home-section" aria-labelledby="home-picks">
      <div class="reader-section-heading"><div><p class="reader-eyebrow">MORE STORIES</p><h2 id="home-picks">ほかにも、こんな旅。</h2><p>気になる写真から、寄り道してみよう。</p></div><a href="/setouchi-cultural-economic-atlas/book/">すべてのエッセイを見る →</a></div>
      <AtlasEssayCards stories={recommended.slice(3).map((article)=>{
        const photo=essayPhoto(article);
        return {
          href:`/setouchi-cultural-economic-atlas/book/${article.slug}/`,
          imageUrl:photo?.imageUrl || '',
          alt:photo?.alt || article.title,
          title:article.title,
          region:article.cities?.slice(0,2).join('・') || '瀬戸内',
          teaser:cardTeaser(article)
        };
      })} />
    </section>

    <section class="reader-home-section" aria-label="エッセイの探し方">
      <div class="reader-section-heading"><div><p class="reader-eyebrow">EXPLORE THE LANDSCAPE</p><h2>自然と文化、二つの入口。</h2><p>瀬戸内の風景を、土地の条件からも、人の営みからも。</p></div></div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px">
        <a href="/setouchi-cultural-economic-atlas/book/nature/" style="display:block;padding:24px;border:1px solid #d7e6dc;border-radius:16px;text-decoration:none;background:#f1f7f2;color:#315d4a"><strong style="display:block;font-size:1.2rem;margin-bottom:9px">自然条件から</strong><span>雨、潮、風、地形、生き物から探す ↗</span></a>
        <a href="/setouchi-cultural-economic-atlas/book/culture/" style="display:block;padding:24px;border:1px solid #eaded0;border-radius:16px;text-decoration:none;background:#fcf6ee;color:#855a3b"><strong style="display:block;font-size:1.2rem;margin-bottom:9px">文化・風習から</strong><span>食、信仰、商い、技術、暮らしから探す ↗</span></a>
      </div>
    </section>
    <section class="reader-home-search" aria-labelledby="reader-home-search-title">
      <div class="reader-section-heading"><div><p class="reader-eyebrow">FIND A STORY</p><h2 id="reader-home-search-title">ことばで、ひとっとび。</h2><p>町、食べもの、港、島。思いついた言葉で探してみよう。</p></div></div>
      <SiteSearch essaysOnly={true} />
    </section>
    <script id="home-random-picks" type="application/json" set:html={JSON.stringify(randomPickPool).replace(/</g,'\\u003c')}></script>
    <script is:inline>
      (() => {
        const data=document.getElementById('home-random-picks');
        const features=[...document.querySelectorAll('.reader-home-feature-grid .reader-home-feature')];
        const cards=[...document.querySelectorAll('.reader-home-section .reader-essay-card')];
        if(!data || features.length!==3 || cards.length!==5) return;
        let options;
        try {options=JSON.parse(data.textContent || '[]');} catch {return;}
        if(options.length<8) return;
        // Select three different main essays and five additional stories, without repeats.
        for(let i=options.length-1;i>0;i--){
          const j=Math.floor(Math.random()*(i+1));
          [options[i],options[j]]=[options[j],options[i]];
        }
        const selected=options.slice(0,8);
        const root='/setouchi-cultural-economic-atlas/book/';
        features.forEach((feature,index)=>{
          const story=selected[index];
          feature.href=root+story.slug+'/';
          const img=feature.querySelector('img');
          if(img){img.src=story.imageUrl;img.alt=story.alt;}
          const city=feature.querySelector('.reader-home-feature-copy>span');
          const title=feature.querySelector('h2');
          const teaser=feature.querySelector('p');
          if(city)city.textContent=story.cities;
          if(title)title.textContent=story.title;
          if(teaser)teaser.textContent=story.teaser;
        });
        cards.forEach((card,index)=>{
          const story=selected[index+3];
          card.href=root+story.slug+'/';
          const img=card.querySelector('img');
          if(img){img.src=story.imageUrl;img.alt=story.alt;}
          const city=card.querySelector('div>span');
          const title=card.querySelector('h3');
          const teaser=card.querySelector('p');
          if(city)city.textContent=story.cities;
          if(title)title.textContent=story.title;
          if(teaser)teaser.textContent=story.teaser;
        });
      })();
    </script>
  </div>
</BaseLayout>