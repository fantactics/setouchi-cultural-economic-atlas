---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { publishedEssays } from '../../../data/publishedEssayList.js';
import { cultureTagIndex } from '../../../data/cultureTraditionTags.js';
import { photoEvidence } from '../../../data/photoEvidence.js';
const groups=cultureTagIndex(publishedEssays);
const photoById=Object.fromEntries(photoEvidence.map(photo=>[photo.id,photo]));
const features=[
  {tag:'食文化',photoId:'photo-matsuyama-zushi-shared-bowl',question:'同じ魚でも、食べ方は違う。',eyebrow:'FOOD & TABLE'},
  {tag:'港の商い',photoId:'photo-yanai-whitewall',question:'港が、白壁の町を育てた。',eyebrow:'PORT & TRADE'},
  {tag:'信仰・寺社',photoId:'photo-onomichi-panorama',question:'寺と町は、どう結ばれた？',eyebrow:'FAITH & TOWN'}
].map(f=>({...f,group:groups.find(g=>g.tag===f.tag),photo:photoById[f.photoId]})).filter(f=>f.group && f.photo?.imageUrl);
---
<BaseLayout title="文化・風習から探す | SETOUCHI ATLAS" description="食文化、港の商い、町並み、信仰。瀬戸内の人びとの知恵と営みから、風景の物語を探す。">
  <main class="culture-index">
    <nav class="culture-back"><a href="/setouchi-cultural-economic-atlas/book/nature/">自然条件から</a><a href="/setouchi-cultural-economic-atlas/book/">エッセイ一覧へ</a></nav>
    <header class="culture-intro">
      <p class="culture-kicker">CULTURE × STORIES</p>
      <h1>文化・風習から、瀬戸内を読む。</h1>
      <p>土地の水や風や地形に、人はどんな仕事や習わしで応えてきたのだろう。食卓、港、農の技、信仰、町並み。人びとの選択から、風景の意味を探ります。</p>
    </header>
    <section aria-labelledby="culture-features">
      <div class="culture-section-heading"><span>START HERE</span><h2 id="culture-features">まずは、この3つ。</h2></div>
      <div class="culture-features">
        {features.map(({tag,question,eyebrow,group,photo})=><a href={`#culture-${tag}`} class="culture-feature"><div class="culture-feature-image"><img src={photo.imageUrl} alt={photo.alt||photo.title} loading="eager" decoding="async" /></div><div class="culture-feature-copy"><small>{eyebrow}</small><strong>{question}</strong><span>#{tag} · {group.essays.length}篇 ↗</span></div></a>)}
      </div>
    </section>
    <section class="culture-overview" id="culture-overview">
      <div class="culture-section-heading"><span>PICK A CLUE</span><h2>気になる営みは、どれ？ <small>{groups.length}のテーマ</small></h2></div>
      <p>タグを選ぶと、その営みが生んだ風景とエッセイに出会えます。</p>
      <div class="culture-chips">{groups.map(({tag,essays})=><a href={`#culture-${tag}`}><strong>{tag}</strong><small>{essays.length}篇</small></a>)}</div>
    </section>
    <div class="culture-results">
      {groups.map(({tag,essays})=><section class="culture-group" id={`culture-${tag}`}>
        <header><h2>{tag}</h2><span>{essays.length}篇の物語</span><a href="#culture-overview" aria-label={`${tag}からタグ一覧へ戻る`}>↑</a></header>
        <ul>{essays.slice(0,4).map(article=><li><a href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}><strong>{article.title}</strong><small>{article.subtitle||''}</small></a></li>)}</ul>
        {essays.length>4 && <details><summary>ほかの物語も見る（{essays.length-4}篇）</summary><ul>{essays.slice(4).map(article=><li><a href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}><strong>{article.title}</strong><small>{article.subtitle||''}</small></a></li>)}</ul></details>}
      </section>)}
    </div>
    <p class="culture-note">文化・風習タグは自然条件タグとは独立して設定しています。名称は料理や生業、技術、信仰、暮らしの工夫を表します。記事の主題との関係が確認できるものを優先しています。</p>
    <details class="culture-credits"><summary>代表写真の出典・利用条件</summary><ul>{features.map(({photo})=><li><a href={photo.sourcePage||photo.imageUrl} target="_blank" rel="noreferrer">{photo.title}</a> / {photo.author||'出典先参照'} / {photo.licenseUrl?<a href={photo.licenseUrl} target="_blank" rel="noreferrer">{photo.license||'利用条件'}</a>:(photo.license||'利用条件は出典参照')}</li>)}</ul></details>
  </main>
</BaseLayout>
<style>
.culture-index{max-width:1210px;margin:0 auto;padding:25px 24px 75px;color:#354842}
.culture-back{display:flex;gap:20px;flex-wrap:wrap;margin-bottom:30px;font-size:.85rem}
.culture-back a{color:#51766b}
.culture-intro{max-width:850px;margin-bottom:42px}
.culture-kicker{font-size:.75rem;font-weight:800;letter-spacing:.13em;color:#ad624b;margin:0}
.culture-intro h1{font-size:clamp(1.85rem,3.5vw,2.8rem);line-height:1.4;margin:12px 0}
.culture-intro>p:last-child{line-height:1.9;color:#677970}
.culture-section-heading{display:flex;gap:15px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.culture-section-heading>span{font-size:.68rem;font-weight:800;letter-spacing:.12em;color:#a15e45;background:#ffede3;padding:7px 12px;border-radius:99px}
.culture-section-heading h2{font-size:1.43rem;margin:0}
.culture-section-heading small{font-size:.73rem;color:#89958c}
.culture-features{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-bottom:40px}
.culture-feature{display:flex;min-width:0;flex-direction:column;gap:0;border-radius:19px;overflow:hidden;background:#f9f4eb;border:1px solid #e9e1d4;text-decoration:none;color:inherit;transition:transform .2s ease,box-shadow .2s ease}
.culture-feature:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(30,67,54,.12)}
.culture-feature-image{aspect-ratio:16/10;overflow:hidden;background:#dfe9e2}
.culture-feature-image img{display:block;width:100%;height:100%;object-fit:cover}
.culture-feature-copy{display:flex;flex-direction:column;gap:12px;padding:19px 22px 22px;flex:1}
.culture-feature:nth-child(2){background:#edf5f0}.culture-feature:nth-child(3){background:#f2f0f9}
.culture-feature-copy small{color:#ab6b4b;letter-spacing:.09em;font-size:.7rem;font-weight:750}
.culture-feature-copy strong{font-size:1.2rem;line-height:1.5}
.culture-feature-copy span{margin-top:auto;color:#517c69;font-size:.8rem}
.culture-overview{padding:30px;background:#f7f8f4;border:1px solid #e4e9e0;border-radius:22px;margin-bottom:32px}
.culture-overview p{font-size:.9rem;color:#667b70}
.culture-chips{display:flex;flex-wrap:wrap;gap:9px}
.culture-chips a{display:flex;gap:9px;align-items:center;background:white;border:1px solid #cdded5;border-radius:99px;padding:9px 13px;text-decoration:none;color:#34584d;font-size:.85rem}
.culture-chips small{color:#82958b}
.culture-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.culture-group{min-width:0;border:1px solid #e0e8df;border-top:4px solid #9abbac;border-radius:16px;background:#fff;padding:19px 21px;scroll-margin-top:100px}
.culture-group:nth-child(3n+2){border-top-color:#dea884}.culture-group:nth-child(3n){border-top-color:#a6b2d9}
.culture-group header{display:flex;align-items:center;gap:11px;padding-bottom:12px;border-bottom:1px solid #edf0ea}
.culture-group header h2{font-size:1.18rem;margin:0}.culture-group header span{font-size:.78rem;color:#87958d}
.culture-group header a{margin-left:auto;color:#678c7e}
.culture-group ul{padding:0;margin:0;list-style:none}
.culture-group li{padding:11px 0;border-bottom:1px solid #edf0ea}
.culture-group li:last-child{border-bottom:0}
.culture-group li a{display:flex;flex-direction:column;gap:4px;text-decoration:none;color:#345448;line-height:1.55}
.culture-group li a:hover strong{text-decoration:underline}
.culture-group li small{font-size:.77rem;color:#7d9084}
.culture-group details{margin-top:12px}.culture-group summary{cursor:pointer;padding:10px;border-radius:9px;background:#eff6f1;color:#456a57;font-size:.85rem;font-weight:700}
.culture-note{max-width:860px;margin:37px auto 0;line-height:1.9;font-size:.83rem;color:#718477}
.culture-credits{margin:18px auto;max-width:860px;color:#65796e;font-size:.82rem;line-height:1.8}.culture-credits summary{cursor:pointer;font-weight:700}.culture-credits a{color:#476e5c}
@media(max-width:720px){.culture-features,.culture-results{grid-template-columns:1fr}.culture-index{padding:18px 15px 55px}.culture-overview{padding:20px}.culture-feature{min-height:145px}}
</style>