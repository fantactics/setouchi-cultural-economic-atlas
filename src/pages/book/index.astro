---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteSearch from '../../components/SiteSearch.astro';
import { essayEntryCategories, essayEntryBySlug, entryIdsForEssay, essaysForEntrance } from '../../data/essayEntryCategories.js';
import { essayFeaturedByEntrance } from '../../data/essayFeaturedPicks.js';
import { essayIndexPhotoOverrides, essayCardPhotoContext } from '../../data/essayIndexPhotos.js';
import { cardTeaser, cardPhotoId } from '../../data/essayCardCopy.js';
import '../../styles/reader-navigation.css';
import { orderedBookArticles } from '../../data/bookArticles.js';
import { cycleTourismEssay } from '../../data/cycleTourismEssay.js';
import { aiRegionalPlanningEssay } from '../../data/aiRegionalPlanningEssay.js';
import { kadaEssays } from '../../data/kadaEssays.js';
import { kadaIndustryEssay } from '../../data/kadaIndustryEssay.js';
import { shimotsuiHijikiEssay } from '../../data/shimotsuiHijikiEssay.js';
import { tomoTwoActPortEssay } from '../../data/tomoTwoActPortEssay.js';
import { portSystemEssays } from '../../data/portSystemEssays.js';
import { kojimaCircularEssay } from '../../data/kojimaCircularEssay.js';
import { kojimaIslandEssays } from '../../data/kojimaIslandEssays.js';
import { quageoSetouchiEssays } from '../../data/quageoSetouchiEssays.js';
import { setouchiSushiEssay } from '../../data/setouchiSushiEssay.js';
import { setouchiShrimpEssay } from '../../data/setouchiShrimpEssay.js';
import { setouchiItinerantTradeBoatsEssay } from '../../data/setouchiItinerantTradeBoatsEssay.js';
import { setouchiShipMaterialsEssay } from '../../data/setouchiShipMaterialsEssay.js';
import { niboshiShirasuEssay } from '../../data/niboshiShirasuEssay.js';
import { photoEvidence } from '../../data/photoEvidence.js';
import { additionalPlacePhotos } from '../../data/additionalPlacePhotos.js';
import '../../styles/essay-magazine.css';

const allBookArticles=[...orderedBookArticles,...kadaEssays,kadaIndustryEssay,cycleTourismEssay,shimotsuiHijikiEssay,tomoTwoActPortEssay,...portSystemEssays,kojimaCircularEssay,...kojimaIslandEssays,...quageoSetouchiEssays,setouchiSushiEssay,setouchiShrimpEssay,setouchiItinerantTradeBoatsEssay,setouchiShipMaterialsEssay,niboshiShirasuEssay,aiRegionalPlanningEssay];
const allPhotoEvidence=[...photoEvidence,...Object.values(additionalPlacePhotos).flat()];
const photoById=Object.fromEntries(allPhotoEvidence.map((p)=>[p.id,p]));
// Use article photography first, then a place-matched or theme-matched image.
// Fallback images are explicitly described as related scenery, never as the article location.
// No generic coastal/town image is substituted for an unrelated essay.
// Missing cover photos are intentional text-only states until sourced imagery is available.
const articlePhoto=(article)=>{
  // Index-only overrides, then explicitly selected card photos, then article heroes.
  // Article hero images must not silently override reviewed cardPhotoId choices.
  const curated=essayIndexPhotoOverrides[article?.slug];
  if(curated?.imageUrl) return curated;
  const cardId=cardPhotoId(article);
  const cardImage=cardId ? photoById[cardId] : null;
  if(cardImage?.imageUrl) return cardImage;
  if(article?.heroPhoto?.imageUrl) return article.heroPhoto;
  const ids=[article?.heroPhotoId,...(article?.sections || []).flatMap((section)=>section.photoIds || [])].filter(Boolean);
  const articleSpecific=ids.map((id)=>photoById[id]).find((photo)=>photo?.imageUrl);
  if(articleSpecific) return articleSpecific;
  return null;
};
const photoMissingArticles=allBookArticles.filter((article)=>!articlePhoto(article));
const expectedTextOnlySlugs=['ai-era-regional-planning-learning-velocity'];
const unexpectedMissing=photoMissingArticles.filter((article)=>!expectedTextOnlySlugs.includes(article.slug));
if(unexpectedMissing.length) {
  throw new Error(`Review essay cover photo before publishing: ${unexpectedMissing.map((article)=>article.slug).join(', ')}`);
}
const categories=essayEntryCategories;
const entranceId=(entry)=>`entrance-${entry.id}`;
const essaysIn=(entry)=>essaysForEntrance(allBookArticles,entry.id);
const primaryEssaysIn=(entry)=>essaysIn(entry).filter((article)=>entryIdsForEssay(article)[0]===entry.id);
const featuredSlugsFor=(entry)=>essayFeaturedByEntrance[entry.id] || [];
const galleryEssaysIn=(entry)=>featuredSlugsFor(entry).map((slug)=>allBookArticles.find((article)=>article.slug===slug)).filter(Boolean);
const otherPrimaryEssaysIn=(entry)=>primaryEssaysIn(entry).filter((article)=>!featuredSlugsFor(entry).includes(article.slug));
const relatedEssaysIn=(entry)=>essaysIn(entry).filter((article)=>entryIdsForEssay(article)[0]!==entry.id && !featuredSlugsFor(entry).includes(article.slug));
const invalidFeatured=categories.filter((entry)=>{
  const slugs=featuredSlugsFor(entry);
  return slugs.length!==3 || new Set(slugs).size!==3 || slugs.some((slug)=>!essaysIn(entry).some((article)=>article.slug===slug));
});
if(invalidFeatured.length) throw new Error(`Invalid featured essays: ${invalidFeatured.map((entry)=>entry.id).join(', ')}`);
// A title appears once in the directory, under its primary entry category.
const directoryCount=categories.reduce((total,entry)=>total+primaryEssaysIn(entry).length,0);
if(directoryCount!==allBookArticles.length) throw new Error('Each essay needs one primary directory entry');
const essayCategoryLabel=(article)=>categories.find((entry)=>entry.id===entryIdsForEssay(article)[0])?.label || '瀬戸内';
const uncategorized=allBookArticles.filter((article)=>!essayEntryBySlug[article.slug] || entryIdsForEssay(article).some((id)=>!categories.some((entry)=>entry.id===id)));
if(uncategorized.length) throw new Error(`Essay entrance categorization missing: ${uncategorized.map((article)=>article.slug).join(', ')}`);

const coverSlugs=[
  'kojima-from-cotton-to-jeans',
  'tai-meshi-two-seas',
  'mitarai-economy-of-waiting',
  'onomichi-capital-to-culture-and-ships',
  'imabari-why-shipbuilding',
  'shodoshima-open-island',
  'mikan-slope-and-varieties',
  'ports-that-needed-waiting',
  'takehara-salt-capital-to-townscape',
  'shimotsui-tako-meshi',
  'setouchi-itinerant-trade-boats',
  'tomo-two-act-tidal-port'
];
const coverStories=coverSlugs
  .map((slug)=>allBookArticles.find((a)=>a.slug===slug))
  .filter(Boolean)
  .map((article)=>{
    const photo=articlePhoto(article);
    return photo ? {imageUrl:photo.imageUrl,alt:photo.alt,part:essayCategoryLabel(article),title:article.title,subtitle:cardTeaser(article),href:`/setouchi-cultural-economic-atlas/book/${article.slug}/`} : null;
  })
  .filter(Boolean);
const featureStory=coverStories[0];
const coverSide=coverStories.slice(1,3);
// Attribution for photos shown in the category highlights and rotating editor picks.
// Deduplicate by source URL; include index-specific image overrides even below the fold.
const creditedSlugs=[...new Set([
  ...Object.values(essayFeaturedByEntrance).flat(),
  ...coverSlugs,
  ...Object.keys(essayIndexPhotoOverrides)
])];
const editorialPhotoCredits=[...new Map(
  creditedSlugs
    .map((slug)=>allBookArticles.find((item)=>item.slug===slug))
    .filter(Boolean)
    .map((article)=>({storyTitle:article.title,...articlePhoto(article)}))
    .filter((photo)=>photo.sourcePage && photo.imageUrl)
    .map((photo)=>[photo.sourcePage,photo])
).values()];
---
<BaseLayout title="エッセイ | SETOUCHI ATLAS" description="港町を歩く。島の味に出会う。気になる風景から選んで読む、瀬戸内の旅エッセイ集。">
  <main class="essay-magazine">
    <section class="essay-magazine-intro"><div><div class="eyebrow">STORIES FROM SETOUCHI <span aria-hidden="true">✳</span></div><h1>今日は、どの瀬戸内へ？</h1></div><p>海の色、町の路地、おいしいもの。<br />気になる写真から、旅するように読んでみよう。</p></section>

    <div class="reader-feature-heading"><span>START HERE <span aria-hidden="true">✦</span></span><h2>まずは、この3篇。</h2></div>

    <section class="essay-magazine-cover" aria-label="今読みたいエッセイ" data-random-cover="essays" data-cover-stories={JSON.stringify(coverStories)}>
      {featureStory && (<a class="essay-cover-main js-essay-main" href={featureStory.href}><img class="js-essay-main-image" src={featureStory.imageUrl} alt={featureStory.alt} fetchpriority="high" /><div class="essay-cover-copy"><small class="js-essay-main-kicker">FEATURE / {featureStory.part}</small><h2 class="js-essay-main-title">{featureStory.title}</h2><p class="js-essay-main-subtitle">{featureStory.subtitle}</p></div></a>)}
      <div class="essay-cover-side">{coverSide.map((story,index)=>(<a class={`essay-cover-side-card js-essay-side js-essay-side-${index}`} href={story.href}><img class="js-essay-side-image" src={story.imageUrl} alt={story.alt} loading="eager" /><div class="essay-card-copy"><small class="js-essay-side-kicker">{story.part}</small><h2 class="js-essay-side-title">{story.title}</h2></div></a>))}</div>
    </section>

    <script is:inline>
      (() => {
        const cover=document.querySelector('[data-random-cover="essays"]'); if (!cover) return;
        let stories=[]; try { stories=JSON.parse(cover.dataset.coverStories || '[]'); } catch (_) { return; }
        if (stories.length<3) return;
        const key='setouchi-essay-cover-last'; const previous=Number(sessionStorage.getItem(key)); const indices=stories.map((_,i)=>i);
        for (let i=indices.length-1;i>0;i--) { const j=Math.floor(Math.random()*(i+1)); [indices[i],indices[j]]=[indices[j],indices[i]]; }
        if (indices.length>1 && Number.isInteger(previous) && indices[0]===previous) { const swapWith=1+Math.floor(Math.random()*(indices.length-1)); [indices[0],indices[swapWith]]=[indices[swapWith],indices[0]]; }
        sessionStorage.setItem(key,String(indices[0])); const chosen=indices.slice(0,3).map((i)=>stories[i]); const main=chosen[0];
        const mainLink=cover.querySelector('.js-essay-main'); const mainImage=cover.querySelector('.js-essay-main-image'); const mainKicker=cover.querySelector('.js-essay-main-kicker'); const mainTitle=cover.querySelector('.js-essay-main-title'); const mainSubtitle=cover.querySelector('.js-essay-main-subtitle');
        if (mainLink) mainLink.href=main.href; if (mainImage) { mainImage.src=main.imageUrl; mainImage.alt=main.alt || ''; } if (mainKicker) mainKicker.textContent=`FEATURE / ${main.part || ''}`; if (mainTitle) mainTitle.textContent=main.title || ''; if (mainSubtitle) mainSubtitle.textContent=main.subtitle || '';
        chosen.slice(1).forEach((story,index)=>{ const card=cover.querySelector(`.js-essay-side-${index}`); if (!card) return; card.href=story.href; const image=card.querySelector('.js-essay-side-image'); const kicker=card.querySelector('.js-essay-side-kicker'); const title=card.querySelector('.js-essay-side-title'); if (image) { image.src=story.imageUrl; image.alt=story.alt || ''; } if (kicker) kicker.textContent=story.part || ''; if (title) title.textContent=story.title || ''; });
      })();
    </script>


    <section class="reader-discovery" aria-labelledby="reader-discovery-title">
      <div class="reader-discovery-head"><div><span>PICK YOUR MOOD <span aria-hidden="true">✳</span></span><h2 id="reader-discovery-title">いま、何が気になる？</h2><p>食べたい、歩きたい、眺めたい。そんな気分から選ぼう。</p></div><div class="reader-discovery-head-links"><a href="#essay-all-themes">カテゴリをめくる ↓</a><a href="/setouchi-cultural-economic-atlas/book/nature/">自然条件から探す</a><a href="#essay-directory">全{directoryCount}篇のタイトル一覧 ↓</a></div></div>
      <div class="reader-discovery-grid">
        {categories.map((entry)=><a class="reader-discovery-tile" href={`#${entranceId(entry)}`}>
          <span>{String(essaysIn(entry).length).padStart(2,'0')} ESSAYS</span>
          <strong>{entry.label}</strong><small>{entry.description}</small><em aria-hidden="true">↗</em>
        </a>)}
      </div>
      <div class="reader-discovery-search" id="essay-search">
        <h3>キーワードでひとっとび</h3>
        <p>「尾道」「タコ」「みかん」「造船」など、思いついた言葉で。</p>
        <SiteSearch essaysOnly={true} />
      </div>
    </section>

    <nav class="reader-theme-shortcuts" aria-label="エッセイのカテゴリへ移動">
      <span>カテゴリへジャンプ</span>
      <div>{categories.map((entry)=><a href={`#${entranceId(entry)}`}>{entry.label}</a>)}<a class="reader-directory-jump" href="/setouchi-cultural-economic-atlas/book/nature/">自然条件</a><a class="reader-directory-jump" href="#essay-directory">タイトル一覧</a></div>
    </nav>

    <section id="essay-all-themes">
      <div class="essay-magazine-heading"><h2>瀬戸内を、つまみ読み。</h2><p>テーマごとに3篇ずつ。好きな景色からどうぞ。</p></div>
      {categories.map((entry)=>(<section class="essay-theme reader-essay-theme" id={entranceId(entry)}>
        <div class="essay-theme-head">
          <h3>{entry.label} <small>{essaysIn(entry).length}篇</small></h3>
          <p>{entry.description}</p>
        </div>
        <div class="essay-theme-grid reader-category-featured">
          {galleryEssaysIn(entry).map((article)=>{
            const photo=articlePhoto(article);
            return <a class="essay-theme-card" href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>
              {photo && <div class="reader-category-photo">
                <img src={photo.imageUrl} alt={photo.alt || article.title} loading="lazy" />
                {essayCardPhotoContext[article.slug] && <span class="reader-category-photo-label">{essayCardPhotoContext[article.slug]}</span>}
              </div>}
              <div class="essay-theme-card-body">
                <h4>{article.title}</h4><p>{cardTeaser(article)}</p><span>{article.cities?.join(' / ')}</span>
              </div>
            </a>;
          })}
        </div>
        {otherPrimaryEssaysIn(entry).length>0 && (
          <details class="reader-category-more">
            <summary>このカテゴリのほかの作品 <span>{otherPrimaryEssaysIn(entry).length}篇</span></summary>
            <ul>{otherPrimaryEssaysIn(entry).map((article)=><li><a href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>{article.title}</a></li>)}</ul>
          </details>
        )}
        {relatedEssaysIn(entry).length>0 && (
          <details class="reader-category-more reader-category-related">
            <summary>この風景からも読める作品 <span>{relatedEssaysIn(entry).length}篇</span></summary>
            <ul>{relatedEssaysIn(entry).map((article)=><li><a href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>{article.title}</a></li>)}</ul>
          </details>
        )}
      </section>))}

    </section>

    <section class="reader-title-directory" id="essay-directory" aria-labelledby="essay-directory-title">
      <div class="reader-title-directory-heading">
        <span>ALL STORIES / DIRECTORY</span>
        <h2 id="essay-directory-title">タイトルを、ずらり。</h2>
        <p>全{allBookArticles.length}篇。写真を見ずに探したいときはこちら。</p>
      </div>
      {categories.map((entry)=>(<div class="reader-title-directory-group">
        <h3>{entry.label} <small>{primaryEssaysIn(entry).length}篇</small></h3>
        <ul>{primaryEssaysIn(entry).map((article)=><li><a href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>{article.title}</a></li>)}</ul>
      </div>))}
    </section>

    <details class="reader-cover-credits">
      <summary>写真の出典・撮影者・利用条件（{editorialPhotoCredits.length}点）</summary>
      <p>代表エッセイや特集に使った写真の出典です。カードでは掲載枠に合わせて表示範囲を調整しています。参考写真は撮影場所をそのまま記事の場所とは扱いません。</p>
      <ul>{editorialPhotoCredits.map((photo)=><li>
        <span>{photo.storyTitle} / </span><a href={photo.sourcePage} target="_blank" rel="noopener noreferrer">写真の出典</a>
        <span> / 撮影・提供：{photo.author || '出典先参照'}</span>
        <span> / {photo.licenseUrl ? <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">{photo.license || '利用条件'}</a> : (photo.license || '利用条件は出典参照')}</span>
      </li>)}</ul>
    </details>

    <div class="reader-book-back"><a href="#reader-discovery-title">↑ カテゴリ選びへ戻る</a></div>
  </main>
</BaseLayout>