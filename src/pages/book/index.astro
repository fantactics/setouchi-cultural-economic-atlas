---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { orderedBookArticles } from '../../data/bookArticles.js';
import { cycleTourismEssay } from '../../data/cycleTourismEssay.js';
import { aiRegionalPlanningEssay } from '../../data/aiRegionalPlanningEssay.js';
import { photoEvidence } from '../../data/photoEvidence.js';

const allBookArticles=[...orderedBookArticles,cycleTourismEssay,aiRegionalPlanningEssay];
const photoById=Object.fromEntries(photoEvidence.map((p)=>[p.id,p]));
const articlePhoto=(article)=>{
  const ids=[article.heroPhotoId,...article.sections.flatMap((section)=>section.photoIds || [])].filter(Boolean);
  return ids.map((id)=>photoById[id]).find(Boolean) || null;
};
const parts=[...new Set(allBookArticles.map((a)=>a.part))];
const chapterDescriptions={
  '海と陸は、人がつくった':'自然は背景ではない。干拓、塩田、河川、港を通じて、人は海と陸の境界そのものを作り替えてきた。',
  '土地は、何度でも使い直される':'塩田、工場、住宅、港。前の用途が残した地形・設備・権利・記憶が、次の土地利用をどう決めるかを追う。',
  'なぜ、船はここで止まったのか':'潮、風、海峡、港。移動の制約が交易、情報、都市を生む仕組みを読む。',
  '食は、土地を語る':'海、川、畑、市場、加工。自然資源が食文化へ変わるまでの地域固有の連鎖を読む。',
  '捨てるものは、どこへ行くのか':'副産物や廃棄物が、農地・飼料・素材へ戻る循環から地域経済を見る。',
  '産業は、紡がれる':'前の産業が残した技能、設備、資本、企業ネットワークが、次の産業へどう受け渡されるかを読む。',
  '富は、町に何を残したのか':'交易や産業の利益が、建築、文化、教育、制度へ固定され、地域資産へ変わる過程を追う。',
  '町は、何度でもつくり直される':'交通、人口、産業の変化に応じて、都市の中心と土地利用がどう組み替えられてきたかを見る。',
  '移動は、地域を変える':'人の移動が売上だけでなく、店、人材、景観、インフラ、関係人口へ何を残すかを考える。',
  '地域は、学習し続ける':'AI時代の地域計画を、完成図ではなく観測・比較・実験・修正を反復するLearning Velocityとして考える。'
};
---
<BaseLayout title="エッセイ | SETOUCHI ATLAS" description="現地の風景や違和感から問いを立て、自然・産業・文化・都市を横断して仮説を組み立てる。研究ノートで検証し、必要なら書き換えるための出発点。">
  <section class="concept-hero">
    <div class="kicker">ESSAYS / HYPOTHESIS FORMATION</div>
    <h1>エッセイは、問いを立てる場所。</h1>
    <p class="concept-dek">風景を見て生まれた「なぜ？」を、地形、歴史、産業、食、交通、文化へ横断させ、説明仮説へ変えます。ここでの文章は完成した結論ではありません。研究ノートとデータで検証され、違えば書き換えられます。</p>
    <div class="concept-actions"><a href="/setouchi-cultural-economic-atlas/chapters/">研究ノートで検証する</a><a class="secondary" href="/setouchi-cultural-economic-atlas/methodology/">方法論を見る</a></div>
  </section>

  <section class="section atlas-thesis">
    <div class="page-intro-grid">
      <p class="big-question">現地観察から仮説をつくり、比較研究で壊し、また地域へ戻す。</p>
      <div class="body-copy">
        <p>SETOUCHI ATLASでは、エッセイを「読み物」と「研究の入口」の両方として扱います。直感や違和感を曖昧なまま終わらせず、後から検証できる問いへ変換します。</p>
        <div class="book-cycle"><span>現場</span><b>→</b><span>問い</span><b>→</b><span>エッセイ</span><b>→</b><span>研究ノート</span><b>→</b><span>世界比較</span><b>→</b><span>再記述</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">CORE ESSAY</div>
    <h2>いま、このアトラスをどう読むか</h2>
    <a class="core-essay-callout" href={`/setouchi-cultural-economic-atlas/book/${aiRegionalPlanningEssay.slug}/`}>
      <div><em>{aiRegionalPlanningEssay.part}</em><strong>{aiRegionalPlanningEssay.title}</strong></div>
      <div><p>{aiRegionalPlanningEssay.subtitle}</p><p>AI時代の地域計画を、未来予測ではなく「観測・比較・修正の速度」という地域能力から考えます。</p></div>
    </a>
  </section>

  <section class="section gene-section">
    <div class="kicker">ESSAY THEMES</div>
    <h2>問いの束から読む</h2>
    <p class="lead">章は分野分類ではなく、地域を見るための問いのまとまりです。自然から形成を読む章と、産業・土地・地域の再編集を考える章を往復してください。</p>
  </section>

  {parts.map((part)=>(
    <section class="section book-part">
      <div class="book-part-title">{part}</div>
      <p class="book-part-dek">{chapterDescriptions[part] || '地域の風景から問いを立て、複数の因果をつないで仮説を組み立てます。'}</p>
      <div class="book-toc-list">
        {allBookArticles.filter((a)=>a.part===part).map((article)=>{
          const photo=articlePhoto(article);
          return (
            <a class="book-toc-item" href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>
              <div class="book-toc-copy"><h2>{article.title}</h2><p>{article.subtitle}</p><div class="book-toc-tags">{article.cities.map((x)=><span>{x}</span>)}</div></div>
              {photo && <img src={photo.imageUrl} alt={photo.alt} loading="lazy" />}
            </a>
          )
        })}
      </div>
    </section>
  ))}

  <section class="learning-band">
    <div class="kicker">FROM ESSAY TO RESEARCH</div>
    <h2>仮説は、更新されるためにある。</h2>
    <p>説得力のある物語ほど、反証可能であることが重要です。エッセイで立てた因果は、研究ノート、データ、現地調査、世界比較を通じて検証し、支持されなければ修正します。その更新速度そのものが、このアトラスの研究品質です。</p>
  </section>
</BaseLayout>