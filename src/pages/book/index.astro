---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { orderedBookArticles } from '../../data/bookArticles.js';
import { photoEvidence } from '../../data/photoEvidence.js';
const photoById=Object.fromEntries(photoEvidence.map((p)=>[p.id,p]));
const articlePhoto=(article)=>{
  const ids=[
    article.heroPhotoId,
    ...article.sections.flatMap((section)=>section.photoIds || [])
  ].filter(Boolean);
  return ids.map((id)=>photoById[id]).find(Boolean) || null;
};
const parts=[...new Set(orderedBookArticles.map((a)=>a.part))];
const editorialFeatures=[
  orderedBookArticles.find((a)=>a.slug==='oysters-taste-of-small-seas'),
  orderedBookArticles.find((a)=>a.slug==='ports-that-needed-waiting'),
  orderedBookArticles.find((a)=>a.slug==='niihama-after-copper')
].filter(Boolean);
const editorialPhotos=editorialFeatures.map(articlePhoto).filter(Boolean);
const leadFeature=editorialFeatures[0] || orderedBookArticles.find((a)=>articlePhoto(a));
const leadPhoto=leadFeature ? articlePhoto(leadFeature) : photoEvidence[0];
const chapterDescriptions={
  '海と陸は、人がつくった':'雨を貯める。海を干す。川を渡る。自然に適応しながら、人は土地そのものをつくり変えてきた。',
  '土地は、何度でも使い直される':'海を干して塩田にし、塩田を工場や住宅へ変え、遊休地を発電所へ変える。土地の形が次の産業と都市をどう呼び込むかを追う。',
  'なぜ、船はここで止まったのか':'潮、風、海峡、港。移動の不便さが、交易と町を生んだ。',
  '食は、土地を語る':'海、川、畑、市場。自然が与えた食材を、人がどう採り、保存し、加工し、地域の味へ変えたのかを追う。',
  '捨てるものは、どこへ行くのか':'カキ殻、魚のアラ、ウロコ、搾り粕。主製品の陰で生まれる副産物を追い、海・農地・飼料・素材へ戻る循環を読む。',
  '産業は、紡がれる':'鉱山が機械を生み、塩田が化学を残し、織物がジーンズへ変わる。前の産業が残した技能・資本・設備が、次の産業へ渡っていく。',
  '富は、町に何を残したのか':'交易や産業で生まれた利益は、寺、町家、白壁、文化へ姿を変えて残っていく。',
  '町は、何度でもつくり直される':'港から鉄道へ、鉄道から道路へ。交通が変わるたびに、都市の中心も組み替えられる。'
};
---
<!-- editorial-index-publish-marker -->
<BaseLayout title="地域エッセイ | 瀬戸内自然文化経済アトラス" description="瀬戸内の地域が、自然・交通・産業・文化の積み重なりからどう形成されたかを読む。">
  <section class="essay-index-cover">
    {leadPhoto && <img class="essay-index-cover-image" src={leadPhoto.imageUrl} alt={leadPhoto.alt} fetchpriority="high" />}
    <div class="essay-index-cover-scrim"></div>

    <div class="essay-index-cover-meta">
      <span>ESSAYS</span>
      <span>瀬戸内自然文化経済アトラス</span>
    </div>

    <div class="essay-index-cover-copy">
      <h1>エッセイ</h1>
      <p class="essay-index-cover-thesis">瀬戸内を、<br/>問いから読む。</p>
      <p class="essay-index-cover-dek">地形、海、交通、生業、技術、資本、食。目の前の風景に「なぜ？」を置くと、地域の成り立ちが一本の物語として見えてきます。</p>
      {leadFeature && (
        <a class="essay-index-feature-link" href={'/setouchi-cultural-economic-atlas/book/' + leadFeature.slug + '/'}>
          <small>FEATURED ESSAY</small>
          <strong>{leadFeature.title}</strong>
          <span>読む →</span>
        </a>
      )}
    </div>

    {leadPhoto && (
      <div class="essay-index-cover-credit">
        <strong>{leadPhoto.title}</strong>
        <span>Photo: {leadPhoto.author} / <a href={leadPhoto.sourcePage} target="_blank" rel="noreferrer">{leadPhoto.license}</a></span>
      </div>
    )}
  </section>

  <section class="essay-index-editorial-strip">
    <div class="essay-index-editorial-intro">
      <span>THIS EDITION</span>
      <strong>海・土地・産業を、別々にしない。</strong>
    </div>
    <div class="essay-index-mini-features">
      {editorialFeatures.slice(1).map((article)=>{
        const photo=articlePhoto(article);
        return (
          <a href={'/setouchi-cultural-economic-atlas/book/' + article.slug + '/'}>
            {photo && <img src={photo.imageUrl} alt={photo.alt} loading="lazy" />}
            <span>{article.part}</span>
            <strong>{article.title}</strong>
          </a>
        )
      })}
    </div>
    <div class="essay-index-tools">
      <a href="/setouchi-cultural-economic-atlas/cities/">都市から探す →</a>
      <a href="/setouchi-cultural-economic-atlas/keywords/">キーワードから探す →</a>
    </div>
  </section>

  <section class="section book-intro">
    <h2>気になる地域や問いから読む</h2>
    <p class="lead">塩田が消えたあと町に何が残ったのか。なぜ今治に造船が集まったのか。なぜ船は鞆や御手洗で止まったのか。地域の風景から問いを立て、地図・写真・史料をたどります。</p>
  </section>

  {parts.map((part)=>(
    <section class="section book-part">
      <div class="book-part-title">{part}</div>\n      <p class="book-part-dek">{chapterDescriptions[part]}</p>
      <div class="book-toc-list">
        {orderedBookArticles.filter((a)=>a.part===part).map((article)=>{
          const photo=articlePhoto(article);
          return (
            <a class="book-toc-item" href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>
              <div class="book-toc-copy">
                <h2>{article.title}</h2>
                <p>{article.subtitle}</p>
                <div class="book-toc-tags">{article.cities.map((x)=><span>{x}</span>)}</div>
              </div>
              {photo && <img src={photo.imageUrl} alt={photo.alt} loading="lazy" />}
            </a>
          )
        })}
      </div>
    </section>
  ))}
</BaseLayout>
