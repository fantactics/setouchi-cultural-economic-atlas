      margin:.65rem 0 0;
      color:var(--muted,#687572);
      font-size:.85rem;
      line-height:1.75;
      text-align:left;
    }
    /* Other images placed directly in Markdown content, including Commons. */
    .markdown-essay-body :global(p > img:only-child),
    .markdown-essay-body :global(p > a:only-child > img:only-child) {
      display:block;
      width:min(100%, 560px);
      max-width:100%;
      max-height:420px;
      height:auto;
      object-fit:contain;
      border-radius:9px;
      margin:0 auto;
    }
    .markdown-essay-body :global(p:has(> img:only-child)),
