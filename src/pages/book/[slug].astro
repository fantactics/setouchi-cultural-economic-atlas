---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EssayGoogleMap from '../../components/EssayGoogleMap.astro';
import EssayProseSections from '../../components/EssayProseSections.astro';
import { selectEssayInlinePhotos } from '../../data/essayReadingPresentation.js';
import EssayPhotoGallery from '../../components/EssayPhotoGallery.astro';
import { orderedBookArticles, bookArticleBySlug } from '../../data/bookArticles.js';
import { cycleTourismEssay } from '../../data/cycleTourismEssay.js';
import { kadaEssays } from '../../data/kadaEssays.js';
import { kadaIndustryEssay } from '../../data/kadaIndustryEssay.js';
import { shimotsuiHijikiEssay } from '../../data/shimotsuiHijikiEssay.js';
import { tomoTwoActPortEssay } from '../../data/tomoTwoActPortEssay.js';
import { portSystemEssays } from '../../data/portSystemEssays.js';
import { niboshiShirasuEssay } from '../../data/niboshiShirasuEssay.js';
import { setouchiSushiEssay } from '../../data/setouchiSushiEssay.js';
import { setouchiShrimpEssay } from '../../data/setouchiShrimpEssay.js';
import { setouchiItinerantTradeBoatsEssay } from '../../data/setouchiItinerantTradeBoatsEssay.js';
import { setouchiShipMaterialsEssay } from '../../data/setouchiShipMaterialsEssay.js';
import { aiRegionalPlanningEssay } from '../../data/aiRegionalPlanningEssay.js';
import { kojimaCircularEssay } from '../../data/kojimaCircularEssay.js';
import { kojimaIslandEssays } from '../../data/kojimaIslandEssays.js';
import { quageoSetouchiEssays } from '../../data/quageoSetouchiEssays.js';
import { photoEvidence } from '../../data/photoEvidence.js';
import { tomoTwoActPortPhotos } from '../../data/tomoTwoActPortPhotos.js';
import { additionalPlacePhotos } from '../../data/additionalPlacePhotos.js';
import { gastronomyPhotoSets } from '../../data/gastronomyPhotos.js';
import { essayPhotoGalleries } from '../../data/essayPhotoGalleries.js';
import { essayPhotoGalleriesMore } from '../../data/essayPhotoGalleriesMore.js';
import { essayPhotoGalleriesExpansion } from '../../data/essayPhotoGalleriesExpansion.js';
import { essayPhotoGalleriesMore2 } from '../../data/essayPhotoGalleriesMore2.js';
import { essayPhotoGalleriesMore3 } from '../../data/essayPhotoGalleriesMore3.js';
import { essayPhotoGalleriesMore4 } from '../../data/essayPhotoGalleriesMore4.js';
import { essayPhotoGalleriesMore5 } from '../../data/essayPhotoGalleriesMore5.js';
import { essayPhotoGalleriesMore6 } from '../../data/essayPhotoGalleriesMore6.js';
import { essayPhotoGalleriesMore7 } from '../../data/essayPhotoGalleriesMore7.js';
import { essayPhotoGalleriesMore8 } from '../../data/essayPhotoGalleriesMore8.js';
import { essayPhotoGalleriesMore9 } from '../../data/essayPhotoGalleriesMore9.js';
import { essayPhotoGalleriesMore10 } from '../../data/essayPhotoGalleriesMore10.js';
import { applyPhotoMetadataCorrection } from '../../data/photoMetadataCorrections.js';
import { enhanceBookArticle } from '../../data/articleEnhancements.js';
import { applyEssayEditorialOverride } from '../../data/essayEditorialOverrides.js';
import { relatedEssaysFor } from '../../data/relatedEssayRecommendations.js';
import { cardTeaser, cardPhotoId } from '../../data/essayCardCopy.js';
import { essayPhotoFieldReferences } from '../../data/essayPhotoFieldReferences.js';
import { essayIndexPhotoOverrides, essayCardPhotoContext } from '../../data/essayIndexPhotos.js';
import { getNaturalConditionTags } from '../../data/naturalEnvironmentTags.js';
import { essaySearchMeta } from '../../data/essaySeo.js';
import { publishedEssays } from '../../data/publishedEssayList.js';
import '../../styles/gastronomy-gallery.css';
import '../../styles/reader-navigation.css';

const markdownModules=import.meta.glob('../../content/essays/*.md',{eager:true});
const markdownBySlug=Object.fromEntries(Object.entries(markdownModules).map(([file,module])=>[file.split('/').pop().replace(/\.md$/,''),module]));

export function getStaticPaths(){
  const publishedBookArticles=[...orderedBookArticles,...kadaEssays,kadaIndustryEssay,cycleTourismEssay,shimotsuiHijikiEssay,tomoTwoActPortEssay,...portSystemEssays,kojimaCircularEssay,...kojimaIslandEssays,...quageoSetouchiEssays,niboshiShirasuEssay,setouchiSushiEssay,setouchiShrimpEssay,setouchiItinerantTradeBoatsEssay,setouchiShipMaterialsEssay,aiRegionalPlanningEssay].filter(Boolean);
  const archivedBookArticles=['tadano-shido-industrial-ecosystem','miura-matsuyama-small-boiler-revolution'].map((slug)=>bookArticleBySlug[slug]).filter(Boolean);
  return [
    ...publishedBookArticles.map((article,index)=>({
      params:{slug:article.slug},
      props:{article,prev:index>0?publishedBookArticles[index-1]:null,next:index<publishedBookArticles.length-1?publishedBookArticles[index+1]:null}
    })),
    ...archivedBookArticles.map((article)=>({
      params:{slug:article.slug},
      props:{article,prev:null,next:null}
    }))
  ];
}

const { article:rawArticle, prev, next }=Astro.props;
const enhancedArticle=applyEssayEditorialOverride(enhanceBookArticle(rawArticle));
const markdownModule=markdownBySlug[enhancedArticle.slug] || null;
const article=markdownModule
  ? {...enhancedArticle,...markdownModule.frontmatter,sections:enhancedArticle.sections}
  : enhancedArticle;
const MarkdownContent=markdownModule?.Content || null;
const seo=essaySearchMeta(article);
const naturalTags=getNaturalConditionTags(article);
const archivedResearchHref={
  'tadano-shido-industrial-ecosystem':'/setouchi-cultural-economic-atlas/chapters/tadano-shido-industrial-ecosystem-note/',
  'miura-matsuyama-small-boiler-revolution':'/setouchi-cultural-economic-atlas/chapters/miura-matsuyama-boiler-note/'
}[article.slug] || null;
const isTravelogue=article.narrativeMode==='travelogue';
const isNarrativeEssay=isTravelogue || article.narrativeMode==='sketch';
const usesNarrativeEnding=new Set(['mihara-castle-to-multimodal-city','kojima-jeans-circular-economy','setouchi-ship-materials', 'setouchi-sushi-not-nigiri','niihama-after-copper','shimonoseki-resource-made-by-market','faith-as-transport-map','matsuyama-three-centers-one-city','mitarai-economy-of-waiting','onomichi-capital-to-culture-and-ships','takehara-salt-capital-to-townscape','sakaide-salt-fields-to-industry','ako-after-salt-fields','sanuki-store-the-rain','iwakuni-river-city','mikan-slope-and-varieties','four-salt-fields']).has(article.slug);
const allPhotoEvidence=[...photoEvidence,...tomoTwoActPortPhotos,...Object.values(additionalPlacePhotos).flat()].map(applyPhotoMetadataCorrection);
const photoById=Object.fromEntries(allPhotoEvidence.map((p)=>[p.id,p]));
const relatedEssays=archivedResearchHref ? [] : relatedEssaysFor(article,publishedEssays,3)
  .map((item)=>{
    // Match editorial cover choices used on the essay-index page.
    const card=photoById[cardPhotoId(item)];
    const image=essayIndexPhotoOverrides[item.slug]?.imageUrl
      ? essayIndexPhotoOverrides[item.slug]
      : card?.imageUrl ? card
      : item.heroPhoto?.imageUrl ? item.heroPhoto
      : (item.sections||[]).flatMap((section)=>section.photoIds||[])
          .map((id)=>photoById[id]).find((photo)=>photo?.imageUrl) || null;
    return {...item,photo:image,photoContext:essayCardPhotoContext[item.slug] || null,teaser:cardTeaser(item)};
  });

const hero=article.heroPhoto?.imageUrl ? article.heroPhoto : photoById[article.heroPhotoId];
const inlinePhotos=selectEssayInlinePhotos(article,photoById,hero);
const inlinePhotoUrls=new Set(Object.values(inlinePhotos).map((photo)=>photo.imageUrl));
const photoFieldReferences=essayPhotoFieldReferences[article.slug] || [];
const isKojimaIslandEssay=kojimaIslandEssays.some((item)=>item.slug===article.slug);
const kojimaSeriesLinks=kojimaIslandEssays.map((item)=>({title:item.title,href:`/setouchi-cultural-economic-atlas/book/${item.slug}/`,current:item.slug===article.slug}));
const contextualResearchLinks=isKojimaIslandEssay
  ? [
      {label:'研究ノート｜人口ではなく、島の利用強度を測る',href:'/setouchi-cultural-economic-atlas/chapters/island-use-intensity/'},
      ...(article.slug==='kojima-island-cycling-without-consumption'?[{label:'研究ノート｜自転車は、島を変えたか',href:'/setouchi-cultural-economic-atlas/chapters/cycle-tourism-regional-impact/'}]:[])
    ]
  : (article.researchLinks||[]);

const rawEssayPhotos=[
  ...(article.photoGallery||[]),
  ...(essayPhotoGalleries[article.slug]||[]),...(essayPhotoGalleriesMore[article.slug]||[]),...(essayPhotoGalleriesExpansion[article.slug]||[]),
  ...(essayPhotoGalleriesMore2[article.slug]||[]),...(essayPhotoGalleriesMore3[article.slug]||[]),...(essayPhotoGalleriesMore4[article.slug]||[]),
  ...(essayPhotoGalleriesMore5[article.slug]||[]),...(essayPhotoGalleriesMore6[article.slug]||[]),...(essayPhotoGalleriesMore7[article.slug]||[]),
  ...(essayPhotoGalleriesMore8[article.slug]||[]),...(essayPhotoGalleriesMore9[article.slug]||[]),...(essayPhotoGalleriesMore10[article.slug]||[])
];
const essayPhotos=rawEssayPhotos.map((entry)=>entry && entry.photoId ? {...photoById[entry.photoId],...entry} : entry).map(applyPhotoMetadataCorrection).filter((entry)=>entry && entry.imageUrl);
const isGastronomy=article.part==='食は、土地を語る';
const gastronomyPhotos=(gastronomyPhotoSets[article.slug]||[]).map((entry)=>entry.photoId ? photoById[entry.photoId] : entry).map(applyPhotoMetadataCorrection).filter(Boolean);
const placeLinkByName={'赤穂':'ako','竹原':'takehara','坂出':'sakaide','防府（三田尻）':'hofu','三田尻':'hofu','児島':'shimotsui','下津井':'shimotsui','倉敷':'shimotsui','鞆の浦':'tomonoura','鞆':'tomonoura','御手洗':'mitarai','多度津':'tadotsu','尾道':'onomichi','今治':'imabari','波止浜':'imabari','来島海峡':'imabari','大三島':'imabari','新居浜':'niihama','別子':'niihama','東平':'niihama','小豆島':'shodoshima','牛窓':'ushimado','高松':'takamatsu','松山':'matsuyama','三原':'mihara','下関':'shimonoseki','柳井':'yanai','引田':'hiketa','丸亀':'marugame','岩国':'iwakuni','加太':'kada','鳴門':'naruto','明石':'akashi','鴻島':'hinase','日生':'hinase'};
const cityLinks=article.cities.map((name)=>({name,href:placeLinkByName[name]?`/setouchi-cultural-economic-atlas/places/${placeLinkByName[name]}/`:`/setouchi-cultural-economic-atlas/cities/#${encodeURIComponent(name)}`}));
const sections=article.sections.map((section,index)=>({
  ...section,
  number:String(index+1).padStart(2,'0')
}));
const sectionPhotos=article.sections.flatMap((section)=>section.photoIds||[])
  .map((id)=>photoById[id]).filter((photo)=>photo?.imageUrl);
const distinctPhotoKeys=new Set();
const appendixPhotos=sectionPhotos.filter((photo)=>{
  const key=photo.imageUrl||photo.sourcePage||photo.id;
  if(!key||distinctPhotoKeys.has(key)||photo.imageUrl===hero?.imageUrl||inlinePhotoUrls.has(photo.imageUrl)) return false;
  distinctPhotoKeys.add(key);return true;
});
const supplementaryPhotos=essayPhotos.filter((photo)=>{
  const key=photo.imageUrl||photo.sourcePage||photo.id;
  if(!key||distinctPhotoKeys.has(key)||photo.imageUrl===hero?.imageUrl||inlinePhotoUrls.has(photo.imageUrl)) return false;
  distinctPhotoKeys.add(key);return true;
});
const foodPhotos=gastronomyPhotos.filter((photo)=>{
  const key=photo.imageUrl||photo.sourcePage||photo.id;
  if(!key||distinctPhotoKeys.has(key)||photo.imageUrl===hero?.imageUrl||inlinePhotoUrls.has(photo.imageUrl)) return false;
  distinctPhotoKeys.add(key);return true;
});
---
<BaseLayout title={`${article.title} | 地域エッセイ`} seoTitle={seo.title} description={seo.description} image={hero?.imageUrl} imageAlt={hero?.alt || article.title}>
  <article class="book-article">
    {archivedResearchHref && <section class="book-open-questions">
      <div class="kicker">資料保存版</div>
      <p>この記事は、企業沿革と技術史の資料性を保つため旧URLに保存しています。現在の掲載区分は研究ノートです。</p>
      <div class="chapter-related-grid"><a class="compare-button" href={archivedResearchHref}>研究ノート版を読む →</a></div>
    </section>}
    <div class="reader-book-back"><a href="/setouchi-cultural-economic-atlas/book/">← エッセイ一覧に戻る</a></div>
    <header class="book-article-header">
      <div class="book-article-series">{isKojimaIslandEssay ? '鴻島シリーズ' : article.part}</div>
      <h1>{article.title}</h1>
      <p class="book-article-subtitle">{article.subtitle}</p>
      <p class="book-article-dek">{article.lead}</p>
      <div class="book-meta-row">
        <div>{cityLinks.map((item)=><a href={item.href}>{item.name}</a>)}</div>
        <div class="reader-nature-tags" aria-label="このエッセイを貫く自然条件">
          {naturalTags.length>0 ? (<>
            <span class="reader-nature-tags-label">自然条件</span>
            {naturalTags.map((tag)=><a href={`/setouchi-cultural-economic-atlas/book/nature/#nature-${encodeURIComponent(tag)}`}>#{tag}</a>)}
          </>) : <a class="reader-nature-tags-index-link" href="/setouchi-cultural-economic-atlas/book/nature/">自然条件からほかのエッセイを探す</a>}
        </div>
      </div>
    </header>

    {hero && <figure class="book-hero-photo"><img src={hero.imageUrl} alt={hero.alt} /><figcaption><strong>{hero.title}</strong>　{hero.caption}{!article.omitPhotoCredits && <span>{hero.kind==='illustration'?'Illustration: ':'Photo: '}{hero.author} / <a href={hero.sourcePage} target="_blank" rel="noreferrer">{hero.license}</a></span>}</figcaption></figure>}
    {article.slug==='tai-meshi-two-seas' && (
      <section class="tai-meshi-photo-pair" aria-labelledby="tai-meshi-compare-heading">
        <div class="tai-meshi-pair-heading">
          <span>二つのルーツ、二つの食卓</span>
          <h2 id="tai-meshi-compare-heading">鯛を分け合う飯と、漁師の一膳</h2>
          <p>同じ鯛と米でも、祝いの席と漁の現場に伝わる食べ方は、調理も盛り付けも違います。</p>
        </div>
        <div class="tai-meshi-photo-grid">
          <figure>
            <img src="https://commons.wikimedia.org/wiki/Special:FilePath/%E9%AF%9B%E3%82%81%E3%81%97%EF%BC%88%E4%BB%8A%E6%B2%BB%E9%A7%85%EF%BC%8920220111-P1300537.jpg?width=780" alt="今治駅で販売された炊き込み型の鯛めしの写真" loading="lazy" />
            <figcaption>
              <strong>今治・北条の鯛めし｜祝いの席にもつながる料理</strong>
              <span>鯛を米と一緒に炊き、身をほぐして取り分ける。鯛を献上したという北条鹿島の伝承や、一尾を囲む食卓の文化につながる。写真は今治駅で販売された炊き込み型の一例。</span>
              <small>写真：くろふね / <a href="https://commons.wikimedia.org/wiki/File:%E9%AF%9B%E3%82%81%E3%81%97%EF%BC%88%E4%BB%8A%E6%B2%BB%E9%A7%85%EF%BC%8920220111-P1300537.jpg" target="_blank" rel="noreferrer">Wikimedia Commons</a>（<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">CC BY 4.0</a>）</small>
            </figcaption>
          </figure>
          <figure>
            <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Uwajima%20Taimeshi.jpg?width=780" alt="生の鯛の刺身とたれを白いご飯に合わせる宇和島鯛めしの写真" loading="lazy" />
            <figcaption>
              <strong>宇和島の鯛めし｜船上の漁師めしに由来する料理</strong>
              <span>鯛の刺身を卵入りのたれにからめ、自分のご飯へかける。生魚の食感を生かす、一人分ずつの食べ方。写真は松山市の店舗で提供された宇和島式。</span>
              <small>写真：Fred Cherrygarden / <a href="https://commons.wikimedia.org/wiki/File:Uwajima_Taimeshi.jpg" target="_blank" rel="noreferrer">Wikimedia Commons</a>（<a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noreferrer">CC BY-SA 4.0</a>）</small>
            </figcaption>
          </figure>
        </div>
      </section>
    )}
    {photoFieldReferences.length>0 && <nav class="reader-photo-evidence" aria-label="記事に登場する実物・史料の写真へのリンク">
      <span class="reader-photo-evidence-heading">実物の写真も見る</span>
      {photoFieldReferences.map((reference)=><div class="reader-photo-evidence-item">
        <a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.label} <span aria-hidden="true">↗</span></a>
        <span class="reader-photo-evidence-publisher">{reference.publisher}</span>
        <p>{reference.note}</p>
      </div>)}
    </nav>}

    {isKojimaIslandEssay && <section class="book-open-questions">
      <div class="kicker">鴻島シリーズ</div>
      <p>別荘地として開発された小島を、公共インフラ、観光、住宅ストック、所有と利用の変化から読みます。</p>
      <div class="chapter-related-grid">
        {kojimaSeriesLinks.map((item)=><a class:list={['compare-button',item.current&&'secondary']} href={item.href}>{item.current?'現在の記事｜':''}{item.title} →</a>)}
        <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/places/hinase/">地域ページ｜日生・鴻島 →</a>
      </div>
    </section>}

    <div class="book-reading-column">
      <EssayGoogleMap article={article} />
      {article.slug==='takamatsu-sea-castle-to-gateway' && (
        <section class="reader-landscape-map" aria-labelledby="takamatsu-landscape-map-title">
          <div class="kicker">地図で見る自然条件</div>
          <h2 id="takamatsu-landscape-map-title">城と港の間に生まれた土地</h2>
          <p>航空写真に切り替え、玉藻公園の北側から高松港、JR高松駅、サンポートまでを見渡してみてください。現在は陸地ですが、城が築かれた頃は海に面していました。地図は現在の海岸線を示しており、江戸時代の海岸線ではありません。</p>
          <div class="reader-landscape-map-frame">
            <iframe
              title="高松城跡と高松港の位置関係を示すGoogleマップ"
              src="https://www.google.com/maps?q=34.352%2C134.052&z=15&t=k&output=embed"
              width="100%"
              height="370"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <p class="reader-landscape-map-source">地図：Google マップ（現在の航空写真）。過去の海岸線の復元図ではありません。</p>
        </section>
      )}
      {article.slug==='hiketa-castle-port-town' && (
        <section class="reader-landscape-map" aria-labelledby="hiketa-landscape-map-title">
          <div class="kicker">地図で見る自然条件</div>
          <h2 id="hiketa-landscape-map-title">城山の岬が抱く、引田の港</h2>
          <p>地図を動かすと、標高82メートルの城山が海へ突き出し、その西側に港と町が寄り添う様子が見えます。航空写真表示に切り替えると、岬の形がよりはっきりわかります。</p>
          <div class="reader-landscape-map-frame">
            <iframe
              title="引田城跡・城山と引田港の位置関係を示すGoogleマップ"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3298.5594693697603!2d134.406110597845!3d34.234265102236975!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x355377d0222ea119:0x99a068599c9dce81!2z5byV55Sw5Z-O6Leh!5e0!3m2!1sja!2sjp!4v1652429091454!5m2!1sja!2sjp"
              width="100%"
              height="370"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <p class="reader-landscape-map-source">地図：Google マップ（<a href="https://higashikagawa.net/sightseeing/hiketajo" target="_blank" rel="noopener noreferrer">東かがわ市観光情報サイト掲載の地図</a>を利用）</p>
        </section>
      )}
      {article.slug==='matsuyama-three-centers-one-city' && (
        <section class="reader-landscape-map" aria-labelledby="matsuyama-harbors-map-title">
          <div class="kicker">地図で見る自然条件</div>
          <h2 id="matsuyama-harbors-map-title">三津浜の河口と、北の高浜港</h2>
          <p>航空写真を拡大すると、三津浜の河口に沿って伸びる町と、北の高浜港が近い距離にありながら違う海岸の形をしていることがわかります。地図を動かし、汽船が寄る港が移った理由を地形から考えてみてください。</p>
          <div class="reader-landscape-map-frame">
            <iframe
              title="三津浜・宮前川河口と高浜港の航空写真（Googleマップ）"
              src="https://maps.google.com/maps?ll=33.8745,132.7075&z=13&t=k&output=embed"
              width="100%"
              height="370"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <p class="reader-landscape-map-source">地図：Google マップ（航空写真）。<a href="https://www.google.com/maps/search/?api=1&query=%E4%B8%89%E6%B4%A5%E3%81%AE%E6%B8%A1%E3%81%97+%E6%9D%BE%E5%B1%B1" target="_blank" rel="noopener noreferrer">三津の渡し</a>／<a href="https://www.google.com/maps/search/?api=1&query=%E9%AB%98%E6%B5%9C%E6%B8%AF+%E6%9D%BE%E5%B1%B1" target="_blank" rel="noopener noreferrer">高浜港</a>を地図で開く</p>
        </section>
      )}
      {article.slug==='yanai-trade-profit-to-whitewalls' && (
        <section class="reader-landscape-map" aria-labelledby="yanai-town-river-map-title">
          <div class="kicker">地図で見る自然条件</div>
          <h2 id="yanai-town-river-map-title">柳井川と、二百メートルの商家町</h2>
          <p>航空写真で古市・金屋の白壁の町並みを見つけ、南側を流れる柳井川との距離や、川へつながる小路をたどってみてください。現在の水路と道筋から、かつての港町の位置関係を読み取れます。</p>
          <div class="reader-landscape-map-frame">
            <iframe
              title="柳井市古市・金屋の白壁の町並みと柳井川の航空写真（Googleマップ）"
              src="https://maps.google.com/maps?q=%E6%9F%B3%E4%BA%95%E5%B8%82%E5%8F%A4%E5%B8%82%E9%87%91%E5%B1%8B&t=k&z=16&output=embed"
              width="100%"
              height="370"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <p class="reader-landscape-map-source">地図：Google マップ（航空写真）。<a href="https://www.google.com/maps/search/?api=1&query=%E6%9F%B3%E4%BA%95%E5%B8%82%E5%8F%A4%E5%B8%82%E9%87%91%E5%B1%8B" target="_blank" rel="noopener noreferrer">大きな地図で見る</a></p>
        </section>
      )}
      {article.slug==='niihama-after-copper' && (
        <section class="reader-landscape-map" aria-labelledby="niihama-mountains-to-sea-map-title">
          <div class="kicker">航空写真で、山と海を見る</div>
          <h2 id="niihama-mountains-to-sea-map-title">東平の山から、惣開・新居浜港へ</h2>
          <p>南東の山中に残る東平の貯鉱庫跡と、北西の海辺に広がる工場・港を、同じ航空写真で見比べてみてください。谷の出口に端出場があり、山の鉱山と海辺の製錬拠点を結ぶ輸送が新居浜の産業の位置を変えました。現在の地形・土地利用を示す地図で、当時の鉄道の正確な経路を復元したものではありません。</p>
          <div class="reader-landscape-map-frame">
            <iframe
              title="別子銅山東平から新居浜港まで、山地と臨海工業地帯の位置関係を示す航空写真（Googleマップ）"
              src="https://maps.google.com/maps?ll=33.927,133.309&z=11&t=k&output=embed"
              width="100%"
              height="370"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <p class="reader-landscape-map-source">地図：Google マップ（現在の航空写真）。<a href="https://www.google.com/maps/search/?api=1&query=%E5%88%A5%E5%AD%90%E9%8A%85%E5%B1%B1%20%E6%9D%B1%E5%B9%B3" target="_blank" rel="noopener noreferrer">東平の貯鉱庫跡</a>／<a href="https://www.google.com/maps/search/?api=1&query=%E6%96%B0%E5%B1%85%E6%B5%9C%E6%B8%AF%E6%9C%AC%E6%B8%AF" target="_blank" rel="noopener noreferrer">新居浜港本港</a></p>
        </section>
      )}
      {MarkdownContent
        ? <div class="markdown-essay-body"><MarkdownContent /></div>
        : <EssayProseSections article={article} showNumbers={!isNarrativeEssay} inlinePhotos={inlinePhotos} />}

      {article.originalPhotoSequence?.length>0 && <section class="quageo-own-photo-sequence" aria-label="旅の写真">
        <h2>旅の写真</h2>
        <div class="quageo-own-photo-grid">{article.originalPhotoSequence.map((photo)=><figure>
          <img src={photo.imageUrl} alt={photo.alt||photo.title} loading="lazy" decoding="async" />
          <figcaption><strong>{photo.title}</strong><span>{photo.caption}</span></figcaption>
        </figure>)}</div>
      </section>}
      {contextualResearchLinks.length>0 && <section class="book-open-questions"><div class="kicker">もっと深く知りたくなったら</div><p>エッセイでは視点と仮説を簡潔に示しています。詳しい論証、比較表、年代・統計は研究ノートとデータページに分けています。</p><div class="chapter-related-grid">{contextualResearchLinks.map((item,index)=><a class:list={['compare-button',index>0&&'secondary']} href={item.href}>{item.label} →</a>)}</div></section>}
      {!article.omitPhotoCredits && article.sources?.length>0 && <section class="book-sources"><div class="kicker">出典・参照資料</div><ol>{article.sources.map((source)=><li id={`source-${source.id}`}><a href={source.url} target="_blank" rel="noreferrer">{source.title}</a><span>{source.publisher}</span></li>)}</ol></section>}
    </div>

    {(appendixPhotos.length>0 || supplementaryPhotos.length>0 || (isGastronomy && foodPhotos.length>0)) && <section class="reader-photo-appendix" aria-label="記事の写真">
      <h2>旅の写真帳</h2>
      <p>本文に登場した土地や仕事を、写真でたどります。比較用の写真には説明を添えています。</p>
      {appendixPhotos.length>0 && <div class="reader-photo-appendix-grid">{appendixPhotos.map((photo)=><figure>
        <a href={photo.sourcePage||photo.imageUrl} target="_blank" rel="noreferrer"><img src={photo.imageUrl} alt={photo.alt||photo.title} loading="lazy" /></a>
        <figcaption><strong>{photo.title}</strong>{photo.caption && <span>{photo.caption}</span>}{photo.insight && <span>写真から考える：{photo.insight}</span>}<small>Photo: {photo.author||'出典参照'} / <a href={photo.licenseUrl||photo.sourcePage||photo.imageUrl} target="_blank" rel="noreferrer">{photo.license||'出典'}</a></small></figcaption>
      </figure>)}</div>}
    </section>}
        {supplementaryPhotos.length>0 && <EssayPhotoGallery photos={supplementaryPhotos} title={isTravelogue ? "写真でたどる小魚の旅" : `${article.cities[0] || '地域'}を写真で読む`} description={isTravelogue ? "魚の姿、加工の仕事、食卓の一皿。海沿いの旅を、写真でもたどってみる。" : undefined} />}

    {isGastronomy && foodPhotos.length>0 && <section class="gastronomy-photo-atlas" aria-label="料理と食材の写真">
      <div class="gastronomy-photo-head"><div><span>FOOD / INGREDIENTS</span><h2>料理と食材から読む</h2></div><p>風景だけでなく、食材そのもの、料理の完成形、生産・加工の場を並べます。土地の自然条件が、人の仕事と調理を介してどのような「食べられる形」へ変わったのかを写真から追います。</p></div>
      <div class="gastronomy-photo-mosaic">{foodPhotos.map((photo,index)=><figure class:list={['gastronomy-photo-card',index===0&&'feature']}><a href={photo.sourcePage} target="_blank" rel="noreferrer"><img src={photo.imageUrl} alt={photo.alt} loading="lazy" /></a><figcaption><strong>{photo.title}</strong><span>{photo.caption}</span>{photo.insight && <em>写真から考える：{photo.insight}</em>}<small>Photo: {photo.author} / <a href={photo.licenseUrl || photo.sourcePage} target="_blank" rel="noreferrer">{photo.license}</a></small></figcaption></figure>)}</div>
      <p class="gastronomy-photo-note">「比較資料」と記した写真は、当該地域で撮影されたものではなく、食材・料理法・作業形態を比較するために掲載しています。</p>
    </section>}


    {relatedEssays.length>0 && <section class="reader-related-essays" aria-labelledby="reader-related-title">
      <div class="reader-related-head">
        <div><span>READ NEXT</span><h2 id="reader-related-title">次は、どの風景を旅する？</h2><p>今読んだ物語から、瀬戸内の別の一篇へ。</p></div>
        <a href="/setouchi-cultural-economic-atlas/book/">すべてのエッセイを見る →</a>
      </div>
      <div class="reader-related-grid">
        {relatedEssays.map((item)=><a class="reader-related-card" href={`/setouchi-cultural-economic-atlas/book/${item.slug}/`}>
          {item.photo?.imageUrl && <img src={item.photo.imageUrl} alt={item.photo.alt||item.title} loading="lazy" />}
          <div><span>{item.relatedReason}{item.cities?.length ? ` ・ ${item.cities.slice(0,2).join('・')}` : ''}</span><h3>{item.title}</h3><p>{item.teaser}</p>{item.photoContext && <small class="reader-related-photo-note">写真：{item.photoContext}</small>}<strong>読む →</strong></div>
        </a>)}
      </div>
    </section>}

    <nav class="book-pager">
      {prev ? <a href={`/setouchi-cultural-economic-atlas/book/${prev.slug}/`}><small>← 前の記事</small><strong>{prev.title}</strong></a> : <span></span>}
      {next ? <a class="next" href={`/setouchi-cultural-economic-atlas/book/${next.slug}/`}><small>次の記事 →</small><strong>{next.title}</strong></a> : <span></span>}
    </nav>

  <style>
    .quageo-own-photo-sequence{max-width:1060px;margin:3.25rem auto;padding:0 1rem;}
    .quageo-own-photo-sequence h2{font-size:clamp(1.3rem,2.8vw,1.85rem);margin:0 0 1.25rem;}
    .quageo-own-photo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:1.5rem;}
    .quageo-own-photo-grid figure{margin:0;min-width:0;}
    .quageo-own-photo-grid img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:9px;}
    .quageo-own-photo-grid figcaption{display:flex;flex-direction:column;gap:.4rem;margin-top:.7rem;line-height:1.75;font-size:.89rem;}
    .quageo-own-photo-grid figcaption span{color:var(--muted,#666);}
    .markdown-essay-body :global(h2){margin:3.4rem 0 1.25rem;font-size:clamp(1.45rem,2.6vw,2rem);line-height:1.45;letter-spacing:.02em;}
    .markdown-essay-body :global(p){margin:0 0 1.4rem;line-height:2.05;}
    /* Markdown-native citation links remain clickable after Pages CMS editing. */
    .markdown-essay-body :global(a[href^="#source-"]){font-size:.72em;vertical-align:super;line-height:0;margin-left:.15em;white-space:nowrap;}

    .reader-landscape-map{margin:1rem 0 2.6rem;}
    .reader-landscape-map h2{font-size:clamp(1.3rem,2.7vw,1.8rem);line-height:1.4;margin:.5rem 0 .75rem;}
    .reader-landscape-map p{line-height:1.8;margin:0 0 1rem;}
    .reader-landscape-map-frame{border-radius:12px;overflow:hidden;border:1px solid rgba(80,80,80,.18);background:#eee;}
    .reader-landscape-map iframe{display:block;width:100%;border:0;min-height:330px;}
    .reader-landscape-map-source{font-size:.77rem;color:var(--muted,#777);margin:.65rem 0 0!important;}
    .reader-landscape-map-source a{color:inherit;text-decoration:underline;}
    @media(max-width:600px){.reader-landscape-map iframe{height:300px;min-height:300px;}}
    .reader-nature-tags{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem .55rem;max-width:100%;}
    .reader-nature-tags-label{font-size:.76rem;letter-spacing:.06em;color:var(--muted,#777);font-weight:600;margin-right:.1rem;}
    .reader-nature-tags a{display:inline-block;padding:.17rem .65rem;border-radius:999px;border:1px solid color-mix(in srgb, currentColor 19%, transparent);font-size:.8rem;text-decoration:none;line-height:1.7;}
    .reader-nature-tags a:hover,.reader-nature-tags a:focus-visible{border-color:currentColor;text-decoration:underline;}
    .reader-nature-tags .reader-nature-tags-index-link{border:none;border-radius:0;padding:0;text-decoration:underline;}
    .tai-meshi-photo-pair{max-width:1080px;margin:2.5rem auto 3rem;padding:0 1.5rem;}
    .tai-meshi-pair-heading{margin-bottom:1.3rem;}
    .tai-meshi-pair-heading>span{font-size:.74rem;letter-spacing:.12em;color:var(--muted,#777);}
    .tai-meshi-pair-heading h2{font-size:clamp(1.45rem,3.3vw,2.2rem);margin:.5rem 0 .7rem;line-height:1.35;}
    .tai-meshi-pair-heading p{line-height:1.85;margin:0;max-width:720px;}
    .tai-meshi-photo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;align-items:start;}
    .tai-meshi-photo-grid figure{margin:0;min-width:0;}
    .tai-meshi-photo-grid img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:4px;}
    .tai-meshi-photo-grid figcaption{display:flex;flex-direction:column;gap:.65rem;padding:.9rem .1rem 0;line-height:1.75;}
    .tai-meshi-photo-grid figcaption strong{font-size:1.05rem;line-height:1.5;}
    .tai-meshi-photo-grid figcaption span{font-size:.94rem;}
    .tai-meshi-photo-grid figcaption small{font-size:.75rem;color:var(--muted,#777);}
    .tai-meshi-photo-grid figcaption small a{color:inherit;text-decoration:underline;}
    @media(max-width:680px){.tai-meshi-photo-grid{grid-template-columns:1fr;gap:2rem;}}
  </style>
  </article>
</BaseLayout>