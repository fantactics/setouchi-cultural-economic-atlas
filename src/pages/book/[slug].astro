---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { bookArticles } from '../../data/bookArticles.js';
import { photoEvidence } from '../../data/photoEvidence.js';

export function getStaticPaths(){
  return bookArticles.map((article,index)=>({
    params:{slug:article.slug},
    props:{
      article,
      prev:index>0?bookArticles[index-1]:null,
      next:index<bookArticles.length-1?bookArticles[index+1]:null
    }
  }));
}
const { article, prev, next }=Astro.props;
const photoById=Object.fromEntries(photoEvidence.map((p)=>[p.id,p]));
const hero=photoById[article.heroPhotoId];
const sourceById=Object.fromEntries(article.sources.map((s)=>[s.id,s]));
const placeLinkByName = {
  '赤穂':'ako',
  '竹原':'takehara',
  '坂出':'sakaide',
  '防府（三田尻）':'hofu',
  '三田尻':'hofu',
  '児島':'shimotsui',
  '下津井':'shimotsui',
  '倉敷':'shimotsui',
  '鞆の浦':'tomonoura',
  '鞆':'tomonoura',
  '御手洗':'mitarai',
  '多度津':'tadotsu',
  '尾道':'onomichi',
  '今治':'imabari',
  '波止浜':'imabari',
  '来島海峡':'imabari',
  '新居浜':'niihama',
  '別子':'niihama',
  '東平':'niihama',
  '小豆島':'shodoshima',
  '牛窓':'ushimado',
  '高松':'takamatsu',
  '丸亀':'marugame',
  '岩国':'iwakuni'
};
---
<BaseLayout title={`${article.title} | 地域の物語`} description={article.subtitle}>
  <article class="book-article">
    <header class="book-article-header">
      <div class="book-article-series">{article.part}</div>
      <h1>{article.title}</h1>
      <p class="book-article-subtitle">{article.subtitle}</p>
      <p class="book-article-dek">{article.lead}</p>
      <div class="book-meta-row">
        <div>{article.cities.map((x)=>{
          const placeId=placeLinkByName[x];
          return <a href={placeId ? `/setouchi-cultural-economic-atlas/places/${placeId}/` : `/setouchi-cultural-economic-atlas/cities/#${encodeURIComponent(x)}`}>{x}</a>;
        })}</div>
        <div>{article.keywords.slice(0,6).map((x)=><a href={`/setouchi-cultural-economic-atlas/keywords/#${encodeURIComponent(x)}`}>#{x}</a>)}</div>
      </div>
    </header>

    {hero && (
      <figure class="book-hero-photo">
        <img src={hero.imageUrl} alt={hero.alt} />
        <figcaption>
          <strong>{hero.title}</strong>　{hero.caption}
          <span>Photo: {hero.author} / <a href={hero.sourcePage} target="_blank" rel="noreferrer">{hero.license}</a></span>
        </figcaption>
      </figure>
    )}

    <div class="book-reading-column">
      {article.sections.map((section,sectionIndex)=>(
        <section class="book-prose-section">
          <div class="book-section-no">{String(sectionIndex+1).padStart(2,'0')}</div>
          <h2>{section.heading}</h2>
          {section.paragraphs.slice(0, Math.max(1, Math.ceil(section.paragraphs.length/2))).map((p)=>(
            <p>
              {p.text}
              {p.refs?.length>0 && <sup class="book-footnotes">{p.refs.map((ref)=><a href={`#source-${ref}`}>[{ref}]</a>)}</sup>}
            </p>
          ))}
          {section.photoIds?.length>0 && (() => {
            const photo=photoById[section.photoIds[0]];
            if(!photo) return null;
            return (
              <figure class="book-photo-break">
                <a href={photo.sourcePage} target="_blank" rel="noreferrer"><img src={photo.imageUrl} alt={photo.alt} loading="lazy" /></a>
                <figcaption>
                  <strong>{photo.title}</strong>
                  <span>{photo.caption}</span>
                  <em>写真から考える：{photo.insight}</em>
                  <small>Photo: {photo.author} / <a href={photo.licenseUrl} target="_blank" rel="noreferrer">{photo.license}</a></small>
                </figcaption>
              </figure>
            );
          })()}
          {section.paragraphs.slice(Math.max(1, Math.ceil(section.paragraphs.length/2))).map((p)=>(
            <p>
              {p.text}
              {p.refs?.length>0 && <sup class="book-footnotes">{p.refs.map((ref)=><a href={`#source-${ref}`}>[{ref}]</a>)}</sup>}
            </p>
          ))}
          {section.photoIds?.length>1 && (
            <div class:list={['book-inline-photos',section.photoIds.length===2&&'single']}>
              {section.photoIds.slice(1).map((id)=>{
                const photo=photoById[id];
                if(!photo) return null;
                return (
                  <figure>
                    <a href={photo.sourcePage} target="_blank" rel="noreferrer"><img src={photo.imageUrl} alt={photo.alt} loading="lazy" /></a>
                    <figcaption>
                      <strong>{photo.title}</strong>
                      <span>{photo.caption}</span>
                      <em>写真から考える：{photo.insight}</em>
                      <small>Photo: {photo.author} / <a href={photo.licenseUrl} target="_blank" rel="noreferrer">{photo.license}</a></small>
                    </figcaption>
                  </figure>
                )
              })}
            </div>
          )}
        </section>
      ))}

      <section class="book-small-conclusion">
        <div class="kicker">暫定的なまとめ</div>
        <p>{article.provisionalConclusion}</p>
      </section>

      <section class="book-open-questions">
        <div class="kicker">まだ分からないこと</div>
        <ul>{article.openQuestions.map((q)=><li>{q}</li>)}</ul>
      </section>

      <section class="book-sources">
        <div class="kicker">出典・参照資料</div>
        <ol>
          {article.sources.map((source)=>(
            <li id={`source-${source.id}`}>
              <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
              <span>{source.publisher}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <nav class="book-pager">
      {prev ? <a href={`/setouchi-cultural-economic-atlas/book/${prev.slug}/`}><small>← 前の記事</small><strong>{prev.title}</strong></a> : <span></span>}
      {next ? <a class="next" href={`/setouchi-cultural-economic-atlas/book/${next.slug}/`}><small>次の記事 →</small><strong>{next.title}</strong></a> : <span></span>}
    </nav>
  </article>
</BaseLayout>
