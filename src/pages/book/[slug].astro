    .markdown-essay-body :global(p){margin:0 0 1.4rem;line-height:2.05;}
    .markdown-essay-body :global(.onomichi-gate-reference){padding:23px 26px;margin:1.8rem 0 2.6rem;border-radius:15px;border:1px solid #d9e5d9;background:#f5f8f1;color:#3c5f50}
    .markdown-essay-body :global(.onomichi-gate-reference p){margin:0 0 10px;line-height:1.9}
    .markdown-essay-body :global(.onomichi-gate-reference a){font-weight:800;color:#27745d;text-underline-offset:4px}
    .markdown-essay-body :global(.onomichi-gate-reference small){display:block;font-size:.78rem;line-height:1.8;color:#738378}

    /* A source-linked schematic may be wider than a normal inline photograph. */
    .markdown-essay-body :global(figure.onomichi-section-diagram) {width:100%;max-width:920px;margin:2.4rem auto 3rem;padding:0;}
    .markdown-essay-body :global(figure.onomichi-section-diagram img) {display:block;width:100%;height:auto;aspect-ratio:1120 / 500;object-fit:contain;border-radius:15px;background:#f7f8f2;}
    .markdown-essay-body :global(figure.onomichi-section-diagram figcaption) {color:#697b70;font-size:.83rem;line-height:1.9;margin:10px 2px 0;}
    .markdown-essay-body :global(figure.onomichi-section-diagram a) {color:#287966;text-underline-offset:3px;}
    .markdown-essay-body :global(.onomichi-section-scroll){overflow-x:auto;overscroll-behavior-x:contain}
    .markdown-essay-body :global(.onomichi-section-mobile-tip){display:none;font-weight:700;color:#477866}
    @media(max-width:700px){
      .markdown-essay-body :global(.onomichi-section-scroll img){min-width:760px;max-width:none}
      .markdown-essay-body :global(.onomichi-section-mobile-tip){display:block;margin-bottom:7px}
    }


    /* A single editorial scale for original and Commons photographs inside essays.
       Hero images and gallery components retain their own design. */
    .markdown-essay-body :global(figure.atlas-inline-photo) {
      width:min(100%, 560px);
      max-width:100%;
      margin:2rem auto 2.4rem;
      padding:0;
    }
