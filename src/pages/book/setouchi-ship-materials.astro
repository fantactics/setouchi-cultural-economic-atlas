---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EssayGoogleMap from '../../components/EssayGoogleMap.astro';
import { setouchiShipMaterialsEssay as article } from '../../data/setouchiShipMaterialsEssay.js';
const hero=article.heroPhoto;
---
<BaseLayout title={`${article.title} | 瀬戸内自然文化経済アトラス`} description={article.subtitle} image={hero?.imageUrl} imageAlt={hero?.alt || article.title}>
  <article class="book-article">
    <header class="book-article-header">
      <div class="book-article-series">{article.part}</div>
      <h1>{article.title}</h1>
      <p class="book-article-subtitle">{article.subtitle}</p>
      <p class="book-article-dek">{article.lead}</p>
      <div class="book-meta-row">
        <div>{article.cities.join('・')}</div>
        <div>{article.keywords.slice(0,6).map((x)=><a href={`/setouchi-cultural-economic-atlas/keywords/#${encodeURIComponent(x)}`}>#{x}</a>)}</div>
      </div>
    </header>

    {hero && <figure class="book-hero-photo">
      <a href={hero.sourcePage} target="_blank" rel="noreferrer"><img src={hero.imageUrl} alt={hero.alt} /></a>
      <figcaption><strong>{hero.title}</strong><span>Image: {hero.author} / <a href={hero.licenseUrl || hero.sourcePage} target="_blank" rel="noreferrer">{hero.license}</a></span></figcaption>
    </figure>}

    <div class="book-reading-column">
      <EssayGoogleMap article={article} />
      <aside class="ship-real-photo-note">
        <strong>本文に登場する本物の船を見る</strong>
        <p>伊予市指定文化財の「和船（地引き網船）」は、双海シーサイド公園に保存されています。<a href="https://www.city.iyo.lg.jp/shisetsu/shisetsu/bunka/bunka-085.html" target="_blank" rel="noopener noreferrer">伊予市公式ページで船の写真を見る</a>。冒頭の帆船画は時代の情景を示すもので、現存する漁船そのものではありません。</p>
      </aside>

      {article.sections.map((section,sectionIndex)=>(
        <section class="book-prose-section">
          <div class="book-section-no">{String(sectionIndex+1).padStart(2,'0')}</div>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p)=>(
            <p>
              {p.text}
              {p.refs?.length>0 && <sup class="book-footnotes">{p.refs.map((ref)=><a href={`#source-${ref}`}>[{ref}]</a>)}</sup>}
            </p>
          ))}

        </section>
      ))}

      <section class="book-sources">
        <div class="kicker">出典・参照資料</div>
        <ol>
          {article.sources.map((source)=>(
            <li id={`source-${source.id}`}>
              <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
              <span>{source.publisher}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="section" style="padding-left:0;padding-right:0;">
        <div class="chapter-related-grid">
          <a class="compare-button" href="/setouchi-cultural-economic-atlas/book/">エッセイ一覧 →</a>
          <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/book/setouchi-itinerant-trade-boats/">瀬戸内の行商船を読む →</a>
          <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/transport/">交通・航路を読む →</a>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .ship-real-photo-note{margin:0 0 2.5rem;padding:1.1rem 1.35rem;border-left:3px solid currentColor;background:rgba(127,127,127,.07);}
  .ship-real-photo-note strong{display:block;margin-bottom:.5rem;}
  .ship-real-photo-note p{margin:0;line-height:1.9;}
  .ship-real-photo-note a{text-decoration:underline;text-underline-offset:3px;}
</style>
