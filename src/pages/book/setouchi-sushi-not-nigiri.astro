---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EssayRelatedLinks from '../../components/EssayRelatedLinks.astro';
import { essaySearchMeta } from '../../data/essaySeo.js';
import EssayGoogleMap from '../../components/EssayGoogleMap.astro';
import { Content, frontmatter } from '../../content/essays/setouchi-sushi-not-nigiri.md';

const article = frontmatter;
const seo = essaySearchMeta(article);
---
<BaseLayout title={article.title} seoTitle={seo.title} description={seo.description} image={article.heroPhoto?.imageUrl} imageAlt={article.heroPhoto?.alt || article.title}>
  <article class="book-article">
    <header class="book-article-header">
      <div class="book-article-series">{article.part}</div>
      <h1>{article.title}</h1>
      <p class="book-article-subtitle">{article.subtitle}</p>
      <p class="book-article-dek">{article.lead}</p>
      <div class="book-meta-row">
        <div>{article.cities.join('・')}</div>
        <div>{article.keywords.slice(0,6).map((x)=><a href={`/setouchi-cultural-economic-atlas/keywords/#${encodeURIComponent(x)}`}>#{x}</a>)}</div>
      </div>
    </header>

    {article.heroPhoto?.imageUrl && <figure class="book-hero-photo">
      <img src={article.heroPhoto.imageUrl} alt={article.heroPhoto.alt} />
      <figcaption>
        <strong>{article.heroPhoto.title}</strong>
        <span>Photo: {article.heroPhoto.author} / <a href={article.heroPhoto.sourcePage} target="_blank" rel="noreferrer">{article.heroPhoto.license}</a></span>
      </figcaption>
    </figure>}

    <div class="book-reading-column">
      <EssayGoogleMap article={article} />

      <div class="markdown-essay-body">
        <Content />
      </div>

      <section class="book-sources">
        <div class="kicker">出典・参照資料</div>
        <ol>
          {article.sources.map((source)=>(
            <li id={`source-${source.id}`}>
              <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
              <span>{source.publisher}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="section" style="padding-left:0;padding-right:0;">
        <div class="chapter-related-grid">
          <a class="compare-button" href="/setouchi-cultural-economic-atlas/book/">エッセイ一覧 →</a>
          <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/gastronomy-matrix/">食文化を比較する →</a>
          <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/">研究ノート →</a>
        </div>
      </section>
    </div>

    <EssayRelatedLinks article={article} />
  </article>
</BaseLayout>

<style>
  .markdown-essay-body :global(h2){
    margin:3.4rem 0 1.25rem;
    font-size:clamp(1.45rem,2.6vw,2rem);
    line-height:1.45;
    letter-spacing:.02em;
  }
  .markdown-essay-body :global(p){
    margin:0 0 1.4rem;
    line-height:2.05;
  }
</style>
