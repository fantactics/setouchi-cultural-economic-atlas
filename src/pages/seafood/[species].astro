---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { places } from '../../data/places.js';
import { seafoodSpecies } from '../../data/seafood.js';

export function getStaticPaths() {
  return seafoodSpecies.map((species)=>({
    params:{ species:species.id },
    props:{ species }
  }));
}
const { species } = Astro.props;
const placeById = Object.fromEntries(places.map((p)=>[p.id,p]));
const linkedPlaces = species.places.map((id)=>placeById[id]).filter(Boolean);
---
<BaseLayout title={`${species.name} | 海の食文化 | 瀬戸内文化経済アトラス`} description={species.thesis}>
  <section class="place-hero">
    <div class="kicker">SEAFOOD SPECIES</div>
    <h1>{species.name}</h1>
    <p class="subtitle">{species.thesis}</p>
    <p class="map-note">{species.latin} / 主な旬：{species.seasons}</p>
  </section>

  <section class="section">
    <div class="kicker">SEA → FOOD</div>
    <h2>海域条件から料理まで</h2>
    <div class="seafood-detail-grid">
      <article class="seafood-detail-card"><span>海域・生態</span><p>{species.ecology}</p></article>
      <article class="seafood-detail-card"><span>食文化</span><p>{species.culture}</p></article>
    </div>
    <div class="causal-chain seafood-chain">
      <span>海域条件</span><b>→</b><span>{species.name}</span><b>→</b><span>漁獲・流通</span><b>→</b><span>{species.dishes.slice(0,3).join('・')}</span>
    </div>
  </section>

  <section class="section">
    <div class="kicker">DISHES</div>
    <h2>主な食べ方</h2>
    <ul class="seafood-dish-list">{species.dishes.map((dish)=><li>{dish}</li>)}</ul>
  </section>

  <section class="section">
    <div class="kicker">REGIONS</div>
    <h2>関係する地域</h2>
    <div class="tag-cloud">{species.regions.map((r)=><span>{r}</span>)}</div>
    {linkedPlaces.length > 0 && (
      <div class="seafood-place-links">
        {linkedPlaces.map((p)=>(
          <a class="card" href={`/setouchi-cultural-economic-atlas/places/${p.id}/`}>
            <div class="kicker">{p.prefecture}</div><h3>{p.name}</h3><p>{p.subtitle}</p>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section sources-section">
    <div class="kicker">PRIMARY SOURCES</div>
    <h2>主な出典</h2>
    <div class="source-list">
      {species.sources.map((source)=>(
        <a class="source-link" href={source.url} target="_blank" rel="noreferrer">
          <span><b>{source.id}</b>　{source.label}<small>{source.publisher}</small></span><span>↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <a class="compare-button" href="/setouchi-cultural-economic-atlas/seafood/">← 海の食文化へ戻る</a>
  </section>
</BaseLayout>
