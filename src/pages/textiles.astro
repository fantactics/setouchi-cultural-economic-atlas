---
import BaseLayout from '../layouts/BaseLayout.astro';
import { textileZones, textileMechanisms, textileRelations } from '../data/textileBelt.js';

const mechanismLabel=(id)=>textileMechanisms[id]?.label || id;
---
<BaseLayout title="瀬戸内の繊維・縫製産業帯 | 瀬戸内文化経済アトラス" description="児島・倉敷、今治、東かがわ、福山・備後を、原料・水・物流・技能・ブランド化の違いから比較する。">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <section class="place-hero">
    <div class="kicker">SETOUCHI TEXTILE BELT</div>
    <h1>同じ「繊維産業」でも、何が残ったかは違う</h1>
    <p class="subtitle">児島・倉敷、今治、東かがわ、福山・備後を、綿作・水質・港湾物流・縫製・染色・織布・ブランド化の連鎖で比較します。</p>
  </section>

  <section class="section">
    <div class="kicker">MAP</div>
    <h2>瀬戸内の主要繊維産地を空間で見る</h2>
    <p class="lead">点は代表地点です。福山・備後は新市・芦田など北部産地を示し、鞆の浦と直接の産業系譜を示すものではありません。</p>
    <div id="textile-map" class="atlas-map textile-map"
      data-zones={JSON.stringify(textileZones)}
      data-relations={JSON.stringify(textileRelations)}></div>
  </section>

  <section class="section">
    <div class="kicker">4 INDUSTRIAL SYSTEMS</div>
    <h2>4産地の形成メカニズム</h2>
    <div class="textile-zone-grid">
      {textileZones.map((zone)=>(
        <article class="textile-zone-card" id={zone.id}>
          <div class="kicker">{zone.prefecture} / {zone.scope}</div>
          <h3>{zone.name}</h3>
          <dl class="textile-facts">
            <div><dt>起点</dt><dd>{zone.origin}</dd></div>
            <div><dt>歴史産業</dt><dd>{zone.historic}</dd></div>
            <div><dt>現在</dt><dd>{zone.modern}</dd></div>
            <div><dt>中核技能</dt><dd>{zone.coreSkill}</dd></div>
          </dl>
          <div class="textile-mechanism-row">
            {zone.mechanism.map((id)=><span>{mechanismLabel(id)}</span>)}
          </div>
          <div class="causal-chain compact-chain"><span>{zone.chain.join(' → ')}</span></div>
          <p class="textile-note">{zone.note}</p>
          <div class="causal-source-row">
            {zone.evidence.map((source)=><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a>)}
          </div>
          {zone.relatedPlaceId && <a class="text-link" href={`/setouchi-cultural-economic-atlas/places/${zone.relatedPlaceId}/`}>関連地域ページ →</a>}
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="kicker">COMPARATIVE MATRIX</div>
    <h2>「何を継承したか」で比べる</h2>
    <div class="compare-table-wrap">
      <table class="compare-table textile-table">
        <thead>
          <tr><th>産地</th><th>地理・資源</th><th>強い工程</th><th>製品転換</th><th>現在の競争力</th></tr>
        </thead>
        <tbody>
          <tr><th>児島・倉敷</th><td>干拓地・綿作＋港湾物流</td><td>織布・縫製・染色加工</td><td>足袋 → 学生服 → 作業服 → ジーンズ</td><td>加工技術・ブランド・産業観光</td></tr>
          <tr><th>今治</th><td>綿業地＋蒼社川の軟水</td><td>染晒・先染・織布</td><td>白木綿 → タオル → 高品質ブランド</td><td>品質管理・産地ブランド</td></tr>
          <tr><th>東かがわ</th><td>原料より技能集積</td><td>縫製・立体加工</td><td>防寒手袋 → スポーツ・高機能 → 革製品</td><td>専門技能・多品種対応</td></tr>
          <tr><th>福山・備後</th><td>綿作＋藍染文化</td><td>紡績・染色・織布・加工・縫製・洗い</td><td>備後絣 → デニム</td><td>工程集積・高付加価値デニム</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="kicker">KEY INSIGHT</div>
    <h2>瀬戸内の繊維産業は「同じ原料」ではなく「技能の転用」でつながる</h2>
    <div class="comparison-insight-grid">
      <article class="insight-card"><h3>児島：縫製適応</h3><p>原料綿から始まった産地が、足袋・学生服・作業服・ジーンズへ需要変化に合わせて製品を変え続けた。</p></article>
      <article class="insight-card"><h3>今治：工程品質</h3><p>軟水を活かした染晒と織布工程が、タオルという単一製品の品質差別化へ集約された。</p></article>
      <article class="insight-card"><h3>東かがわ：技能特化</h3><p>手袋という立体縫製の専門技能を深掘りし、スポーツ・高機能・革製品へ用途を拡張した。</p></article>
      <article class="insight-card"><h3>備後：工程集積</h3><p>備後絣の藍染・厚地織布を起点に、デニムに必要な全工程を地域内へ集積させた。</p></article>
    </div>
  </section>

  <section class="section">
    <div class="kicker">WIDER NETWORK</div>
    <h2>児島と福山は、現在は「備中備後デニム」としてつながる</h2>
    <div class="synthesis">
      児島・倉敷と福山・備後は、同じ企業系譜の産地ではありません。しかし現在は、備中備後ジャパンデニムプロジェクトのような広域連携によって、
      それぞれの工程・企業・産地ブランドを「一つのデニム生産圏」として外部市場へ提示しています。
      これは歴史的継承ではなく、現代のネットワーク再編として扱うべき関係です。
    </div>
  </section>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script is:inline>
    (() => {
      const el=document.getElementById('textile-map');
      if(!el || !window.L) return;
      const zones=JSON.parse(el.dataset.zones || '[]');
      const relations=JSON.parse(el.dataset.relations || '[]');
      const byId=Object.fromEntries(zones.map((z)=>[z.id,z]));
      const map=L.map(el,{scrollWheelZoom:false}).setView([34.25,133.5],7);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
        maxZoom:18,attribution:'&copy; OpenStreetMap contributors'
      }).addTo(map);

      zones.forEach((z)=>{
        L.circleMarker([z.lat,z.lon],{
          radius:10,weight:2,fillOpacity:.82
        }).addTo(map).bindPopup(
          '<strong>'+z.name+'</strong><br>'+
          z.origin+'<br>'+
          '<small>'+z.coreSkill+'</small><br>'+
          '<a href="#'+z.id+'">比較カードを見る →</a>'
        );
      });

      relations.forEach((r)=>{
        const a=byId[r.from], b=byId[r.to];
        if(!a || !b) return;
        L.polyline([[a.lat,a.lon],[b.lat,b.lon]],{
          weight:4,dashArray:'8 7',opacity:.75
        }).addTo(map).bindPopup(
          '<strong>'+r.label+'</strong><br>'+r.description
        );
      });

      if(zones.length) map.fitBounds(L.latLngBounds(zones.map((z)=>[z.lat,z.lon])),{padding:[28,28]});
    })();
  </script>
</BaseLayout>
