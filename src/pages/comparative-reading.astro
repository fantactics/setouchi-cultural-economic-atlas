---
import BaseLayout from '../layouts/BaseLayout.astro';

const possibilityRows=[
  ['移動する','御手洗・鞆の浦','潮や風を待ちながら移動する','高速道路・橋・鉄道で待たずに移動する','移動時間は短くなった一方、滞留から生まれた港町経済は縮小した'],
  ['働く','児島・今治・新居浜','地域資源や特定産業の工程で働く','蓄積技能を別製品・別産業へ転用する','職業選択は広がる一方、技能継承や外部市場依存が新しい制約になる'],
  ['自然を利用する','赤穂・坂出・防府','海岸を塩田・生産空間として使う','工業・物流・公共・自然空間など複数用途を比較する','生産性の向上と引き換えに、水際へのアクセスや生態系との関係が変化した'],
  ['暮らす','尾道・松山','地形と徒歩圏に強く規定された生活圏で暮らす','鉄道・道路・自動車で複数拠点を使い分ける','選択範囲は広がる一方、斜面地や周辺部では移動負担・サービス格差が残る'],
  ['文化を実践する','竹原・柳井・御手洗','商業・生業と一体で町家・祭礼・港を使う','文化資産として保存・観光・滞在に使う','建物が残っても、担い手や日常利用が減れば文化実践は弱くなる'],
  ['地域に残る／出る','小豆島・島嶼部','島内の限られた仕事と船便の中で暮らす','島外就業、複数拠点、観光・加工業・創作活動を組み合わせる','選択肢は増える一方、交通コストとサービス維持が残留可能性を左右する']
];

const industryRows=[
  ['児島','干拓・綿','織る・縫う・加工する','技能転用型','足袋→学生服→ジーンズ','商品より技能が長生きする'],
  ['今治','海運・船','操船・修船・造船','集積自己増殖型','船主→造船→舶用→金融・教育','企業同士が互いの市場になる'],
  ['新居浜','銅鉱床','採鉱・製錬・機械','企業内分岐型','銅山→機械／化学／非鉄','本業の補助能力が独立する'],
  ['小豆島','塩・海運＋外部原料','発酵・食品加工','地域内連鎖型','塩→醤油→佃煮／素麺→ごま油','多数の事業者が横につながる']
];

const cityRows=[
  ['尾道','線状高密度・積層型','港商業・商人資本','水道沿いの狭い平地','中世港→商人→鉄道→金融→観光'],
  ['御手洗','圧縮混在・低上書き型','潮待ち・風待ち','小さな島の限られた平地','雁木・問屋・船宿・茶屋・神社が近接'],
  ['多度津','交通結節更新型','参詣・海運→鉄道→工業','平野・港','中心が港→駅→臨海部へ移動'],
  ['新居浜','企業インフラ・重心移動型','鉱山→工業','山地から臨海部','旧別子→東平→端出場→平野→海'],
  ['松山','機能分離・多核統合型','城下＋温泉＋外港','松山平野','道後・城下・三津浜を鉄道が統合'],
  ['柳井','商人資本固定型','広域交易','柳井川・旧湾岸','流れる富を町家・土地・銀行へ固定'],
  ['岩国','対岸二極統合型','城下＋流域経済','錦川両岸','政治・武家地と商業地を橋で接続']
];

const localityRows=[
  ['物質的地域性','地元原料・地元自然が不可欠','綿・銅・塩・石'],
  ['能力的地域性','技能・設備・工程・企業集積が地域にある','児島縫製、今治造船'],
  ['制度的地域性','教育・研究・金融・ブランドが能力を再生産する','共同研修、発酵研究、地域金融']
];
---
<BaseLayout title="地域比較 | 研究ノート | SETOUCHI ATLAS" description="地域を、人口や経済規模の優劣ではなく、人が何を得られ、何ができるようになったかという可能性の変化から比較する研究ノート。">
  <section class="place-hero chapter-hero research-note-hero">
    <a class="research-note-back" href="/setouchi-cultural-economic-atlas/chapters/">研究ノート一覧 ←</a>
    <h1>地域比較</h1>
    <p class="subtitle">地域の違いを、優劣ではなく「可能性の組み合わせ」の違いとして読む。</p>
    <div class="chapter-thesis">人口、所得、観光客数の多寡だけでは地域を評価しません。自然、交通、産業、文化、制度の変化によって、人が何をできるようになり、何が難しくなったのかを比較します。</div>
  </section>

  <section class="section gene-section">
    <div class="kicker">HUMAN POSSIBILITIES</div>
    <h2>同じ「近代化」でも、増えた可能性と失われた可能性は違う</h2>
    <p class="lead">地域比較の単位を「人口が増えた／減った」「産業が伸びた／衰えた」から、人の行為へ移します。何をする可能性がどう変わったかを見ると、成長と喪失が同じ変化の中に共存していることが見えます。</p>
    <div class="compare-table-wrap">
      <table class="compare-table">
        <thead><tr><th>人の行為</th><th>例</th><th>以前可能だったこと</th><th>新しく可能になったこと</th><th>同時に生じた交換関係</th></tr></thead>
        <tbody>{possibilityRows.map((row)=><tr>{row.map((cell,i)=>i===0?<th>{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <div class="comparison-callout">
      <strong>比較原則</strong>
      <p>「便利になった」「豊かになった」「衰退した」と先に評価せず、誰のどの可能性が広がり、どの可能性が狭まったのかまで分解してから地域の変化を記述します。</p>
    </div>
  </section>

  <section class="section">
    <h2>4つの産業進化モデル</h2>
    <p class="lead">4地域とも「地域資源→地域能力」へ進みますが、その経路は異なります。</p>
    <div class="compare-table-wrap">
      <table class="compare-table">
        <thead><tr><th>地域</th><th>起点</th><th>最初の能力</th><th>進化方式</th><th>代表的な連鎖</th><th>読み取り</th></tr></thead>
        <tbody>{industryRows.map((row)=><tr>{row.map((cell,i)=>i===0?<th>{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <div class="comparison-callout">
      <strong>共通命題</strong>
      <p>地域産業の継続を、同じ商品を守れるかだけで見ません。蓄積した能力を別の商品・原料・市場へ再構成することで、どのような仕事や生業が新しく可能になったかを見ます。</p>
    </div>
  </section>

  <section class="section gene-section">
    <h2>地域性は「原料」から「能力・制度」へ移動する</h2>
    <div class="compare-table-wrap">
      <table class="compare-table">
        <thead><tr><th>層</th><th>何に依存するか</th><th>例</th></tr></thead>
        <tbody>{localityRows.map((row)=><tr>{row.map((cell,i)=>i===0?<th>{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <p class="lead">原料が地域外へ移っても、加工能力・企業関係・教育・ブランドが地域に残れば、地域性が消えるとは限りません。「脱地域化」ではなく「地域性の層が変わる」と読みます。</p>
  </section>

  <section class="section">
    <h2>7つの都市形成モデル</h2>
    <div class="compare-table-wrap">
      <table class="compare-table">
        <thead><tr><th>地域</th><th>都市型</th><th>経済エンジン</th><th>地形条件</th><th>空間の特徴</th></tr></thead>
        <tbody>{cityRows.map((row)=><tr>{row.map((cell,i)=>i===0?<th>{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <h2>都市を比較するときの共通質問</h2>
    <div class="comparison-insight-grid">
      <article class="insight-card"><h3>何ができたか</h3><p>港、鉱山、城、温泉、工場などが、どのような仕事・移動・生活を可能にしたかを見る。</p></article>
      <article class="insight-card"><h3>誰に可能だったか</h3><p>商人、労働者、船主、農漁業者、住民、来訪者など、可能性が誰に開かれていたかを分けて見る。</p></article>
      <article class="insight-card"><h3>何との交換だったか</h3><p>所得、便利さ、安全性、自然、土地、時間、共同体など、得たものと同時に変化したものを見る。</p></article>
    </div>
  </section>

  <section class="section gene-section">
    <h2>料理・祭礼・景観も「できること」として比較する</h2>
    <div class="comparison-insight-grid">
      <article class="insight-card"><h3>料理</h3><p>「何が名物か」ではなく、どの生態系・加工・保存・交易によって、その料理をつくり食べることが可能になったかを見る。</p></article>
      <article class="insight-card"><h3>祭礼</h3><p>祭神だけでなく、祭礼を実際に担い続ける人・時間・資金・場所が存在するかを見る。</p></article>
      <article class="insight-card"><h3>景観</h3><p>美しさだけでなく、そこに住む、歩く、商う、修理する、海へ出るといった行為が今も可能かを見る。</p></article>
    </div>
  </section>

  <section class="section chapter-related">
    <h2>関連する研究ノート</h2>
    <div class="chapter-related-grid">
      <a class="compare-button" href="/setouchi-cultural-economic-atlas/chapters/capabilities/">地域能力を読む →</a>
      <a class="compare-button" href="/setouchi-cultural-economic-atlas/chapters/cities/">都市形成を読む →</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/concepts/">概念辞典 →</a>
    </div>
  </section>
</BaseLayout>
