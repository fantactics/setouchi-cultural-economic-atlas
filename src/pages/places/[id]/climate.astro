---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { places } from '../../../data/places.js';
import { climateProfiles } from '../../../data/climate.js';

export function getStaticPaths() {
  return places
    .filter((place) => climateProfiles[place.id])
    .map((place) => ({
      params: { id: place.id },
      props: { place, climate: climateProfiles[place.id] }
    }));
}

const { place, climate } = Astro.props;
const metrics = [
  {label:'年平均気温', value:`${climate.annualTemp.toFixed(1)} ℃`},
  {label:'年間降水量', value:`${climate.annualRain.toLocaleString('ja-JP')} mm`},
  {label:'年間日照時間', value: climate.annualSun == null ? 'データなし' : `${climate.annualSun.toLocaleString('ja-JP')} 時間`}
];

const buildLinePath = (values, width=720, height=220, pad=28) => {
  const nums = values.filter((v) => v != null);
  if (!nums.length) return '';
  const min = Math.min(...nums);
  const max = Math.max(...nums);
  const range = max - min || 1;
  return values.map((v,i) => {
    if (v == null) return null;
    const x = pad + (i * (width - pad * 2) / (values.length - 1));
    const y = height - pad - ((v - min) / range) * (height - pad * 2);
    return `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`;
  }).filter(Boolean).join(' ');
};

const tempValues = climate.monthly?.map((row) => row[1]) || [];
const rainValues = climate.monthly?.map((row) => row[2]) || [];
const sunValues = climate.monthly?.map((row) => row[3]) || [];
const tempPath = buildLinePath(tempValues);
const sunPath = buildLinePath(sunValues);
const rainMax = rainValues.length ? Math.max(...rainValues) : 0;
---
<BaseLayout title={`${place.name}の気候 | 瀬戸内文化経済アトラス`} description={`${place.name}の気温・降水量・日照時間などの気候平年値。`}>
  <section class="place-hero">
    <div class="kicker">CLIMATE / WATER / NATURAL CONDITIONS</div>
    <h1>{place.name}の気候</h1>
    <p class="subtitle">気象庁の平年値を使い、地域の自然条件を定量的に確認します。</p>
  </section>

  <section class="section">
    <div class="climate-station-card">
      <div>
        <div class="kicker">REPRESENTATIVE STATION</div>
        <h2>{climate.station}</h2>
        <p>{climate.stationContext}</p>
      </div>
      <div>
        <span class="claim-badge fact">FACT</span>
        <p class="climate-period">統計期間 {climate.period}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="climate-metrics">
      {metrics.map((metric) => (
        <article class="climate-metric">
          <span>{metric.label}</span>
          <strong>{metric.value}</strong>
        </article>
      ))}
    </div>
    <p class="map-note">観測点の値は地域全体を完全に代表するものではありません。沿岸・島嶼・内陸、標高、海風などによって実際の体感・局地気候は変わります。</p>
  </section>

  {climate.monthly && (
    <section class="section">
      <div class="kicker">MONTHLY NORMALS</div>
      <h2>月別の平年値</h2>
      <div class="climate-chart-grid">
        <article class="climate-chart-card">
          <h3>平均気温</h3>
          <svg viewBox="0 0 720 220" role="img" aria-label="月別平均気温">
            <path class="climate-line climate-temp-line" d={tempPath}></path>
            {tempValues.map((v,i) => {
              const min = Math.min(...tempValues);
              const max = Math.max(...tempValues);
              const range = max - min || 1;
              const x = 28 + (i * (720 - 56) / 11);
              const y = 220 - 28 - ((v - min) / range) * (220 - 56);
              return <circle class="climate-point" cx={x} cy={y} r="3.5"></circle>;
            })}
          </svg>
          <div class="climate-month-axis">{climate.monthly.map(([m]) => <span>{m}月</span>)}</div>
        </article>

        <article class="climate-chart-card">
          <h3>降水量</h3>
          <svg viewBox="0 0 720 220" role="img" aria-label="月別降水量">
            {rainValues.map((v,i) => {
              const barW = 38;
              const gap = (720 - 56 - barW * 12) / 11;
              const x = 28 + i * (barW + gap);
              const h = rainMax ? (v / rainMax) * 160 : 0;
              const y = 192 - h;
              return <rect class="climate-bar" x={x} y={y} width={barW} height={h} rx="3"></rect>;
            })}
          </svg>
          <div class="climate-month-axis">{climate.monthly.map(([m]) => <span>{m}月</span>)}</div>
        </article>

        {sunValues.some((v) => v != null) && (
          <article class="climate-chart-card">
            <h3>日照時間</h3>
            <svg viewBox="0 0 720 220" role="img" aria-label="月別日照時間">
              <path class="climate-line climate-sun-line" d={sunPath}></path>
            </svg>
            <div class="climate-month-axis">{climate.monthly.map(([m]) => <span>{m}月</span>)}</div>
          </article>
        )}
      </div>

      <div class="compare-table-wrap">
        <table class="compare-table climate-table">
          <thead><tr><th>月</th><th>平均気温</th><th>降水量</th><th>日照時間</th></tr></thead>
          <tbody>
            {climate.monthly.map(([month,temp,rain,sun]) => (
              <tr>
                <th>{month}月</th>
                <td>{temp.toFixed(1)} ℃</td>
                <td>{rain.toFixed(1)} mm</td>
                <td>{sun == null ? '—' : `${sun.toFixed(1)} 時間`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {!climate.monthly && (
    <section class="section">
      <div class="kicker">MONTHLY NORMALS</div>
      <h2>月別の平年値</h2>
      <p class="lead">月別データは一次資料確認後に追加します。年平均値のみ先行掲載しています。</p>
    </section>
  )}

  <section class="section">
    <div class="kicker">REGIONAL READING</div>
    <h2>地域形成とのつながり</h2>
    <div class="synthesis">{place.sections[2][1]}</div>
  </section>

  <section class="section sources-section">
    <div class="kicker">PRIMARY SOURCE</div>
    <h2>気象データ出典</h2>
    <a class="source-link" href={climate.sourceUrl} target="_blank" rel="noreferrer">
      <span><b>気象庁</b>　平年値（年・月ごとの値）<small>{climate.station} / {climate.period}</small></span>
      <span>↗</span>
    </a>
  </section>

  <section class="section">
    <a class="compare-button" href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>← {place.name}の地域ページへ戻る</a>
  </section>
</BaseLayout>
