---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { places } from '../../data/places.js';
import { climateProfiles } from '../../data/climate.js';
import { photosForPlace } from '../../data/photoEvidence.js';
import PhotoEvidenceGallery from '../../components/PhotoEvidenceGallery.astro';
import { bookArticles } from '../../data/bookArticles.js';

export function getStaticPaths() {
  return places.map((place) => ({
    params: { id: place.id },
    props: { place }
  }));
}
const { place } = Astro.props;
const sourceById = Object.fromEntries(place.sources.map((source) => [source.id, source]));
const hasClimate = !!climateProfiles[place.id];
const placePhotos = photosForPlace(place.id);
const textileRelated = ['shimotsui','imabari','hiketa','tomonoura'].includes(place.id);
const storyAliases = {
  ako:['赤穂'],
  onomichi:['尾道'],
  imabari:['今治','波止浜','来島海峡'],
  shimotsui:['下津井','児島','倉敷'],
  tadotsu:['多度津'],
  mitarai:['御手洗'],
  ushimado:['牛窓'],
  tomonoura:['鞆の浦'],
  takehara:['竹原'],
  sakaide:['坂出'],
  hofu:['防府（三田尻）','三田尻'],
  niihama:['新居浜','別子','東平'],
  shodoshima:['小豆島'],
  iwakuni:['岩国'],
  takamatsu:['高松'],
  marugame:['丸亀']
};
const relatedNames = storyAliases[place.id] || [place.name];
const relatedStories = bookArticles.filter((article)=>article.cities.some((city)=>relatedNames.includes(city)));
const claimLabelsJa = { fact:'事実', interpretation:'解釈', hypothesis:'仮説' };
const storyById = {
  ako:{
    title:'海水から塩をつくった町は、塩田の後に何を残したか',
    body:'赤穂では、遠浅の海岸と瀬戸内の気候を利用した製塩が長く地域経済を支えました。塩田そのものが消えた後も、製塩事業の技術と、広い沿岸用地という二つの資産が残り、素材・化学・臨海工業へ形を変えて受け継がれています。'
  },
  onomichi:{
    title:'港に集まった富は、なぜ町と造船の両方を育てたか',
    body:'尾道は、山と海に挟まれた狭い都市空間に港、商家、寺社、鉄道、造船が重なっています。海上交易で蓄積した資本と人のネットワークが、商業・金融・文化だけでなく、海運と造船へも展開したことが、この町の厚みをつくりました。'
  },
  imabari:{
    title:'潮の速い海峡と港から、海事産業へ',
    body:'来島海峡の強い潮流は航海の制約である一方、波止浜などの待避・潮待ち需要を生みました。船が滞在することで修繕や船大工の技能が蓄積し、海運・船主資本・造船・舶用産業へと厚みを増していきます。別系統では、蒼社川の水と繊維技能がタオル産地を育てました。',
    chains:[
      ['急潮','潮待ち','修繕','造船・海運'],
      ['水資源','染晒','タオル','産地ブランド']
    ]
  },
  shimotsui:{
    title:'海だった土地から、綿とデニムの産地へ',
    body:'児島の浅海・干拓地では綿作が育ち、下津井などの港は肥料を受け入れ、木綿や塩を外へ出す物流を担いました。織布・縫製・染色の技能は、足袋、学生服、作業服、ジーンズへと製品を変えながら継承されました。',
    chains:[
      ['浅海・干拓','綿','織布・縫製','学生服','デニム'],
      ['北前船','肥料搬入','綿・木綿移出','港町商業']
    ]
  },
  tadotsu:{
    title:'港から鉄道へ、交通の中心はどう生き残ったか',
    body:'多度津は、北前船と金毘羅参詣で人と物が集まる港として発展し、その結節機能を近代の鉄道へ引き継ぎました。交通手段が船から鉄道へ変わっても、「人と物を集め、次の交通へ渡す」という地域能力が残った町として読むことができます。'
  },
  mitarai:{
    title:'「待つ時間」は、どうやって町の富になったか',
    body:'御手洗では、潮や風を待つ船が島の小さな港に滞在しました。その時間が宿、商店、問屋、茶屋、港湾施設への需要を生み、海上交通の摩擦そのものが町の経済を育てました。現在の町並みは、その滞留経済が建物として残ったものでもあります。'
  },
  ushimado:{
    title:'港は、交易だけでなく外交の舞台にもなった',
    body:'牛窓は、瀬戸内航路の港として船と物資を受け入れる一方、朝鮮通信使など対外交流の舞台にもなりました。海上交通の結節点であることが、物流だけでなく人・情報・文化を呼び込み、その蓄積が港町の歴史資産へ変わっています。'
  },
  tomonoura:{
    title:'潮を待つ時間が、港町を育てた',
    body:'鞆の浦では、瀬戸内の潮流が切り替わるまで船が待つ必要がありました。停泊する船と船員が、商業、宿泊、酒造、鍛冶などの仕事を生み、航海上の制約が港町の密度を高めました。'
  },
  mihara:{
    title:'海の要衝は、城下・工業・高速交通へどう更新されたか',
    body:'三原は瀬戸内の海上交通上の位置を城下町と港として使い、近代には工業と鉄道、現代には新幹線や空港への接続を重ねてきました。同じ場所の交通価値を、時代ごとに別のインフラへ更新してきた都市です。'
  },
  takehara:{
    title:'塩の利益は、なぜ町並みとして残ったか',
    body:'竹原では、干拓と製塩が生んだ富が酒造・廻船・商業へ再投資され、さらに町家や蔵へ固定されました。塩田が消えた後にも、産業で得た利益が建築と都市空間として残っている点が、この町を特徴づけます。'
  },
  matsuyama:{
    title:'城・温泉・港は、どう一つの都市になったか',
    body:'松山には、城下町としての行政・商業、道後温泉の観光、三津浜港の海上交通という異なる都市機能が近接して存在しました。近代鉄道がそれらを結び、複数の地域システムを束ねることで現在の県都が形成されました。'
  },
  shimonoseki:{
    title:'海峡は、なぜ市場と国際港を同じ場所に集めたか',
    body:'関門海峡は瀬戸内海と日本海をつなぐ狭い通路で、船、人、商品が集中します。その地理的な集中が、港湾商業、北前船、国際物流、水産市場など時代ごとに異なる機能を呼び込み、海峡都市としての厚みをつくりました。'
  },
  yanai:{
    title:'交易の利益は、なぜ白壁の町になったか',
    body:'柳井では、瀬戸内交易で広がった商圏と商人資本が町家や蔵へ投資されました。現在の白壁の町並みは、単なる景観ではなく、かつての交易利益が都市空間へ固定された痕跡として読むことができます。'
  },
  hofu:{
    title:'遠浅の海岸を塩田に変えると、何が町に残るか',
    body:'三田尻では、周防灘の遠浅海岸を大規模な塩田へ変え、そこで作った塩を北前船で広域市場へ送りました。製塩が終わった後も、沿岸の土地と港湾機能が工業・物流へ再利用され、資源産業と交易の履歴が現在の都市構造に残っています。'
  },
  hiketa:{
    title:'風と潮を待つ港は、どう商家と醸造を育てたか',
    body:'引田では、風待ち・潮待ちを必要とする海上交通が港を重要な滞在地点にしました。港を核に城、商家、漁業、醸造が重なり、東讃の小さな港町に複数の生業と文化が蓄積しました。'
  },
  sakaide:{
    title:'塩田の土地は、どう巨大な工業地帯へ変わったか',
    body:'坂出では、製塩のために使われた広い沿岸平坦地と港湾条件が、塩田廃止後の埋立・工業用地へつながりました。塩という商品よりも、「海を陸へ変えて使う能力」が次の時代へ継承された町として見ることができます。'
  },
  takamatsu:{
    title:'港町は、どう海城・県都・四国の玄関口へ変わったか',
    body:'高松は、中世以来の港湾機能を基礎に海に面した城と城下町を整え、近代以降は鉄道・航路・行政機能を重ねて県都へ成長しました。海と陸の接続点という位置を、時代ごとに別の都市機能へ更新してきた町です。'
  },
  niihama:{
    title:'山の銅山から、海辺の工業都市へ',
    body:'別子銅山の採鉱から始まった産業は、運搬、製錬、機械修理、発電、化学へと機能を広げました。鉱山が閉じた後も、そこで蓄積した技術、企業、港湾、電力、取引関係が残り、非鉄・機械・化学を核とする工業都市へ引き継がれています。',
    chains:[
      ['銅鉱床','採鉱・製錬','非鉄素材'],
      ['鉱山需要','機械・電力・化学','工業都市']
    ]
  },
  shodoshima:{
    title:'外から来る原料を、島の価値へ変える',
    body:'小豆島は、島内で採れる原料だけで成り立った島ではありません。海運で大豆・小麦・ごまなどを受け入れ、発酵・製麺・製油・加工の技能によって高付加価値の商品へ変え、再び島外へ送り出してきました。'
  },
  iwakuni:{
    title:'川に分けられた城下町を、橋が一つの都市にした',
    body:'岩国では、錦川を防御線として横山と錦見に都市機能を分けたため、両岸を安定して結ぶ技術が不可欠でした。錦帯橋はその問題への答えであり、錦川の水運や流域産業とともに、川を隔てる力と結ぶ力の両方を地域形成に取り込んだ町です。'
  }
}
const story = storyById[place.id] || {
  title:'この地域は、どうできたか',
  body:place.sections[17][1]
};
const storyChains = story.chains || place.genes.map((gene)=>gene.chain);
const storyParagraphs = [
  `${place.sections[1][1]} ${place.sections[2][1]}`,
  `${place.sections[3][1]} ${place.sections[4][1]}`,
  `${place.sections[6][1]} ${place.sections[16][1]}`
];
---
<BaseLayout title={`${place.name} | 瀬戸内自然文化経済アトラス`} description={place.subtitle}>
  <section class="place-hero">
    <div class="kicker">{place.prefecture}</div>
    <h1>{place.name}</h1>
    <p class="subtitle">{place.subtitle}</p>
    <ul class="tags">{place.tags.map((tag) => <li>{tag}</li>)}</ul>
  </section>

  <section class="section place-story-intro">
    <h2>{story.title}</h2>
    <p class="place-story-lead">{story.body}</p>
    <div class="place-story-prose">
      {storyParagraphs.map((paragraph)=><p>{paragraph}</p>)}
    </div>
    <div class="place-story-chains">
      {storyChains.map((chain) => (
        <div class="place-story-chain">
          <div class="chain">
            {chain.map((step, i) => (
              <>
                <span>{step}</span>
                {i < chain.length - 1 && <b class="arrow">→</b>}
              </>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {relatedStories.length > 0 && (
    <section class="section place-related-stories">
      <h2>{place.name}の物語を読む</h2>
      <div class="place-related-story-list">
        {relatedStories.map((article)=>(
          <a href={`/setouchi-cultural-economic-atlas/book/${article.slug}/`}>
            <strong>{article.title}</strong>
            <span>{article.subtitle}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <PhotoEvidenceGallery items={placePhotos} title={`${place.name}を写真で見る`} />

  <section class="section place-research-links">
    <h2>関連するテーマ</h2>
    <div class="chapter-related-grid">
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/geography/">地形</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/livelihoods/">生業</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/ports-trade/">港・交易</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/capabilities/">地域能力</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/culture/">文化</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/cities/">都市</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/standardization/">近代化</a>
    </div>
  </section>

  {textileRelated && (
    <section class="section place-textile-link">
      <h2>瀬戸内の繊維・縫製産業帯の中で見る</h2>
      <p class="lead">{place.id === 'tomonoura'
        ? '福山市北部の備後絣・デニム産地との市域内比較です。鞆の浦の港町形成から直接デニム産業が生まれたという意味ではありません。'
        : 'この地域の繊維・縫製産業を、児島・今治・東かがわ・福山の技能継承と横断比較します。'}</p>
      <a class="compare-button" href="/setouchi-cultural-economic-atlas/textiles/">繊維・縫製産業帯を見る →</a>
    </section>
  )}

  <section class="section gene-section">
    <h2>産業の系譜</h2>
    <p class="lead">現在の産業が、どのような資源・技能・物流・資本から生まれたかをたどります。</p>
    <div class="grid">
      {place.genes.map((gene) => (
        <article class="card">
          <div class="kicker">{gene.type}</div>
          <h3>{gene.name}</h3>
          <div class="chain">
            {gene.chain.map((step, i) => (
              <>
                <span>{step}</span>
                {i < gene.chain.length - 1 && <b class="arrow">→</b>}
              </>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section place-data-section">
    <h2>地域データ</h2>
    <p class="lead">自然、歴史、産業、暮らしなど18項目をまとめています。各項目は、事実・解釈・仮説を区別して表示します。</p>
    <div class="profile-grid">
      {place.sections.map(([title, body, type], i) => (
        <article class="profile-card">
          <div class="profile-num">{String(i + 1).padStart(2,'0')}</div>
          <div>
            <div class={`claim-badge ${type}`}>{claimLabelsJa[type]}</div>
            {i === 2 && hasClimate ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/places/${place.id}/climate/`}>{title} →</a></h3>
            ) : i === 4 ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/transport/#place-${place.id}`}>{title} →</a></h3>
            ) : i === 5 ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/seafood/#place-${place.id}`}>{title} →</a></h3>
            ) : [6,7,8,9,10].includes(i) ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/industry/#place-${place.id}`}>{title} →</a></h3>
            ) : i === 17 ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/evolution/#place-${place.id}`}>{title} →</a></h3>
            ) : (
              <h3>{title}</h3>
            )}
            <p>{body}</p>
            {place.sectionSources?.[i]?.length > 0 && (
              <div class="claim-sources">
                <span class="claim-sources-label">出典</span>
                {place.sectionSources[i].map((sourceId) => {
                  const source = sourceById[sourceId];
                  return source ? (
                    <a href={source.url} target="_blank" rel="noreferrer" title={source.label}>{source.id}</a>
                  ) : null;
                })}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section sources-section">
    <h2>主な出典</h2>
    <p class="lead">自治体・気象庁等の一次情報を優先しています。解釈・仮説は、出典が示す事実を基礎に編集上の推論を加えたものです。</p>
    <div class="source-list">
      {place.sources.map((source) => (
        <a class="source-link" href={source.url} target="_blank" rel="noreferrer">
          <span>
            <b>{source.id}</b>　{source.label}
            <small>{source.publisher} / 確認日 {source.verifiedAt}</small>
          </span>
          <span>↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
