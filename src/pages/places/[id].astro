---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegionReadingPage from '../../components/RegionReadingPage.astro';
import LegacyRegionDetail from '../../components/LegacyRegionDetail.astro';
import { places } from '../../data/places.js';
import { regionalPlaces, regionPhotoFor } from '../../data/regionDirectory.js';
export function getStaticPaths(){
  const staticIds=new Set(['akashi','naruto','kada','hinase']);
  return regionalPlaces.filter(p=>!staticIds.has(p.id)).map(place=>({params:{id:place.id},props:{place}}));
}
const { place }=Astro.props;
const legacy=places.find(p=>p.id===place.id);
const photo=regionPhotoFor(place);
---
<BaseLayout title={`${place.name} | SETOUCHI ATLAS`} description={place.subtitle||`${place.name}の関連エッセイ`} image={photo?.imageUrl} imageAlt={photo?.alt||place.name}>
  {legacy ? <RegionReadingPage place={place}><LegacyRegionDetail slot="research" place={legacy} /></RegionReadingPage> : <RegionReadingPage place={place} />}
</BaseLayout>
