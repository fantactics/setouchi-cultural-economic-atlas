---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { places } from '../../data/places.js';
import { climateProfiles } from '../../data/climate.js';
import { photosForPlace } from '../../data/photoEvidence.js';
import PhotoEvidenceGallery from '../../components/PhotoEvidenceGallery.astro';

export function getStaticPaths() {
  return places.map((place) => ({
    params: { id: place.id },
    props: { place }
  }));
}
const { place } = Astro.props;
const sourceById = Object.fromEntries(place.sources.map((source) => [source.id, source]));
const hasClimate = !!climateProfiles[place.id];
const placePhotos = photosForPlace(place.id);
const textileRelated = ['shimotsui','imabari','hiketa','tomonoura'].includes(place.id);
const claimLabelsJa = { fact:'事実', interpretation:'解釈', hypothesis:'仮説' };
---
<BaseLayout title={`${place.name} | 瀬戸内自然文化経済アトラス`} description={place.subtitle}>
  <section class="place-hero">
    <div class="kicker">{place.prefecture}</div>
    <h1>{place.name}</h1>
    <p class="subtitle">{place.subtitle}</p>
    <ul class="tags">{place.tags.map((tag) => <li>{tag}</li>)}</ul>
  </section>

  <section class="section place-story-intro">
    <h2>この地域は、どうできたか</h2>
    <p class="place-story-lead">{place.sections[17][1]}</p>
    <div class="place-story-chains">
      {place.genes.map((gene) => (
        <article class="place-story-chain">
          <h3>{gene.name}</h3>
          <div class="chain">
            {gene.chain.map((step, i) => (
              <>
                <span>{step}</span>
                {i < gene.chain.length - 1 && <b class="arrow">→</b>}
              </>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <PhotoEvidenceGallery items={placePhotos} title={`${place.name}を写真で見る`} />

  <section class="section place-research-links">
    <h2>関連するテーマ</h2>
    <div class="chapter-related-grid">
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/geography/">地形</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/livelihoods/">生業</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/ports-trade/">港・交易</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/capabilities/">地域能力</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/culture/">文化</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/cities/">都市</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/standardization/">近代化</a>
    </div>
  </section>

  {textileRelated && (
    <section class="section place-textile-link">
      <h2>瀬戸内の繊維・縫製産業帯の中で見る</h2>
      <p class="lead">{place.id === 'tomonoura'
        ? '福山市北部の備後絣・デニム産地との市域内比較です。鞆の浦の港町形成から直接デニム産業が生まれたという意味ではありません。'
        : 'この地域の繊維・縫製産業を、児島・今治・東かがわ・福山の技能継承と横断比較します。'}</p>
      <a class="compare-button" href="/setouchi-cultural-economic-atlas/textiles/">繊維・縫製産業帯を見る →</a>
    </section>
  )}

  <section class="section gene-section">
    <h2>産業の系譜</h2>
    <p class="lead">現在の産業が、どのような資源・技能・物流・資本から生まれたかをたどります。</p>
    <div class="grid">
      {place.genes.map((gene) => (
        <article class="card">
          <div class="kicker">{gene.type}</div>
          <h3>{gene.name}</h3>
          <div class="chain">
            {gene.chain.map((step, i) => (
              <>
                <span>{step}</span>
                {i < gene.chain.length - 1 && <b class="arrow">→</b>}
              </>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section place-data-section">
    <h2>地域データ</h2>
    <p class="lead">自然、歴史、産業、暮らしなど18項目をまとめています。各項目は、事実・解釈・仮説を区別して表示します。</p>
    <div class="profile-grid">
      {place.sections.map(([title, body, type], i) => (
        <article class="profile-card">
          <div class="profile-num">{String(i + 1).padStart(2,'0')}</div>
          <div>
            <div class={`claim-badge ${type}`}>{claimLabelsJa[type]}</div>
            {i === 2 && hasClimate ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/places/${place.id}/climate/`}>{title} →</a></h3>
            ) : i === 4 ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/transport/#place-${place.id}`}>{title} →</a></h3>
            ) : i === 5 ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/seafood/#place-${place.id}`}>{title} →</a></h3>
            ) : [6,7,8,9,10].includes(i) ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/industry/#place-${place.id}`}>{title} →</a></h3>
            ) : i === 17 ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/evolution/#place-${place.id}`}>{title} →</a></h3>
            ) : (
              <h3>{title}</h3>
            )}
            <p>{body}</p>
            {place.sectionSources?.[i]?.length > 0 && (
              <div class="claim-sources">
                <span class="claim-sources-label">出典</span>
                {place.sectionSources[i].map((sourceId) => {
                  const source = sourceById[sourceId];
                  return source ? (
                    <a href={source.url} target="_blank" rel="noreferrer" title={source.label}>{source.id}</a>
                  ) : null;
                })}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section sources-section">
    <h2>主な出典</h2>
    <p class="lead">自治体・気象庁等の一次情報を優先しています。解釈・仮説は、出典が示す事実を基礎に編集上の推論を加えたものです。</p>
    <div class="source-list">
      {place.sources.map((source) => (
        <a class="source-link" href={source.url} target="_blank" rel="noreferrer">
          <span>
            <b>{source.id}</b>　{source.label}
            <small>{source.publisher} / 確認日 {source.verifiedAt}</small>
          </span>
          <span>↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
