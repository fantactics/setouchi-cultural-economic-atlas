---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { places } from '../../data/places.js';
import { climateProfiles } from '../../data/climate.js';
import { photosForPlace } from '../../data/photoEvidence.js';
import PhotoEvidenceGallery from '../../components/PhotoEvidenceGallery.astro';
import { orderedBookArticles } from '../../data/bookArticles.js';
import { researchChapters } from '../../data/researchChapters.js';

export function getStaticPaths() {
  return places.map((place) => ({
    params: { id: place.id },
    props: { place }
  }));
}
const { place } = Astro.props;
const sourceById = Object.fromEntries(place.sources.map((source) => [source.id, source]));
const hasClimate = !!climateProfiles[place.id];
const placePhotos = photosForPlace(place.id);
const textileRelated = ['shimotsui','imabari','hiketa','tomonoura'].includes(place.id);
const storyAliases = {
  ako:['赤穂','gastronomy'],
  onomichi:['尾道','gastronomy'],
  imabari:['今治','波止浜','来島海峡','gastronomy'],
  shimotsui:['下津井','児島','倉敷','gastronomy'],
  tadotsu:['多度津','gastronomy'],
  mitarai:['御手洗','gastronomy'],
  ushimado:['牛窓','gastronomy'],
  tomonoura:['鞆の浦','gastronomy'],
  mihara:['三原'],
  takehara:['竹原','gastronomy'],
  sakaide:['坂出','gastronomy'],
  hofu:['防府（三田尻）','三田尻'],
  niihama:['新居浜','別子','東平'],
  shodoshima:['小豆島','gastronomy'],
  iwakuni:['岩国'],
  takamatsu:['高松','gastronomy'],
  matsuyama:['松山','gastronomy'],
  shimonoseki:['下関','gastronomy'],
  yanai:['柳井'],
  hiketa:['引田','gastronomy'],
  marugame:['丸亀']
};
const relatedNames = storyAliases[place.id] || [place.name];
const relatedStories = orderedBookArticles.filter((article)=>article.cities.some((city)=>relatedNames.includes(city)));
const claimLabelsJa = { fact:'事実', interpretation:'解釈', hypothesis:'仮説' };
const storyById = {
  ako:{
    title:'海水から塩をつくった町は、塩田の後に何を残したか',
    body:'赤穂では、遠浅の海岸と瀬戸内の気候を利用した製塩が長く地域経済を支えました。塩田そのものが消えた後も、製塩事業の技術と、広い沿岸用地という二つの資産が残り、素材・化学・臨海工業へ形を変えて受け継がれています。'
  },
  onomichi:{
    title:'港に集まった富は、なぜ町と造船の両方を育てたか',
    body:'尾道は、山と海に挟まれた狭い都市空間に港、商家、寺社、鉄道、造船が重なっています。海上交易で蓄積した資本と人のネットワークが、商業・金融・文化だけでなく、海運と造船へも展開したことが、この町の厚みをつくりました。'
  },
  imabari:{
    title:'潮の速い海峡と港から、海事産業へ',
    body:'来島海峡の強い潮流は航海の制約である一方、波止浜などの待避・潮待ち需要を生みました。船が滞在することで修繕や船大工の技能が蓄積し、海運・船主資本・造船・舶用産業へと厚みを増していきます。別系統では、蒼社川の水と繊維技能がタオル産地を育てました。',
    chains:[
      ['急潮','潮待ち','修繕','造船・海運'],
      ['水資源','染晒','タオル','産地ブランド']
    ]
  },
  shimotsui:{
    title:'海だった土地から、綿とデニムの産地へ',
    body:'児島の浅海・干拓地では綿作が育ち、下津井などの港は肥料を受け入れ、木綿や塩を外へ出す物流を担いました。織布・縫製・染色の技能は、足袋、学生服、作業服、ジーンズへと製品を変えながら継承されました。',
    chains:[
      ['浅海・干拓','綿','織布・縫製','学生服','デニム'],
      ['北前船','肥料搬入','綿・木綿移出','港町商業']
    ]
  },
  tadotsu:{
    title:'港から鉄道へ、交通の中心はどう生き残ったか',
    body:'多度津は、北前船と金毘羅参詣で人と物が集まる港として発展し、その結節機能を近代の鉄道へ引き継ぎました。交通手段が船から鉄道へ変わっても、「人と物を集め、次の交通へ渡す」という地域能力が残った町として読むことができます。'
  },
  mitarai:{
    title:'「待つ時間」は、どうやって町の富になったか',
    body:'御手洗では、潮や風を待つ船が島の小さな港に滞在しました。その時間が宿、商店、問屋、茶屋、港湾施設への需要を生み、海上交通の摩擦そのものが町の経済を育てました。現在の町並みは、その滞留経済が建物として残ったものでもあります。'
  },
  ushimado:{
    title:'港は、交易だけでなく外交の舞台にもなった',
    body:'牛窓は、瀬戸内航路の港として船と物資を受け入れる一方、朝鮮通信使など対外交流の舞台にもなりました。海上交通の結節点であることが、物流だけでなく人・情報・文化を呼び込み、その蓄積が港町の歴史資産へ変わっています。'
  },
  tomonoura:{
    title:'潮を待つ時間が、港町を育てた',
    body:'鞆の浦では、瀬戸内の潮流が切り替わるまで船が待つ必要がありました。停泊する船と船員が、商業、宿泊、酒造、鍛冶などの仕事を生み、航海上の制約が港町の密度を高めました。'
  },
  mihara:{
    title:'海の要衝は、城下・工業・高速交通へどう更新されたか',
    body:'三原は瀬戸内の海上交通上の位置を城下町と港として使い、近代には工業と鉄道、現代には新幹線や空港への接続を重ねてきました。同じ場所の交通価値を、時代ごとに別のインフラへ更新してきた都市です。'
  },
  takehara:{
    title:'塩の利益は、なぜ町並みとして残ったか',
    body:'竹原では、干拓と製塩が生んだ富が酒造・廻船・商業へ再投資され、さらに町家や蔵へ固定されました。塩田が消えた後にも、産業で得た利益が建築と都市空間として残っている点が、この町を特徴づけます。'
  },
  matsuyama:{
    title:'城・温泉・港は、どう一つの都市になったか',
    body:'松山には、城下町としての行政・商業、道後温泉の観光、三津浜港の海上交通という異なる都市機能が近接して存在しました。近代鉄道がそれらを結び、複数の地域システムを束ねることで現在の県都が形成されました。'
  },
  shimonoseki:{
    title:'海峡は、なぜ市場と国際港を同じ場所に集めたか',
