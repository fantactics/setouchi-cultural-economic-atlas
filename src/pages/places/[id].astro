---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { places, claimLabels } from '../../data/places.js';

export function getStaticPaths() {
  return places.map((place) => ({
    params: { id: place.id },
    props: { place }
  }));
}
const { place } = Astro.props;
const sourceById = Object.fromEntries(place.sources.map((source) => [source.id, source]));
---
<BaseLayout title={`${place.name} | 瀬戸内文化経済アトラス`} description={place.subtitle}>
  <section class="place-hero">
    <div class="kicker">{place.prefecture}</div>
    <h1>{place.name}</h1>
    <p class="subtitle">{place.subtitle}</p>
    <ul class="tags">{place.tags.map((tag) => <li>{tag}</li>)}</ul>
  </section>

  <section class="section">
    <div class="kicker">18-LAYER CITY PROFILE</div>
    <h2>地域を18の層で読む</h2>
    <p class="lead">事実と解釈を分けながら、自然・歴史・産業・暮らしを一つの因果構造として読みます。</p>
    <div class="profile-grid">
      {place.sections.map(([title, body, type], i) => (
        <article class="profile-card">
          <div class="profile-num">{String(i + 1).padStart(2,'0')}</div>
          <div>
            <div class={`claim-badge ${type}`}>{claimLabels[type]}</div>
            {i === 2 ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/places/${place.id}/climate/`}>{title} →</a></h3>
            ) : i === 4 ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/transport/#place-${place.id}`}>{title} →</a></h3>
            ) : i === 5 ? (
              <h3><a class="profile-detail-link" href={`/setouchi-cultural-economic-atlas/seafood/#place-${place.id}`}>{title} →</a></h3>
            ) : (
              <h3>{title}</h3>
            )}
            <p>{body}</p>
            {place.sectionSources?.[i]?.length > 0 && (
              <div class="claim-sources">
                <span class="claim-sources-label">Sources</span>
                {place.sectionSources[i].map((sourceId) => {
                  const source = sourceById[sourceId];
                  return source ? (
                    <a href={source.url} target="_blank" rel="noreferrer" title={source.label}>{source.id}</a>
                  ) : null;
                })}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section gene-section">
    <div class="kicker">INDUSTRIAL GENES</div>
    <h2>産業遺伝子</h2>
    <p class="lead">現在の産業を、その成立経路まで遡って表示します。</p>
    <div class="grid">
      {place.genes.map((gene) => (
        <article class="card">
          <div class="kicker">{gene.type}</div>
          <h3>{gene.name}</h3>
          <div class="chain">
            {gene.chain.map((step, i) => (
              <>
                <span>{step}</span>
                {i < gene.chain.length - 1 && <b class="arrow">→</b>}
              </>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="kicker">SYNTHESIS</div>
    <h2>なぜこの町はこの町になったのか</h2>
    <div class="synthesis">{place.sections[17][1]}</div>
  </section>

  <section class="section sources-section">
    <div class="kicker">PRIMARY SOURCES</div>
    <h2>主な出典</h2>
    <p class="lead">自治体・気象庁等の一次情報を優先し、各記述カードから出典IDを追えるようにしています。解釈・仮説は、出典が示す事実を基礎に編集上の推論を加えたものです。</p>
    <div class="source-list">
      {place.sources.map((source) => (
        <a class="source-link" href={source.url} target="_blank" rel="noreferrer">
          <span>
            <b>{source.id}</b>　{source.label}
            <small>{source.publisher} / verified {source.verifiedAt}</small>
          </span>
          <span>↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
