  },
  yanai:{
    title:'交易の利益は、なぜ白壁の町になったか',
    body:'柳井では、瀬戸内交易で広がった商圏と商人資本が町家や蔵へ投資されました。現在の白壁の町並みは、単なる景観ではなく、かつての交易利益が都市空間へ固定された痕跡として読むことができます。'
  },
  hofu:{
    title:'遠浅の海岸を塩田に変えると、何が町に残るか',
    body:'三田尻では、周防灘の遠浅海岸を大規模な塩田へ変え、そこで作った塩を北前船で広域市場へ送りました。製塩が終わった後も、沿岸の土地と港湾機能が工業・物流へ再利用され、資源産業と交易の履歴が現在の都市構造に残っています。'
  },
  hiketa:{
    title:'風と潮を待つ港は、どう商家と醸造を育てたか',
    body:'引田では、風待ち・潮待ちを必要とする海上交通が港を重要な滞在地点にしました。港を核に城、商家、漁業、醸造が重なり、東讃の小さな港町に複数の生業と文化が蓄積しました。'
  },
  sakaide:{
    title:'塩田の土地は、どう巨大な工業地帯へ変わったか',
    body:'坂出では、製塩のために使われた広い沿岸平坦地と港湾条件が、塩田廃止後の埋立・工業用地へつながりました。塩という商品よりも、「海を陸へ変えて使う能力」が次の時代へ継承された町として見ることができます。'
  },
  takamatsu:{
    title:'港町は、どう海城・県都・四国の玄関口へ変わったか',
    body:'高松は、中世以来の港湾機能を基礎に海に面した城と城下町を整え、近代以降は鉄道・航路・行政機能を重ねて県都へ成長しました。海と陸の接続点という位置を、時代ごとに別の都市機能へ更新してきた町です。'
  },
  niihama:{
    title:'山の銅山から、海辺の工業都市へ',
    body:'別子銅山の採鉱から始まった産業は、運搬、製錬、機械修理、発電、化学へと機能を広げました。鉱山が閉じた後も、そこで蓄積した技術、企業、港湾、電力、取引関係が残り、非鉄・機械・化学を核とする工業都市へ引き継がれています。',
    chains:[
      ['銅鉱床','採鉱・製錬','非鉄素材'],
      ['鉱山需要','機械・電力・化学','工業都市']
    ]
  },
  shodoshima:{
    title:'外から来る原料を、島の価値へ変える',
    body:'小豆島は、島内で採れる原料だけで成り立った島ではありません。海運で大豆・小麦・ごまなどを受け入れ、発酵・製麺・製油・加工の技能によって高付加価値の商品へ変え、再び島外へ送り出してきました。'
  },
  iwakuni:{
    title:'川に分けられた城下町を、橋が一つの都市にした',
    body:'岩国では、錦川を防御線として横山と錦見に都市機能を分けたため、両岸を安定して結ぶ技術が不可欠でした。錦帯橋はその問題への答えであり、錦川の水運や流域産業とともに、川を隔てる力と結ぶ力の両方を地域形成に取り込んだ町です。'
  }
}
const story = storyById[place.id] || {
  title:'この地域は、どうできたか',
  body:place.sections[17][1]
};
const storyChains = story.chains || place.genes.map((gene)=>gene.chain);

