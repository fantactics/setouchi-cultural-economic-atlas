---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { places } from '../../data/places.js';

const eastToWestOrder=['hiketa','ako','shodoshima','ushimado','takamatsu','sakaide','shimotsui','tadotsu','tomonoura','niihama','onomichi','mihara','imabari','takehara','mitarai','matsuyama','iwakuni','yanai','hofu','shimonoseki'];
const eastToWestPlaces=eastToWestOrder.map((id)=>places.find((p)=>p.id===id)).filter(Boolean);
---
<BaseLayout
  title="地域から見る | SETOUCHI ATLAS"
  description="瀬戸内のまちを東から西へ。自然環境と人々の営みが、地域の現在をどう形づくったのかをたどる。"
>
  <section class="place-hero chapter-hero">
    <h1>地域から見る</h1>
    <p class="subtitle">瀬戸内のまちを東から西へ。地形、海、水、交通、生業、産業、文化がどう重なり、現在の姿になったのかを地域ごとにたどります。</p>
  </section>

  <section class="section place-index-story">
    <div class="place-index-intro">
      <h2>まちの成り立ちから読む</h2>
      <p>地域名を選ぶと、まず「なぜこの町はこの町になったのか」を読みます。その後に写真、関連する物語、産業の系譜が続き、ページの最後に自然・歴史・産業・暮らしなど18項目の地域データをまとめています。</p>
    </div>

    <div class="place-index-direction">
      <span>東</span>
      <b>→</b>
      <span>西</span>
    </div>

    <div class="place-index-grid">
      {eastToWestPlaces.map((place)=>(
        <a class="place-index-card place-index-story-card" href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>
          <div class="place-index-prefecture">{place.prefecture}</div>
          <h2>{place.name}</h2>
          <p class="place-index-subtitle">{place.subtitle}</p>
          <p class="place-index-causal">{place.sections[17][1]}</p>
          <span class="place-index-read">この地域を読む →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
