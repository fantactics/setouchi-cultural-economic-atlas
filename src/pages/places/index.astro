---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { places } from '../../data/places.js';
import { photoEvidence } from '../../data/photoEvidence.js';

const mainlandOrder=['ako','ushimado','shimotsui','tomonoura','onomichi','mihara','takehara','mitarai','iwakuni','yanai','hofu','shimonoseki'];
const shikokuOrder=['hiketa','shodoshima','takamatsu','sakaide','tadotsu','niihama','imabari','matsuyama'];
const mainlandPlaces=mainlandOrder.map((id)=>places.find((p)=>p.id===id)).filter(Boolean);
const shikokuPlaces=shikokuOrder.map((id)=>places.find((p)=>p.id===id)).filter(Boolean);
const photoById=Object.fromEntries(photoEvidence.map((photo)=>[photo.id,photo]));
const regionCoverPhotoIds={
  ako:'photo-ako-salt-terrace',
  ushimado:'photo-ushimado-islands',
  shimotsui:'photo-shimotsui-geography',
  tomonoura:'photo-tomonoura-port',
  onomichi:'photo-onomichi-panorama',
  mihara:'photo-mihara-castle-station',
  takehara:'photo-takehara-view',
  mitarai:'photo-mitarai-panorama',
  iwakuni:'photo-iwakuni-kintai',
  yanai:'photo-yanai-whitewall',
  hofu:'photo-hofu-salt-official',
  shimonoseki:'photo-shimonoseki-kanmon',
  hiketa:'photo-hiketa-townscape',
  shodoshima:'photo-shodoshima-olive-sea',
  takamatsu:'photo-takamatsu-seawater-moat',
  sakaide:'photo-sakaide-bannosu-aerial',
  tadotsu:'photo-tadotsu-station',
  niihama:'photo-niihama-tonaru',
  imabari:'photo-imabari-kurushima',
  matsuyama:'photo-matsuyama-city-view'
};
const coverPhotoFor=(place)=>photoById[regionCoverPhotoIds[place.id]] || null;
const indexLeadPhoto=photoById['photo-onomichi-panorama'];
const indexSidePhotos=[
  photoById['photo-imabari-kurushima'],
  photoById['photo-ako-salt-terrace']
].filter(Boolean);
---
<BaseLayout
  title="地域から見る | SETOUCHI ATLAS"
  description="都市名を入口に、地域エッセイ、関連する研究ノート、写真・基礎データ・出典を一つの地域ページからたどる。"
>
  <section class="places-index-cover">
    <div class="places-index-cover-grid">
      <div class="places-index-main-photo">
        {indexLeadPhoto && <img src={indexLeadPhoto.imageUrl} alt={indexLeadPhoto.alt} fetchpriority="high" />}
        <div class="places-index-photo-scrim"></div>
        <div class="places-index-cover-copy">
          <span class="places-index-kicker">REGIONS</span>
          <h1>地域から見る</h1>
          <p class="places-index-thesis">瀬戸内は、<br/>一つの地域ではない。</p>
          <p>海峡、干潟、斜面、河口、島、港。自然条件の違いに、人の技術と交易が重なって、それぞれ別の町が生まれました。</p>
          <a href="#place-directory">地域を選ぶ ↓</a>
        </div>
        {indexLeadPhoto && (
          <div class="places-index-photo-credit">
            {indexLeadPhoto.title} — Photo: {indexLeadPhoto.author}
          </div>
        )}
      </div>

      <div class="places-index-side-photos">
        {indexSidePhotos.map((photo)=>(
          <figure>
            <img src={photo.imageUrl} alt={photo.alt} loading="lazy" />
            <figcaption>{photo.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section region-layer-guide">
    <div class="region-layer-guide-grid">
      <article>
        <span>自然環境</span>
        <strong>人は、どんな土地と海に働きかけたのか</strong>
        <p>地図、地形、気候、水、生態系、自然制約を最初に確認します。</p>
      </article>
      <article>
        <span>エッセイ</span>
        <strong>この町は、なぜこの町になったのか</strong>
        <p>その地域固有の地形・交通・生業・産業のつながりを、因果の流れとして読みます。</p>
      </article>
      <article>
        <span>研究ノート</span>
        <strong>この町を、瀬戸内全体の中で考える</strong>
        <p>地形、水、港、産業、文化、都市など、複数地域を横断するテーマへ進みます。</p>
      </article>
      <article>
        <span>データ</span>
        <strong>根拠を、写真と基礎情報で確かめる</strong>
        <p>写真資料、18項目の地域データ、一次情報を中心とした出典を確認できます。</p>
      </article>
    </div>
  </section>

  <section class="section place-index-story region-directory" id="place-directory">
    <div class="place-index-intro">
      <h2>都市名から入る</h2>
      <p>近畿・中国地方を東から西へ、その後に四国地方を東から西へ並べています。都市名を選ぶと、地図と自然環境、その地域のエッセイ・研究ノート・データをまとめたページへ進みます。</p>
    </div>

    <div class="place-region-group">
      <div class="place-region-group-head">
        <h2>近畿・中国地方</h2>
        <span>東 → 西</span>
      </div>
      <div class="place-index-grid">
        {mainlandPlaces.map((place)=>(
          <a class="place-index-card place-index-story-card region-hub-card visual-region-card" href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>
            {coverPhotoFor(place) && (
              <div class="visual-region-card-photo">
                <img src={coverPhotoFor(place).imageUrl} alt={coverPhotoFor(place).alt} loading="lazy" />
              </div>
            )}
            <div class="visual-region-card-body">
            <div class="place-index-prefecture">{place.prefecture}</div>
            <h2>{place.name}</h2>
            <p class="place-index-subtitle">{place.subtitle}</p>
            <div class="region-layer-chips" aria-label="この地域ページの内容">
              <span>エッセイ</span><span>研究ノート</span><span>データ</span>
            </div>
            <p class="place-index-causal">{place.sections[17][1]}</p>
            <span class="place-index-read">地域ページを開く →</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="place-region-group">
      <div class="place-region-group-head">
        <h2>四国地方</h2>
        <span>東 → 西</span>
      </div>
      <div class="place-index-grid">
        {shikokuPlaces.map((place)=>(
          <a class="place-index-card place-index-story-card region-hub-card visual-region-card" href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>
            {coverPhotoFor(place) && (
              <div class="visual-region-card-photo">
                <img src={coverPhotoFor(place).imageUrl} alt={coverPhotoFor(place).alt} loading="lazy" />
              </div>
            )}
            <div class="visual-region-card-body">
            <div class="place-index-prefecture">{place.prefecture}</div>
            <h2>{place.name}</h2>
            <p class="place-index-subtitle">{place.subtitle}</p>
            <div class="region-layer-chips" aria-label="この地域ページの内容">
              <span>エッセイ</span><span>研究ノート</span><span>データ</span>
            </div>
            <p class="place-index-causal">{place.sections[17][1]}</p>
            <span class="place-index-read">地域ページを開く →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
