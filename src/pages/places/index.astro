---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionMap from '../../components/AtlasRegionMap.astro';
import { places } from '../../data/places.js';
import { hinasePlace } from '../../data/hinasePlace.js';
import { additionalPlaces } from '../../data/additionalPlaces.js';
import { photoEvidence } from '../../data/photoEvidence.js';

const allPlaces=[...places,hinasePlace,...additionalPlaces];
const mainlandOrder=['kada','akashi','ako','hinase','ushimado','shimotsui','tomonoura','onomichi','mihara','takehara','mitarai','iwakuni','yanai','hofu','shimonoseki'];
const shikokuOrder=['naruto','hiketa','shodoshima','takamatsu','sakaide','tadotsu','niihama','imabari','matsuyama'];
const mainlandPlaces=mainlandOrder.map((id)=>allPlaces.find((p)=>p.id===id)).filter(Boolean);
const shikokuPlaces=shikokuOrder.map((id)=>allPlaces.find((p)=>p.id===id)).filter(Boolean);
const photoById=Object.fromEntries(photoEvidence.map((photo)=>[photo.id,photo]));
const regionCoverPhotoIds={ako:'photo-ako-salt-terrace',hinase:'photo-hinase-bay',ushimado:'photo-ushimado-islands',shimotsui:'photo-shimotsui-geography',tomonoura:'photo-tomonoura-port',onomichi:'photo-onomichi-panorama',mihara:'photo-mihara-castle-station',takehara:'photo-takehara-view',mitarai:'photo-mitarai-panorama',iwakuni:'photo-iwakuni-kintai',yanai:'photo-yanai-whitewall',hofu:'photo-hofu-salt-official',shimonoseki:'photo-shimonoseki-kanmon',hiketa:'photo-hiketa-townscape',shodoshima:'photo-shodoshima-olive-sea',takamatsu:'photo-takamatsu-seawater-moat',sakaide:'photo-sakaide-bannosu-aerial',tadotsu:'photo-tadotsu-station',niihama:'photo-niihama-tonaru',imabari:'photo-imabari-kurushima',matsuyama:'photo-matsuyama-city-view'};
const coverPhotoFor=(place)=>photoById[regionCoverPhotoIds[place.id]] || null;
const leadPhoto=photoById['photo-onomichi-panorama'];
const groups=[{title:'近畿・中国地方',note:'東 → 西',items:mainlandPlaces},{title:'四国地方',note:'東 → 西',items:shikokuPlaces}];
---
<BaseLayout title="地域 | SETOUCHI ATLAS" description="地域における人間の可能性の変遷を、自然基盤、生業、技術、産業、文化、都市、暮らしの関係から縦に読む。">
  <section class="places-index-cover">
    <div class="places-index-cover-grid">
      <div class="places-index-main-photo">
        {leadPhoto && <img src={leadPhoto.imageUrl} alt={leadPhoto.alt} fetchpriority="high" />}
        <div class="places-index-photo-scrim"></div>
        <div class="places-index-cover-copy">
          <span class="places-index-kicker">REGIONS</span>
          <h1>地域から見る</h1>
          <p class="places-index-thesis">地域は、<br/>人の可能性と制約が変化してきた場所である。</p>
          <p>地形や海況、生態系、交通、技術、産業、制度の変化によって、この土地で人が得られるもの、できること、難しくなったことは変わってきました。地域ページでは、自然環境と人の営みの変化を重ねながら、時代ごとに人の可能性と制約がどう変わったのかをたどります。</p>
          <a href="#place-directory">地域を選ぶ ↓</a>
        </div>
      </div>
      <div class="places-index-side-photos">
        {[photoById['photo-imabari-kurushima'],photoById['photo-niihama-tonaru']].filter(Boolean).map((photo)=><figure><img src={photo.imageUrl} alt={photo.alt} loading="lazy"/><figcaption>{photo.title}</figcaption></figure>)}
      </div>
    </div>
  </section>

  <AtlasRegionMap places={allPlaces} actionHref="#place-directory" actionLabel="地域一覧へ" />

  <section class="section">
    <div class="page-intro-grid">
      <p class="big-question">「この町はなぜこの町になったのか」と、「そこで可能だった生き方はどう変わったのか」を読む。</p>
      <div class="body-copy">
        <p>地域ページは観光案内でも、地域振興の処方箋でもありません。自然環境、生態系、生業、技術、産業、文化、都市、制度の変化を追い、それによって人の暮らしや選択肢がどう変わったかを記述するための入口です。</p>
        <p>人口増加や産業成長を自動的に成功とはせず、人口減少や産業縮小を自動的に失敗ともみなしません。それぞれの変化が何を可能にし、何を難しくしたのかを、利得と損失の両面から確かめます。</p>
      </div>
    </div>
    <div class="reading-lens-grid">
      <div class="reading-lens"><span>01</span><strong>自然基盤</strong><p>地形・地質・水・気候・海況・生態系がつくる可能性と制約。</p></div>
      <div class="reading-lens"><span>02</span><strong>人の働きかけ</strong><p>生業・技術・交易・制度・土地改変が自然条件をどう読み替えたか。</p></div>
      <div class="reading-lens"><span>03</span><strong>可能になったこと</strong><p>働く、移動する、商う、つくる、住む、自然を利用するなど、地域が開いた選択肢。</p></div>
      <div class="reading-lens"><span>04</span><strong>失われた・難しくなったこと</strong><p>産業、交通、人口、環境の変化によって縮小した生業、文化、アクセス、生活上の選択肢。</p></div>
      <div class="reading-lens"><span>05</span><strong>新しく生まれた可能性</strong><p>技術、交通、市場、制度の変化によって、以前にはなかった生き方や仕事がどう生まれたか。</p></div>
      <div class="reading-lens"><span>06</span><strong>これから問われる選択</strong><p>何を大切にするかは分析から自動的には決まりません。未来の選択は、この変化を理解した先に置きます。</p></div>
    </div>
  </section>

  <section class="section gene-section">
    <div class="kicker">FROM PROFILE TO CHANGING POSSIBILITIES</div>
    <h2>地域ページも、更新され続ける。</h2>
    <p class="lead">SETOUCHI ATLASでは、地域の「正解」を一度で確定しません。現地観察、統計、土地利用、産業、世界の比較事例を重ね、新しい証拠が出れば仮説も地域の読み方も書き換えます。変化を観測し、地域と人との関係を更新して理解すること自体が研究対象です。</p>
    <div class="chapter-related-grid">
      <a class="compare-button" href="/setouchi-cultural-economic-atlas/about/">このアトラスの立場 →</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/methodology/">方法論を見る →</a>
    </div>
  </section>

  <section class="section place-index-story region-directory" id="place-directory">
    <div class="place-index-intro">
      <div class="kicker">DIRECTORY / 24 REGIONS</div>
      <h2>地域を選ぶ</h2>
      <p>東から西へ並べています。各ページでは、自然基盤から都市形成、産業・食文化、暮らし、現在の変化までを横断し、その地域で人が得られるもの・できることがどう変わってきたかを読みます。</p>
    </div>

    {groups.map((group)=>(
      <div class="place-region-group">
        <div class="place-region-group-head"><h2>{group.title}</h2><span>{group.note}</span></div>
        <div class="place-index-grid">
          {group.items.map((place)=>(
            <a class="place-index-card place-index-story-card region-hub-card visual-region-card" href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>
              {coverPhotoFor(place) && <div class="visual-region-card-photo"><img src={coverPhotoFor(place).imageUrl} alt={coverPhotoFor(place).alt} loading="lazy" /></div>}
              <div class="visual-region-card-body">
                <div class="place-index-prefecture">{place.prefecture}</div>
                <h2>{place.name}</h2>
                <p class="place-index-subtitle">{place.subtitle}</p>
                <div class="region-layer-chips" aria-label="この地域ページの内容"><span>自然基盤</span><span>形成過程</span><span>可能性と制約</span></div>
                {place.sections?.[17]?.[1] && <p class="place-index-causal">{place.sections[17][1]}</p>}
                <span class="place-index-read">地域ページを開く →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>