---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { researchChapters } from '../../data/researchChapters.js';
import { transportResearchChapters } from '../../data/transportResearchChapters.js';
import { reasoningEssays } from '../../data/reasoningEssays.js';

export function getStaticPaths() {
  return [...researchChapters,...transportResearchChapters].map((chapter)=>({
    params:{slug:chapter.slug},
    props:{chapter}
  }));
}
const { chapter } = Astro.props;
const labels={fact:'事実',interpretation:'解釈',hypothesis:'仮説'};
const relatedReasoning=reasoningEssays.filter((essay)=>essay.chapter.split('-').includes(chapter.number));
const dataHrefPrefixes=[
  '/setouchi-cultural-economic-atlas/climate/',
  '/setouchi-cultural-economic-atlas/wind-tide/',
  '/setouchi-cultural-economic-atlas/transect/',
  '/setouchi-cultural-economic-atlas/land-use/',
  '/setouchi-cultural-economic-atlas/transport/',
  '/setouchi-cultural-economic-atlas/industry/',
  '/setouchi-cultural-economic-atlas/gastronomy-matrix/',
  '/setouchi-cultural-economic-atlas/photos/',
  '/setouchi-cultural-economic-atlas/compare/',
  '/setouchi-cultural-economic-atlas/data/'
];
const relatedPages=(chapter.related || []).filter((item)=>!dataHrefPrefixes.some((prefix)=>item.href.startsWith(prefix)));
const sectionTitles=(chapter.sections || []).map((section)=>section.title);
const researchMeta={
  purpose: chapter.thesis,
  target: `${chapter.subtitle}。主に「${sectionTitles.slice(0,3).join('」「')}」を手掛かりに、関係する地域・自然条件・暮らし・制度・産業を対象として扱う。`,
  method: '事実・解釈・仮説を明示的に分け、複数地域と時間軸を比較する。個別事象を単独で説明せず、自然資本、人間の適応・改変、暮らし・生業、産業・文化・都市への波及という因果関係の中で検討する。',
  content: sectionTitles.length ? `本文では、${sectionTitles.map((title)=>`「${title}」`).join('、')}の順に論点を展開する。` : `本文では「${chapter.title}」を構成する主要論点を順に検討する。`
};
---
<BaseLayout title={`${chapter.title} | 研究ノート | SETOUCHI ATLAS`} description={chapter.subtitle} researchMeta={researchMeta}>
  <section class="place-hero chapter-hero research-note-hero">
    <a class="research-note-back" href="/setouchi-cultural-economic-atlas/chapters/">研究ノート一覧 ←</a>
    <h1>{chapter.title}</h1>
    <p class="subtitle">{chapter.subtitle}</p>
    <div class="chapter-thesis">{chapter.thesis}</div>
  </section>

  <section class="section chapter-intro">
    <h2>このテーマを考える理由</h2>
    {chapter.intro.map((p)=><p class="lead">{p}</p>)}
  </section>

  <section class="section chapter-toc">
    <h2>このノートで考えること</h2>
    <div class="chapter-toc-grid chapter-toc-plain">
      {chapter.sections.map((section,i)=>(
        <a href={`#section-${i+1}`}>{section.title}</a>
      ))}
    </div>
  </section>

  <section class="section chapter-body">
    {chapter.sections.map((section,i)=>(
      <article class="research-section" id={`section-${i+1}`}>
        <div class="research-section-head">
          <div class={`claim-badge ${section.claim}`}>{labels[section.claim] || section.claim}</div>
        </div>
        <h2>{section.title}</h2>
        <div class="research-copy">
          {section.paragraphs.map((p)=><p>{p}</p>)}
        </div>
        {section.chain?.length > 0 && (
          <div class="research-chain">
            <span>{section.chain.join(' → ')}</span>
          </div>
        )}
      </article>
    ))}
  </section>

  {relatedReasoning.length > 0 && (
    <section class="section chapter-reasoning">
      <h2>思考の道筋</h2>
      <p class="lead">結論だけでなく、どこで疑い、どの比較から説明を組み替えたかを読みます。</p>
      <div class="reasoning-chapter-grid">
        {relatedReasoning.map((essay)=>(
          <a class="reasoning-chapter-card" href={`/setouchi-cultural-economic-atlas/reasoning/${essay.slug}/`}>
            <h3>{essay.title}</h3>
            <p>{essay.question}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {chapter.sources?.length > 0 && (
    <section class="section book-sources">
      <h2>主な出典・参照資料</h2>
      <ol>
        {chapter.sources.map((source)=><li><a href={source.url} target="_blank" rel="noreferrer">{source.title}</a><span>{source.publisher}</span></li>)}
      </ol>
    </section>
  )}

  <section class="section chapter-related">
    <h2>関連する地域・概念へ</h2>
    <div class="chapter-related-grid">
      {relatedPages.map((item)=><a class="compare-button" href={item.href}>{item.label} →</a>)}
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/concepts/">概念辞典 →</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/chapters/">研究ノート一覧 →</a>
    </div>
  </section>
</BaseLayout>