---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/cycle-counterfactual.css';

const cases=[
  {
    name:'大三島',type:'サイクル幹線・成熟側',route:'しまなみ海道',
    population:'6,494 → 4,963人',period:'2010 → 2020',populationChange:'−23.6%',
    mobility:'本州―四国を結ぶ広域ルート上。橋で連続し、通過交通そのものが来訪を生む。',
    tourism:'しまなみブランド、レンタサイクル、宿泊、飲食、イベント、DMOが重層化。',
    people:'2020年の転入理由「起業」19.2%。2021年時点で飲食店48店の約半数が移住者経営と報告。',
    reading:'人口減少は止まっていないが、域外需要を相手にする事業者・移住創業者が入り、地域経済の構成が変化している可能性がある。'
  },
  {
    name:'瀬戸田・生口島',type:'サイクル幹線・滞在価値高度化',route:'しまなみ海道',
    population:'9,383 → 8,839人',period:'2015 → 2020',populationChange:'−5.8%',
    mobility:'尾道側から連続する主要経路。橋だけでなく港からもアクセスできる。',
    tourism:'古民家活用、高付加価値宿泊、飲食・アート等をサイクリング動線へ接続。',
    people:'人口は減る一方、観光客数だけでなく1人当たり観光消費額を追える地域。',
    reading:'「通過量」を「滞在価値」へ変換する民間投資が重要な変数になっている。'
  },
  {
    name:'大崎下島',type:'サイクルルート・捕捉形成途上',route:'とびしま海道',
    population:'2,169 → 1,748人',period:'2015 → 2020',populationChange:'−19.4%',
    mobility:'本土から橋で連続するが、しまなみのような本州―四国縦断の幹線性は弱い。',
    tourism:'御手洗という強い文化資産と良好な海岸景観を持つ。呉市は滞在時間・宿泊・観光消費の増加を政策課題化。',
    people:'島単位で継続的に追える消費・創業統計がまだ乏しい。',
    reading:'走行環境や景観品質だけでは、地域内消費へ自動転換しないことを検証する比較対象。'
  },
  {
    name:'大崎上島',type:'準対照群',route:'島内周回・フェリーアクセス',
    population:'8,448 → 7,158人',period:'2010 → 2020',populationChange:'−15.3%',
    mobility:'島一周約34〜35km。サイクリング適性は高いが、橋で他地域を貫く広域通過ルートではない。来島には船が必要。',
    tourism:'2019年までは年間8万人前後の観光入込。コロナ禍で3万人台へ落ち、その後は微増。',
    people:'移住者・地域おこし協力隊・教育関係者の流入があり、移住定住策や空き家バンクも展開。サイクリング以外の移住誘因が比較的明確。',
    reading:'自然条件と「自転車で走れる島」という条件をある程度共有しつつ、広域サイクル幹線化の上乗せ効果を考える準対照群として有効。'
  },
  {
    name:'上島町',type:'新規介入群',route:'ゆめしま海道',
    population:'6,598 → 6,171人',period:'2020 → 2024',populationChange:'−6.5%',
    mobility:'2022年3月の岩城橋開通で島間道路が連続。外部からは船で接続する。',
    tourism:'全線開通後にサイクリスト流入が増え、2025年度サイクルフリー利用は12,089台。',
    people:'来訪流は増えたが人口減少は継続。今後、宿泊・創業・空き家活用への転換を追える。',
    reading:'介入時点が新しく、今後の追跡調査に向く。大崎上島との比較で「橋による島内連結＋サイクルブランド」の効果を観察できる。'
  }
];

const hypotheses=[
  {no:'H1',title:'幹線性仮説',body:'同じ景観・走行適性でも、広域ルートの途中に位置する島ほど偶発的な来訪を大量に獲得しやすい。'},
  {no:'H2',title:'停止点仮説',body:'来訪者数より、食・宿・文化・体験・修理など「止まる理由」の密度が地域内消費を左右する。'},
  {no:'H3',title:'事業者厚み仮説',body:'観光需要を受け止める民間事業者が増えると、移住・創業が次の滞在価値を生み、自己強化ループが形成される。'},
  {no:'H4',title:'人口非対称仮説',body:'サイクルツーリズムは人口総数を反転させなくても、年齢・職業・起業者比率など「人口の構成」を変え得る。'},
  {no:'H5',title:'資産再評価仮説',body:'低速移動によって、路地、港、柑橘畑、石垣、古民家など自動車観光では通過される資産が経済価値を持つ。'},
  {no:'H6',title:'接続コスト仮説',body:'フェリー乗継、時刻、輪行、乗捨て可否などの摩擦が、同じ距離・景観でも来訪量と消費機会を大きく変える。'}
];

const kpis=[
  ['通行','年間サイクリスト数、外国人比率、ルート完走率'],
  ['停止','平均立寄地点数、平均停止時間、主要停止点別通行→入店率'],
  ['滞在','宿泊率、平均泊数、夜間滞在人口'],
  ['消費','1人当たり飲食・宿泊・物販・体験・交通支出'],
  ['事業','新規開業数、廃業数、サイクリスト売上比率、地元仕入率'],
  ['人材','移住者数、移住創業数、初回来訪契機、協力隊定着率'],
  ['資産','空き家転用件数、改修額、店舗・宿・工房化'],
  ['再投資','道路・港・景観・トイレ・休憩所等への公共・民間投資額']
];

const sources=[
  {label:'大崎上島町｜人口及び世帯数の推移',url:'https://www.town.osakikamijima.hiroshima.jp/soshiki/jumin/772.html'},
  {label:'広島県｜大崎上島町 交流定住ポータル',url:'https://www.pref.hiroshima.lg.jp/shi-machi/osakikamijimacho.html'},
  {label:'大崎上島町｜移住・定住支援ポータル',url:'https://iju-teiju.town.osakikamijima.hiroshima.jp/'},
  {label:'大崎上島町｜空き家バンク',url:'https://www.town.osakikamijima.hiroshima.jp/kurashi/sumai/1/1/2513.html'},
  {label:'大崎上島町｜地域公共交通計画（観光入込推移を含む）',url:'https://www.town.osakikamijima.hiroshima.jp/material/files/group/20/keikaku2.pdf'},
  {label:'今治市｜国勢調査',url:'https://www.city.imabari.ehime.jp/simingamannaka/tokei/kokuseichosa/'},
  {label:'IRC｜大三島の移住・起業',url:'https://www.iyoirc.jp/wp-content/uploads/2022/03/22-148.pdf'},
  {label:'上島町｜サイクルフリー令和7年度実績',url:'https://www.town.kamijima.lg.jp/soshiki/kanko-senryaku/27310.html'}
];
---
<BaseLayout title="サイクルルートの効果を、対照群から考える | SETOUCHI ATLAS" description="大三島・瀬戸田・大崎下島・大崎上島・上島町を比較し、サイクルルート固有の地域効果を準実験的に考える研究ノート。">
  <section class="cf-hero">
    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/%E5%A4%A7%E5%B4%8E%E4%B8%8A%E5%B3%B6.jpg" alt="瀬戸内海の大崎上島" fetchpriority="high" />
    <div class="cf-scrim"></div>
    <div class="cf-copy">
      <a href="/setouchi-cultural-economic-atlas/chapters/cycle-tourism-timeseries/">← 時系列データノート</a>
      <span>RESEARCH NOTE / COUNTERFACTUAL</span>
      <h1>サイクルルートが<br/>なかったら？</h1>
      <p>大崎上島を準対照群に置き、しまなみ・とびしま・ゆめしまで起きた変化のうち、どこまでが「島だから起きたこと」で、どこからがサイクルルートの上乗せ効果なのかを考えます。</p>
      <small>Photo: 00340 / Wikimedia Commons / CC BY-SA 3.0</small>
    </div>
  </section>

  <section class="section cf-intro">
    <span class="region-layer-label research">比較の考え方</span>
    <h2>「成功地域だけを見る」ことをやめる</h2>
    <div class="cf-prose">
      <p>しまなみ海道だけを見れば、観光客増、国際ブランド、飲食・宿泊、移住創業をすべてサイクルツーリズムの成果として語りたくなります。しかし、瀬戸内の島々ではサイクル政策がなくても、人口減少、移住、空き家活用、教育施策、産業転換、観光振興が同時に進んでいます。</p>
      <p>そこで、地形・気候・島嶼性・海岸景観が比較的近い<strong>大崎上島</strong>を「準対照群」として置きます。大崎上島も一周約34〜35kmでサイクリングに適しますが、しまなみのように本州と四国を結ぶ巨大な通過動線ではありません。この差を利用して、広域ルート化・ブランド化・接続性の上乗せ効果を考えます。</p>
    </div>
    <div class="cf-warning"><strong>注意</strong><p>これは厳密なDifference-in-Differencesではありません。各地域で人口規模、産業、教育、交通、観光資源が異なるため、現段階では「反実仮想を意識した比較設計」です。</p></div>
  </section>

  <section class="section cf-cases">
    <span class="region-layer-label data">比較ケース</span>
    <h2>人口減少は共通する。違うのは、その上に何が乗ったか</h2>
    <div class="cf-case-grid">
      {cases.map((item)=>(
        <article>
          <div class="cf-case-head"><span>{item.type}</span><h3>{item.name}</h3><small>{item.route}</small></div>
          <div class="cf-pop"><strong>{item.populationChange}</strong><span>{item.population}</span><small>{item.period}</small></div>
          <dl>
            <div><dt>接続・動線</dt><dd>{item.mobility}</dd></div>
            <div><dt>観光・事業</dt><dd>{item.tourism}</dd></div>
            <div><dt>人材</dt><dd>{item.people}</dd></div>
            <div><dt>読み</dt><dd>{item.reading}</dd></div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="section cf-contrast">
    <span class="region-layer-label research">大崎上島が教えること</span>
    <h2>「自転車で走れる島」と「サイクル経済圏」は違う</h2>
    <div class="cf-contrast-grid">
      <article><span>01</span><h3>景観は必要条件にすぎない</h3><p>大崎上島にも多島海景観と一周道路があります。それでも、しまなみ規模の来訪動線は生まれていません。景観品質だけでは来訪量を説明できません。</p></article>
      <article><span>02</span><h3>幹線性が偶発需要をつくる</h3><p>尾道から今治へ「通り抜ける」だけで複数島を訪れるしまなみと、船で目的地として入る大崎上島では、来訪の獲得コストが違います。</p></article>
      <article><span>03</span><h3>移住は自転車だけでは起きない</h3><p>大崎上島にも移住者・協力隊・カフェ経営者がいます。教育、地域コミュニティ、住宅支援など、サイクルツーリズム以外の移住経路を分離して考える必要があります。</p></article>
      <article><span>04</span><h3>人口総数より構成を見る</h3><p>サイクルルート地域でも対照地域でも人口は減少しています。差が表れやすいのは、創業者、若者、宿泊・飲食事業者、空き家利用者など人口・事業の「構成」です。</p></article>
    </div>
  </section>

  <section class="section cf-hypotheses">
    <span class="region-layer-label research">検証仮説</span>
    <h2>これから数字で潰していく6つの仮説</h2>
    <div class="cf-hypothesis-grid">
      {hypotheses.map((h)=><article><span>{h.no}</span><h3>{h.title}</h3><p>{h.body}</p></article>)}
    </div>
  </section>

  <section class="section cf-kpis">
    <span class="region-layer-label data">自治体向けKPI</span>
    <h2>通行台数から「地域に何が残ったか」へ</h2>
    <div class="cf-kpi-table-wrap"><table class="cf-kpi-table"><tbody>{kpis.map(([name,metric])=><tr><th>{name}</th><td>{metric}</td></tr>)}</tbody></table></div>
    <div class="cf-formula"><strong>1,000人のサイクリスト</strong><b>→</b><span>何泊</span><b>→</b><span>何食</span><b>→</b><span>何円</span><b>→</b><span>何件の再訪</span><b>→</b><span>何件の創業・空き家再生</span></div>
  </section>

  <section class="section cf-next">
    <span class="region-layer-label research">次の現地調査</span>
    <h2>大崎上島を「何も起きていない島」と見ない</h2>
    <div class="cf-prose"><p>対照群は「政策をしていない地域」ではありません。大崎上島には教育振興、移住支援、空き家バンク、地域おこし協力隊、観光・アウトドア施策があり、独自の変化が起きています。現地では、サイクル需要の有無だけでなく、<strong>何が移住者を呼び、何が店を成立させ、何が空き家を再利用させたのか</strong>を聞きます。</p></div>
    <div class="cf-field-grid">
      <article><strong>自転車客</strong><p>一周客の人数、滞在時間、フェリー持込台数、立寄地点。</p></article>
      <article><strong>店舗</strong><p>客の来島目的、サイクリスト比率、平均単価、繁忙期。</p></article>
      <article><strong>移住者</strong><p>初回来島の契機、移住理由、創業理由。自転車との関係を切り分ける。</p></article>
      <article><strong>住宅</strong><p>空き家バンク成約、改修、店舗転用、賃貸供給不足。</p></article>
      <article><strong>交通</strong><p>フェリー運賃・本数・自転車積載・港から集落への動線。</p></article>
      <article><strong>公共投資</strong><p>観光サイン、道路、休憩所、港、景観整備が何を目的に行われたか。</p></article>
    </div>
  </section>

  <section class="section cf-sources">
    <h2>主な資料</h2>
    <div class="source-list">{sources.map((source)=><a class="source-link" href={source.url} target="_blank" rel="noreferrer"><span>{source.label}</span><small>外部資料 ↗</small></a>)}</div>
  </section>
</BaseLayout>
