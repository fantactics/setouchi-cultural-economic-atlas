---
import BaseLayout from '../../layouts/BaseLayout.astro';

const coreResearch = [
  {
    no:'01', title:'自然制約への応答は、地域能力をどう形成するか',
    insight:'自然条件そのものだけでなく、制約への長期的な応答が、技術・制度・共同管理能力として地域に蓄積する可能性を検証する。',
    items:[
      ['少雨地域の水貯留と配分制度','讃岐の少雨条件に対し、ため池・水利慣行・広域用水がどのように生活可能性を組み替えたかを比較する。','/setouchi-cultural-economic-atlas/chapters/water-storage-allocation/'],
      ['地域別・動的自然資本の比較','自然資本の変化と人間の応答を22地域で比較し、同じ自然条件でも異なる地域構造が生まれる理由を探る。','/setouchi-cultural-economic-atlas/chapters/regional-dynamic-natural-capital/']
    ]
  },
  {
    no:'02', title:'移動量ではなく「停止と滞留」が地域価値を生むのではないか',
    insight:'交通量や来訪者数が増えても、停止・滞在・消費・関係継続へ変換されなければ地域内に価値は残らない、という仮説を港と観光の双方から検証する。',
    items:[
      ['潮待ち港の近代化と機能転換','鞆・御手洗・多度津・尾道を比較し、交通条件の変化後に港町の蓄積が何へ転換されたかを見る。','/setouchi-cultural-economic-atlas/chapters/waiting-ports-transition/'],
      ['港湾結節機能と都市資産の転換','交通摩擦が生んだ滞留・資本蓄積・都市形成が、交通高速化後にどう再利用されたかを比較する。','/setouchi-cultural-economic-atlas/chapters/port-node-urban-assets/'],
      ['シクロツーリズムの地域影響と時系列比較','走行者数ではなく、停止・宿泊・消費・再訪・所有・移住・創業への変換を比較する。','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-system/']
    ]
  },
  {
    no:'03', title:'産業は「工場」ではなく、能力の再結合によって継続するのではないか',
    insight:'産業転換を企業名や製品の交代としてではなく、技能・設備・資本・土地・港湾・顧客・制度が別用途へ再結合される過程として読む。',
    items:[
      ['瀬戸内産業の転換と能力継承','複数産業を横断し、何が失われ、何が次産業へ持ち越されたかを比較する。','/setouchi-cultural-economic-atlas/chapters/setouchi-industrial-transformation/'],
      ['塩田産業の地域資産継承','赤穂・竹原・坂出・三田尻で、塩業後に土地・港・資本・技術がどう残ったかを比較する。','/setouchi-cultural-economic-atlas/chapters/salt-fields-legacy/'],
      ['瀬戸内造船産業の形成・集積・再生産構造','造船所単体ではなく、船主・修繕・舶用工業・技能・金融の相互依存から産業集積の再生産を読む。','/setouchi-cultural-economic-atlas/chapters/shipbuilding-system/'],
      ['瀬戸内の地域資源循環','副産物・廃材・技能・物流を含め、地域内で資源価値が何段階に再利用されるかを比較する。','/setouchi-cultural-economic-atlas/chapters/regional-resource-circulation/']
    ]
  },
  {
    no:'04', title:'食文化は「名物」ではなく、資源と担い手の再生産系ではないか',
    insight:'料理名の分布ではなく、海・農地・漁法・加工・流通・調理・食べる場・所得が連結して初めて食文化が継続する、という見方を地域比較で検証する。',
    items:[
      ['沿岸食資源の価値形成','自然資源が漁法・養殖・加工・市場・料理を経て地域価値へ変わる経路を比較する。','/setouchi-cultural-economic-atlas/chapters/coastal-food-value-formation/'],
      ['食文化の再生産構造','資源、担い手、加工、食べる場、記憶、所得が食文化を維持する条件を整理・比較する。','/setouchi-cultural-economic-atlas/chapters/food-culture-reproduction/']
    ]
  },
  {
    no:'05', title:'人口減少下では「人口」より地域の利用強度を見るべきではないか',
    insight:'常住人口だけでは地域の実態を捉えられない。所有・滞在・消費・移動・公共負担・外部不経済を分解して、地域がどのように使われているかを測る。',
    items:[
      ['小規模離島の利用強度','鴻島等を念頭に、人口の少なさと利用の少なさを分け、別荘・滞在・公共負担を含めて測る。','/setouchi-cultural-economic-atlas/chapters/island-use-intensity/'],
      ['地域資産の再生産構造','資産価格ではなく、利用・維持・外部性・再利用可能性から地域資産が持続する条件を比較する。','/setouchi-cultural-economic-atlas/chapters/regional-asset-reproduction/'],
      ['瀬戸内の土地利用ライフサイクル','形成・利用・転換・退出・再利用という時間軸で土地利用を比較する。','/setouchi-cultural-economic-atlas/chapters/land-use-lifecycle/']
    ]
  },
  {
    no:'06', title:'巨大投資が地域価値を生む条件は「地域接続」にあるのではないか',
    insight:'投資額や立地件数そのものではなく、地元調達・人材・既存産業・計算資源利用・インフラ外部効果への接続度が地域効果を左右するという仮説を検証する。',
    items:[
      ['AIデータセンターの立地・地域接続・適地比較','「立地できるか」と「地域に何が残るか」を分け、瀬戸内の適地性と接続性を比較する。','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-system/'],
      ['瀬戸内Physical AIエコシステム','計算資源と製造・物流・港湾等の現場需要がどこで接続し得るかを整理する。','/setouchi-cultural-economic-atlas/chapters/physical-ai-player-ecosystem/']
    ]
  }
];

const sourceNotes=[
  ['地形・地理構造','/setouchi-cultural-economic-atlas/chapters/geography/'],
  ['気候・水循環','/setouchi-cultural-economic-atlas/chapters/climate-water/'],
  ['海と陸のエコシステム','/setouchi-cultural-economic-atlas/chapters/ecosystems/'],
  ['自然資源の生業化','/setouchi-cultural-economic-atlas/chapters/livelihoods/'],
  ['瀬戸内食文化の自然環境基盤','/setouchi-cultural-economic-atlas/chapters/gastronomy-environment/'],
  ['瀬戸内の港・交通・交易','/setouchi-cultural-economic-atlas/chapters/ports-trade/'],
  ['児島繊維産業の系譜','/setouchi-cultural-economic-atlas/chapters/kojima-textile-genealogy/'],
  ['福山デニム産業の系譜','/setouchi-cultural-economic-atlas/chapters/fukuyama-denim-genealogy/'],
  ['塩業から化学工業への産業転換','/setouchi-cultural-economic-atlas/chapters/shunan-soda-chemical-genealogy/'],
  ['別子銅山から化学工業への産業系譜','/setouchi-cultural-economic-atlas/chapters/niihama-industrial-genealogy/'],
  ['瀬戸内の都市・集落形成','/setouchi-cultural-economic-atlas/chapters/cities/'],
  ['瀬戸内の信仰・生活文化','/setouchi-cultural-economic-atlas/chapters/culture/']
];

const methods=[
  ['地域研究の方法論','/setouchi-cultural-economic-atlas/methodology/'],
  ['動的自然資本','/setouchi-cultural-economic-atlas/chapters/dynamic-natural-capital/'],
  ['自然資本と暮らしの共通分析フレーム','/setouchi-cultural-economic-atlas/chapters/natural-capital-lifestyle-framework/'],
  ['シクロツーリズム評価プロトコル','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-evaluation-protocol/'],
  ['産業研究の自然資本監査','/setouchi-cultural-economic-atlas/chapters/industry-natural-capital-audit/']
];
---
<BaseLayout title="研究ノート | SETOUCHI ATLAS" description="瀬戸内の地域比較から、新しい説明・仮説・知見を導く研究ノート。">
  <section class="research-index-hero">
    <div class="research-index-kicker">RESEARCH FINDINGS</div>
    <h1>研究ノート</h1>
    <p class="research-index-lead">瀬戸内の地域差と時間的変化を比較し、自然条件、人間の応答、暮らし、生業、産業、交通、制度の関係から、地域の成り立ちを説明する知見や仮説を検証します。</p>
  </section>

  <section class="research-program-intro">
    <article><div class="research-program-no">01</div><div><div class="research-program-label">研究目的</div><h2>瀬戸内の地域差から、説明可能な知見を導く</h2><p>個別地域の紹介を積み上げるだけでなく、複数地域・複数時点を比較し、自然条件、人間の応答、暮らし、生業、産業、交通、制度の関係から、他地域にも検証可能な説明や仮説を導きます。</p></div></article>
    <article><div class="research-program-no">02</div><div><div class="research-program-label">研究ノートの基準</div><h2>「情報がある」ではなく「比較から何かを言える」こと</h2><p>研究ノートでは、①研究上の問い、②比較対象、③根拠、④分析、⑤新しい知見または検証可能な仮説、⑥どこまで言えるか、を明示します。</p></div></article>
  </section>

  <section class="research-themes-head"><div class="research-index-kicker">CORE RESEARCH</div><h2>現在の中核研究</h2><p>現時点で比較分析以上まで進んでいるテーマです。各ブロックの冒頭には、現在検証している「知見候補」を置いています。</p></section>

  <div class="research-category-list">
    {coreResearch.map(group=><section class="research-category" id={`research-${group.no}`}>
      <header class="research-category-head"><span>{group.no}</span><div><h2>{group.title}</h2><p>{group.insight}</p></div></header>
      <div class="research-note-grid core-grid">{group.items.map(item=><a class="research-note-card" href={item[2]}><strong>{item[0]}</strong><p>{item[1]}</p><span>分析を見る →</span></a>)}</div>
    </section>)}

    <section class="research-category support-block">
      <header class="research-category-head"><span>B</span><div><h2>資料ノート</h2><p>研究の材料となる既知情報・地域史・自然条件・産業系譜の整理です。これ自体を研究成果とは扱いません。</p></div></header>
      <div class="support-links">{sourceNotes.map(item=><a href={item[1]}>{item[0]} →</a>)}</div>
    </section>

    <section class="research-category support-block">
      <header class="research-category-head"><span>A</span><div><h2>研究の方法</h2><p>何をどう見るか、どう比較・評価するかを定める方法論です。研究成果とは分離して扱います。</p></div></header>
      <div class="support-links">{methods.map(item=><a href={item[1]}>{item[0]} →</a>)}</div>
    </section>

    <section class="research-category support-block editorial-block">
      <header class="research-category-head"><span>E</span><div><h2>アトラスの編集方法</h2><p>研究内容ではなく、サイトの編集・更新・同期のための内部運用です。研究ノートでは「どう見るか」ではなく、比較と証拠から何がわかったかを主役にし、視点や方法論だけのページは研究の方法へ、既知情報の整理は資料ノートへ分けています。</p></div></header>
      <div class="support-links"><a href="/setouchi-cultural-economic-atlas/editorial-methodology/">アトラスの編集方法 →</a><a href="/setouchi-cultural-economic-atlas/research-workflow/">エッセイ→研究ノート更新フロー →</a></div>
    </section>
  </div>

  <style>
    .research-index-hero{max-width:1180px;margin:0 auto;padding:5.5rem 1.5rem 3rem;border-bottom:1px solid var(--line,#ddd)}.research-index-kicker{font-size:.72rem;letter-spacing:.18em;font-weight:700;opacity:.6;margin-bottom:1.2rem}.research-index-hero h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;margin:0 0 1.5rem}.research-index-lead{max-width:860px;font-size:1.18rem;line-height:1.9}.research-program-intro{max-width:1120px;margin:0 auto;padding:2rem 1.5rem 4rem}.research-program-intro>article{display:grid;grid-template-columns:70px 1fr;gap:1.25rem;padding:3rem 0;border-bottom:1px solid var(--line,#ddd)}.research-program-no{font-size:2.2rem;font-weight:800;opacity:.16}.research-program-label{font-size:.72rem;letter-spacing:.14em;font-weight:700;opacity:.55}.research-program-intro h2,.research-themes-head h2{font-size:clamp(2rem,4vw,3.2rem);margin:.3rem 0 1rem}.research-program-intro p,.research-themes-head p{max-width:860px;line-height:1.9}.research-themes-head{max-width:1120px;margin:0 auto;padding:4rem 1.5rem 1rem}.research-category-list{max-width:1180px;margin:0 auto;padding:0 1.5rem 6rem}.research-category{padding:4rem 0;border-top:1px solid var(--line,#ddd)}.research-category-head{display:grid;grid-template-columns:70px 1fr;gap:1.2rem;margin-bottom:2rem}.research-category-head>span{font-size:2.6rem;font-weight:700;opacity:.18}.research-category-head h2{font-size:clamp(1.8rem,3.6vw,3rem);margin:0 0 .8rem;max-width:900px}.research-category-head p{max-width:850px;line-height:1.8;opacity:.78}.research-note-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:.9rem;margin-left:90px}.research-note-card{display:flex;flex-direction:column;min-height:190px;padding:1.3rem;text-decoration:none;color:inherit;border:1px solid var(--line,#ddd);background:rgba(255,255,255,.76)}.research-note-card p{font-size:.92rem;line-height:1.7;opacity:.73;flex:1}.research-note-card span{font-size:.8rem;font-weight:700}.support-block{padding-top:3rem}.support-links{display:flex;gap:.6rem;flex-wrap:wrap;margin-left:90px}.support-links a{padding:.7rem .9rem;border:1px solid var(--line,#ddd);text-decoration:none;color:inherit;font-size:.86rem}.editorial-block{opacity:.82}@media(max-width:720px){.research-program-intro>article,.research-category-head{grid-template-columns:1fr}.research-note-grid,.support-links{margin-left:0}.research-index-hero{padding-top:3.5rem}}
  </style>
</BaseLayout>