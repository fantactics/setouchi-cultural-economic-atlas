---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = [
  {no:'01',title:'自然環境・生態系',description:'自然資本を固定的な背景ではなく、地殻変動・気候変動・水・海況・生態系の変化を含む動的な基盤として扱う。',groups:[
    {title:'動的自然資本',items:[{title:'動的自然資本――変わり続ける土地と、人間の応答',description:'地殻変動、海面変動、気候変動、生態系遷移によって変化する自然資本と、人間の適応・改変・暮らしの再編を読む。',href:'/setouchi-cultural-economic-atlas/chapters/dynamic-natural-capital/'}]},
    {title:'瀬戸内の地形・地理構造',items:[{title:'瀬戸内の地形・地理構造',description:'灘・湾・瀬戸・海峡、島嶼、地質、河川、平野、海底地形を地域差の基盤として読む。',href:'/setouchi-cultural-economic-atlas/chapters/geography/'}]},
    {title:'瀬戸内の気候・水循環',items:[
      {title:'瀬戸内の気候・水循環',description:'降水、風、河川、地下水、ため池、陸から海への水と物質の移動を読む。',href:'/setouchi-cultural-economic-atlas/chapters/climate-water/'},
      {title:'少雨地域の水貯留と配分制度',description:'讃岐のため池、水利慣行、香川用水から、少雨という自然制約を貯留・配分・連結によって組み替える仕組みを読む。',href:'/setouchi-cultural-economic-atlas/chapters/water-storage-allocation/'}
    ]},
    {title:'海と陸のエコシステム',items:[{title:'海と陸のエコシステム',description:'砂底・干潟・藻場・岩礁、森林・里山・段畑など、自然条件と人間利用が重なる生態系を読む。',href:'/setouchi-cultural-economic-atlas/chapters/ecosystems/'}]}
  ]},
  {no:'02',title:'生業・食文化',description:'自然資源を採取・栽培・加工し、商品や料理へ変換する人間の営みを扱う。',groups:[
    {title:'生業・資源利用',items:[{title:'自然資源の生業化',description:'塩、魚、柑橘、石、鉱物などを、技術・労働・制度・交易によって生業へ変換する過程を読む。',href:'/setouchi-cultural-economic-atlas/chapters/livelihoods/'}]},
    {title:'食文化',items:[
      {title:'瀬戸内食文化の自然環境基盤',description:'海域、魚介、農産物、漁法、加工、流通、調理の因果鎖を地域横断で読む。',href:'/setouchi-cultural-economic-atlas/chapters/gastronomy-environment/'},
      {title:'沿岸食資源の価値形成',description:'自然資源が漁法・養殖・加工・市場・料理を通じて地域価値へ変わる過程を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/coastal-food-value-formation/'},
      {title:'食文化の再生産構造',description:'資源、担い手、加工、食べる場、記憶、所得が地域の食文化を支える関係を追う。',href:'/setouchi-cultural-economic-atlas/chapters/food-culture-reproduction/'}
    ]}
  ]},
  {no:'03',title:'交通・交易・移動',description:'海運、港、鉄道、道路、自転車など、人・物・情報の移動と地域の結節構造を扱う。',groups:[
    {title:'港・海運・交易',items:[
      {title:'瀬戸内の港・交通・交易',description:'潮待ち、風待ち、積替え、参詣、修船、交易が港町と広域市場を結ぶ構造を読む。',href:'/setouchi-cultural-economic-atlas/chapters/ports-trade/'},
      {title:'潮待ち港の近代化と機能転換',description:'鞆・御手洗・多度津・尾道で、帆船時代の蓄積が近代交通へどう接続したかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/waiting-ports-transition/'},
      {title:'港湾結節機能と都市資産の転換',description:'交通摩擦が滞留・資本蓄積・都市形成を生み、交通転換後に何へ変わったかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/port-node-urban-assets/'}
    ]},
    {title:'シクロツーリズム',items:[{title:'シクロツーリズムの地域影響と時系列比較',description:'来訪、停止、滞在、消費、関係人口、移住、創業、景観、インフラへの影響を統合して読む。',href:'/setouchi-cultural-economic-atlas/chapters/cycle-tourism-system/',modules:[['地域影響','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-regional-impact/'],['時系列','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-timeseries/'],['経済・関係捕捉','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-capture/'],['評価方法','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-evaluation-protocol/']]}]}
  ]},
  {no:'04',title:'産業・技術・資源循環',description:'自然資本と暮らしの上に形成された産業の転換、技能・設備・資本の継承、企業間連鎖、循環設計、新しい技術基盤を扱う。',groups:[
    {title:'産業転換・能力継承',items:[
      {title:'瀬戸内産業の転換と能力継承',description:'自然資本を基層に置き、修理需要、企業技術、制度変更、市場などが能力形成をどう促し、次市場へ再結合されるかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-industrial-transformation/'},
      {title:'塩田産業の地域資産継承',description:'赤穂・竹原・坂出・三田尻で、能力、土地、港湾、資本がどう残ったかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/salt-fields-legacy/'}
    ]},
    {title:'造船・海事産業',items:[{title:'瀬戸内造船産業の形成・集積・再生産構造',description:'海峡・潮流・港湾条件が航海生活と修繕需要を生み、技能・船主資本・設備・企業間分業へつながる過程を扱う。',href:'/setouchi-cultural-economic-atlas/chapters/shipbuilding-system/',modules:[['自然資本と航海生活','/setouchi-cultural-economic-atlas/chapters/shipbuilding-natural-capital/'],['形成・集積','/setouchi-cultural-economic-atlas/chapters/setouchi-shipbuilding-cluster/'],['再生産モデル','/setouchi-cultural-economic-atlas/chapters/shipbuilding-reproduction-models/']]}]},
    {title:'繊維・衣料',items:[
      {title:'児島繊維産業の系譜',description:'干拓・綿作・紡績・学生服・ジーンズへ続く産業系譜を追う。',href:'/setouchi-cultural-economic-atlas/chapters/kojima-textile-genealogy/'},
      {title:'福山デニム産業の系譜',description:'備後絣・藍染・織布の技能がデニムへ接続する過程を追う。',href:'/setouchi-cultural-economic-atlas/chapters/fukuyama-denim-genealogy/'}
    ]},
    {title:'資源・化学・素材',items:[
      {title:'塩業から化学工業への産業転換',description:'塩田・港からソーダ、石油化学、高機能材料へ続く系譜を追う。',href:'/setouchi-cultural-economic-atlas/chapters/shunan-soda-chemical-genealogy/'},
      {title:'別子銅山から化学工業への産業系譜',description:'鉱山・製錬・煙害・硫黄回収から化学産業へ至る過程を追う。',href:'/setouchi-cultural-economic-atlas/chapters/niihama-industrial-genealogy/'}
    ]},
    {title:'資源循環・循環設計',items:[{title:'瀬戸内の地域資源循環',description:'食品副産物から児島デニムまで、用途適合、カスケード利用、物流、循環速度、循環設計を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/regional-resource-circulation/'}]},
    {title:'デジタル・AIインフラ',items:[
      {title:'AIデータセンターの立地・地域接続・適地比較',description:'自然資本、水・電力・土地・災害条件と地域生活との競合・補完を含め、通信・計算資源・地域接続まで評価する。',href:'/setouchi-cultural-economic-atlas/chapters/ai-datacenter-system/',modules:[['立地条件','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-ecosystem/'],['自然資本・暮らしとの関係','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-natural-capital/'],['適地比較','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-suitability-map/']]},
      {title:'瀬戸内Physical AIエコシステム',description:'GPU/DC、電力、通信、現場企業、制御、SI、大学・高専の接続を読む。',href:'/setouchi-cultural-economic-atlas/chapters/physical-ai-player-ecosystem/'}
    ]}
  ]},
  {no:'05',title:'都市・集落・土地利用',description:'都市・集落の形成と、干拓・埋立・再自然化など空間と土地利用の変化を扱う。',groups:[
    {title:'都市・集落形成',items:[{title:'瀬戸内の都市・集落形成',description:'港、企業、藩、商人、地形、交通の違いが都市形態をどう分けたかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/cities/'}]},
    {title:'土地利用・再自然化',items:[
      {title:'瀬戸内の土地利用ライフサイクル',description:'塩田、干拓地、農地、太陽光、別荘地を、形成・利用・終了・再利用・退出までの時間軸で読む。',href:'/setouchi-cultural-economic-atlas/chapters/land-use-lifecycle/'},
      {title:'瀬戸内ネイチャーポジティブ／戦略的再自然化',description:'人口減少、土地利用、生態系、防災を重ね、維持・低密度管理・生態系復元・自然遷移を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-nature-positive/',modules:[['スクリーニング','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-screening-map/'],['パイロット分析','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-pilot-fields/']]}
    ]}
  ]},
  {no:'06',title:'社会・暮らし・制度',description:'人口、居住、所有、公共サービス、地域経済など、人が地域を使い続ける社会的条件を扱う。',groups:[
    {title:'人口・居住・地域利用',items:[{title:'小規模離島の利用強度',description:'常住人口だけでなく、所有、居住、滞在、消費、移動、公共負担、外部不経済を分解して島を測る。',href:'/setouchi-cultural-economic-atlas/chapters/island-use-intensity/'}]},
    {title:'地域経済・資産再生産',items:[{title:'地域資産の再生産構造',description:'産業、食文化、町並み、観光などの地域資産が、利用されながら維持・更新される条件を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/regional-asset-reproduction/'}]}
  ]},
  {no:'07',title:'文化・信仰・地域認識',description:'信仰、祭礼、生活文化、景観、地域記憶など、人が土地に与えてきた意味と文化的蓄積を扱う。',groups:[
    {title:'信仰・祭礼・文化景観',items:[{title:'瀬戸内の信仰・生活文化',description:'神社ネットワーク、祭礼、生活技術、文化景観が地域社会に定着する過程を読む。',href:'/setouchi-cultural-economic-atlas/chapters/culture/'}]}
  ]}
];

const relatedResources=[
  {group:'方法',title:'SETOUCHI ATLAS 共通分析フレーム',description:'自然資本を基層、暮らしを中心、Flow/Capture/Reproductionを二次的レンズとして位置づける。',href:'/setouchi-cultural-economic-atlas/chapters/atlas-common-framework/'},
  {group:'方法',title:'産業研究の自然資本監査',description:'産業系ノートを自然資本→適応・改変→暮らし→産業化→自然へのフィードバックで再監査する。',href:'/setouchi-cultural-economic-atlas/chapters/industry-natural-capital-audit/'},
  {group:'方法',title:'産業形成を自然資本から読む',description:'自然資本を起点の一類型ではなく基層として扱い、企業・制度・市場との関係を整理する。',href:'/setouchi-cultural-economic-atlas/chapters/industry-dynamic-foundation/'},
  {group:'データ',title:'瀬戸内食資源マトリクス',description:'魚介・食資源を地域横断で比較するデータページ。',href:'/setouchi-cultural-economic-atlas/gastronomy-matrix/'},
  {group:'データ',title:'食文化ダッシュボード',description:'食資源と地域文化を比較する指標・可視化。',href:'/setouchi-cultural-economic-atlas/chapters/food-culture-dashboard/'},
  {group:'方法',title:'シクロツーリズム評価プロトコル',description:'地域影響を測る評価手順。',href:'/setouchi-cultural-economic-atlas/chapters/cycle-tourism-evaluation-protocol/'},
  {group:'方法',title:'シクロツーリズム反実仮想KPI',description:'整備がなかった場合との比較に使う評価指標。',href:'/setouchi-cultural-economic-atlas/chapters/cycle-tourism-counterfactual-kpi/'},
  {group:'方法',title:'エッセイ→研究ノート更新フロー',description:'エッセイの新知見を研究ノートへ蓄積する編集ルール。',href:'/setouchi-cultural-economic-atlas/research-workflow/'}
];
const noteCount=new Set(categories.flatMap(c=>c.groups.flatMap(g=>g.items.map(i=>i.href)))).size;
---
<BaseLayout title="研究ノート | SETOUCHI ATLAS" description="瀬戸内を7つの分析軸から読む研究ノート。動的自然資本を基層に、エッセイで得た知見を比較・統合して更新する。">
  <section class="research-index-hero"><div class="research-index-kicker">RESEARCH NOTES / STRUCTURED INDEX</div><h1>研究ノート</h1><p class="research-index-lead">エッセイで生まれた問い・データ・仮説を、比較可能な知見として蓄積する場所です。自然資本そのものも時間とともに変動するという前提に立ち、土地と人間の暮らしの関係から各テーマを読みます。</p><div class="research-index-meta"><strong>{categories.length}</strong><span>大カテゴリ</span><strong>{noteCount}</strong><span>個別ノート</span></div></section>
  <nav class="research-major-nav" aria-label="研究ノート大カテゴリ">{categories.map(c=><a href={`#research-${c.no}`}><span>{c.no}</span>{c.title}</a>)}</nav>
  <section class="research-index-guide"><strong>分類とタイトルのルール</strong><p>自然資本を各分析の基層、暮らしと生業を中心に置きます。産業・交通・都市・文化は土地と人間の関係の表出として扱い、自然変動・人為改変・可能性と制約の変化を区別して記述します。</p></section>
  <div class="research-category-list">
    {categories.map(c=><section class="research-category" id={`research-${c.no}`}><header class="research-category-head"><span>{c.no}</span><div><h2>{c.title}</h2><p>{c.description}</p></div></header><div class="research-middle-list">{c.groups.map(g=><section class="research-middle"><h3>{g.title}</h3><div class="research-note-grid">{g.items.map(i=><article class="research-note-card-wrap"><a class="research-note-card" href={i.href}><strong>{i.title}</strong><p>{i.description}</p><span>研究ノートを開く →</span></a>{i.modules&&<div class="research-module-links">{i.modules.map(m=><a href={m[1]}>{m[0]} →</a>)}</div>}</article>)}</div></section>)}</div></section>)}
    <section class="research-category related-resources"><header class="research-category-head"><span>＋</span><div><h2>関連データ・方法</h2><p>比較・検証・更新を支えるデータページと方法論。</p></div></header><div class="research-middle-list">{['データ','方法'].map(name=><section class="research-middle"><h3>{name}</h3><div class="research-note-grid">{relatedResources.filter(i=>i.group===name).map(i=><a class="research-note-card" href={i.href}><strong>{i.title}</strong><p>{i.description}</p><span>{name}を見る →</span></a>)}</div></section>)}</div></section>
  </div>
  <style>
    .research-index-hero{max-width:1180px;margin:0 auto;padding:5.5rem 1.5rem 3rem;border-bottom:1px solid var(--line,#ddd)}.research-index-kicker{font-size:.72rem;letter-spacing:.18em;font-weight:700;opacity:.6;margin-bottom:1.2rem}.research-index-hero h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;margin:0 0 1.5rem}.research-index-lead{max-width:760px;font-size:1.12rem;line-height:1.9}.research-index-meta{display:flex;gap:.7rem 1.2rem;align-items:baseline;flex-wrap:wrap;margin-top:2rem}.research-index-meta strong{font-size:2rem}.research-index-meta span{font-size:.82rem;opacity:.65;margin-right:1rem}.research-major-nav{max-width:1180px;margin:0 auto;padding:1.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.6rem}.research-major-nav a{display:flex;gap:.8rem;align-items:center;padding:.9rem 1rem;border:1px solid var(--line,#ddd);text-decoration:none;color:inherit}.research-major-nav span{font-size:.72rem;opacity:.5}.research-index-guide{max-width:1120px;margin:1rem auto 3rem;padding:1.2rem 1.4rem;background:rgba(120,120,120,.07)}.research-index-guide p{margin:.35rem 0 0;line-height:1.7}.research-category-list{max-width:1180px;margin:0 auto;padding:0 1.5rem 6rem}.research-category{padding:4rem 0;border-top:1px solid var(--line,#ddd);scroll-margin-top:5rem}.research-category-head{display:grid;grid-template-columns:70px 1fr;gap:1.2rem;margin-bottom:2.4rem}.research-category-head>span{font-size:2.6rem;font-weight:700;opacity:.18}.research-category-head h2{font-size:clamp(2rem,4vw,3.2rem);margin:0 0 .8rem}.research-category-head p{max-width:760px;line-height:1.8;opacity:.75}.research-middle-list{display:grid;gap:2.8rem;margin-left:90px}.research-middle h3{font-size:1.25rem;padding-bottom:.7rem;border-bottom:1px solid var(--line,#ddd)}.research-note-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:.8rem}.research-note-card-wrap{border:1px solid var(--line,#ddd)}.research-note-card{display:flex;flex-direction:column;min-height:170px;padding:1.25rem;text-decoration:none;color:inherit;border:1px solid var(--line,#ddd)}.research-note-card-wrap>.research-note-card{border:0}.research-note-card p{font-size:.9rem;line-height:1.65;opacity:.72;flex:1}.research-note-card span{font-size:.8rem;font-weight:700}.research-module-links{display:flex;gap:.5rem;flex-wrap:wrap;padding:0 1.25rem 1rem}.research-module-links a{font-size:.76rem;color:inherit;opacity:.7}.related-resources{margin-top:1rem}@media(max-width:720px){.research-category-head{grid-template-columns:1fr}.research-middle-list{margin-left:0}.research-index-hero{padding-top:3.5rem}}
  </style>
</BaseLayout>
