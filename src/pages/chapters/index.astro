---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  notebookUpdated,
  notebookPrinciples,
  notebookEntries,
  notebookArchiveGroups
} from '../../data/researchWritingNotebook.js';
import '../../styles/research-notebook.css';

const root='/setouchi-cultural-economic-atlas/';
const articleUrl=(slug)=>root+'book/'+slug+'/';
const noteUrl=(slug)=>root+'chapters/'+slug+'/';
---
<BaseLayout title="調査と研究ノート | SETOUCHI ATLAS" description="風景から生まれた疑問を調べ、得られた知見と未解決の問いを次のエッセイにつなぐ、更新し続けるSETOUCHI ATLASの研究ノート。">
  <div class="working-notebook">
    <header class="working-notebook-hero">
      <p class="working-notebook-kicker">QUESTIONS FROM THE LANDSCAPE</p>
      <h1>調査と研究ノート</h1>
      <p class="working-notebook-lead">風景の不思議から始め、地図や史料をたどり、別の土地と比べてみる。調べてわかったことも、まだわからないことも、次の旅とエッセイの手掛かりとして残していきます。</p>
      <nav class="working-notebook-shortcuts" aria-label="このページの目次">
        <a href="#research-method">調査の姿勢</a>
        <a href="#research-findings">蓄積された知見</a>
        <a href="#research-library">研究・資料ノート</a>
      </nav>
    </header>

    <section class="working-notebook-method" id="research-method" aria-labelledby="working-notebook-method-title">
      <div class="working-notebook-heading">
        <p class="working-notebook-kicker">OUR APPROACH</p>
        <h2 id="working-notebook-method-title">調査の姿勢</h2>
        <p>四つの共通姿勢だけを置きます。観光、産業、食文化などに固有の評価手法を、すべてのエッセイの原則にはしません。</p>
      </div>
      <div class="working-notebook-principles">
        {notebookPrinciples.map(([title,body],index)=>(
          <article>
            <span>{String(index+1).padStart(2,'0')}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="working-notebook-knowledge" id="research-findings" aria-labelledby="working-notebook-knowledge-title">
      <div class="working-notebook-heading">
        <p class="working-notebook-kicker">A GROWING LIBRARY OF FINDINGS</p>
        <h2 id="working-notebook-knowledge-title">次のエッセイへつながる知見</h2>
        <p>完成した理論の一覧ではありません。既存のエッセイを通じて見えてきたことと、今後の調査で確かめたいことを、テーマごとに蓄積しています。各項目の根拠は、リンク先のエッセイと研究ノートを参照できます。</p>
      </div>
      <nav class="working-notebook-topic-nav" aria-label="知見のテーマ">
        {notebookEntries.map((entry)=><a href={'#note-'+entry.id}>{entry.title}</a>)}
      </nav>

      <div class="working-notebook-topics">
        {notebookEntries.map((entry,index)=>(
          <details class="working-notebook-topic" id={'note-'+entry.id} open={index===0}>
            <summary>
              <span class="working-notebook-topic-number">{String(index+1).padStart(2,'0')}</span>
              <span class="working-notebook-topic-summary">
                <strong>{entry.title}</strong>
                <small>{entry.question}</small>
              </span>
              <span class="working-notebook-topic-toggle" aria-hidden="true">＋</span>
            </summary>
            <div class="working-notebook-topic-body">
              <div class="working-notebook-topic-columns">
                <section>
                  <h4>現時点で見えていること</h4>
                  <p>{entry.finding}</p>
                </section>
                <section>
                  <h4>次に確かめたいこと</h4>
                  <ul>{entry.next.map((q)=><li>{q}</li>)}</ul>
                </section>
              </div>
              <div class="working-notebook-writing-prompt"><strong>次の執筆に使うなら</strong><p>{entry.use}</p></div>
              <div class="working-notebook-reference-grid">
                <section>
                  <h4>発見の入口になったエッセイ</h4>
                  <ul>{entry.essays.map(([title,slug])=>(
                    <li><a href={articleUrl(slug)}>{title}<span aria-hidden="true">↗</span></a></li>
                  ))}</ul>
                </section>
                <section>
                  <h4>関連する研究・比較資料</h4>
                  <ul>{entry.research.map(([title,slug])=>(
                    <li><a href={noteUrl(slug)}>{title}<span aria-hidden="true">↗</span></a></li>
                  ))}</ul>
                </section>
              </div>
              {entry.sources.length>0 && (
                <div class="working-notebook-primary-sources">
                  <h4>一次資料への入口</h4>
                  {entry.sources.map(([title,url])=><a href={url} target="_blank" rel="noopener noreferrer">{title}<span aria-hidden="true">↗</span></a>)}
                </div>
              )}
            </div>
          </details>
        ))}
      </div>
      <p class="working-notebook-updated">知見カードの整理日：<time datetime={notebookUpdated}>{notebookUpdated}</time>。調査の進展に応じて内容を更新します。</p>
    </section>

    <section class="working-notebook-library" id="research-library" aria-labelledby="working-notebook-library-title">
      <div class="working-notebook-heading">
        <p class="working-notebook-kicker">REFERENCE & SPECIALIST NOTES</p>
        <h2 id="working-notebook-library-title">研究・資料ノートの書架</h2>
        <p>個別の比較研究や初期の資料、観光・産業・地域政策の専門的な分析手法は、ここから参照できます。専門的なモデルは適用できる分野でだけ使い、新しい風景に当てはめるための定説とはしません。</p>
      </div>
      <div class="working-notebook-library-groups">
        {notebookArchiveGroups.map((group)=>(
          <details class="working-notebook-library-group">
            <summary>
              <span>{group.title}</span>
              <small>{group.items.length}件</small>
              <span aria-hidden="true">＋</span>
            </summary>
            <ul>
              {group.items.map(([title,slug])=><li><a href={noteUrl(slug)}>{title}<span aria-hidden="true">↗</span></a></li>)}
            </ul>
          </details>
        ))}
      </div>
    </section>

    <section class="working-notebook-end">
      <h2>知見は、次の風景へ</h2>
      <p>一つの地域を調べると、別の土地を訪ねたくなる。研究ノートではその過程と結果を残します。新しい事実が出てくれば、以前の説明も更新していきます。</p>
      <a href="/setouchi-cultural-economic-atlas/book/">エッセイから旅を始める <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>