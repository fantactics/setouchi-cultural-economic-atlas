---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = [
  {
    no:'01', title:'自然環境・生態系',
    description:'人間の利用や政策判断に先立つ、地形・気候・水・海況・生態系という基盤条件を扱う。',
    groups:[
      {title:'瀬戸内の地形・地理構造',items:[
        {title:'瀬戸内の地形・地理構造',description:'灘・湾・瀬戸・海峡、島嶼、地質、河川、平野、海底地形を地域差の基盤として読む。',href:'/setouchi-cultural-economic-atlas/chapters/geography/'}
      ]},
      {title:'瀬戸内の気候・水循環',items:[
        {title:'瀬戸内の気候・水循環',description:'降水、風、河川、地下水、ため池、陸から海への水と物質の移動を読む。',href:'/setouchi-cultural-economic-atlas/chapters/climate-water/'}
      ]},
      {title:'海と陸のエコシステム',items:[
        {title:'海と陸のエコシステム',description:'砂底・干潟・藻場・岩礁、森林・里山・段畑など、自然条件と人間利用が重なる生態系を読む。',href:'/setouchi-cultural-economic-atlas/chapters/ecosystems/'}
      ]}
    ]
  },
  {
    no:'02', title:'生業・食文化',
    description:'自然資源を採取・栽培・加工し、商品や料理へ変換する人間の営みを扱う。',
    groups:[
      {title:'生業・資源利用',items:[
        {title:'自然資源の生業化',description:'塩、魚、柑橘、石、鉱物などを、技術・労働・制度・交易によって生業へ変換する過程を読む。',href:'/setouchi-cultural-economic-atlas/chapters/livelihoods/'}
      ]},
      {title:'食文化',items:[
        {title:'瀬戸内食文化の自然環境基盤',description:'海域、魚介、農産物、漁法、加工、流通、調理の因果鎖を地域横断で読む。',href:'/setouchi-cultural-economic-atlas/chapters/gastronomy-environment/'},
        {title:'食文化の再生産構造',description:'資源、担い手、加工、食べる場、記憶、所得が地域の食文化を支える関係を追う。',href:'/setouchi-cultural-economic-atlas/chapters/food-culture-reproduction/'}
      ]}
    ]
  },
  {
    no:'03', title:'交通・交易・移動',
    description:'海運、港、鉄道、道路、自転車など、人・物・情報の移動と地域の結節構造を扱う。',
    groups:[
      {title:'港・海運・交易',items:[
        {title:'瀬戸内の港・交通・交易',description:'潮待ち、風待ち、積替え、参詣、修船、交易が港町と広域市場を結ぶ構造を読む。',href:'/setouchi-cultural-economic-atlas/chapters/ports-trade/'},
        {title:'潮待ち港の近代化と機能転換',description:'鞆・御手洗・多度津・尾道で、帆船時代の蓄積が近代交通へどう接続したかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/waiting-ports-transition/'}
      ]},
      {title:'シクロツーリズム',items:[
        {title:'シクロツーリズムの地域影響と時系列比較',description:'来訪、滞在、消費、移住、創業、景観、インフラへの影響を、地域比較と整備前後の時系列で統合して読む。',href:'/setouchi-cultural-economic-atlas/chapters/cycle-tourism-system/',modules:[
          ['地域影響の詳細','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-regional-impact/'],
          ['時系列データ','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-timeseries/'],
          ['評価プロトコル','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-evaluation-protocol/'],
          ['反実仮想KPI','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-counterfactual-kpi/']
        ]}
      ]}
    ]
  },
  {
    no:'04', title:'産業・技術・資源循環',
    description:'産業の形成と転換、技能・設備・資本の継承、企業間連鎖、副産物循環、新しい技術基盤を扱う。',
    groups:[
      {title:'産業転換・能力継承',items:[
        {title:'瀬戸内産業の転換と能力継承',description:'商品が変わっても残る技能、設備、企業、取引関係、教育、問題解決能力を横断的に読む。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-industrial-transformation/'},
        {title:'塩田産業の地域資産継承',description:'赤穂・竹原・坂出・三田尻で、能力、土地、港湾、資本がどう残ったかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/salt-fields-legacy/'}
      ]},
      {title:'造船・海事産業',items:[
        {title:'瀬戸内造船産業の形成・集積・再生産構造',description:'海運需要、技能、資本、設備、企業間分業が形成され、ショック後に次の需要へ再結合されるまでを一つの研究として扱う。',href:'/setouchi-cultural-economic-atlas/chapters/shipbuilding-system/',modules:[
          ['形成・集積の詳細','/setouchi-cultural-economic-atlas/chapters/setouchi-shipbuilding-cluster/'],
          ['再生産モデル','/setouchi-cultural-economic-atlas/chapters/shipbuilding-reproduction-models/'],
          ['今治','/setouchi-cultural-economic-atlas/chapters/imabari-maritime-cluster/'],
          ['因島・尾道','/setouchi-cultural-economic-atlas/chapters/onomichi-innoshima-skill-ecosystem/'],
          ['呉','/setouchi-cultural-economic-atlas/chapters/kure-state-led-industrial-transition/'],
          ['玉野','/setouchi-cultural-economic-atlas/chapters/tamano-company-town-shipbuilding/']
        ]}
      ]},
      {title:'繊維・衣料',items:[
        {title:'児島繊維産業の系譜',description:'干拓・綿作・紡績・学生服・ジーンズへ続く産業系譜を追う。',href:'/setouchi-cultural-economic-atlas/chapters/kojima-textile-genealogy/'},
        {title:'福山デニム産業の系譜',description:'備後絣・藍染・織布の技能がデニムへ接続する過程を追う。',href:'/setouchi-cultural-economic-atlas/chapters/fukuyama-denim-genealogy/'}
      ]},
      {title:'資源・化学・素材',items:[
        {title:'塩業から化学工業への産業転換',description:'塩田・港からソーダ、石油化学、高機能材料へ続く系譜を追う。',href:'/setouchi-cultural-economic-atlas/chapters/shunan-soda-chemical-genealogy/'},
        {title:'別子銅山から化学工業への産業系譜',description:'鉱山・製錬・煙害・硫黄回収から化学産業へ至る過程を追う。',href:'/setouchi-cultural-economic-atlas/chapters/niihama-industrial-genealogy/'}
      ]},
      {title:'資源循環・副産物利用',items:[
        {title:'瀬戸内の地域資源循環',description:'牡蠣殻、魚の鱗・残渣、オリーブ粕、醤油粕、柑橘残渣・剪定枝を比較し、副産物が次の生産系の資源へ変わる条件を整理する。',href:'/setouchi-cultural-economic-atlas/chapters/regional-resource-circulation/'}
      ]},
      {title:'デジタル・AIインフラ',items:[
        {title:'AIデータセンターの立地・地域接続・適地比較',description:'電力、通信、冷却、土地、災害条件と地域産業への接続を一体で評価し、瀬戸内の地域類型を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/ai-datacenter-system/',modules:[
          ['立地条件・エコシステム','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-ecosystem/'],
          ['瀬戸内適地比較','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-suitability-map/']
        ]},
        {title:'瀬戸内Physical AIエコシステム',description:'GPU/DC、電力、通信、現場企業、制御、SI、大学・高専の接続を読む。',href:'/setouchi-cultural-economic-atlas/chapters/physical-ai-player-ecosystem/'}
      ]}
    ]
  },
  {
    no:'05', title:'都市・集落・土地利用',
    description:'都市・集落の形成と、干拓・埋立・再自然化など空間と土地利用の変化を扱う。',
    groups:[
      {title:'都市・集落形成',items:[
        {title:'瀬戸内の都市・集落形成',description:'港、企業、藩、商人、地形、交通の違いが都市形態をどう分けたかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/cities/'}
      ]},
      {title:'土地利用・再自然化',items:[
        {title:'瀬戸内ネイチャーポジティブ／戦略的再自然化',description:'人口減少、土地利用、生態系、防災を重ね、維持・低密度管理・生態系復元・自然遷移を比較する統合研究。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-nature-positive/',modules:[
          ['スクリーニング設計','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-screening-map/'],
          ['パイロット分析単位','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-pilot-fields/']
        ]}
      ]}
    ]
  },
  {
    no:'06', title:'社会・暮らし・制度',
    description:'人口、居住、所有、公共サービス、地域経済など、人が地域を使い続ける社会的条件を扱う。',
    groups:[
      {title:'人口・居住・地域利用',items:[
        {title:'小規模離島の利用強度',description:'常住人口だけでなく、所有、居住、滞在、消費、移動、公共負担を分解して島の利用実態を測る。',href:'/setouchi-cultural-economic-atlas/chapters/island-use-intensity/'}
      ]},
      {title:'地域経済・資産再生産',items:[
        {title:'地域資産の再生産構造',description:'産業、食文化、町並み、観光などの地域資産が、利用されながら維持・更新される条件を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/regional-asset-reproduction/'}
      ]}
    ]
  },
  {
    no:'07', title:'文化・信仰・地域認識',
    description:'信仰、祭礼、生活文化、景観、地域記憶など、人が土地に与えてきた意味と文化的蓄積を扱う。',
    groups:[
      {title:'信仰・祭礼・文化景観',items:[
        {title:'瀬戸内の信仰・生活文化',description:'神社ネットワーク、祭礼、生活技術、文化景観が地域社会に定着する過程を読む。',href:'/setouchi-cultural-economic-atlas/chapters/culture/'}
      ]}
    ]
  }
];

const relatedResources = [
  {group:'データ',title:'瀬戸内食資源マトリクス',description:'魚介・食資源を地域横断で比較するデータページ。',href:'/setouchi-cultural-economic-atlas/gastronomy-matrix/'},
  {group:'データ',title:'食文化ダッシュボード',description:'食資源と地域文化を比較するための指標・可視化。',href:'/setouchi-cultural-economic-atlas/chapters/food-culture-dashboard/'},
  {group:'方法',title:'エッセイ→研究ノート更新フロー',description:'新しいエッセイで得た知見を、関連研究ノートへ追記・修正・再構成する編集ルール。',href:'/setouchi-cultural-economic-atlas/research-workflow/'}
];

const noteCount = new Set(categories.flatMap((category)=>category.groups.flatMap((group)=>group.items.map((item)=>item.href)))).size;
---
<BaseLayout title="研究ノート | SETOUCHI ATLAS" description="瀬戸内を7つの分析軸から読む研究ノート。重複する研究は統合研究ノートを正本とし、詳細分析をモジュールとして接続する。">
  <section class="research-index-hero">
    <div class="research-index-kicker">RESEARCH NOTES / STRUCTURED INDEX</div>
    <h1>研究ノート</h1>
    <p class="research-index-lead">研究対象ごとに知見を蓄積する正本です。内容が重なる研究は統合研究ノートへまとめ、既存の詳細ページは分析モジュール・地域ケースとして残します。</p>
    <div class="research-index-meta"><strong>{categories.length}</strong><span>大カテゴリ</span><strong>{noteCount}</strong><span>統合・個別研究ノート</span></div>
  </section>

  <nav class="research-major-nav" aria-label="研究ノート大カテゴリ">
    {categories.map((category)=><a href={`#research-${category.no}`}><span>{category.no}</span>{category.title}</a>)}
  </nav>

  <section class="research-index-guide">
    <strong>研究ノートの統合ルール</strong>
    <p>大カテゴリは分析領域、中カテゴリは研究対象のまとまり、カードは知見を蓄積する正本です。理論編・時系列・適地比較・地域ケースなどは、同じ研究テーマなら正本の下に分析モジュールとして束ねます。新しいエッセイから得た知見は、まず正本を更新します。</p>
  </section>

  <div class="research-category-list">
    {categories.map((category)=><section class="research-category" id={`research-${category.no}`}>
      <header class="research-category-head"><span>{category.no}</span><div><h2>{category.title}</h2><p>{category.description}</p></div></header>
      <div class="research-middle-list">
        {category.groups.map((group)=><section class="research-middle">
          <h3>{group.title}</h3>
          <div class="research-note-grid">
            {group.items.map((item)=><article class="research-note-card">
              <a class="research-note-main" href={item.href}><strong>{item.title}</strong><p>{item.description}</p><span>研究ノートを開く →</span></a>
              {item.modules && <div class="research-modules"><small>詳細分析</small>{item.modules.map(([label,href])=><a href={href}>{label}</a>)}</div>}
            </article>)}
          </div>
        </section>)}
      </div>
    </section>)}

    <section class="research-category related-resources" id="research-resources">
      <header class="research-category-head"><span>＋</span><div><h2>関連データ・方法</h2><p>研究対象そのものではなく、比較・検証・更新を支えるデータページと編集方法をまとめます。</p></div></header>
      <div class="research-middle-list">
        {['データ','方法'].map((groupName)=><section class="research-middle"><h3>{groupName}</h3><div class="research-note-grid">
          {relatedResources.filter((item)=>item.group===groupName).map((item)=><article class="research-note-card"><a class="research-note-main" href={item.href}><strong>{item.title}</strong><p>{item.description}</p><span>{groupName}を見る →</span></a></article>)}
        </div></section>)}
      </div>
    </section>
  </div>

  <style>
    .research-index-hero{max-width:1180px;margin:0 auto;padding:5.5rem 1.5rem 3rem;border-bottom:1px solid var(--line,#ddd)}
    .research-index-kicker{font-size:.72rem;letter-spacing:.18em;font-weight:700;opacity:.6;margin-bottom:1.2rem}
    .research-index-hero h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;margin:0 0 1.5rem}.research-index-lead{max-width:780px;font-size:1.12rem;line-height:1.9;margin:0}
    .research-index-meta{display:flex;gap:.7rem 1.2rem;align-items:baseline;flex-wrap:wrap;margin-top:2rem}.research-index-meta strong{font-size:2rem}.research-index-meta span{font-size:.82rem;opacity:.65;margin-right:1rem}
    .research-major-nav{max-width:1180px;margin:0 auto;padding:1.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.6rem}.research-major-nav a{display:flex;gap:.8rem;align-items:center;padding:.9rem 1rem;border:1px solid var(--line,#ddd);text-decoration:none;color:inherit;background:var(--surface,#fff)}.research-major-nav span{font-size:.72rem;opacity:.5}
    .research-index-guide{max-width:1120px;margin:1rem auto 3rem;padding:1.2rem 1.4rem;background:rgba(120,120,120,.07)}.research-index-guide strong{display:block;margin-bottom:.35rem}.research-index-guide p{margin:0;line-height:1.7}
    .research-category-list{max-width:1180px;margin:0 auto;padding:0 1.5rem 6rem}.research-category{padding:4rem 0;border-top:1px solid var(--line,#ddd);scroll-margin-top:5rem}
    .research-category-head{display:grid;grid-template-columns:70px 1fr;gap:1.2rem;margin-bottom:2.4rem}.research-category-head>span{font-size:2.6rem;font-weight:700;opacity:.18;line-height:1}.research-category-head h2{font-size:clamp(2rem,4vw,3.2rem);margin:0 0 .8rem;line-height:1.15}.research-category-head p{margin:0;max-width:760px;line-height:1.8;opacity:.75}
    .research-middle-list{display:grid;gap:2.8rem;margin-left:90px}.research-middle h3{font-size:1.25rem;margin:0 0 1rem;padding-bottom:.7rem;border-bottom:1px solid var(--line,#ddd)}
    .research-note-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:.9rem}.research-note-card{border:1px solid var(--line,#ddd);background:var(--surface,#fff);display:flex;flex-direction:column}.research-note-main{display:flex;flex-direction:column;min-height:165px;padding:1.25rem;text-decoration:none;color:inherit}.research-note-main strong{font-size:1.08rem;line-height:1.45}.research-note-main p{font-size:.9rem;line-height:1.65;opacity:.72;flex:1}.research-note-main span{font-size:.8rem;font-weight:700}
    .research-modules{border-top:1px solid var(--line,#ddd);padding:.9rem 1.1rem;display:flex;gap:.45rem .8rem;flex-wrap:wrap;align-items:center}.research-modules small{width:100%;font-size:.68rem;letter-spacing:.12em;opacity:.5}.research-modules a{font-size:.8rem;text-decoration:none;border-bottom:1px solid currentColor;color:inherit;opacity:.78}.research-modules a:hover{opacity:1}.related-resources{margin-top:1rem}
    @media(max-width:720px){.research-category-head{grid-template-columns:1fr}.research-category-head>span{font-size:1.2rem}.research-middle-list{margin-left:0}.research-index-hero{padding-top:3.5rem}}
  </style>
</BaseLayout>
