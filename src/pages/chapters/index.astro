---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { researchChapters } from '../../data/researchChapters.js';

const featuredResearch=[
  {tag:'自然・土地利用',title:'瀬戸内ネイチャーポジティブ論',subtitle:'人口、災害、生態系、土地利用の変化を重ね、瀬戸内の土地がどのように使われ、管理され、自然へ戻りうるのかを調べる。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-nature-positive/'},
  {tag:'産業',title:'瀬戸内の産業は、なぜ別の産業へ転生できたのか',subtitle:'造船、繊維、鉱山、化学などをたどり、技能・設備・企業ネットワークが次の産業へどう受け渡されるかを調べる。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-industrial-transformation/'},
  {tag:'地域資産',title:'地域資産は、どう再生産されるのか',subtitle:'産業、食文化、町並み、観光などが利用されながら次世代へ残る条件を、複数地域から比較する。',href:'/setouchi-cultural-economic-atlas/chapters/regional-asset-reproduction/'},
  {tag:'食',title:'瀬戸内の食は、どこまで自然環境で説明できるか',subtitle:'海域、魚介、農産物、漁法、加工、流通、料理をつなぎ、地域ごとの食文化の成立条件を調べる。',href:'/setouchi-cultural-economic-atlas/chapters/gastronomy-environment/'},
  {tag:'移動・観光',title:'自転車は、島を変えたか',subtitle:'しまなみ・とびしま・ゆめしまを比較し、観光、消費、移住、景観、インフラへの変化を追う。',href:'/setouchi-cultural-economic-atlas/chapters/cycle-tourism-regional-impact/'},
  {tag:'AI・インフラ',title:'AIデータセンターは、なぜその場所に立地するのか',subtitle:'電力、通信、冷却、水、土地、計算資源、需要を重ね、次世代インフラの立地条件を調べる。',href:'/setouchi-cultural-economic-atlas/chapters/ai-datacenter-ecosystem/'}
];

const programs=[
  {title:'自然・土地利用',desc:'海、地形、生態系、人口、災害、土地利用の変化を扱う研究。',items:[
    ['瀬戸内ネイチャーポジティブ論','人口減少と土地利用、生態系、防災の関係を広域で考える。','/setouchi-cultural-economic-atlas/chapters/setouchi-nature-positive/'],
    ['戦略的再自然化 スクリーニング・マップ v0.1','人口・土地利用・災害・自然資本から候補地を比較する。','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-screening-map/'],
    ['戦略的再自然化 パイロット分析単位 v0.2','島嶼斜面、斜面市街地、里海、河川低地、旧工業地を比較する。','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-pilot-fields/']
  ]},
  {title:'産業の系譜と転換',desc:'造船、繊維、鉱山、化学など、瀬戸内の産業がどこから生まれ、何を残したかを追う研究。',items:[
    ['瀬戸内の産業は、なぜ別の産業へ転生できたのか','技能・設備・ネットワーク・市場接続の継承と変化を横断的に見る。','/setouchi-cultural-economic-atlas/chapters/setouchi-industrial-transformation/'],
    ['瀬戸内造船産業の4つの再生産モデル','今治・因島／尾道・呉・玉野を資本、技能、固定資産、制度で比較する。','/setouchi-cultural-economic-atlas/chapters/shipbuilding-reproduction-models/'],
    ['なぜ瀬戸内に造船業が集積したのか','海運需要、修繕、技能、資本、船主、舶用工業から海事クラスター形成を読む。','/setouchi-cultural-economic-atlas/chapters/setouchi-shipbuilding-cluster/'],
    ['なぜ児島でジーンズだったのか','干拓・綿作・紡績・学生服・ジーンズへつながる産業系譜を追う。','/setouchi-cultural-economic-atlas/chapters/kojima-textile-genealogy/'],
    ['なぜ福山がデニム生地の産地になったのか','備後絣・藍染・織布の技能がデニムへつながる過程を追う。','/setouchi-cultural-economic-atlas/chapters/fukuyama-denim-genealogy/'],
    ['塩田は、どう化学コンビナートになったのか','塩田・港からソーダ・石油化学・高機能材料への系譜を追う。','/setouchi-cultural-economic-atlas/chapters/shunan-soda-chemical-genealogy/'],
    ['別子銅山は、どう化学工業を生んだのか','鉱山・製錬・煙害・硫黄回収から化学産業へ至る過程を追う。','/setouchi-cultural-economic-atlas/chapters/niihama-industrial-genealogy/']
  ]},
  {title:'食・海産物・地域料理',desc:'自然環境から食材、漁撈・栽培、加工、流通、料理までを地域横断で比較する研究。',items:[
    ['瀬戸内の食は、どこまで自然環境で説明できるか','海域・資源・漁法・加工・流通・調理法をつなぐ。','/setouchi-cultural-economic-atlas/chapters/gastronomy-environment/'],
    ['食文化は、どうすれば消えずに再生産されるのか','資源・担い手・加工・食べる場・記憶・所得の関係を追う。','/setouchi-cultural-economic-atlas/chapters/food-culture-reproduction/'],
    ['瀬戸内食資源マトリクス','鯛・タコ・サワラ・穴子・牡蠣・いりこを地域横断で比較する。','/setouchi-cultural-economic-atlas/gastronomy-matrix/']
  ]},
  {title:'移動・観光・地域変化',desc:'船、鉄道、道路、自転車、観光が、町・島・暮らし・商業をどう変えてきたかを調べる研究。',items:[
    ['自転車は、島を変えたか','しまなみ・とびしま・ゆめしまの経済・移住・景観・インフラへの影響を追う。','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-regional-impact/'],
    ['自転車の前と後を、数字で見る','人口、観光、消費、移住・創業を時系列で比較する。','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-timeseries/']
  ]},
  {title:'地域資産・町並み・文化',desc:'産業や交易が残した建築、技能、文化、町並みを、現在まで続く地域資産として調べる研究。',items:[
    ['地域資産は、どうすれば消費されず再生産されるのか','産業・食文化・町並み・観光を横断して地域資産の循環を見る。','/setouchi-cultural-economic-atlas/chapters/regional-asset-reproduction/']
  ]},
  {title:'AI・データセンター・Physical AI',desc:'AIを計算機だけでなく、電力、通信、冷却、土地、製造、物流、ロボットを含む物理システムとして調べる研究。',items:[
    ['AIデータセンターは、なぜその場所に立地するのか','自然環境・電力・通信・冷却・計算資源・AI需要を重ねる。','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-ecosystem/'],
    ['瀬戸内Physical AIエコシステム','GPU/DC、電力、通信、現場企業、制御、SI、大学・高専をつなぐ。','/setouchi-cultural-economic-atlas/chapters/physical-ai-player-ecosystem/']
  ]}
];

const shipbuildingCases=[
  ['今治｜資本循環型','船主・造船・舶用・金融が結びつく海事産業集積。','/setouchi-cultural-economic-atlas/chapters/imabari-maritime-cluster/'],
  ['因島・尾道｜技能コモンズ型','企業境界を越えて技能が蓄積・移動してきた地域。','/setouchi-cultural-economic-atlas/chapters/onomichi-innoshima-skill-ecosystem/'],
  ['呉｜制度的コンバージョン型','軍港・海軍工廠から民需産業へ転換した都市。','/setouchi-cultural-economic-atlas/chapters/kure-state-led-industrial-transition/'],
  ['玉野｜企業城下町の再結合型','造船会社を中心に形成された能力が分解・再結合する地域。','/setouchi-cultural-economic-atlas/chapters/tamano-company-town-shipbuilding/']
];

const totalProgramNotes=programs.reduce((sum,program)=>sum+program.items.length,0);
---
<BaseLayout title="研究ノート | SETOUCHI ATLAS" description="瀬戸内の自然、土地利用、産業、食、交通、観光、地域資産、AIインフラを地域横断で調べる研究ノート集。">
  <section class="concept-hero">
    <div class="kicker">RESEARCH NOTES</div>
    <h1>瀬戸内を、テーマから深く調べる。</h1>
    <p class="concept-dek">自然と土地利用、造船や繊維の産業史、魚介と地域料理、港と交通、観光、町並み、AIデータセンター。地域ページだけでは見えにくいテーマを、複数の町や時代をまたいで調べています。</p>
  </section>

  <section class="section">
    <div class="section-heading-row">
      <div><div class="kicker">FEATURED RESEARCH</div><h2>いま調べていること</h2></div>
      <div class="research-count">{programs.length}テーマ / {totalProgramNotes}ノート＋基礎研究</div>
    </div>
    <div class="program-grid">
      {featuredResearch.map((item)=><a class="program-card featured" href={item.href}><span>{item.tag}</span><h3>{item.title}</h3><p>{item.subtitle}</p></a>)}
    </div>
  </section>

  {programs.map((program,index)=>(
    <section class:list={['section','program-section',index%2===1&&'gene-section']}>
      <div class="program-section-head">
        <div><div class="kicker">RESEARCH THEME</div><h2>{program.title}</h2></div>
        <p>{program.desc}</p>
      </div>
      <div class="program-grid">
        {program.items.map((item)=><a class="program-card" href={item[2]}><h3>{item[0]}</h3><p>{item[1]}</p></a>)}
      </div>
    </section>
  ))}

  <section class="section program-section">
    <div class="program-section-head">
      <div><div class="kicker">CASE COMPARISON</div><h2>造船都市4ケース</h2></div>
      <p>同じ造船都市でも、産業が形成された経路は異なります。今治、因島・尾道、呉、玉野を個別に読む比較研究です。</p>
    </div>
    <div class="program-grid">
      {shipbuildingCases.map((item)=><a class="program-card" href={item[2]}><h3>{item[0]}</h3><p>{item[1]}</p></a>)}
    </div>
  </section>

  <section class="section gene-section program-section">
    <div class="program-section-head">
      <div><div class="kicker">FOUNDATIONS</div><h2>地域形成の基礎研究</h2></div>
      <p>地形、気候、水、海、生業、交通、産業、文化、都市形成など、個別テーマを読むための基礎章です。</p>
    </div>
    <div class="program-grid">
      {researchChapters.map((chapter)=><a class="program-card" href={`/setouchi-cultural-economic-atlas/chapters/${chapter.slug}/`}><span>FOUNDATION {chapter.number}</span><h3>{chapter.title}</h3><p>{chapter.subtitle}</p></a>)}
    </div>
  </section>

  <section class="section">
    <div class="program-section-head">
      <div><div class="kicker">METHOD</div><h2>研究の方法について</h2></div>
      <p>研究ノートの作り方、事実・解釈・仮説の区別、AIの使い方などは別ページにまとめています。</p>
    </div>
    <div class="chapter-related-grid">
      <a class="compare-button" href="/setouchi-cultural-economic-atlas/methodology/">方法論を見る →</a>
      <a class="compare-button secondary" href="/setouchi-cultural-economic-atlas/methodology-ai-adaptive/">AI × Adaptive Research →</a>
    </div>
  </section>
</BaseLayout>