---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = [
  {no:'01',title:'自然環境・生態系',description:'自然資本を固定的な背景ではなく、地殻変動・気候変動・水・海況・生態系の変化を含む動的な基盤として扱う。',method:'形成・変動・人為改変・再編を時間軸で追い、現在の自然条件だけでなく、自然資本そのものがどう変わってきたかを見る。',groups:[
    {title:'動的自然資本',items:[{title:'動的自然資本――変わり続ける土地と、人間の応答',description:'地殻変動、海面変動、気候変動、生態系遷移によって変化する自然資本と、人間の適応・改変・暮らしの再編を読む。',href:'/setouchi-cultural-economic-atlas/chapters/dynamic-natural-capital/'}]},
    {title:'瀬戸内の地形・地理構造',items:[{title:'瀬戸内の地形・地理構造',description:'灘・湾・瀬戸・海峡、島嶼、地質、河川、平野、海底地形を地域差の基盤として読む。',href:'/setouchi-cultural-economic-atlas/chapters/geography/'}]},
    {title:'瀬戸内の気候・水循環',items:[
      {title:'瀬戸内の気候・水循環',description:'降水、風、河川、地下水、ため池、陸から海への水と物質の移動を読む。',href:'/setouchi-cultural-economic-atlas/chapters/climate-water/'},
      {title:'少雨地域の水貯留と配分制度',description:'讃岐のため池、水利慣行、香川用水から、少雨という自然制約を貯留・配分・連結によって組み替える仕組みを読む。',href:'/setouchi-cultural-economic-atlas/chapters/water-storage-allocation/'}
    ]},
    {title:'海と陸のエコシステム',items:[{title:'海と陸のエコシステム',description:'砂底・干潟・藻場・岩礁、森林・里山・段畑など、自然条件と人間利用が重なる生態系を読む。',href:'/setouchi-cultural-economic-atlas/chapters/ecosystems/'}]}
  ]},
  {no:'02',title:'生業・食文化',description:'自然資源を採取・栽培・加工し、商品や料理へ変換する人間の営みを扱う。',method:'資源の存在だけでなく、採取・栽培、加工、保存、流通、調理、消費、担い手の再生産までを一続きの系として見る。',groups:[
    {title:'生業・資源利用',items:[{title:'自然資源の生業化',description:'塩、魚、柑橘、石、鉱物などを、技術・労働・制度・交易によって生業へ変換する過程を読む。',href:'/setouchi-cultural-economic-atlas/chapters/livelihoods/'}]},
    {title:'食文化',items:[
      {title:'瀬戸内食文化の自然環境基盤',description:'海域、魚介、農産物、漁法、加工、流通、調理の因果鎖を地域横断で読む。',href:'/setouchi-cultural-economic-atlas/chapters/gastronomy-environment/'},
      {title:'沿岸食資源の価値形成',description:'自然資源が漁法・養殖・加工・市場・料理を通じて地域価値へ変わる過程を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/coastal-food-value-formation/'},
      {title:'食文化の再生産構造',description:'資源、担い手、加工、食べる場、記憶、所得が地域の食文化を支える関係を追う。',href:'/setouchi-cultural-economic-atlas/chapters/food-culture-reproduction/'}
    ]}
  ]},
  {no:'03',title:'交通・交易・移動',description:'海運、港、鉄道、道路、自転車など、人・物・情報の移動と地域の結節構造を扱う。',method:'移動の速さだけでなく、自然が生む摩擦、結節点での停止・滞留・積替え、地域内への経済的・関係的な捕捉を見る。',groups:[
    {title:'港・海運・交易',items:[
      {title:'瀬戸内の港・交通・交易',description:'潮待ち、風待ち、積替え、参詣、修船、交易が港町と広域市場を結ぶ構造を読む。',href:'/setouchi-cultural-economic-atlas/chapters/ports-trade/'},
      {title:'潮待ち港の近代化と機能転換',description:'鞆・御手洗・多度津・尾道で、帆船時代の蓄積が近代交通へどう接続したかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/waiting-ports-transition/'},
      {title:'港湾結節機能と都市資産の転換',description:'交通摩擦が滞留・資本蓄積・都市形成を生み、交通転換後に何へ変わったかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/port-node-urban-assets/'}
    ]},
    {title:'シクロツーリズム',items:[{title:'シクロツーリズムの地域影響と時系列比較',description:'来訪、停止、滞在、消費、関係人口、移住、創業、景観、インフラへの影響を統合して読む。',href:'/setouchi-cultural-economic-atlas/chapters/cycle-tourism-system/',modules:[['地域影響','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-regional-impact/'],['時系列','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-timeseries/'],['経済・関係捕捉','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-capture/'],['評価方法','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-evaluation-protocol/'],['反実仮想KPI','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-counterfactual-kpi/']]}]}
  ]},
  {no:'04',title:'産業・技術・資源循環',description:'自然資本と暮らしの上に形成された産業の転換、技能・設備・資本の継承、企業間連鎖、循環設計、新しい技術基盤を扱う。',method:'産業を単独で起点にせず、自然資本と暮らしを基層に置き、技能・設備・資本・制度・市場がどう蓄積され、別の用途へ再結合されたかを見る。',groups:[
    {title:'産業転換・能力継承',items:[
      {title:'瀬戸内産業の転換と能力継承',description:'自然資本を基層に置き、修理需要、企業技術、制度変更、市場などが能力形成をどう促し、次市場へ再結合されるかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-industrial-transformation/'},
      {title:'塩田産業の地域資産継承',description:'赤穂・竹原・坂出・三田尻で、能力、土地、港湾、資本がどう残ったかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/salt-fields-legacy/'}
    ]},
    {title:'造船・海事産業',items:[{title:'瀬戸内造船産業の形成・集積・再生産構造',description:'海峡・潮流・港湾条件が航海生活と修繕需要を生み、技能・船主資本・設備・企業間分業へつながる過程を扱う。',href:'/setouchi-cultural-economic-atlas/chapters/shipbuilding-system/',modules:[['自然資本と航海生活','/setouchi-cultural-economic-atlas/chapters/shipbuilding-natural-capital/'],['形成・集積','/setouchi-cultural-economic-atlas/chapters/setouchi-shipbuilding-cluster/'],['再生産モデル','/setouchi-cultural-economic-atlas/chapters/shipbuilding-reproduction-models/']]}]},
    {title:'繊維・衣料',items:[
      {title:'児島繊維産業の系譜',description:'干拓・綿作・紡績・学生服・ジーンズへ続く産業系譜を追う。',href:'/setouchi-cultural-economic-atlas/chapters/kojima-textile-genealogy/'},
      {title:'福山デニム産業の系譜',description:'備後絣・藍染・織布の技能がデニムへ接続する過程を追う。',href:'/setouchi-cultural-economic-atlas/chapters/fukuyama-denim-genealogy/'}
    ]},
    {title:'資源・化学・素材',items:[
      {title:'塩業から化学工業への産業転換',description:'塩田・港からソーダ、石油化学、高機能材料へ続く系譜を追う。',href:'/setouchi-cultural-economic-atlas/chapters/shunan-soda-chemical-genealogy/'},
      {title:'別子銅山から化学工業への産業系譜',description:'鉱山・製錬・煙害・硫黄回収から化学産業へ至る過程を追う。',href:'/setouchi-cultural-economic-atlas/chapters/niihama-industrial-genealogy/'}
    ]},
    {title:'資源循環・循環設計',items:[{title:'瀬戸内の地域資源循環',description:'食品副産物から児島デニムまで、用途適合、カスケード利用、物流、循環速度、循環設計を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/regional-resource-circulation/'}]},
    {title:'デジタル・AIインフラ',items:[
      {title:'AIデータセンターの立地・地域接続・適地比較',description:'自然資本、水・電力・土地・災害条件と地域生活との競合・補完を含め、通信・計算資源・地域接続まで評価する。',href:'/setouchi-cultural-economic-atlas/chapters/ai-datacenter-system/',modules:[['立地条件','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-ecosystem/'],['自然資本・暮らしとの関係','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-natural-capital/'],['適地比較','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-suitability-map/']]},
      {title:'瀬戸内Physical AIエコシステム',description:'GPU/DC、電力、通信、現場企業、制御、SI、大学・高専の接続を読む。',href:'/setouchi-cultural-economic-atlas/chapters/physical-ai-player-ecosystem/'}
    ]}
  ]},
  {no:'05',title:'都市・集落・土地利用',description:'都市・集落の形成と、干拓・埋立・再自然化など空間と土地利用の変化を扱う。',method:'地形と交通条件を起点に、土地の形成・改変・所有・用途転換・低密度化・退出までを時間軸で追い、空間がどう再編されたかを見る。',groups:[
    {title:'都市・集落形成',items:[{title:'瀬戸内の都市・集落形成',description:'港、企業、藩、商人、地形、交通の違いが都市形態をどう分けたかを比較する。',href:'/setouchi-cultural-economic-atlas/chapters/cities/'}]},
    {title:'土地利用・再自然化',items:[
      {title:'瀬戸内の土地利用ライフサイクル',description:'塩田、干拓地、農地、太陽光、別荘地を、形成・利用・終了・再利用・退出までの時間軸で読む。',href:'/setouchi-cultural-economic-atlas/chapters/land-use-lifecycle/'},
      {title:'瀬戸内ネイチャーポジティブ／戦略的再自然化',description:'人口減少、土地利用、生態系、防災を重ね、維持・低密度管理・生態系復元・自然遷移を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-nature-positive/',modules:[['スクリーニング','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-screening-map/'],['パイロット分析','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-pilot-fields/']]}
    ]}
  ]},
  {no:'06',title:'社会・暮らし・制度',description:'人口、居住、所有、公共サービス、地域経済など、人が地域を使い続ける社会的条件を扱う。',method:'人口だけを代理指標にせず、居住・滞在・所有・利用・消費・公共負担・関係形成などを分け、地域を使い続ける条件を見る。',groups:[
    {title:'人口・居住・地域利用',items:[{title:'小規模離島の利用強度',description:'常住人口だけでなく、所有、居住、滞在、消費、移動、公共負担、外部不経済を分解して島を測る。',href:'/setouchi-cultural-economic-atlas/chapters/island-use-intensity/'}]},
    {title:'地域経済・資産再生産',items:[{title:'地域資産の再生産構造',description:'産業、食文化、町並み、観光などの地域資産が、利用されながら維持・更新される条件を比較する。',href:'/setouchi-cultural-economic-atlas/chapters/regional-asset-reproduction/'}]}
  ]},
  {no:'07',title:'文化・信仰・地域認識',description:'信仰、祭礼、生活文化、景観、地域記憶など、人が土地に与えてきた意味と文化的蓄積を扱う。',method:'文化を独立した装飾要素として扱わず、自然条件・生業・移動・共同体・制度との関係から、意味や実践がどう形成・継承されたかを見る。',groups:[
    {title:'信仰・祭礼・文化景観',items:[{title:'瀬戸内の信仰・生活文化',description:'神社ネットワーク、祭礼、生活技術、文化景観が地域社会に定着する過程を読む。',href:'/setouchi-cultural-economic-atlas/chapters/culture/'}]}
  ]}
];

const sharedMethods=[
  ['動的自然資本','自然資本を固定値として扱わず、Natural Capital(t) として形成・変動・改変・継承を時間軸で見る。'],
  ['環境決定論に立たない','自然条件は可能性と制約を与えるが、人間の選択、技術、制度、市場によって結果は変わると考える。'],
  ['暮らしを産業より先に置く','人がどう住み、食べ、働き、移動し、資源を使ったかを先に読み、産業や都市をその表出として捉える。'],
  ['事実・解釈・仮説を分ける','確認できる事実と、比較から導く解釈、まだ検証を要する仮説を明示的に分ける。'],
  ['地域間比較を行う','同じ自然条件でも異なる選択があり、異なる自然条件でも似た仕組みが生まれることを比較から検証する。'],
  ['可能性と制約の変化を見る','人口増加や産業成長を自動的に善とせず、何が可能になり、何が難しくなったかを両面から記述する。']
];

const noteCount=new Set(categories.flatMap(c=>c.groups.flatMap(g=>g.items.map(i=>i.href)))).size;
---
<BaseLayout title="研究ノート | SETOUCHI ATLAS" description="変わり続ける瀬戸内の自然資本と、人間の暮らし・生業・産業・文化・都市の関係を比較研究するノート。">
  <section class="research-index-hero">
    <div class="research-index-kicker">RESEARCH PROGRAM</div>
    <h1>研究ノート</h1>
    <p class="research-index-lead">SETOUCHI ATLASの研究は、変わり続ける土地と、その変化に応答しながら生き方を組み替えてきた人間との関係を読むことを目的とします。</p>
    <div class="research-index-meta"><strong>{categories.length}</strong><span>研究テーマ</span><strong>{noteCount}</strong><span>個別ノート</span></div>
  </section>

  <section class="research-program-intro">
    <article><div class="research-program-no">01</div><div><div class="research-program-label">研究目的</div><h2>この研究が明らかにしたいこと</h2><p>自然環境を背景として固定せず、それ自体が変動する自然資本として捉えます。その上で、人間が自然の変化や制約にどう適応し、改変し、暮らしや生業を組み替え、その結果として産業・文化・集落・都市・制度がどう形成されてきたかを読みます。さらに、人間の営みが次の時代の自然資本へどのような条件を残したかまで追います。</p></div></article>
    <article><div class="research-program-no">02</div><div><div class="research-program-label">研究対象</div><h2>何を対象にするか</h2><p>対象は「瀬戸内」という地理範囲だけではありません。地形・地質・気候・水・海況・生態系と、それに接続する暮らし、生業、移動、産業、土地利用、都市・集落、制度、信仰、食文化を扱います。現在の姿だけでなく、それらが形成され、変化し、受け継がれてきた過程そのものを研究対象とします。</p></div></article>
    <article><div class="research-program-no">03</div><div><div class="research-program-label">共通方法論</div><h2>どのように読むか</h2><div class="research-program-chain"><span>自然資本(t)</span><b>→</b><span>人間の適応・改変</span><b>→</b><span>暮らし・生業</span><b>→</b><span>産業・文化・集落・都市</span><b>→</b><span>自然資本(t+1)</span></div><p>この因果関係を基本線としつつ、単純な一方向モデルにはしません。自然と人間の双方が時間とともに変化し、互いに次の条件をつくる循環として読みます。</p><div class="shared-method-grid">{sharedMethods.map(m=><div><strong>{m[0]}</strong><p>{m[1]}</p></div>)}</div><div class="research-program-links"><a href="/setouchi-cultural-economic-atlas/methodology/">地域研究の方法論 →</a><a href="/setouchi-cultural-economic-atlas/chapters/natural-capital-lifestyle-framework/">共通分析フレーム →</a></div></div></article>
  </section>

  <section class="research-themes-head"><div class="research-index-kicker">RESEARCH THEMES</div><h2>研究内容</h2><p>以下では、共通方法論を各テーマへ適用します。各テーマには、その領域で特に何を見るかという「テーマ別の見方」を置き、その下に個別研究ノートを配置します。</p></section>
  <nav class="research-major-nav" aria-label="研究テーマ">{categories.map(c=><a href={`#research-${c.no}`}><span>{c.no}</span>{c.title}</a>)}</nav>

  <div class="research-category-list">
    {categories.map(c=><section class="research-category" id={`research-${c.no}`}>
      <header class="research-category-head"><span>{c.no}</span><div><h2>{c.title}</h2><p>{c.description}</p></div></header>
      <div class="research-theme-method"><strong>このテーマの見方</strong><p>{c.method}</p></div>
      <div class="research-middle-list">{c.groups.map(g=><section class="research-middle"><h3>{g.title}</h3><div class="research-note-grid">{g.items.map(i=><article class="research-note-card-wrap"><a class="research-note-card" href={i.href}><strong>{i.title}</strong><p>{i.description}</p><span>研究ノートを開く →</span></a>{i.modules&&<div class="research-module-links">{i.modules.map(m=><a href={m[1]}>{m[0]} →</a>)}</div>}</article>)}</div></section>)}</div>
    </section>)}

    <section class="research-category research-support-section editorial-section">
      <header class="research-category-head"><span>E</span><div><h2>アトラスの編集方法</h2><p>ここから先は研究内容ではなく、エッセイ・研究ノート・地域ページをどう編集・更新するかという編集者向けの備忘録です。</p></div></header>
      <div class="research-middle-list"><section class="research-middle"><h3>編集者向け</h3><div class="research-note-grid">
        <a class="research-note-card" href="/setouchi-cultural-economic-atlas/editorial-methodology/"><strong>アトラスの編集方法</strong><p>ページ種別の役割分担、知見の蓄積先、更新レベル、公開時チェックなどの内部ルール。</p><span>編集方法を見る →</span></a>
        <a class="research-note-card" href="/setouchi-cultural-economic-atlas/research-workflow/"><strong>エッセイ→研究ノート更新フロー</strong><p>エッセイで得た新事実・比較・仮説を研究ノートへ戻す具体的な同期手順。</p><span>編集フローを見る →</span></a>
      </div></section></div>
    </section>
  </div>

  <style>
