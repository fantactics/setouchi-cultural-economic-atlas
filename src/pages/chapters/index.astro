---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { researchChapters } from '../../data/researchChapters.js';

const corePrograms=[
  {tag:'CORE / REPRODUCTION',title:'地域資産は、どうすれば消費されず再生産されるのか',subtitle:'産業・食文化・町並み・観光を横断し、「利用→地域内価値→再投資→次世代継承」の循環を考える。',href:'/setouchi-cultural-economic-atlas/chapters/regional-asset-reproduction/'},
  {tag:'CORE / NATURE POSITIVE',title:'瀬戸内ネイチャーポジティブ論',subtitle:'人口減少時代に、どの土地を維持し、低密度管理へ移し、生態系を復元し、自然遷移へ委ねるのか。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-nature-positive/'},
  {tag:'CORE / INDUSTRY',title:'瀬戸内の産業は、なぜ別の産業へ転生できたのか',subtitle:'製品ではなく、技能・設備・企業ネットワーク・市場接続・制度が次産業を生むという仮説を検証する。',href:'/setouchi-cultural-economic-atlas/chapters/setouchi-industrial-transformation/'},
  {tag:'METHOD / ADAPTIVE',title:'AI時代の地域研究は、完成形より更新能力を設計する',subtitle:'Local Depth × Global Comparison × Adaptive Managementを、調査と地域計画の共通方法として整備する。',href:'/setouchi-cultural-economic-atlas/methodology-ai-adaptive/'}
];

const programs=[
  {title:'戦略的再自然化',desc:'人口減少、災害リスク、生態系、維持管理負担を重ね、土地の人工利用密度をどこで下げるかを研究する。',items:[
    ['スクリーニング・マップ v0.1','再自然化の候補を人口・土地利用・災害・自然資本から絞る。','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-screening-map/'],
    ['パイロット分析単位 v0.2','島嶼斜面、斜面市街地、里海、河川低地、旧工業地などを同じ判断枠で比較する。','/setouchi-cultural-economic-atlas/chapters/strategic-renaturing-pilot-fields/']
  ]},
  {title:'産業の再生産と転換',desc:'企業が変わっても地域能力が残る条件を、造船、繊維、化学、鉱山などの産業系譜から読む。',items:[
    ['瀬戸内造船産業の4つの再生産モデル','今治・因島／尾道・呉・玉野を資本、技能、固定資産、制度、企業能力で比較する。','/setouchi-cultural-economic-atlas/chapters/shipbuilding-reproduction-models/'],
    ['なぜ瀬戸内に造船業が集積したのか','海運需要、修繕、技能、資本、船主、舶用工業から海事クラスター形成を読む。','/setouchi-cultural-economic-atlas/chapters/setouchi-shipbuilding-cluster/'],
    ['なぜ児島でジーンズだったのか','干拓・綿作・紡績・学生服・ジーンズへ地域固有性が転移する過程を読む。','/setouchi-cultural-economic-atlas/chapters/kojima-textile-genealogy/'],
    ['なぜ福山がデニム生地の産地になったのか','備後絣・藍染・織布の技能が世界向け素材へ再結合される過程を追う。','/setouchi-cultural-economic-atlas/chapters/fukuyama-denim-genealogy/'],
    ['塩田は、どう化学コンビナートになったのか','周南の塩田・港からソーダ・石油化学・高機能材料への系譜を読む。','/setouchi-cultural-economic-atlas/chapters/shunan-soda-chemical-genealogy/'],
    ['別子銅山は、どう化学工業を生んだのか','鉱山・製錬・煙害・硫黄回収から住友化学へ、外部性が新産業へ変わる過程を追う。','/setouchi-cultural-economic-atlas/chapters/niihama-industrial-genealogy/']
  ]},
  {title:'食文化と地域資産',desc:'自然資源、漁撈、加工、流通、料理、記憶、所得を一つの再生産システムとして検証する。',items:[
    ['瀬戸内の食は、どこまで自然環境で説明できるか','海域・資源・漁法・加工・流通・調理法をつなぐ。','/setouchi-cultural-economic-atlas/chapters/gastronomy-environment/'],
    ['食文化は、どうすれば消えずに再生産されるのか','資源・担い手・加工・食べる場・記憶・所得の循環を考える。','/setouchi-cultural-economic-atlas/chapters/food-culture-reproduction/'],
    ['瀬戸内食資源マトリクス','鯛・タコ・サワラ・穴子・牡蠣・いりこを横断比較する。','/setouchi-cultural-economic-atlas/gastronomy-matrix/']
  ]},
  {title:'移動・観光・地域変化',desc:'交通や観光を来訪者数だけでなく、売上、人材、建物、景観、インフラ、関係人口に何を残すかで評価する。',items:[
    ['自転車は、島を変えたか','しまなみ・とびしま・ゆめしまを比較し、経済・移住・景観・インフラへの波及を追う。','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-regional-impact/'],
    ['自転車の前と後を、数字で見る','人口、観光、消費、移住・創業を時系列で比較する。','/setouchi-cultural-economic-atlas/chapters/cycle-tourism-timeseries/']
  ]},
  {title:'AI・次世代インフラ',desc:'AIをソフトウェアだけでなく、電力、通信、冷却、計算資源、ロボット、現場産業を含む物理インフラとして読む。',items:[
    ['AIデータセンターは、なぜその場所に立地するのか','自然環境・電力・通信・冷却・計算資源・AI需要を一つの立地エコシステムとして読む。','/setouchi-cultural-economic-atlas/chapters/ai-datacenter-ecosystem/'],
    ['瀬戸内Physical AIエコシステム','GPU/DC、電力、通信、現場企業、制御、SI、大学・高専をつなぐ。','/setouchi-cultural-economic-atlas/chapters/physical-ai-player-ecosystem/']
  ]}
];

const shipbuildingCases=[
  ['今治｜資本循環型','船主・造船・舶用・金融が自己強化する海事資産循環。','/setouchi-cultural-economic-atlas/chapters/imabari-maritime-cluster/'],
  ['因島・尾道｜技能コモンズ型','企業境界を越えて技能を再生産する仕組み。','/setouchi-cultural-economic-atlas/chapters/onomichi-innoshima-skill-ecosystem/'],
  ['呉｜制度的コンバージョン型','国家形成の固定資産と統合技術を民需へ転用する。','/setouchi-cultural-economic-atlas/chapters/kure-state-led-industrial-transition/'],
  ['玉野｜企業城下町の再結合型','大企業内部能力を分解し、地域内で再結合する条件を考える。','/setouchi-cultural-economic-atlas/chapters/tamano-company-town-shipbuilding/']
];
---
<BaseLayout title="研究ノート | SETOUCHI ATLAS" description="エッセイで立てた仮説を、地域比較、統計、史料、地図、世界比較から検証し、地域の読み方を更新する研究プログラム。">
  <section class="concept-hero">
    <div class="kicker">RESEARCH NOTES / TEST & REVISE</div>
    <h1>研究ノートは、仮説を検証し、壊し、更新する場所。</h1>
    <p class="concept-dek">一つの地域で見えた因果を、瀬戸内の別地域、時系列、統計、史料、世界の土地利用や産業転換と比較します。目的は仮説を守ることではなく、どこまで説明でき、どこで修正が必要かを明らかにすることです。</p>
  </section>

  <section class="section atlas-thesis">
    <div class="page-intro-grid">
      <p class="big-question">研究テーマを「分野」ではなく、「地域が変化へ適応する仕組み」で束ねる。</p>
      <div class="body-copy"><p>地形、食、造船、観光、ネイチャーポジティブは別々の話に見えます。しかし共通して問うのは、自然条件に人がどう働きかけ、何が地域に蓄積し、環境が変わったとき何を再利用・再生産・再編集できるかです。</p><p>そのため、個別テーマを研究プログラムとして束ね、相互に仮説を移植して検証します。</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">CORE PROGRAMS</div><h2>中核研究</h2>
    <div class="program-grid">{corePrograms.map((item)=><a class="program-card featured" href={item.href}><span>{item.tag}</span><h3>{item.title}</h3><p>{item.subtitle}</p></a>)}</div>
  </section>

  <section class="section gene-section program-section">
    <div class="program-section-head"><div><div class="kicker">FOUNDATIONS</div><h2>地域形成の基層</h2></div><p>自然・生態系・生業・交通・産業・文化・都市を、地域形成の因果鎖として確認する基礎章です。</p></div>
    <div class="program-grid">
      {researchChapters.map((chapter)=><a class="program-card" href={`/setouchi-cultural-economic-atlas/chapters/${chapter.slug}/`}><span>FOUNDATION {chapter.number}</span><h3>{chapter.title}</h3><p>{chapter.subtitle}</p></a>)}
    </div>
  </section>

  {programs.map((program,index)=>(
    <section class:list={['section','program-section',index%2===1&&'gene-section']}>
      <div class="program-section-head"><div><div class="kicker">RESEARCH PROGRAM</div><h2>{program.title}</h2></div><p>{program.desc}</p></div>
      <div class="program-grid">{program.items.map((item)=><a class="program-card" href={item[2]}><h3>{item[0]}</h3><p>{item[1]}</p></a>)}</div>
    </section>
  ))}

  <section class="section program-section">
    <div class="program-section-head"><div><div class="kicker">CASE COMPARISON</div><h2>造船都市4ケース</h2></div><p>総括モデルだけでなく、異なる「地域能力の担体」を持つ4都市の個別過程を比較します。</p></div>
    <div class="program-grid">{shipbuildingCases.map((item)=><a class="program-card" href={item[2]}><h3>{item[0]}</h3><p>{item[1]}</p></a>)}</div>
  </section>

  <section class="learning-band">
    <div class="kicker">RESEARCH LOOP</div><h2>研究ノートも、完成しない。</h2>
    <p>新しい統計、現地観察、世界比較、政策実験の結果が入れば、研究ノートの仮説も更新します。研究成果の量ではなく、事実と仮説の距離を縮め、誤りを早く修正するLearning Velocityを重視します。</p>
  </section>
</BaseLayout>