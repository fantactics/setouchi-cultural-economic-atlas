---
import BaseLayout from '../../layouts/BaseLayout.astro';

const cases = [
  {material:'カキ殻',place:'広島・日生',from:'牡蠣養殖・加工',to:'肥料・飼料・底質改良',lesson:'大量発生する副産物では、単価より「安定して大量に吸収できる用途」と近距離物流が重要。岡山では海底環境改善へ戻すことで、副産物利用と生態系再生が接続する。',href:'/setouchi-cultural-economic-atlas/book/oyster-shells-after-the-meal/'},
  {material:'真鯛の鱗',place:'宇和島',from:'養殖・水産加工',to:'コラーゲン等の高付加価値素材',lesson:'副産物を形ではなく成分で見ると用途が変わる。ただし高単価用途は吸収量が小さく、全量処理には複数の出口が必要。',href:'/setouchi-cultural-economic-atlas/book/sea-bream-scales-to-collagen/'},
  {material:'魚残渣',place:'愛媛',from:'水産加工',to:'養殖飼料・柑橘肥料',lesson:'海へ戻す循環と、海から山へ渡す循環が並存する。異業種が近接していること自体が循環の立地条件になる。',href:'/setouchi-cultural-economic-atlas/book/fish-waste-to-feed-and-citrus/'},
  {material:'オリーブ搾り粕',place:'小豆島・香川',from:'搾油',to:'牛の飼料→オリーブ牛',lesson:'副産物の由来を消さず、次の商品ブランドへ引き継ぐことで、循環がコスト削減だけでなく差別化価値になる。',href:'/setouchi-cultural-economic-atlas/book/olive-pomace-to-cattle/'},
  {material:'醤油粕',place:'小豆島',from:'醤油醸造',to:'長命草等の肥料',lesson:'循環とは欠点を消すことではなく、「塩分が高い」など素材固有の性質と、それを必要とする受け手を組み合わせる相性設計でもある。',href:'/setouchi-cultural-economic-atlas/book/soy-sauce-lees-to-chomeiso/'},
  {material:'脂イワシ',place:'伊吹島',from:'いりこ漁・加工',to:'急速冷凍食品等',lesson:'規格外は絶対的な低品質ではなく、用途との不一致で生じる。価値が落ちる工程を避けることは、廃棄後の再利用より上流の循環設計である。',href:'/setouchi-cultural-economic-atlas/book/ibuki-fat-sardines-revalued/'},
  {material:'柑橘搾汁粕',place:'愛媛',from:'ジュース加工',to:'サイレージ飼料・セルロースナノファイバー等',lesson:'大量・低単価用途と少量・高付加価値用途を競合させず、成分と量に応じて段階的に使うカスケード利用が必要。',href:'/setouchi-cultural-economic-atlas/book/citrus-pomace-cascade/'},
  {material:'柑橘剪定枝',place:'愛媛',from:'果樹園管理',to:'畜産敷料→堆肥／バイオ炭',lesson:'循環では「何へ使うか」だけでなく「どの速度で炭素を回すか」も設計変数になる。循環と長期固定は目的が異なる。',href:'/setouchi-cultural-economic-atlas/book/citrus-prunings-to-soil/'},
  {material:'デニム裁断くず・使用済み製品',place:'児島',from:'縫製・衣料利用',to:'修理・アップサイクル・反毛・再紡績',lesson:'循環は製品末端の処理ではなく、リベットや異素材を減らすDesign for Recyclingから始まる。産地全体の工程ネットワークが回収・分別・再製造までつながるかが次の論点。',href:'/setouchi-cultural-economic-atlas/book/kojima-jeans-circular-economy/'}
];

const principles = [
  ['01','廃棄物は絶対概念ではない','「余るもの」の物性と、「足りないもの」を持つ別工程との関係で資源価値が決まる。脂イワシや醤油粕は、用途を変えると欠点が長所へ反転する。'],
  ['02','循環の前に価値低下を防ぐ','乾燥で価値が落ちる脂イワシを急速冷凍する、ジーンズを解体しやすく設計するなど、廃棄後のリサイクルより上流で損失を避ける。'],
  ['03','高付加価値と大量処理を分ける','コラーゲンやCNFは高単価でも吸収量が限られる。飼料・肥料・建材等の大口用途との組み合わせが必要。'],
  ['04','近接性が循環を成立させる','水分・臭気・かさの大きい副産物ほど輸送費が支配的になる。水産加工と柑橘、醤油と農業の近接は地域資産になり得る。'],
  ['05','カスケードで価値を使い切る','修理→再使用→素材回収、機能性成分→飼料→肥料など、価値の高い機能から順に使い、最後まで用途を設計する。'],
  ['06','循環速度も設計する','養分は回す一方、炭素はバイオ炭として長く固定する方が望ましい場合がある。「回す量」だけでなく時間軸を持つ。'],
  ['07','ブランドも循環できる','オリーブ粕がオリーブ牛へつながるように、素材の由来や物語が次の商品価値へ継承される場合がある。'],
  ['08','一社ではなく地域ネットワークを見る','回収、保管、分別、前処理、加工、需要、品質保証までが連続して初めて循環する。個別の成功商品と地域全体の循環率は分けて評価する。']
];

const metrics = [
  ['物量','年間発生量／回収量／再利用量／最終処分量','「事例がある」から「どの程度回っているか」へ進む。'],
  ['価値','用途別単価、処理費回避額、付加価値額','高単価用途と大量用途の役割を分ける。'],
  ['距離','回収・加工・利用地点間の輸送距離','地域内循環が本当に輸送負荷を下げるか確かめる。'],
  ['投入','前処理・乾燥・発酵・抽出等のエネルギーと水','リサイクル率だけでなく循環のための追加負荷を測る。'],
  ['代替','何の原料・飼料・肥料・素材を置き換えたか','循環による実際の資源節約を測る。'],
  ['残存価値','再利用後にさらに次用途へ渡せるか','一回限りのダウンサイクルとカスケード利用を区別する。'],
  ['地域捕捉','地元企業・農漁業者への所得、雇用、設備投資','物質が地域を回っても経済価値が地域外へ流出していないかを見る。']
];
---
<BaseLayout title="瀬戸内の地域資源循環と産業共生 | 研究ノート | SETOUCHI ATLAS" description="牡蠣殻、魚残渣、柑橘搾汁粕、剪定枝、オリーブ粕、醤油粕、デニムなどを横断し、副産物を次の産業へ渡す瀬戸内の地域資源循環を分析する。">
  <section class="place-hero chapter-hero">
    <div class="kicker">MATERIAL CIRCULATION / INDUSTRIAL SYMBIOSIS</div>
    <h1>瀬戸内の地域資源循環と産業共生</h1>
    <p class="subtitle">「捨てない」ではなく、余るものと足りないものを地域の中でどう接続するか。</p>
    <p class="lead">既存エッセイを横断すると、瀬戸内の循環経済は一つの技術では説明できない。カキ殻を海底へ戻す、魚のアラを飼料やみかん肥料へ渡す、柑橘粕を大量飼料と高機能素材へ分ける、デニムを解体しやすく設計する。共通するのは、副産物の性質、量、距離、受け手、加工コストを組み合わせ、次の生産工程へ接続する「地域産業設計」である。</p>
  </section>

  <section class="section">
    <h2>01｜基本モデル｜循環は「相性 × 距離 × 量 × 加工」で決まる</h2>
    <div class="process-chain"><span>主製品</span><b>→</b><span>副産物</span><b>→</b><span>分別・前処理</span><b>→</b><span>近隣需要</span><b>→</b><span>次の生産</span><b>→</b><span>残余物</span><b>→</b><span>次の用途</span></div>
    <p><strong>仮説：</strong>地域循環の成立可能性は、素材が再利用可能かどうかよりも、①副産物の物性と需要側の適合、②大量発生量を吸収できる需要規模、③輸送距離、④前処理コスト、⑤継続的な品質保証の組合せで決まる。</p>
  </section>

  <section class="section">
    <h2>02｜エッセイから得られた9つの循環ケース</h2>
    <div class="table-wrap"><table><thead><tr><th>副産物・未利用物</th><th>地域</th><th>発生源</th><th>次用途</th><th>研究上の知見</th></tr></thead><tbody>
      {cases.map((c)=><tr><td><a href={c.href}><strong>{c.material}</strong></a></td><td>{c.place}</td><td>{c.from}</td><td>{c.to}</td><td>{c.lesson}</td></tr>)}
    </tbody></table></div>
  </section>

  <section class="section">
    <h2>03｜個別事例から一般化できる8原則</h2>
    <div class="research-note-role-grid">
      {principles.map(([no,title,body])=><article><strong>{no} {title}</strong><p>{body}</p></article>)}
    </div>
  </section>

  <section class="section">
    <h2>04｜「リサイクル率」だけでは比較できない</h2>
    <p>再利用されている割合が高くても、遠距離輸送や大量の乾燥エネルギーが必要なら、地域として望ましい循環とは限らない。一方、少量しか使わない高機能素材は付加価値が高くても、発生物全体を吸収できない。したがって、物量・価値・距離・追加投入を同じ表で見る。</p>
    <div class="table-wrap"><table><thead><tr><th>軸</th><th>測るもの</th><th>意味</th></tr></thead><tbody>
      {metrics.map((r)=><tr>{r.map((c,i)=><td>{i===0?<strong>{c}</strong>:c}</td>)}</tr>)}
    </tbody></table></div>
  </section>

  <section class="section">
    <h2>05｜瀬戸内では「海→陸→海」の物質移動を見る</h2>
    <p>魚残渣が柑橘畑へ移り、カキ殻が海底へ戻り、食品加工残渣が畜産へ入り、家畜由来堆肥が再び農地へ戻る。行政区分や産業分類を越えて物質を追うと、水産・農業・食品・畜産・素材産業が一つの地域システムとして見えてくる。</p>
    <p>この視点はATLASの「自然環境→生態系→生業・産業」という一方向の因果に、<strong>産業→副産物→別産業→土地・生態系</strong>という戻りの矢印を加える。地域経済は物を作るだけでなく、残余物を介して自然環境と他産業を書き換える。</p>
  </section>

  <section class="section">
    <h2>06｜次に作るべき「瀬戸内マテリアルフロー」</h2>
    <p>今後は事例数を増やすより、各地域で年間何トン発生し、どこへ何トン移動し、どの用途でいくらの価値になり、最後に何が残るかを量でつなぐ段階へ進む。最初の重点地域は、食品加工が重なる<strong>小豆島</strong>、水産と柑橘が近接する<strong>愛媛南予</strong>、牡蠣養殖の副産物量が大きい<strong>広島湾・日生</strong>、繊維工程が集積する<strong>児島</strong>が適している。</p>
  </section>

  <section class="section">
    <div class="kicker">ESSAY FEEDBACK</div>
    <h2>この研究ノートへ統合したエッセイ</h2>
    <div class="chapter-related-grid">
      {cases.map((c)=><a class="compare-button secondary" href={c.href}>{c.place}｜{c.material} →</a>)}
    </div>
  </section>
</BaseLayout>
