---
import BaseLayout from '../layouts/BaseLayout.astro';
import { places } from '../data/places.js';
import { climateProfiles } from '../data/climate.js';

const axes = [
  { key: 1, label: '地理・地形' },
  { key: 2, label: '気候・水・自然条件' },
  { key: 3, label: '歴史・都市形成' },
  { key: 4, label: '港・交通・物流' },
  { key: 5, label: '食文化' },
  { key: 6, label: '地域産業' },
  { key: 8, label: '産業遺伝子' },
  { key: 9, label: '資本形成' },
  { key: 10, label: '産業生態系' },
  { key: 12, label: '暮らし' },
  { key: 13, label: '観光・文化' },
  { key: 15, label: '現在の変化' },
  { key: 17, label: 'なぜこの町はこの町になったのか' }
];

const geneSummary = {
  ako: '資源型＋土地継承型',
  onomichi: 'ネットワーク型',
  imabari: '資本循環型＋技能型',
  shimotsui: 'ネットワーク型＋資源型',
  tadotsu: '物流型＋土地継承型',
  mitarai: 'ネットワーク型＋物流型',
  ushimado: 'ネットワーク型＋物流型',
  tomonoura: 'ネットワーク型＋物流型',
  mihara: 'ネットワーク型＋物流型＋土地継承型',
  takehara: '資源型＋資本循環型＋ネットワーク型',
  matsuyama: 'ネットワーク型＋ブランド適応型',
  shimonoseki: 'ネットワーク型＋物流型',
  yanai: 'ネットワーク型＋資本循環型',
  hofu: '資源型＋物流型',
  hiketa: 'ネットワーク型＋物流型',
  sakaide: '資源型＋土地継承型＋物流型',
  takamatsu: 'ネットワーク型＋物流型'
};

const origin = {
  ako: '海水・塩田',
  onomichi: '天然港・交易',
  imabari: '海峡・海運',
  shimotsui: '備讃瀬戸・渡海場',
  tadotsu: '天然港・金毘羅参詣',
  mitarai: '潮待ち・風待ち',
  ushimado: '良港・外交航路',
  tomonoura: '潮流転換点',
  mihara: '良港・城下港',
  takehara: '干拓・塩田',
  matsuyama: '城下・温泉・三津浜港',
  shimonoseki: '関門海峡',
  yanai: '柳井津・瀬戸内交易',
  hofu: '周防灘・塩田',
  hiketa: '風待ち・潮待ち港',
  sakaide: '塩田・港湾用地',
  takamatsu: '中世港町・海城'
};
---
<BaseLayout title="17地域比較 | 瀬戸内文化経済アトラス" description="瀬戸内17地域を同じ軸で比較する地域インテリジェンスページ。">
  <section class="place-hero compare-hero">
    <div class="kicker">CROSS-CITY COMPARISON</div>
    <h1>{places.length}地域を比べる</h1>
    <p class="subtitle">同じ瀬戸内でも、都市をつくった「起点」と「産業遺伝子」は異なります。{places.length}地域を同じ13軸で横並びにし、差分そのものを読むページです。</p>
  </section>

  <section class="section">
    <div class="comparison-summary-grid">
      {places.map((place) => (
        <article class="comparison-summary-card">
          <div class="kicker">{place.prefecture}</div>
          <h2>{place.name}</h2>
          <dl>
            <div><dt>形成の起点</dt><dd>{origin[place.id]}</dd></div>
            <div><dt>主要な産業遺伝子</dt><dd>{geneSummary[place.id]}</dd></div>
            <div><dt>要約</dt><dd>{place.subtitle}</dd></div>
          </dl>
          <a class="text-link" href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>地域ページを見る →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section compare-table-section">
    <div class="kicker">13 COMPARATIVE AXES</div>
    <h2>同じ軸で読む</h2>
    <div class="compare-table-wrap">
      <table class="compare-table">
        <thead>
          <tr>
            <th>比較軸</th>
            {places.map((place) => <th>{place.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {axes.map((axis) => (
            <tr>
              <th>{axis.label}</th>
              {places.map((place) => {
                const section = place.sections[axis.key];
                return (
                  <td>
                    <span class={`claim-badge ${section[2]}`}>{section[2].toUpperCase()}</span>
                    <p>{section[1]}</p>
                    {axis.key === 2 && climateProfiles[place.id] && <a class="text-link" href={`/setouchi-cultural-economic-atlas/places/${place.id}/climate/`}>気候データを見る →</a>}
                    {axis.key === 4 && <a class="text-link" href={`/setouchi-cultural-economic-atlas/transport/#place-${place.id}`}>交通ネットワークを見る →</a>}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="kicker">STRUCTURAL READING</div>
    <h2>{places.length}地域の違いを一言で表すと</h2>
    <div class="comparison-insight-grid">
      <article class="insight-card">
        <h3>赤穂</h3>
        <p><strong>資源を加工し、土地を継承した都市。</strong> 製塩という自然資源利用が、技術系譜と臨海工業用地の二方向に残った。</p>
      </article>
      <article class="insight-card">
        <h3>尾道</h3>
        <p><strong>ネットワークが富と文化を蓄積した都市。</strong> 港と交易が商業資本を生み、海運・造船と文化資産の双方へ展開した。</p>
      </article>
      <article class="insight-card">
        <h3>今治</h3>
        <p><strong>資本と技能が循環する都市。</strong> 船主資本が海事産業を厚くし、繊維技能はタオル産地へ進化した。</p>
      </article>
      <article class="insight-card">
        <h3>下津井</h3>
        <p><strong>航路と漁場が重なった港町。</strong> 北前船・金毘羅参詣と漁業文化が同じ海域条件の上に成立した。</p>
      </article>
      <article class="insight-card">
        <h3>多度津</h3>
        <p><strong>港から鉄道・工業へ転換した交通都市。</strong> 海上交通の結節機能が近代インフラへ継承された。</p>
      </article>
      <article class="insight-card">
        <h3>御手洗</h3>
        <p><strong>航海制約そのものが富を生んだ港町。</strong> 潮待ち・風待ちによる滞留が商業・宿泊・景観を蓄積した。</p>
      </article>
      <article class="insight-card"><h3>牛窓</h3><p><strong>外交と海運が文化を運んだ港町。</strong> 良港と寄港ネットワークが海運・交流文化へ展開した。</p></article>
      <article class="insight-card"><h3>鞆の浦</h3><p><strong>潮の転換点が滞留経済を生んだ港町。</strong> 潮待ちが商業・酒造・鍛冶・宿泊を育てた。</p></article>
      <article class="insight-card"><h3>三原</h3><p><strong>交通手段を乗り換え続けた都市。</strong> 城下港から工業港、鉄道、新幹線、空港へ結節機能を更新した。</p></article>
      <article class="insight-card"><h3>竹原</h3><p><strong>製塩利益を別産業と町並みに転換した町。</strong> 塩田の富が酒造・廻船・問屋・建築へ再投資された。</p></article>
      <article class="insight-card"><h3>松山</h3><p><strong>城下・温泉・港が統合された都市。</strong> 道後、松山城下、三津浜と近代交通が複合都市をつくった。</p></article>
      <article class="insight-card"><h3>下関</h3><p><strong>海峡そのものが都市資産になったゲートウェイ。</strong> 北前船から国際港・水産市場まで機能を更新した。</p></article>
      <article class="insight-card"><h3>柳井</h3><p><strong>交易の富が白壁の商家町に固定化した商都。</strong> 広い商圏が商人資本を育てた。</p></article>
      <article class="insight-card"><h3>防府（三田尻）</h3><p><strong>塩を全国へ売った資源・交易都市。</strong> 塩田と北前船が一体化した。</p></article>
      <article class="insight-card"><h3>引田</h3><p><strong>風待ち・潮待ちが城下と加工文化を育てた港町。</strong> 港・城・商家・醸造が重なる。</p></article>
      <article class="insight-card"><h3>坂出</h3><p><strong>塩田の土地を臨海工業へ継承した都市。</strong> 港湾と埋立が産業転換を可能にした。</p></article>
      <article class="insight-card"><h3>高松</h3><p><strong>港町を海城と県都へ更新した広域拠点。</strong> 海陸交通の結節性が都市中心性を支えた。</p></article>
    </div>
  </section>
</BaseLayout>
