---
import BaseLayout from '../layouts/BaseLayout.astro';
import { places } from '../data/places.js';

const types = [
  {
    name:'資源・土地継承型', places:['赤穂','坂出','防府（三田尻）'],
    mechanism:'自然資源を加工し、その技術・土地・物流機能が次の産業へ継承される。',
    chain:['海・干満','製塩','技術・土地資産','港湾・工業・物流'],
    question:'資源利用の痕跡が、現代産業にどう残ったか'
  },
  {
    name:'航路・漁場・繊維後背地複合型', places:['下津井'],
    mechanism:'潮流海域が漁場と航路を成立させ、さらに北前船物流が後背地の綿作・繊維産業を支える。',
    chain:['潮流海域＋干拓地','北前船・漁場','肥料流入＋木綿積出','織物・紡績・縫製＋漁業'],
    question:'港湾物流は、後背地の産業形成までどこまで規定するか'
  },
  {
    name:'交通インフラ継承型', places:['多度津'],
    mechanism:'港で蓄積された結節機能が鉄道・物流・臨海工業へ別のインフラとして継承される。',
    chain:['天然港','北前船・参詣','鉄道','港湾物流・臨海工業'],
    question:'交通拠点は、交通手段が変わっても残り続けるか'
  },
  {
    name:'交易・商業資本型', places:['尾道','牛窓','柳井'],
    mechanism:'交易ネットワークが商業資本を生み、その資本が海運・文化・町並みへ再投資される。',
    chain:['港','交易','商人資本','海運・文化・町並み'],
    question:'港で生まれた富は、何に再投資されたか'
  },
  {
    name:'滞留経済型', places:['御手洗','鞆の浦','引田'],
    mechanism:'潮・風など航海上の制約が人と船を滞留させ、その時間が商業・宿泊・加工需要を生む。',
    chain:['潮・風','待機','人・物の滞留','商家・宿・加工'],
    question:'「待つこと」は、どう経済価値に変わったか'
  },
  {
    name:'複合交通更新型', places:['三原','高松'],
    mechanism:'港湾結節性を基礎に、時代ごとに鉄道・道路・広域交通へ都市機能を更新していく。',
    chain:['港','城下・工業港','鉄道・道路','広域交通拠点'],
    question:'結節性は、交通技術が変わっても都市資産として残るか'
  },
  {
    name:'資源利益転換型', places:['竹原'],
    mechanism:'資源産業で得た利益を別産業・商業・建築へ再投資し、都市文化へ固定化する。',
    chain:['塩田','製塩利益','酒造・廻船・問屋','商人資本','町並み'],
    question:'資源産業の利益は、次の産業と文化にどう転換されたか'
  },
  {
    name:'資本循環・技能型', places:['今治'],
    mechanism:'船主資本と造船・舶用産業、技能蓄積が相互に需要を生み、自己強化する。',
    chain:['海運','船主資本','造船・舶用','再投資・技能蓄積'],
    question:'地域内の資本循環が、産業集積をどこまで厚くするか'
  },
  {
    name:'海峡ゲートウェイ型', places:['下関'],
    mechanism:'海峡という不可避の通航点が航路・商業・国際交通・水産物流を集中させる。',
    chain:['関門海峡','航路集中','北前船・商人','国際港','物流・市場'],
    question:'海峡という地理的ボトルネックは、どのように都市中心性へ変わるか'
  },
  {
    name:'城下・温泉・港複合型', places:['松山'],
    mechanism:'異なる起源を持つ城下町・温泉地・港町が近代交通で統合され、大都市機能を形成する。',
    chain:['城下町＋道後＋三津浜','私鉄・汽船','県都機能','観光・商業・交通'],
    question:'複数の都市核は、どう一つの都市圏へ統合されたか'
  }
];

types.push(
  {
    name:'分散型加工生態系', places:['小豆島'],
    mechanism:'複数の中小加工業が、原料・副産物・物流・技能を部分的に共有しながら地域内で連鎖する。',
    chain:['塩・海運','醤油・素麺','ごま油・佃煮','オリーブ・加工'],
    question:'一つの中核企業がなくても、産業生態系はどう成立するか'
  },
  {
    name:'資源起点・企業分岐型', places:['新居浜'],
    mechanism:'鉱山を支えた機械・化学・電力などの内部機能が、資源産業から独立して次の工業を形成する。',
    chain:['銅山','機械化・製錬課題','機械・化学・非鉄','臨海工業都市'],
    question:'有限資源を、再利用可能な地域能力へどう変換したか'
  },
  {
    name:'河川二極城下町型', places:['岩国'],
    mechanism:'河川を挟んで政治・武家地と商業・町人地を分け、橋と流域経済によって一都市として統合する。',
    chain:['錦川','横山／錦見','錦帯橋','和紙・商業・城下町'],
    question:'川は防壁・資源・交通・分断をどう同時に担ったか'
  }
);

const matrix = [
  ['赤穂','海水・塩田','製塩','技術・土地','素材・化学・重工'],
  ['下津井','潮流海域＋干拓綿作','北前船・漁場','肥料・木綿物流＋繊維技能','漁港文化＋児島繊維・ジーンズ'],
  ['多度津','良港・立地','北前船・参詣','港＋鉄道','物流・臨海工業'],
  ['尾道','天然港','交易','商業資本','海運・造船・文化'],
  ['御手洗','潮・風の制約','潮待ち・風待ち','滞留需要','歴史景観・観光'],
  ['今治','海峡・海運','船主・航海技能','資本循環＋技能','造船・舶用・タオル'],
  ['牛窓','良港・海上交通','外交・海運','交流ネットワーク','海運・文化観光'],
  ['鞆の浦','潮流転換点','潮待ち','滞留需要','港町文化・観光'],
  ['三原','良港・広域結節','城下港・工業港','交通インフラ','工業・物流・広域交通'],
  ['竹原','干拓・塩田','製塩・廻船','商人資本','酒造・町並み・観光'],
  ['松山','城下・温泉・港','城下町・道後・三津浜','都市核＋地域交通','県都・観光・サービス'],
  ['下関','関門海峡','航路集中・北前船','港湾・商業資本','国際物流・水産・観光'],
  ['柳井','柳井津・内海航路','広域交易','商人資本','白壁商家町・観光'],
  ['防府（三田尻）','周防灘・遠浅海岸','大規模製塩・北前船','塩田・港・流通','産業遺産・都市形成'],
  ['引田','風待ち・潮待ち','港・城下町','商家・加工技能','漁業・醤油・観光'],
  ['坂出','塩田・浅瀬','塩積出港','土地・港湾インフラ','臨海工業・瀬戸大橋'],
  ['高松','中世港町・海城','城下・県都','港＋行政商業','広域交通・都市サービス'],
  ['小豆島','島嶼・塩・海運','発酵・食品加工','加工技能＋事業者ネットワーク','醤油・素麺・ごま油・オリーブ'],
  ['新居浜','銅鉱床・山地','鉱山・製錬','機械・化学・電力能力','非鉄・機械・化学・臨海工業'],
  ['岩国','錦川・城山・流域','城下町・和紙・商業','橋梁技能＋商人能力','錦帯橋・流域都市・文化景観']
];
---
<BaseLayout title="地域形成類型 | 瀬戸内文化経済アトラス" description="瀬戸内各地域を、富の生成メカニズムと地域能力の形成過程で類型化する。">
  <section class="place-hero">
    <div class="kicker">REGIONAL FORMATION TYPOLOGY</div>
    <h1>瀬戸内の地域形成を、類型で読む</h1>
    <p class="subtitle">地域は同じ経路で形成されません。資源、航路、滞留、商業資本、企業、河川、複数都市核という「富と能力の生まれ方」の違いで比較します。</p>
  </section>

  <section class="section">
    <div class="kicker">{types.length} TYPES</div>
    <h2>{places.length}地域・{types.length}の形成メカニズム</h2>
    <div class="typology-grid">
      {types.map((type) => (
        <article class="typology-card">
          <div class="kicker">{type.places.join(' / ')}</div>
          <h3>{type.name}</h3>
          <p>{type.mechanism}</p>
          <div class="causal-chain compact-chain"><span>{type.chain.join(' → ')}</span></div>
          <p class="typology-question"><strong>問い：</strong>{type.question}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section gene-section">
    <div class="kicker">COMPARATIVE MATRIX</div>
    <h2>どこで価値が生まれ、何が残ったか</h2>
    <div class="compare-table-wrap">
      <table class="compare-table">
        <thead><tr><th>地域</th><th>地理的起点</th><th>歴史的機能</th><th>蓄積した資産</th><th>現在への継承</th></tr></thead>
        <tbody>
          {matrix.map((row) => (
            <tr><th>{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td><td>{row[4]}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="kicker">KEY INSIGHT</div>
    <h2>「資源がある」「港がある」だけでは説明できない</h2>
    <div class="synthesis">
      地域差を生むのは、資源や港の存在そのものではなく、何が流れ、何が待ち、誰が投資し、何が能力として蓄積され、次の時代へ何が継承されたかである。
      小豆島・新居浜・岩国まで加えることで、分散加工、資源企業、河川城下町を含む多様な地域形成メカニズムを比較できる。
    </div>
  </section>
</BaseLayout>
