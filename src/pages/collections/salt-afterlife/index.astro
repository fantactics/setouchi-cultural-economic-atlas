---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { publishedEssays } from '../../../data/publishedEssayList.js';
import { photoEvidence } from '../../../data/photoEvidence.js';
import { additionalPlacePhotos } from '../../../data/additionalPlacePhotos.js';
import { essayIndexPhotoOverrides } from '../../../data/essayIndexPhotos.js';
import { cardPhotoId } from '../../../data/essayCardCopy.js';

// An editorial comparison, not a geographical reconstruction or a claim that
// the seven places represent the same kind of land or transition.
const paths = [
  {
    slug:'ako-after-salt-fields',
    place:'兵庫・赤穂',
    kind:'仕事を継ぐ',
    inheritance:'製塩という仕事',
    photoFocus:'赤穂海浜公園に再現された流下式塩田。昔の塩田をそのまま撮ったものではありません。',
    before:'海水を濃くする塩田',
    after:'膜と電気で塩をつくる工場',
    question:'塩田を手放しても、塩づくりを続けられるのか。',
    note:'西浜では土地を売り、新技術で製塩事業を継続。東浜は別の結末を迎えました。'
  },
  {
    slug:null,
    place:'愛媛・伯方島',
    kind:'塩の名前を継ぐ',
    inheritance:'「伯方の塩」の会社',
    before:'島の塩田',
    after:'塩田廃止後に生まれた伯方塩業',
    question:'塩田を残せなかった人々が、なぜ塩の会社をつくったのか。',
    note:'1971年の塩田廃止に反対した人々の運動を母体に、1973年に伯方塩業が創業。現在の原料がすべて伯方島産という意味ではありません。',
    title:'伯方塩業の創業と「伯方の塩」',
    href:'https://www.hakatanoshio.co.jp/company/cp_history/',
    external:true,
    linkLabel:'伯方塩業の公式資料へ'
  },
  {
    slug:'iwagi-salt-pans-to-shrimp-ponds',
    place:'愛媛・岩城島',
    kind:'水を使い直す',
    inheritance:'海水を扱う池',
    photoFocus:'岩城島の集落の参考写真。北浜の養殖池そのものではありません。',
    before:'北浜の塩田',
    after:'クルマエビの養殖池',
    question:'塩を取り出した池で、今度は生き物を育てられるのか。',
    note:'1986年の県史は北浜跡をクルマエビ養殖場と記録。現在の養殖種や稼働状況を示すものではありません。'
  },
  {
    slug:'takehara-salt-capital-to-townscape',
    place:'広島・竹原',
    kind:'富が町に残る',
    inheritance:'塩で得た富',
    photoFocus:'竹原の白壁の町並み。塩田そのものはこの写真には見えません。',
    before:'塩田と廻船の商い',
    after:'白壁の商家と新たな市街地',
    question:'塩田が消えても、塩の利益はどこに残るのか。',
    note:'干拓地は町へ姿を変え、塩で栄えた商家の建物には別の時間が刻まれています。'
  },
  {
    slug:'sakaide-salt-fields-to-industry',
    place:'香川・坂出',
    kind:'海岸線をつくり直す',
    inheritance:'旧塩田と、新たな陸地',
    photoFocus:'番の州の工業地。旧塩田の直接転用ではなく、沖合を新たに埋め立てた土地です。',
    before:'旧塩田と、その沖の海',
    after:'旧塩田の転用と番の州の新規埋立',
    question:'工場が立つ土地は、本当に塩田の跡だったのか。',
    note:'重要なのは二種類の土地。番の州の巨大工業地帯は、旧塩田ではなく沖合を新たに埋め立てた場所です。'
  },
  {
    slug:'imabari-why-shipbuilding',
    place:'愛媛・今治（波止浜）',
    kind:'塩と船が交わる',
    inheritance:'造船と船の修繕',
    photoFocus:'波止浜港に関する参考写真。かつての塩田の範囲を示すものではありません。',
    before:'塩田と潮待ちの港',
    after:'塩田の一部を利用した造船所',
    question:'塩を運んだ船が、なぜ塩田の土地を使うようになったのか。',
    note:'塩の輸送と船の修繕が重なって産業が育ち、塩田の一部が造船所の用地に使われました。'
  },
  {
    slug:'kinkai-salt-field-to-solar',
    place:'岡山・牛窓（錦海）',
    kind:'守る仕事が残る',
    inheritance:'排水し続ける責任',
    photoFocus:'錦海塩田跡の発電所。土地の排水施設は写真だけでは見えません。',
    before:'海を締め切って造った塩田',
    after:'太陽光発電所と排水施設',
    question:'塩づくりをやめたあと、なぜポンプは止められないのか。',
    note:'錦海では排水を続けて発電所へ。一方、近くの鹿忍には排水設備が止まり建物が水没した旧リゾートがあります。',
    relatedHref:'/setouchi-cultural-economic-atlas/book/kashino-sunken-pension-village/',
    relatedLabel:'鹿忍の水没した旧リゾートも読む'
  }
];
const bySlug = new Map(publishedEssays.map(article=>[article.slug,article]));
const photos = Object.fromEntries([...photoEvidence,...Object.values(additionalPlacePhotos).flat()].map(photo=>[photo.id,photo]));
const chapters = paths.map(entry=>{
  if(entry.external) return {...entry,photo:null};
  const article=bySlug.get(entry.slug);
  if(!article) throw new Error('Salt-afterlife collection references unpublished essay: '+entry.slug);
  const curated=essayIndexPhotoOverrides[entry.slug];
  const photo=curated?.imageUrl ? curated :
    photos[cardPhotoId(article)]?.imageUrl ? photos[cardPhotoId(article)] :
    article.heroPhoto?.imageUrl ? article.heroPhoto :
    photos[article.heroPhotoId];
  return {...entry,title:article.title,href:`/setouchi-cultural-economic-atlas/book/${article.slug}/`,photo};
});
---
<BaseLayout
  title="塩田が消えたあと、土地には何が残ったか | SETOUCHI ATLAS"
  description="赤穂、伯方島、岩城島、竹原、坂出、今治・波止浜、牛窓。製塩の仕事や跡地に何が起きたか、七つの土地から個別エッセイを探す案内ページ。"
>
  <main class="salt-series">
    <nav class="salt-breadcrumb" aria-label="パンくず"><a href="/setouchi-cultural-economic-atlas/">トップ</a><span aria-hidden="true">／</span><a href="/setouchi-cultural-economic-atlas/book/">エッセイ</a><span aria-hidden="true">／</span>連作</nav>
    <header class="salt-intro">
      <p class="salt-kicker">LANDSCAPE STORIES · 読み比べる瀬戸内</p>
      <h1>塩田が消えたあと、<br />土地には何が残ったか。</h1>
      <p class="salt-dek">塩田があった七つの土地を、現在の風景から訪ねます。</p>
      <p>赤穂では塩づくりが続き、伯方島では新しい塩の会社が生まれました。竹原の白壁、岩城島の養殖池、坂出の埋立地、今治・波止浜の造船所、牛窓の排水設備。それぞれに違う歴史があります。気になる土地から、詳しいエッセイへ進んでください。</p>
      <a class="salt-intro-start" href="#salt-compare-title">七つの土地を見比べる ↓</a>
    </header>

    <section class="salt-compare" aria-labelledby="salt-compare-title">
      <div class="salt-section-head"><span>SEVEN PLACES · 比較案内</span><h2 id="salt-compare-title">塩田の歴史から、七つの土地を訪ねる。</h2><p>それぞれのカードから個別の物語へ。伯方島は会社の沿革資料をご案内します。</p></div>
      <div class="salt-origin"><span>共通する出発点</span><strong>海水から塩をつくった土地</strong><p>製塩の時代も、跡地の使われ方も、港との関わりも土地ごとに異なります。</p></div><div class="salt-fork" aria-hidden="true"></div>
      <div class="salt-branches" role="list">
        {chapters.map((chapter)=><a role="listitem" class="salt-branch" href={chapter.href} target={chapter.external ? "_blank" : undefined} rel={chapter.external ? "noopener noreferrer" : undefined}>
          <span class="salt-branch-place">{chapter.place}</span>
          <span class="salt-branch-kind">{chapter.kind}</span>
          <span class="salt-branch-arrow" aria-hidden="true">↓</span>
          <strong>{chapter.inheritance}</strong><span class="salt-branch-after">{chapter.after}</span>
          <span class="salt-branch-open">{chapter.external ? "公式資料へ →" : "エッセイへ →"}</span>
        </a>)}
      </div>
      <p class="salt-diagram-caption">この図は記事を探すための案内で、地理的位置や面積を表しません。坂出の番の州は塩田跡ではなく、沖合を新たに埋め立てた土地です。今治の造船所も、すべてが塩田跡に建ったわけではありません。</p>
    </section>

    <section class="salt-chapters" aria-labelledby="salt-chapters-title">
      <div class="salt-section-head"><span>READ THE STORIES</span><h2 id="salt-chapters-title">七つの土地、七つの問い。</h2><p>気になる問いから読み始めてください。決まった順番はありません。</p></div>
      <div class="salt-chapter-grid">
        {chapters.map((chapter,index)=><article class="salt-chapter">
          <a class="salt-chapter-main" href={chapter.href} target={chapter.external ? "_blank" : undefined} rel={chapter.external ? "noopener noreferrer" : undefined}>
            {chapter.photo?.imageUrl && <figure class="salt-chapter-photo">
              <img src={chapter.photo.imageUrl} alt={chapter.photo.alt || chapter.title} loading="lazy" decoding="async" />
              <figcaption>{chapter.photoFocus}</figcaption>
            </figure>}
            <div class="salt-chapter-copy">
              <div class="salt-chapter-meta"><span>{String(index+1).padStart(2,'0')}</span><span>{chapter.place}</span><span>{chapter.kind}</span></div>
              <h3>{chapter.question}</h3>
              <p>{chapter.note}</p>
              <strong class="salt-link">{chapter.external ? chapter.linkLabel : `${chapter.title} を読む`} →</strong>
            </div>
          </a>
          {chapter.relatedHref && <p class="salt-related-link"><a href={chapter.relatedHref}>{chapter.relatedLabel} →</a></p>}
          {chapter.photo?.sourcePage && <p class="salt-photo-credit">
            写真：<a href={chapter.photo.sourcePage} target="_blank" rel="noopener noreferrer">{chapter.photo.author || '出典'}</a>
            {chapter.photo.license && <span> ／ {chapter.photo.license}</span>}
          </p>}
        </article>)}
      </div>
    </section>

    <footer class="salt-ending">
      <p>各地の経緯は、それぞれのエッセイと資料で詳しく紹介しています。塩田があったという共通点だけで、土地の歴史を一つの筋書きにまとめることはしません。</p>
      <a href="#salt-compare-title">七つの土地の案内に戻る ↑</a>
    </footer>
  </main>
  <style>
    .salt-series{max-width:1120px;margin:0 auto;padding:clamp(30px,5vw,68px) 22px 100px;color:#28463e;font-family:system-ui,-apple-system,"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif}
    .salt-breadcrumb{display:flex;gap:9px;align-items:center;flex-wrap:wrap;color:#78877f;font-size:.8rem;margin-bottom:34px}
    .salt-breadcrumb a{color:inherit}
    .salt-intro{max-width:820px;margin-bottom:66px}
    .salt-kicker,.salt-section-head>span{display:block;color:#a57553;letter-spacing:.14em;font-size:.77rem;font-weight:800;margin-bottom:13px}
    .salt-intro h1{font-size:clamp(2.05rem,4.5vw,3.55rem);line-height:1.35;letter-spacing:-.035em;color:#254b43;margin:0 0 24px}
    .salt-intro p{font-size:1.04rem;line-height:2.05;color:#4e655a;margin:0 0 14px}
    .salt-intro .salt-dek{font-size:clamp(1.12rem,2vw,1.32rem);font-weight:700;line-height:1.85;color:#385d50}
    .salt-compare{padding:clamp(22px,3vw,34px);border-radius:24px;background:#f3f6f0;margin-bottom:75px;border:1px solid #dbe6dc}
    .salt-section-head{margin:0 0 24px}.salt-section-head h2{font-size:clamp(1.45rem,2.4vw,2rem);line-height:1.5;margin:0 0 8px;color:#294c42}.salt-section-head p{margin:0;color:#61766a;line-height:1.8}
    .salt-branches{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
    .salt-branch{display:flex;flex-direction:column;align-items:center;gap:9px;min-width:0;padding:20px 12px;border:1px solid #dae3d7;background:#fffefa;border-radius:16px;text-decoration:none;text-align:center;color:#325b4e;transition:transform .18s ease,border-color .18s}
    .salt-branch:hover{transform:translateY(-3px);border-color:#90b2a0}.salt-branch-place{font-size:.78rem;color:#8d6553;font-weight:700}.salt-branch-before{min-height:3.2em;display:flex;align-items:center;font-size:.88rem;color:#5b7066;line-height:1.6}.salt-branch-arrow{color:#c59d68;font-size:1.3rem}.salt-branch strong{font-size:.92rem;line-height:1.65}.salt-branch-open{margin-top:auto;font-size:.75rem;color:#317b67;font-weight:700}
    .salt-diagram-caption{margin:16px 0 0;color:#75847b;font-size:.77rem;line-height:1.8}
    .salt-chapter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.salt-chapter{display:block;overflow:hidden;border-radius:19px;border:1px solid #e3e8de;background:#fffdf9;color:inherit;text-decoration:none;transition:transform .18s ease,box-shadow .18s}.salt-chapter:hover{transform:translateY(-3px);box-shadow:0 10px 30px #294c4214}
    .salt-chapter-photo{height:200px;background:#e9efea;overflow:hidden}.salt-chapter-photo img{width:100%;height:100%;object-fit:cover}.salt-chapter-copy{padding:23px}.salt-chapter-meta{display:flex;gap:9px;flex-wrap:wrap;color:#9a745e;font-size:.76rem;font-weight:700}.salt-chapter h3{color:#294d43;font-size:clamp(1.05rem,1.7vw,1.28rem);line-height:1.6;margin:13px 0}.salt-chapter p{font-size:.9rem;line-height:1.85;color:#64776c;margin:0 0 12px}.salt-photo-note{display:block;font-size:.75rem;line-height:1.6;color:#87958a;margin-bottom:12px}.salt-link{font-size:.86rem;color:#267964}
    .salt-ending{max-width:810px;margin:50px auto 0;padding:22px 0;border-top:1px solid #dce5db}.salt-ending h2{font-size:1.45rem;color:#385246}.salt-ending p{line-height:1.95;color:#54685a}.salt-ending a{display:inline-block;color:#287b68;line-height:1.7;font-weight:700;margin-top:10px}
    @media(max-width:900px){.salt-branches{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media(max-width:610px){.salt-series{padding:30px 16px 70px}.salt-branches{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.salt-branch{padding:15px 9px}.salt-chapter-grid{grid-template-columns:1fr}.salt-chapter-photo{height:190px}.salt-intro{margin-bottom:43px}.salt-compare{margin-bottom:50px;padding:19px 13px}}
    @media(prefers-reduced-motion:reduce){.salt-branch,.salt-chapter{transition:none}}

    .salt-intro-start{display:inline-block;margin-top:12px;color:#267960;font-weight:800;text-underline-offset:4px}
    .salt-compare{scroll-margin-top:20px}
    .salt-origin{max-width:630px;margin:0 auto;text-align:center;background:#fffdf8;border:1px solid #dacdb3;border-radius:15px;padding:20px 18px}
    .salt-origin>span{display:block;color:#956b51;font-size:.77rem;font-weight:800;margin-bottom:7px}
    .salt-origin strong{font-size:clamp(1.07rem,2vw,1.3rem);line-height:1.6;color:#3d614f}
    .salt-origin p{font-size:.8rem;color:#667869;margin:8px 0 0;line-height:1.8}
    .salt-fork{height:34px;display:flex;justify-content:center;align-items:center}
    .salt-fork:before{content:"";display:block;height:26px;width:2px;background:#9ab8a6}
    .salt-branch-kind{font-size:.75rem;color:#789080;line-height:1.6}
    .salt-branch strong{font-size:clamp(.93rem,1.35vw,1.12rem);line-height:1.5;color:#295847;margin:3px 0}
    .salt-branch-after{font-size:.82rem;color:#61756a;line-height:1.6;flex:1}
    .salt-chapter{display:flex;flex-direction:column}
    .salt-chapter-main{display:block;color:inherit;text-decoration:none;flex:1}
    .salt-chapter-photo{margin:0;height:auto;background:#edf3ed;overflow:visible}
    .salt-chapter-photo img{display:block;width:100%;height:210px;object-fit:cover}
    .salt-chapter-photo figcaption{padding:9px 15px;font-size:.78rem;line-height:1.7;color:#5b7265}
    .salt-photo-credit{border-top:1px solid #edf0e9;padding:10px 22px 13px;font-size:.73rem!important;line-height:1.7!important;color:#87958a!important;margin:0!important}
    .salt-photo-credit a{color:#687b70}
    .salt-related-link{margin:0!important;padding:0 23px 18px;font-size:.85rem;line-height:1.75}
    .salt-related-link a{color:#287b68;font-weight:700}
    .salt-ending-kicker{display:block;color:#a57553;letter-spacing:.14em;font-size:.77rem;font-weight:800;margin-bottom:13px}
    .salt-ending h2{line-height:1.55}
    .salt-ending-questions{padding-left:1.4em;color:#506a5d;line-height:2;margin:18px 0}
    .salt-ending-questions li{margin:6px 0}
    .salt-ending-links{display:flex;flex-direction:column;align-items:flex-start;gap:10px;margin-top:24px}
    .salt-ending-links a{color:#287b68;font-weight:700;line-height:1.75}
  </style>
</BaseLayout>
