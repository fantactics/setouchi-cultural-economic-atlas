---
import BaseLayout from '../layouts/BaseLayout.astro';
import { places } from '../data/places.js';

const compactPlaces = places.map((place)=>({
  id:place.id,
  name:place.name,
  prefecture:place.prefecture,
  subtitle:place.subtitle,
  sources:place.sources,
  sectionSources:place.sectionSources || {},
  nodes:[
    {
      key:'nature',title:'自然条件',claim:place.sections[2][2],
      text:place.sections[1][1]+' '+place.sections[2][1],
      sourceIndexes:[1,2]
    },
    {
      key:'formation',title:'歴史・都市形成',claim:place.sections[3][2],
      text:place.sections[3][1],
      sourceIndexes:[3]
    },
    {
      key:'transport',title:'港・交通・物流',claim:place.sections[4][2],
      text:place.sections[4][1],
      sourceIndexes:[4]
    },
    {
      key:'gene',title:'産業遺伝子',claim:place.sections[8][2],
      text:place.sections[8][1],
      sourceIndexes:[8]
    },
    {
      key:'capital',title:'資本形成・産業生態系',claim:place.sections[9][2],
      text:place.sections[9][1]+' '+place.sections[10][1],
      sourceIndexes:[9,10]
    },
    {
      key:'culture',title:'食・文化への波及',claim:place.sections[16][2],
      text:place.sections[5][1]+' '+place.sections[13][1]+' '+place.sections[16][1],
      sourceIndexes:[5,13,16]
    },
    {
      key:'today',title:'現在の変化',claim:place.sections[15][2],
      text:place.sections[15][1],
      sourceIndexes:[15]
    },
    {
      key:'why',title:'なぜこの町はこの町になったのか',claim:place.sections[17][2],
      text:place.sections[17][1],
      sourceIndexes:[17]
    }
  ]
}));

const nodeSources=(place,node)=>{
  const ids=[...new Set(node.sourceIndexes.flatMap((i)=>place.sectionSources[i] || []))];
  return ids.map((id)=>place.sources.find((s)=>s.id===id)).filter(Boolean);
};

const renderGraph=(place,slot)=>{
  return (
    <article class="causal-place-card" data-causal-card={slot} data-place-id={place.id}>
      <div class="causal-place-head">
        <div><div class="kicker">{place.prefecture}</div><h2>{place.name}</h2></div>
        <a class="text-link" href={`/setouchi-cultural-economic-atlas/places/${place.id}/`}>地域ページ →</a>
      </div>
      <p class="lead causal-subtitle">{place.subtitle}</p>
      <div class="causal-graph">
        {place.nodes.map((node,i)=>{
          const refs=nodeSources(place,node);
          return (
            <>
              <section class:list={['causal-node',`node-${node.key}`]}>
                <div class="causal-node-top">
                  <span class="causal-step">{i+1}</span>
                  <span class={`claim-badge ${node.claim}`}>{node.claim.toUpperCase()}</span>
                </div>
                <h3>{node.title}</h3>
                <p>{node.text}</p>
                {refs.length>0 && (
                  <div class="causal-source-row">
                    {refs.slice(0,4).map((s)=><a href={s.url} target="_blank" rel="noreferrer">{s.id}</a>)}
                  </div>
                )}
              </section>
              {i<place.nodes.length-1 && <div class="causal-arrow" aria-hidden="true">↓</div>}
            </>
          );
        })}
      </div>
    </article>
  );
};
---
<BaseLayout title="地域因果グラフ | 瀬戸内文化経済アトラス" description="瀬戸内17地域の自然条件・交通・産業・資本・文化・現在を因果グラフで比較する。">
  <section class="place-hero">
    <div class="kicker">REGIONAL CAUSAL GRAPH</div>
    <h1>「なぜこの町はこの町になったのか」を、一枚で読む</h1>
    <p class="subtitle">自然条件から現在までを8ノードで接続します。矢印は因果の断定ではなく、既存資料と編集上の解釈を区別した「説明仮説の骨格」です。</p>
  </section>

  <section class="section">
    <div class="kicker">COMPARE</div>
    <h2>2地域を横並びで比較する</h2>
    <div class="causal-selectors">
      <label>地域A
        <select id="causal-select-a">
          {compactPlaces.map((p,i)=><option value={p.id} selected={i===0}>{p.name}</option>)}
        </select>
      </label>
      <label>地域B
        <select id="causal-select-b">
          {compactPlaces.map((p,i)=><option value={p.id} selected={i===1}>{p.name}</option>)}
        </select>
      </label>
    </div>
    <div class="causal-compare-grid">
      <div id="causal-slot-a">
        {renderGraph(compactPlaces[0],'a')}
      </div>
      <div id="causal-slot-b">
        {renderGraph(compactPlaces[1] || compactPlaces[0],'b')}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">READING RULE</div>
    <h2>因果グラフの読み方</h2>
    <div class="comparison-insight-grid">
      <article class="insight-card"><h3>FACT</h3><p>自治体資料・企業資料などで確認できる事実。地形、港、企業、歴史的出来事など。</p></article>
      <article class="insight-card"><h3>INTERPRETATION</h3><p>複数の事実をつないだ編集上の説明。「土地が次の産業を呼んだ」などはここに置く。</p></article>
      <article class="insight-card"><h3>HYPOTHESIS</h3><p>因果関係として魅力的だが、追加資料で検証が必要なもの。事実へ自動昇格させない。</p></article>
      <article class="insight-card"><h3>比較</h3><p>同じ順番で2地域を見ることで、「港が資本になった町」「土地が産業になった町」「待つ時間が文化になった町」などの違いが見える。</p></article>
    </div>
  </section>

  <script is:inline define:vars={{ compactPlaces }}>
    (() => {
      const places=compactPlaces;
      const sourceByPlace=Object.fromEntries(places.map((p)=>[p.id,p.sources || []]));

      const refsFor=(p,node)=>{
        const ids=[...new Set((node.sourceIndexes || []).flatMap((i)=>(p.sectionSources || {})[i] || []))];
        const sources=sourceByPlace[p.id] || [];
        return ids.map((id)=>sources.find((s)=>s.id===id)).filter(Boolean);
      };

      const escapeHtml=(value)=>String(value ?? '')
        .replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')
        .replaceAll('"','&quot;').replaceAll("'","&#039;");

      const graphHtml=(p,slot)=>{
        const nodes=p.nodes.map((node,i)=>{
          const refs=refsFor(p,node).slice(0,4).map((s)=>
            '<a href="'+escapeHtml(s.url)+'" target="_blank" rel="noreferrer">'+escapeHtml(s.id)+'</a>'
          ).join('');
          return '<section class="causal-node node-'+escapeHtml(node.key)+'">'+
            '<div class="causal-node-top"><span class="causal-step">'+(i+1)+'</span>'+
            '<span class="claim-badge '+escapeHtml(node.claim)+'">'+escapeHtml(node.claim.toUpperCase())+'</span></div>'+
            '<h3>'+escapeHtml(node.title)+'</h3><p>'+escapeHtml(node.text)+'</p>'+
            (refs ? '<div class="causal-source-row">'+refs+'</div>' : '')+
            '</section>'+(i<p.nodes.length-1?'<div class="causal-arrow" aria-hidden="true">↓</div>':'');
        }).join('');
        return '<article class="causal-place-card" data-causal-card="'+slot+'" data-place-id="'+escapeHtml(p.id)+'">'+
          '<div class="causal-place-head"><div><div class="kicker">'+escapeHtml(p.prefecture)+'</div><h2>'+escapeHtml(p.name)+'</h2></div>'+
          '<a class="text-link" href="/setouchi-cultural-economic-atlas/places/'+escapeHtml(p.id)+'/">地域ページ →</a></div>'+
          '<p class="lead causal-subtitle">'+escapeHtml(p.subtitle)+'</p><div class="causal-graph">'+nodes+'</div></article>';
      };

      const byId=Object.fromEntries(places.map((p)=>[p.id,p]));
      const bind=(selectId,slotId,slotKey)=>{
        const select=document.getElementById(selectId);
        const slot=document.getElementById(slotId);
        if(!select || !slot) return;
        select.addEventListener('change',()=>{
          const p=byId[select.value];
          if(p) slot.innerHTML=graphHtml(p,slotKey);
        });
      };
      bind('causal-select-a','causal-slot-a','a');
      bind('causal-select-b','causal-slot-b','b');
    })();
  </script>
</BaseLayout>
