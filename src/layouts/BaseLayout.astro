---
import NaturalSystemEnhancer from '../components/NaturalSystemEnhancer.astro';
import { atlasSites, atlasHref } from '../config/atlasSites.js';
import RegionalDynamicNaturalCapital from '../components/RegionalDynamicNaturalCapital.astro';
import RegionalAdaptiveLens from '../components/RegionalAdaptiveLens.astro';
import EssayResearchSynthesis from '../components/EssayResearchSynthesis.astro';
import ResearchRelatedData from '../components/ResearchRelatedData.astro';
import ResearchNoteOverview from '../components/ResearchNoteOverview.astro';
import { naturalSystemProfiles } from '../data/naturalSystems.js';
import { regionalDynamicNaturalCapital } from '../data/regionalDynamicNaturalCapital.js';
import { essayResearchSynthesis } from '../data/essayResearchSynthesis.js';
import { essayResearchSynthesisExpansion } from '../data/essayResearchSynthesisExpansion.js';
import { essayResearchSynthesisAudit } from '../data/essayResearchSynthesisAudit.js';
import '../styles/global.css';
import '../styles/about-projects.css';
import '../styles/preservation.css';
import '../styles/concept-refresh.css';
import '../styles/page-type-colors.css';
import '../styles/research-index-refresh.css';
import '../styles/research-detail-refresh.css';
import '../styles/essay-reading-rhythm.css';
import '../styles/essay-detail-pop.css';
import '../styles/region-detail-pop.css';

const {
  siteKey = 'setouchi',
  title = 'SETOUCHI ATLAS',
  description = 'ランドスケープ ＝ ネイチャー ｘ カルチャー。港町の路地、島の食卓、海辺の工場をめぐる瀬戸内のエッセイ集。',
  image = 'https://www.city.takehara.lg.jp/material/images/group/14/9.jpg',
  imageAlt = '瀬戸内の町並み',
  structuredData = null,
  seoTitle = null,
  researchMeta = null
} = Astro.props;
const atlasSite = atlasSites[siteKey];
if (!atlasSite) throw new Error(`Unknown ATLAS site: ${siteKey}`);
const siteTitle = `${atlasSite.name}｜${atlasSite.tagline}`;
const baseUrl = atlasSite.basePath;
const pathname = Astro.url.pathname;
const placePathMatch = pathname.match(/\/places\/([^/]+)\/?$/);
const placeId = placePathMatch?.[1] || null;
const naturalSystemProfile = placeId ? naturalSystemProfiles[placeId] : null;
const dynamicNaturalCapitalProfile = placeId ? regionalDynamicNaturalCapital[placeId] : null;
const synthesisLayers = [essayResearchSynthesis[pathname], essayResearchSynthesisExpansion[pathname], essayResearchSynthesisAudit[pathname]].filter(Boolean);
const researchSynthesis = synthesisLayers.length
  ? synthesisLayers.reduce((merged, layer)=>({
      ...merged,
      ...layer,
      title: layer.title || merged.title || 'エッセイから統合した知見',
      updated: layer.updated || merged.updated,
      points: [...(merged.points || []), ...(layer.points || [])],
      essays: [...(merged.essays || []), ...(layer.essays || [])]
    }), {points:[],essays:[]})
  : null;
const isHome = pathname === baseUrl || pathname === baseUrl.slice(0,-1);
const pageTitle = seoTitle || (isHome ? siteTitle : title.includes(atlasSite.name) ? title.replaceAll(atlasSite.name,siteTitle) : `${title} | ${siteTitle}`);
const isEssayDetail = pathname.startsWith(`${baseUrl}book/`) && /^book\/[^/]+\/?$/.test(pathname.slice(baseUrl.length));
const isResearchDetail = /^\/setouchi-cultural-economic-atlas\/chapters\/[^/]+\/?$/.test(pathname);

const dataPrefixes = [
  'climate','wind-tide','transect','land-use','transport','industry','gastronomy-matrix','photos','compare'
].map((segment)=>`${baseUrl}${segment}`);
const pageType = pathname.startsWith(`${baseUrl}places`)
  ? 'region'
  : pathname.startsWith(`${baseUrl}book`)
    ? 'essay'
    : pathname.startsWith(`${baseUrl}chapters`)
      ? 'research'
      : dataPrefixes.some((prefix)=>pathname.startsWith(prefix))
        ? 'data'
        : 'default';

const contextualEssayLinks = pathname.endsWith('/chapters/island-use-intensity/')
  ? [
      ['公共インフラ｜人口52人の島に、道路と水道をどこまで残すのか','/setouchi-cultural-economic-atlas/book/kojima-island-infrastructure-per-capita/'],
      ['シクロツーリズム｜自転車で島を一周しても、島に一円も落ちないとしたら','/setouchi-cultural-economic-atlas/book/kojima-island-cycling-without-consumption/'],
      ['別荘ストック｜1億円の別荘が200万円になったあと、誰がそこへ来たのか','/setouchi-cultural-economic-atlas/book/kojima-island-bubble-villas-second-life/'],
      ['空き家・退出｜誰も困っていない廃墟を、なぜ「地域課題」と呼ぶのか','/setouchi-cultural-economic-atlas/book/kojima-island-when-ruins-are-not-a-problem/']
    ]
  : pathname.endsWith('/chapters/cycle-tourism-regional-impact/') || pathname.endsWith('/chapters/cycle-tourism-system/')
    ? [['鴻島ケース｜自転車で島を一周しても、島に一円も落ちないとしたら','/setouchi-cultural-economic-atlas/book/kojima-island-cycling-without-consumption/']]
    : pathname.endsWith('/chapters/regional-asset-reproduction/')
      ? [
          ['鴻島ケース｜1億円の別荘が200万円になったあと、誰がそこへ来たのか','/setouchi-cultural-economic-atlas/book/kojima-island-bubble-villas-second-life/'],
          ['鴻島ケース｜誰も困っていない廃墟を、なぜ「地域課題」と呼ぶのか','/setouchi-cultural-economic-atlas/book/kojima-island-when-ruins-are-not-a-problem/']
        ]
      : [];

const siteOrigin = Astro.site?.origin || Astro.url.origin;
const siteRoot = new URL(baseUrl, siteOrigin).href;
const canonicalUrl = new URL(pathname, siteOrigin).href;
const sitemapUrl = new URL(`${baseUrl}sitemap.xml`, siteOrigin).href;
const resolvedImage = image == null ? null : image.startsWith('http://') || image.startsWith('https://')
  ? image
  : new URL(image, siteOrigin).href;
const ogType = isEssayDetail || isResearchDetail ? 'article' : 'website';
const schemaType = isHome ? 'WebSite' : isEssayDetail ? 'Article' : isResearchDetail ? 'ScholarlyArticle' : 'WebPage';
const defaultStructuredData = schemaType === 'WebSite'
  ? {
      '@context':'https://schema.org',
      '@type':'WebSite',
      name:siteTitle,
      alternateName:atlasSite.name,
      url:siteRoot,
      description,
      inLanguage:'ja'
    }
  : {
      '@context':'https://schema.org',
      '@type':schemaType,
      headline:title,
      name:title,
      description,
      url:canonicalUrl,
      image:resolvedImage ? [resolvedImage] : undefined,
      inLanguage:'ja',
      isPartOf:{
        '@type':'WebSite',
        name:siteTitle,
        url:siteRoot
      }
    };
const jsonLd = structuredData || defaultStructuredData;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {siteKey === 'setouchi' && <meta name="google-site-verification" content="frkR3ek-9wFn31mRAOozNREXhAZsgursMZcH6cGmurk" />}
    <meta name="description" content={description} />
    <meta name="robots" content={atlasSite.indexable === false ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />

    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {resolvedImage && <meta property="og:image" content={resolvedImage} />}
    {resolvedImage && <meta property="og:image:alt" content={imageAlt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedImage && <meta name="twitter:image" content={resolvedImage} />}
    {resolvedImage && <meta name="twitter:image:alt" content={imageAlt} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[`page-type-${pageType}`,`atlas-theme-${atlasSite.theme}`,isResearchDetail&&'research-detail-page']} data-page-type={pageType}>
    <header class="site-header">
      <a class="brand-wrap" href={baseUrl}>
        <span class="brand">{atlasSite.name}</span>
        <span class="brand-tagline">{atlasSite.tagline}</span>
      </a>
      <nav>
        {atlasSite.navigation.map((item)=>(
          <a class:list={['site-nav-link',item.path === '' ? isHome : !item.path.startsWith('#') && pathname.startsWith(atlasHref(atlasSite,item.path)) && 'active']} href={atlasHref(atlasSite,item.path)}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
      {isResearchDetail && <ResearchNoteOverview pathname={pathname} title={title} description={description} meta={researchMeta} />}
      {!isEssayDetail && researchSynthesis && <EssayResearchSynthesis synthesis={researchSynthesis} />}
      {contextualEssayLinks.length>0 && (
        <section class="section">
          <div class="program-section-head">
            <div><div class="kicker">RELATED ESSAYS</div><h2>この研究ノートを、地域のエッセイで読む</h2></div>
            <p>研究ノートの分析枠組みを、具体的な地域ケースへ戻して読みます。</p>
          </div>
          <div class="chapter-related-grid">
            {contextualEssayLinks.map((item,index)=><a class:list={['compare-button',index>0&&'secondary']} href={item[1]}>{item[0]} →</a>)}
          </div>
        </section>
      )}
      {isResearchDetail && <ResearchRelatedData pathname={pathname} />}
      {naturalSystemProfile && <NaturalSystemEnhancer profile={naturalSystemProfile} />}
      {dynamicNaturalCapitalProfile && <RegionalDynamicNaturalCapital profile={dynamicNaturalCapitalProfile} />}
      {placeId && <RegionalAdaptiveLens placeId={placeId} />}
    </main>
    <footer id="about">
      <strong>{atlasSite.name}</strong>
      <p class="footer-thesis">{atlasSite.tagline}</p>
      <div class="footer-atlas-links">
        {atlasSite.footer.map((item)=><a href={atlasHref(atlasSite,item.path)}>{item.label}</a>)}
      </div>
    </footer>
  </body>
</html>