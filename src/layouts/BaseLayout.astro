---
import NaturalSystemEnhancer from '../components/NaturalSystemEnhancer.astro';
import RegionalAdaptiveLens from '../components/RegionalAdaptiveLens.astro';
import EssayResearchSynthesis from '../components/EssayResearchSynthesis.astro';
import { naturalSystemProfiles } from '../data/naturalSystems.js';
import { essayResearchSynthesis } from '../data/essayResearchSynthesis.js';
import '../styles/global.css';
import '../styles/about-projects.css';
import '../styles/preservation.css';
import '../styles/concept-refresh.css';
import '../styles/page-type-colors.css';

const {
  title = 'SETOUCHI ATLAS',
  description = '瀬戸内のまち、海、産業、食、文化を、エッセイ、地域ページ、研究ノート、地図・統計・写真データを行き来しながら読むアトラス。',
  image = 'https://www.city.takehara.lg.jp/material/images/group/14/9.jpg',
  imageAlt = '瀬戸内の町並み',
  structuredData = null
} = Astro.props;
const baseUrl = '/setouchi-cultural-economic-atlas/';
const pathname = Astro.url.pathname;
const placePathMatch = pathname.match(/\/places\/([^/]+)\/?$/);
const placeId = placePathMatch?.[1] || null;
const naturalSystemProfile = placeId ? naturalSystemProfiles[placeId] : null;
const researchSynthesis = essayResearchSynthesis[pathname] || null;
const isHome = pathname === '/setouchi-cultural-economic-atlas/' || pathname === '/setouchi-cultural-economic-atlas';
const isEssayDetail = /^\/setouchi-cultural-economic-atlas\/book\/[^/]+\/?$/.test(pathname);
const isResearchDetail = /^\/setouchi-cultural-economic-atlas\/chapters\/[^/]+\/?$/.test(pathname);

const dataPrefixes = [
  'data','climate','wind-tide','transect','land-use','transport','industry','gastronomy-matrix','photos','compare'
].map((segment)=>`${baseUrl}${segment}`);
const pageType = pathname.startsWith(`${baseUrl}places`)
  ? 'region'
  : pathname.startsWith(`${baseUrl}book`)
    ? 'essay'
    : pathname.startsWith(`${baseUrl}chapters`)
      ? 'research'
      : dataPrefixes.some((prefix)=>pathname.startsWith(prefix))
        ? 'data'
        : 'default';

const contextualEssayLinks = pathname.endsWith('/chapters/island-use-intensity/')
  ? [
      ['公共インフラ｜人口52人の島に、道路と水道をどこまで残すのか','/setouchi-cultural-economic-atlas/book/kojima-island-infrastructure-per-capita/'],
      ['シクロツーリズム｜自転車で島を一周しても、島に一円も落ちないとしたら','/setouchi-cultural-economic-atlas/book/kojima-island-cycling-without-consumption/'],
      ['別荘ストック｜1億円の別荘が200万円になったあと、誰がそこへ来たのか','/setouchi-cultural-economic-atlas/book/kojima-island-bubble-villas-second-life/'],
      ['空き家・退出｜誰も困っていない廃墟を、なぜ「地域課題」と呼ぶのか','/setouchi-cultural-economic-atlas/book/kojima-island-when-ruins-are-not-a-problem/']
    ]
  : pathname.endsWith('/chapters/cycle-tourism-regional-impact/') || pathname.endsWith('/chapters/cycle-tourism-system/')
    ? [['鴻島ケース｜自転車で島を一周しても、島に一円も落ちないとしたら','/setouchi-cultural-economic-atlas/book/kojima-island-cycling-without-consumption/']]
    : pathname.endsWith('/chapters/regional-asset-reproduction/')
      ? [
          ['鴻島ケース｜1億円の別荘が200万円になったあと、誰がそこへ来たのか','/setouchi-cultural-economic-atlas/book/kojima-island-bubble-villas-second-life/'],
          ['鴻島ケース｜誰も困っていない廃墟を、なぜ「地域課題」と呼ぶのか','/setouchi-cultural-economic-atlas/book/kojima-island-when-ruins-are-not-a-problem/']
        ]
      : [];

const siteOrigin = Astro.site?.origin || Astro.url.origin;
const siteRoot = new URL(baseUrl, siteOrigin).href;
const canonicalUrl = new URL(pathname, siteOrigin).href;
const sitemapUrl = new URL(`${baseUrl}sitemap-index.xml`, siteOrigin).href;
const resolvedImage = image?.startsWith('http://') || image?.startsWith('https://')
  ? image
  : new URL(image || baseUrl, siteOrigin).href;
const ogType = isEssayDetail || isResearchDetail ? 'article' : 'website';
const schemaType = isHome ? 'WebSite' : isEssayDetail ? 'Article' : isResearchDetail ? 'ScholarlyArticle' : 'WebPage';
const defaultStructuredData = schemaType === 'WebSite'
  ? {
      '@context':'https://schema.org',
      '@type':'WebSite',
      name:'SETOUCHI ATLAS',
      alternateName:'瀬戸内自然文化経済アトラス',
      url:siteRoot,
      description,
      inLanguage:'ja'
    }
  : {
      '@context':'https://schema.org',
      '@type':schemaType,
      headline:title,
      name:title,
      description,
      url:canonicalUrl,
      image:resolvedImage ? [resolvedImage] : undefined,
      inLanguage:'ja',
      isPartOf:{
        '@type':'WebSite',
        name:'SETOUCHI ATLAS',
        url:siteRoot
      }
    };
const jsonLd = structuredData || defaultStructuredData;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="google-site-verification" content="frkR3ek-9wFn31mRAOozNREXhAZsgursMZcH6cGmurk" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />

    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="SETOUCHI ATLAS" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body class={`page-type-${pageType}`} data-page-type={pageType}>
    <header class="site-header">
      <a class="brand-wrap" href={baseUrl}>
        <span class="brand">SETOUCHI ATLAS</span>
        <span class="brand-tagline">瀬戸内自然文化経済アトラス</span>
      </a>
      <nav>
        <a class:list={['site-nav-link',isHome&&'active']} href="/setouchi-cultural-economic-atlas/">トップ</a>
        <a class:list={['site-nav-link',pageType==='region'&&'active']} href="/setouchi-cultural-economic-atlas/places/">地域</a>
        <a class:list={['site-nav-link',pageType==='essay'&&'active']} href="/setouchi-cultural-economic-atlas/book/">エッセイ</a>
        <a class:list={['site-nav-link',pageType==='research'&&'active']} href="/setouchi-cultural-economic-atlas/chapters/">研究ノート</a>
        <a class:list={['site-nav-link',pageType==='data'&&'active']} href="/setouchi-cultural-economic-atlas/data/">データ</a>
      </nav>
    </header>
    <main>
      <slot />
      {researchSynthesis && <EssayResearchSynthesis synthesis={researchSynthesis} />}
      {contextualEssayLinks.length>0 && (
        <section class="section">
          <div class="program-section-head">
            <div><div class="kicker">RELATED ESSAYS</div><h2>この研究ノートを、地域のエッセイで読む</h2></div>
            <p>研究ノートの分析枠組みを、具体的な地域ケースへ戻して読みます。</p>
          </div>
          <div class="chapter-related-grid">
            {contextualEssayLinks.map((item,index)=><a class:list={['compare-button',index>0&&'secondary']} href={item[1]}>{item[0]} →</a>)}
          </div>
        </section>
      )}
      {naturalSystemProfile && <NaturalSystemEnhancer profile={naturalSystemProfile} />}
      {placeId && <RegionalAdaptiveLens placeId={placeId} />}
    </main>
    <footer id="about">
      <strong>SETOUCHI ATLAS</strong>
      <p class="footer-thesis">瀬戸内のまち、海、産業、食、文化を、エッセイ、地域ページ、研究ノート、地図・統計・写真データを行き来しながら読むアトラスです。現地の風景や暮らしから生まれた問いをエッセイでひらき、地域ページで土地との関係をたどり、研究ノートで掘り下げ、データで確かめます。読むこと、見ること、調べることを一つにつなぎ、瀬戸内と人の関係を立体的に描きます。</p>
      <div class="footer-atlas-links">
        <a href="/setouchi-cultural-economic-atlas/about/">このアトラスについて</a>
        <a href="/setouchi-cultural-economic-atlas/places/">地域</a>
        <a href="/setouchi-cultural-economic-atlas/book/">エッセイ</a>
        <a href="/setouchi-cultural-economic-atlas/chapters/">研究ノート</a>
        <a href="/setouchi-cultural-economic-atlas/data/">データ</a>
        <a href="/setouchi-cultural-economic-atlas/methodology/">方法論</a>
      </div>
    </footer>
  </body>
</html>