---
import NaturalSystemEnhancer from '../components/NaturalSystemEnhancer.astro';
import RegionalAdaptiveLens from '../components/RegionalAdaptiveLens.astro';
import HomeResearchMapGlobalEnhancer from '../components/HomeResearchMapGlobalEnhancer.astro';
import { naturalSystemProfiles } from '../data/naturalSystems.js';
import { regionalFutureLenses, defaultRegionalFutureLens } from '../data/regionalFutureLenses.js';
import '../styles/global.css';
import '../styles/about-projects.css';
import '../styles/preservation.css';
import '../styles/concept-refresh.css';

const { title = 'SETOUCHI ATLAS', description = '自然から地域がどう形成され、何が再生産され、変化の中でどう再編集されるかを読む。' } = Astro.props;
const baseUrl = '/setouchi-cultural-economic-atlas/';
const placePathMatch = Astro.url.pathname.match(/\/places\/([^/]+)\/?$/);
const placeId = placePathMatch?.[1] || null;
const naturalSystemProfile = placeId ? naturalSystemProfiles[placeId] : null;
const regionalFutureLens = placeId ? (regionalFutureLenses[placeId] || defaultRegionalFutureLens) : null;
const isHome = Astro.url.pathname === '/setouchi-cultural-economic-atlas/' || Astro.url.pathname === '/setouchi-cultural-economic-atlas';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand-wrap" href={baseUrl}>
        <span class="brand">SETOUCHI ATLAS</span>
        <span class="brand-tagline">瀬戸内自然文化経済アトラス</span>
      </a>
      <nav>
        <a href="/setouchi-cultural-economic-atlas/">トップ</a>
        <a href="/setouchi-cultural-economic-atlas/places/">地域</a>
        <a href="/setouchi-cultural-economic-atlas/book/">エッセイ</a>
        <a href="/setouchi-cultural-economic-atlas/chapters/">研究ノート</a>
        <a href="/setouchi-cultural-economic-atlas/data/">データ</a>
      </nav>
    </header>
    <main>
      <slot />
      {isHome && <HomeResearchMapGlobalEnhancer />}
      {naturalSystemProfile && <NaturalSystemEnhancer profile={naturalSystemProfile} />}
      {regionalFutureLens && placeId && <RegionalAdaptiveLens placeId={placeId} lens={regionalFutureLens} />}
    </main>
    <footer id="about">
      <strong>SETOUCHI ATLAS</strong>
      <p class="footer-thesis">自然環境から地域形成を読み、人口減少・産業転換の先にある土地と産業の再編集を考える。現地観察、比較研究、データ、AI支援を往復しながら、仮説そのものを更新していくリサーチ・アトラスです。</p>
      <div class="footer-atlas-links">
        <a href="/setouchi-cultural-economic-atlas/about/">このアトラスについて</a>
        <a href="/setouchi-cultural-economic-atlas/methodology/">方法論</a>
        <a href="/setouchi-cultural-economic-atlas/methodology-ai-adaptive/">AI × Adaptive Management</a>
        <a href="/setouchi-cultural-economic-atlas/projects/">地域アトラスをつくる</a>
      </div>
    </footer>
  </body>
</html>