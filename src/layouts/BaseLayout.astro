---
const { title = '瀬戸内文化経済アトラス', description = '自然・生業・交易・産業・文化・都市の因果から瀬戸内を読む。' } = Astro.props;
const baseUrl = '/setouchi-cultural-economic-atlas/';
import '../styles/global.css';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={baseUrl}>SETOUCHI CULTURE & ECONOMY ATLAS</a>
      <nav>
        <a href="/setouchi-cultural-economic-atlas/chapters/">Research</a>
        <a href="/setouchi-cultural-economic-atlas/places/">Places</a>
        <a href="/setouchi-cultural-economic-atlas/comparative-reading/">Compare</a>
        <a href="/setouchi-cultural-economic-atlas/concepts/">Concepts</a>
        <a href="/setouchi-cultural-economic-atlas/transport/">Transport</a>
        <a href="/setouchi-cultural-economic-atlas/industry/">Industry</a>
        <a href="/setouchi-cultural-economic-atlas/photos/">Photos</a>
        <a href="/setouchi-cultural-economic-atlas/methodology/">Methodology</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer id="about">
      <strong>瀬戸内文化経済アトラス</strong>
      <p>自然環境が何を可能にし、人間がそれを何に変えた地域なのか。事実・解釈・仮説を分けながら、地形から文化・都市までを因果で読む。</p>
    </footer>
  </body>
</html>
